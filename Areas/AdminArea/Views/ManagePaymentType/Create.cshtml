@{
    ViewBag.Title = "Add Payment Type";
    ViewBag.ActiveMenu = "Payments";
    ViewBag.ActivePage = "PaymentTypes";
}
<div class="page-header">
    <div><div class="page-title">Add Payment Type</div><div class="page-subtitle">Create a new payment method</div></div>
    <a href="@Url.Action("Index","ManagePaymentType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-credit-card-2-front"></i> Payment Type Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManagePaymentType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Type Name <span>*</span></label>
                    <input type="text" name="PaymentTypeName" class="form-control" placeholder="e.g. Visa, Cash, PayPal" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Type</button>
                <a href="@Url.Action("Index","ManagePaymentType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
