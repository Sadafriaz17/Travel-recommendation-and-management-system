@model TourwebsiteFYP.DB_data_models.PaymentType
@{
    ViewBag.Title = "Edit Payment Type";
    ViewBag.ActiveMenu = "Payments";
    ViewBag.ActivePage = "PaymentTypes";
}
<div class="page-header">
    <div><div class="page-title">Edit Payment Type</div><div class="page-subtitle">Update payment method #@Model.PaymentTypeId</div></div>
    <a href="@Url.Action("Index","ManagePaymentType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Payment Type Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManagePaymentType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <input type="hidden" name="PaymentTypeId" value="@Model.PaymentTypeId" />
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Type Name <span>*</span></label>
                    <input type="text" name="PaymentTypeName" value="@Model.PaymentTypeName" class="form-control" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Type</button>
                <a href="@Url.Action("Index","ManagePaymentType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
