                        <div class="val">71%</div>
                    </div>
                    <div>
                        <div style="font-family:var(--font-head);font-weight:700;font-size:0.9rem;">Gold Explorer</div>
                        <div style="font-size:0.75rem;color:var(--sub);margin-top:3px;">2,840 / 4,000 points</div>
                        <div style="font-size:0.7rem;color:var(--accent);font-family:var(--font-mono);margin-top:4px;">1,160 pts to Platinum ✦</div>
                    </div>
                </div>
                <div style="background:var(--border);border-radius:4px;height:4px;overflow:hidden;">
                    <div style="width:71%;height:100%;background:linear-gradient(90deg,var(--accent),var(--purple));border-radius:4px;"></div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="sidebar-widget" data-reveal data-delay="150">
                <div class="widget-title">
                    <span class="widget-title-icon">⚡</span> Quick Actions
                </div>
                <div class="quick-actions">
                    <a href="~/Bookings/Index" class="quick-action-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                        Book New Trip
                    </a>
                    <a href="~/Destinations/Index" class="quick-action-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                        Explore Destinations
                    </a>
                    <a href="#" class="quick-action-btn" onclick="generatePlan()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>
                        Generate AI Plan
                    </a>
                    <a href="#" class="quick-action-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        Edit Profile
                    </a>
                    <a href="~/Packages/Index" class="quick-action-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12" /><rect x="2" y="7" width="20" height="5" /><line x1="12" y1="22" x2="12" y2="7" /><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" /><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" /></svg>
                        View Packages
                        <span class="quick-action-badge">3 NEW</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>// ── AI Chat ──
const chatResponses = {
    'santorini': 'Santorini is perfect May–June! Book Oia 3 months ahead. I can generate a full 7-day itinerary for you.',
    'maldives':  'For Maldives, November–April is ideal. Your Gold status gets you 15% off luxury water villa packages!',
    'bali':      'Bali in May–September is peak season. Canggu or Seminyak for surf vibes, Ubud for cultural immersion.',
    'japan':     'Cherry blossom season (late March – early April) books out fast. Want me to check availability for Kyoto?',
    'budget':    'Based on your profile, Bali, Vietnam, or Morocco offer 10-day trips from $700 all-inclusive.',
    'recommend': 'Based on your travel history, I recommend Amalfi Coast (95% match) or Bali (98% match). Want details?',
    'reward':    'You have 2,840 Gold points. Just 1,160 more to reach Platinum status with exclusive lounge access!',
    'plan':      'I can generate a custom itinerary in seconds! Tell me your destination, dates, and travel style.',
    'default':   'Great question! I can help with destination recommendations, package comparisons, VR previews, and itinerary planning. What would you like to explore?'
};

function sendChat() {
    const input = document.getElementById('chatInput');
    const window = document.getElementById('chatWindow');
    const text = input.value.trim();
    if (!text) return;
    const userMsg = document.createElement('div');
    userMsg.className = 'chat-msg user';
    userMsg.textContent = text;
    window.appendChild(userMsg);
    input.value = '';
    window.scrollTop = window.scrollHeight;
    setTimeout(() => {
        const lower = text.toLowerCase();
        let reply = chatResponses.default;
        for (const [key, val] of Object.entries(chatResponses)) {
            if (lower.includes(key)) { reply = val; break; }
        }
        const botMsg = document.createElement('div');
        botMsg.className = 'chat-msg bot';
        botMsg.textContent = reply;
        window.appendChild(botMsg);
        window.scrollTop = window.scrollHeight;
    }, 800);
}

function generatePlan() {
    window.nexToast && window.nexToast('✦ Opening AI Trip Planner...');
    setTimeout(() => window.location.href = '/#ai-generator', 500);
}

// Animate loyalty ring
document.addEventListener('DOMContentLoaded', () => {
    const fill = document.getElementById('ringFill');
    if (fill) {
        const pct = 0.71;
        const circumference = 2 * Math.PI * 26;
        fill.style.strokeDasharray = circumference;
        fill.style.strokeDashoffset = circumference * (1 - pct);
    }
});</script>
}
