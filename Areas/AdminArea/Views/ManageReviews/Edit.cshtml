@model TourwebsiteFYP.DB_data_models.Review
@{
    ViewBag.Title = "Edit Review";
    ViewBag.ActiveMenu = "Reviews";
    ViewBag.ActivePage = "Reviews";
}
<div class="page-header">
    <div><div class="page-title">Edit Review</div><div class="page-subtitle">Update review #@Model.ReviewId</div></div>
    <a href="@Url.Action("Index","ManageReviews", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Review Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManageReviews", new { area = "AdminArea" }, FormMethod.Post))
        {
            <input type="hidden" name="ReviewId" value="@Model.ReviewId" />
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Reviewer (User) <span>*</span></label>
                    <select name="UserId" class="form-control" required>
                        <option value="">- Select User -</option>
                        @foreach (var u in ViewBag.UserList) {
                            string sel = (u.UserId == Model.UserId) ? "selected" : "";
                            <option value="@u.UserId" @sel>@u.FullName (@u.Email)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Rating (1–5) <span>*</span></label>
                    <select name="Rating" class="form-control" required>
                        <option value="">- Select Rating -</option>
                        @for (int i = 1; i <= 5; i++) {
                            string sel = (Model.Rating == i) ? "selected" : "";
                            <option value="@i" @sel>@i star@(i > 1 ? "s" : "") - @(new string('\u2605', i))</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Package (optional)</label>
                    <select name="PackageId" class="form-control">
                        <option value="">- None -</option>
                        @foreach (var p in ViewBag.PackageList) {
                            string sel = (Model.PackageId == p.PackageId) ? "selected" : "";
                            <option value="@p.PackageId" @sel>@p.PackageName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Product (optional)</label>
                    <select name="ProductId" class="form-control">
                        <option value="">- None -</option>
                        @foreach (var p in ViewBag.ProductList) {
                            string sel = (Model.ProductId == p.ProductId) ? "selected" : "";
                            <option value="@p.ProductId" @sel>@p.ProductName</option>
                        }
                    </select>
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Comment</label>
                    <textarea name="Comment" class="form-control" rows="5">@Model.Comment</textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Review</button>
                <a href="@Url.Action("Index","ManageReviews", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>

