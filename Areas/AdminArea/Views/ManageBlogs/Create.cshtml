@{
    ViewBag.Title = "Add Blog Post";
    ViewBag.ActiveMenu = "Blogs";
}

<div class="page-header">
    <div>
        <div class="page-title">Add Blog Post</div>
        <div class="page-subtitle">Create a new blog article</div>
    </div>
    <a href="@Url.Action("Index","ManageBlogs", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">
        <i class="bi bi-arrow-left"></i> Back to Blogs
    </a>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-pencil-square"></i> Blog Details</div>
    </div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create", "ManageBlogs", new { area = "AdminArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Title <span>*</span></label>
                    <input type="text" name="Title" class="form-control" placeholder="Enter blog title" required />
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Content</label>
                    <textarea name="Content" class="form-control" rows="6" placeholder="Write your blog content here..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Author (User)</label>
                    <select name="AuthorId" class="form-control">
                        <option value="">- Select Author -</option>
                        @if (ViewBag.UserList != null)
                        {
                            foreach (var u in ViewBag.UserList)
                            {
                                <option value="@u.UserId">@u.FullName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Featured Image</label>
                    <input type="file" name="img" class="form-control" accept="image/*" />
                    <span class="form-hint">JPEG, PNG or WebP. Max 5MB.</span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Post</button>
                <a href="@Url.Action("Index","ManageBlogs", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>

