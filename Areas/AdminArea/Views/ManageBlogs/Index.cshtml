@model IEnumerable<TourwebsiteFYP.DB_data_models.Blog>
@{
    ViewBag.Title = "Manage Blogs";
    ViewBag.ActiveMenu = "Blogs";
}

<div class="page-header">
    <div>
        <div class="page-title">Blogs</div>
        <div class="page-subtitle">Create and manage blog posts</div>
    </div>
    <a href="@Url.Action("Create", "ManageBlogs", new { area = "AdminArea" })" class="btn-admin btn-admin-primary">
        <i class="bi bi-plus-circle"></i> Add Blog Post
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-toast alert-toast-success">
        <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
        <button class="alert-close"><i class="bi bi-x"></i></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-toast alert-toast-error">
        <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
        <button class="alert-close"><i class="bi bi-x"></i></button>
    </div>
}

<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-pencil-square"></i> All Blog Posts</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Featured Image</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Created Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string imgSrc = !string.IsNullOrEmpty(item.FeaturedImage) ? item.FeaturedImage : "/images/default-blog.jpg";
                            <tr>
                                <td style="color:var(--text-muted);font-size:12px;font-weight:600">#@item.BlogId</td>
                                <td>
                                    <img src="@imgSrc" alt="@item.Title" class="tbl-img" onerror="this.src='/images/default-blog.jpg'" />
                                </td>
                                <td style="font-weight:600;max-width:260px">
                                    <span class="text-truncate-cell">@item.Title</span>
                                </td>
                                <td>@(item.User?.FullName ?? "—")</td>
                                <td style="color:var(--text-muted)">@(item.CreatedDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageBlogs", new { area = "AdminArea", id = item.BlogId })" class="btn-icon btn-icon-edit" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="@Url.Action("Delete","ManageBlogs", new { area = "AdminArea", id = item.BlogId })"
                                           class="btn-icon btn-icon-delete" title="Delete"
                                           onclick="return confirm('Delete this blog post?');">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-pencil-square"></i></div>
                <h4>No Blog Posts</h4>
                <p>Start by adding your first blog post.</p>
                <a href="@Url.Action("Create","ManageBlogs", new { area = "AdminArea" })" class="btn-admin btn-admin-primary">
                    <i class="bi bi-plus-circle"></i> Add Blog Post
                </a>
            </div>
        }
    </div>
</div>
