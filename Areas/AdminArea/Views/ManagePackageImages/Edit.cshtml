@model TourwebsiteFYP.DB_data_models.PackageImage
@{
    ViewBag.Title = "Edit Package Image";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "PackageImages";
}
<div class="page-header">
    <div><div class="page-title">Edit Package Image</div><div class="page-subtitle">Update image #@Model.ImageId</div></div>
    <a href="@Url.Action("Index","ManagePackageImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Image Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManagePackageImages", new { area = "AdminArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <input type="hidden" name="ImageId" value="@Model.ImageId" />
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Package <span>*</span></label>
                    <select name="PackageId" class="form-control" required>
                        <option value="">— Select Package —</option>
                        @foreach (var p in ViewBag.Packages) {
                            string sel = (p.PackageId == Model.PackageId) ? "selected" : "";
                            <option value="@p.PackageId" @sel>@p.PackageName</option>
                        }
                    </select>
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">New Images (Optional)</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    { <img src="@Model.ImageUrl" style="width:80px;height:60px;object-fit:cover;border-radius:6px;border:1px solid var(--border);margin-bottom:8px" onerror="this.style.display='none'" /> }
                    <input type="file" name="files" class="form-control" accept="image/*" multiple />
                    <span class="form-hint">Leave empty to keep the current image. Uploading multiple will update this image with the last file and create new records for the rest.</span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Image</button>
                <a href="@Url.Action("Index","ManagePackageImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
