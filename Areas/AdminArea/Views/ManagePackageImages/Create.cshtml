@{
    ViewBag.Title = "Add Package Image";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "PackageImages";
}
<div class="page-header">
    <div><div class="page-title">Add Package Image</div><div class="page-subtitle">Upload a photo for a package</div></div>
    <a href="@Url.Action("Index","ManagePackageImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-image-alt"></i> Image Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManagePackageImages", new { area = "AdminArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Package <span>*</span></label>
                    <select name="PackageId" class="form-control" required>
                        <option value="">— Select Package —</option>
                        @foreach (var p in ViewBag.Packages) { <option value="@p.PackageId">@p.PackageName</option> }
                    </select>
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Upload Images <span>*</span></label>
                    <input type="file" name="files" class="form-control" accept="image/*" multiple required />
                    <span class="form-hint">You can select multiple images to upload at once.</span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Images</button>
                <a href="@Url.Action("Index","ManagePackageImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
