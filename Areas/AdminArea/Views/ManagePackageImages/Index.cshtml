@model IEnumerable<TourwebsiteFYP.DB_data_models.PackageImage>
@{
    ViewBag.Title = "Manage Package Images";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "PackageImages";
}
<div class="page-header">
    <div><div class="page-title">Package Images</div><div class="page-subtitle">Manage photo galleries for your packages</div></div>
    <a href="@Url.Action("Create","ManagePackageImages", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Images</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-images"></i> All Package Images</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Image</th><th>Package Name</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string imgSrc = !string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/images/default-package.jpg";
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.ImageId</td>
                                <td><img src="@imgSrc" class="tbl-img" onerror="this.src='/images/default-package.jpg'" /></td>
                                <td style="font-weight:600">@(item.Package?.PackageName ?? "-")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManagePackageImages", new { area="AdminArea", id=item.ImageId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManagePackageImages", new { area="AdminArea", id=item.ImageId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this image?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-images"></i></div>
                <h4>No Package Images</h4>
                <p>Upload appealing photos for your travel packages.</p>
                <a href="@Url.Action("Create","ManagePackageImages", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Images</a>
            </div>
        }
    </div>
</div>

