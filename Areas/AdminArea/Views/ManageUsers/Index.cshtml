@model IEnumerable<TourwebsiteFYP.DB_data_models.User>
@{
    ViewBag.Title = "Manage Users";
    ViewBag.ActiveMenu = "Users";
    ViewBag.ActivePage = "UserList";
}
<div class="page-header">
    <div><div class="page-title">Users</div><div class="page-subtitle">Manage system users, customers, and admins</div></div>
    <a href="@Url.Action("Create","ManageUsers", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add User</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-people"></i> All Users</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.UserId</td>
                                <td style="font-weight:700">@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@(item.Phone ?? "—")</td>
                                <td>
                                    @if(item.UserType?.TypeName == "Admin") { <span class="badge-pill badge-danger">Admin</span> }
                                    else if(item.UserType?.TypeName == "Vendor") { <span class="badge-pill badge-warning">Vendor</span> }
                                    else { <span class="badge-pill badge-success">@(item.UserType?.TypeName ?? "Customer")</span> }
                                </td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageUsers", new { area="AdminArea", id=item.UserId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManageUsers", new { area="AdminArea", id=item.UserId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this user?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-people"></i></div>
                <h4>No Users Found</h4>
                <p>Register admins, vendors, and customers.</p>
                <a href="@Url.Action("Create","ManageUsers", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add User</a>
            </div>
        }
    </div>
</div>