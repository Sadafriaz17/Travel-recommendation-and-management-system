@model IEnumerable<TourwebsiteFYP.DB_data_models.User>
@{
    ViewBag.Title = "Users Management";
}

<style>
    /* ============================================
       NEXVOY ADMIN - USERS MANAGEMENT PAGE
       Version: 1.0 - Matching Products/Booking Page Style
       ============================================ */

    /* OVERRIDE LAYOUT STYLES - Critical fixes */
    .app-wrapper {
        display: flex !important;
        min-height: 100vh !important;
        position: relative !important;
    }

    /* Fix sidebar - keep it on left */
    .app-sidebar {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: var(--sidebar-width, 260px) !important;
        height: 100vh !important;
        z-index: 100 !important;
        background: var(--bg-deep) !important;
    }

    /* Fix main content - MUST have margin-left to avoid sidebar */
    .app-main {
        margin-left: var(--sidebar-width, 260px) !important;
        margin-top: var(--header-height, 64px) !important;
        padding: 0 !important;
        min-height: calc(100vh - var(--header-height, 64px) - 44px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: relative !important;
        overflow-x: auto !important;
        background: var(--bg-void) !important;
    }

    /* Fix header - align with main content */
    .app-header {
        left: var(--sidebar-width, 260px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: fixed !important;
        top: 0 !important;
        z-index: 90 !important;
    }

    /* Fix footer */
    .app-footer {
        left: var(--sidebar-width, 260px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: fixed !important;
        bottom: 0 !important;
        z-index: 89 !important;
    }

    /* Header section - Top aligned */
    .app-content-header {
        margin: 0 !important;
        padding: 16px 24px 12px 24px !important;
        background: var(--bg-deep);
        border-bottom: 1px solid var(--border);
        width: 100% !important;
    }

    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .row {
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
    }

    [class*="col-"] {
        padding: 0 !important;
        margin: 0 !important;
    }

    .app-content-header h3 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.3rem;
        background: linear-gradient(135deg, #fff, var(--accent-cyan));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0 !important;
        padding: 0 !important;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        justify-content: flex-end;
    }

    .breadcrumb-item {
        color: var(--text-muted);
        font-size: 0.75rem;
    }

        .breadcrumb-item a {
            color: var(--text-muted);
            text-decoration: none;
        }

            .breadcrumb-item a:hover {
                color: var(--accent-cyan);
            }

        .breadcrumb-item.active {
            color: var(--text-secondary);
        }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            border-color: var(--accent-cyan);
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(0, 221, 180, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .stat-icon i {
            font-size: 24px;
            color: var(--accent-cyan);
        }

    .stat-value {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Content area */
    .app-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    /* Card styles */
    .card {
        background: var(--bg-card) !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .card-header {
        background: var(--bg-deep) !important;
        border-bottom: 1px solid var(--border) !important;
        color: var(--text-primary) !important;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9rem;
        padding: 14px 24px !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

        .card-header span i {
            color: var(--accent-cyan);
            margin-right: 8px;
        }

    .card-body {
        background: var(--bg-deep);
        padding: 20px 24px !important;
        overflow-x: auto !important;
    }

    /* TABLE - Horizontal scroll fix */
    .table-responsive {
        width: 100%;
        overflow-x: auto !important;
        overflow-y: visible !important;
        margin: 0 !important;
        padding: 0 !important;
        display: block !important;
    }

    /* Force table to have minimum width to show all columns */
    .table {
        width: 100% !important;
        min-width: 1100px !important;
        margin: 0 !important;
        border-collapse: collapse;
        table-layout: auto !important;
    }

        /* Table Header */
        .table thead th {
            background: rgba(13, 24, 37, 0.95);
            color: var(--accent-cyan);
            font-family: var(--font-display);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 12px 12px;
            border: none;
            border-bottom: 1px solid var(--border);
            text-align: left;
            white-space: nowrap;
        }

        /* Table Rows */
        .table tbody tr {
            background: rgba(6, 12, 20, 0.5);
            border-bottom: 1px solid rgba(0, 221, 180, 0.05);
        }

        .table tbody td {
            padding: 12px 12px;
            vertical-align: middle;
            border: none;
            color: var(--text-secondary);
            font-size: 0.8rem;
            text-align: left;
            white-space: nowrap;
        }

    .table-hover tbody tr:hover {
        background: var(--bg-hover);
    }

        .table-hover tbody tr:hover td {
            color: var(--text-primary);
        }

    /* User Avatar */
    .user-avatar-table {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        color: var(--bg-void);
    }

    /* User Type Badges */
    .badge-type {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        text-align: center;
    }

    .badge-admin {
        background: rgba(220, 53, 69, 0.15);
        color: #ff6b7c;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .badge-vendor {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-customer {
        background: rgba(0, 221, 180, 0.15);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

    /* Buttons */
    .btn {
        border-radius: 20px !important;
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 600;
        padding: 5px 12px !important;
        transition: all 0.2s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
    }

        .btn i {
            font-size: 0.75rem;
        }

    .btn-warning {
        background: rgba(255, 193, 7, 0.12);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

        .btn-warning:hover {
            background: #ffc107;
            color: #0a1220;
        }

    .btn-danger {
        background: rgba(220, 53, 69, 0.12);
        color: #ff6b7c;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

        .btn-danger:hover {
            background: #dc3545;
            color: #fff;
        }

    .btn-success {
        background: linear-gradient(135deg, rgba(0, 221, 180, 0.15), rgba(124, 92, 252, 0.15));
        color: var(--accent-cyan);
        border: 1px solid var(--border-glow);
    }

        .btn-success:hover {
            background: var(--accent-grad);
            color: var(--bg-void);
        }

    .btn-primary {
        background: rgba(0, 221, 180, 0.12);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

        .btn-primary:hover {
            background: var(--accent-grad);
            color: var(--bg-void);
        }

    /* Alert Messages */
    .alert {
        border-radius: 12px;
        border: none;
        background: rgba(13, 24, 37, 0.95);
        padding: 10px 16px;
        margin-bottom: 16px;
        border-left: 3px solid;
        font-size: 0.8rem;
    }

    .alert-success {
        border-left-color: var(--accent-cyan);
        background: rgba(0, 221, 180, 0.1);
        color: var(--accent-cyan);
    }

    .alert-danger {
        border-left-color: #dc3545;
        background: rgba(220, 53, 69, 0.1);
        color: #ff8a9a;
    }

    .alert .btn-close {
        filter: invert(1) brightness(0.8);
        opacity: 0.5;
        font-size: 0.7rem;
    }

    /* Scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: var(--bg-surface);
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--accent-cyan);
        border-radius: 3px;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .app-main {
            margin-left: 0 !important;
            width: 100% !important;
        }

        .app-header {
            left: 0 !important;
            width: 100% !important;
        }

        .app-footer {
            left: 0 !important;
            width: 100% !important;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .row {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 8px;
        }

        .breadcrumb {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .app-content-header {
            padding: 12px 16px !important;
        }

        .card-body {
            padding: 12px 16px !important;
        }

        .card-header {
            padding: 12px 16px !important;
        }

        .table thead th {
            padding: 8px 10px;
            font-size: 0.65rem;
        }

        .table tbody td {
            padding: 8px 10px;
            font-size: 0.7rem;
        }

        .btn {
            padding: 3px 8px !important;
            font-size: 0.6rem;
        }

        .user-avatar-table {
            width: 28px;
            height: 28px;
            font-size: 10px;
        }
    }
</style>

<!-- Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3>Users Management</h3>
            </div>
            <div class="col-sm-6">
                <div class="breadcrumb">
                    <span class="breadcrumb-item"><a href="#">Home</a></span>
                    <span class="breadcrumb-item active">Users Table Detail</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Content -->
<div class="app-content">
    <div class="container-fluid">
        <!-- Stats Cards -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-value">@Model.Count()</div>
                <div class="stat-label">Total Users</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <div class="stat-value">@Model.Count(u => u.UserType?.TypeName == "Admin")</div>
                <div class="stat-label">Admins</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-shop"></i>
                </div>
                <div class="stat-value">@Model.Count(u => u.UserType?.TypeName == "Vendor")</div>
                <div class="stat-label">Vendors</div>
            </div>
            <div class="stat-card">
                <div class="stat-icon">
                    <i class="bi bi-person"></i>
                </div>
                <div class="stat-value">@Model.Count(u => u.UserType?.TypeName == "Customer" || u.UserType?.TypeName == null)</div>
                <div class="stat-label">Customers</div>
            </div>
        </div>

        <!-- Main Card -->
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-person-badge me-2"></i> Users Table Detail</span>
                <a href="/AdminArea/ManageUsers/Create" class="btn btn-success">
                    <i class="bi bi-plus-circle me-1"></i> Create New User
                </a>
            </div>
            <div class="card-body">
                <!-- Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>User Type</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Address</th>
                                <th>Created At</th>
                                <th style="min-width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                // Get user type safely
                                string userType = item.UserType?.TypeName ?? "Customer";
                                string badgeClass = "badge-customer";

                                if (userType == "Admin")
                                {
                                    badgeClass = "badge-admin";
                                }
                                else if (userType == "Vendor")
                                {
                                    badgeClass = "badge-vendor";
                                }

                                // Get initials for avatar
                                string initials = "";
                                if (!string.IsNullOrEmpty(item.FullName))
                                {
                                    var nameParts = item.FullName.Split(' ');
                                    if (nameParts.Length >= 2)
                                    {
                                        initials = nameParts[0][0].ToString() + nameParts[1][0].ToString();
                                    }
                                    else
                                    {
                                        initials = item.FullName.Substring(0, Math.Min(2, item.FullName.Length)).ToUpper();
                                    }
                                }
                                else
                                {
                                    initials = "U";
                                }


                                <tr>
                                    <td data-label="User ID">
                                        <div style="display: flex; align-items: center; gap: 10px;">
                                            <div class="user-avatar-table">@initials</div>
                                            <span style="color: var(--accent-cyan); font-weight: 500;">#@item.UserId</span>
                                        </div>
                                    </td>
                                    <td data-label="User Type">
                                        <span class="badge-type @badgeClass">@userType</span>
                                    </td>
                                    <td data-label="Full Name" style="font-weight: 500; color: var(--text-primary);">@item.FullName ?? "N/A"</td>
                                    <td data-label="Email">@item.Email ?? "N/A"</td>
                                    <td data-label="Phone">@item.Phone ?? "N/A"</td>
                                    <td data-label="Address">
                                        @if (!string.IsNullOrEmpty(item.Address) && item.Address.Length > 30)
                                        {
                                            @(item.Address.Substring(0, 30) + "...")
                                        }
                                        else
                                        {
                                            @(item.Address ?? "—")
                                        }
                                    </td>
                                    <td data-label="Created At">@(item.CreatedAt?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                                    <td data-label="Actions">
                                        <a href="/AdminArea/ManageUsers/Edit/@item.UserId" class="btn btn-warning btn-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                        <a href="/AdminArea/ManageUsers/Delete/@item.UserId" class="btn btn-danger btn-sm"
                                           onclick="return confirm('Are you sure you want to delete this user?');">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                @if (!Model.Any())
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <i class="bi bi-person-x-fill" style="font-size: 48px; color: var(--text-muted);"></i>
                        <h4 style="color: var(--text-primary); margin-top: 16px;">No Users Found</h4>
                        <p style="color: var(--text-muted);">Create your first user to get started.</p>
                        <a href="/AdminArea/ManageUsers/Create" class="btn btn-success" style="margin-top: 10px;">
                            <i class="bi bi-plus-circle me-1"></i> Create New User
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>