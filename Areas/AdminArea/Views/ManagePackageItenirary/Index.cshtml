@model IEnumerable<TourwebsiteFYP.DB_data_models.PackageItinerary>
@{
    ViewBag.Title = "Manage Itineraries";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "Itinerary";
}
<div class="page-header">
    <div><div class="page-title">Package Itineraries</div><div class="page-subtitle">Manage daily plans for packages</div></div>
    <a href="@Url.Action("Create","ManagePackageItenirary", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Itinerary Day</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-calendar-event"></i> All Itineraries</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#</th><th>Package</th><th>Day</th><th>Title</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.ItineraryId</td>
                                <td style="font-weight:600">@(item.Package?.PackageName ?? "-")</td>
                                <td>Day @item.DayNumber</td>
                                <td>@item.Title</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManagePackageItenirary", new { area="AdminArea", id=item.ItineraryId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManagePackageItenirary", new { area="AdminArea", id=item.ItineraryId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this itinerary day?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-calendar-event"></i></div>
                <h4>No Itineraries Found</h4>
                <p>Start adding daily plans for your travel packages.</p>
                <a href="@Url.Action("Create","ManagePackageItenirary", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Itinerary Day</a>
            </div>
        }
    </div>
</div>

