    <script>
        function toggleSidebar() {
            var w = document.getElementById('appWrapper');
            if (window.innerWidth <= 992) {
                w.classList.toggle('sidebar-open');
            } else {
                w.classList.toggle('sidebar-collapsed');
            }
        }
        function closeSidebar() {
            document.getElementById('appWrapper').classList.remove('sidebar-open');
        }
        function toggleMenu(id) {
            var el = document.getElementById(id);
            if (el) el.classList.toggle('open');
        }
        function toggleDd(id) {
            var el = document.getElementById(id);
            var isOpen = el.classList.contains('open');
            document.querySelectorAll('.hdr-dropdown.open').forEach(function(d){ d.classList.remove('open'); });
            if (!isOpen) el.classList.add('open');
        }
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.hdr-dropdown')) {
                document.querySelectorAll('.hdr-dropdown.open').forEach(function(d){ d.classList.remove('open'); });
            }
        });
        // Auto-dismiss alerts
        document.querySelectorAll('.alert-close').forEach(function(btn){
            btn.addEventListener('click', function(){ this.closest('.alert-toast').remove(); });
        });
        setTimeout(function(){
            document.querySelectorAll('.alert-toast').forEach(function(a){ a.style.opacity='0'; a.style.transition='opacity 0.5s'; setTimeout(function(){ a.remove(); },500); });
        }, 5000);
    </script>

    @RenderSection("scripts", required: false)
