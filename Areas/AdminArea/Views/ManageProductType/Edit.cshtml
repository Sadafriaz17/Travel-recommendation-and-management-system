@model TourwebsiteFYP.DB_data_models.ProductType

@{
    ViewBag.Title = "Edit Product Type";
    ViewBag.ActiveAdmin = "ProductTypes";
    Layout = "~/Areas/AdminArea/Views/Shared/_Layout.cshtml";

}

@section HeadStyles {
    <style>
        /* ── EDIT PRODUCT TYPE PAGE ─────────────────── */
        .form-card {
            background: var(--glass);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            max-width: 800px;
        }

        .form-card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.5rem 2rem;
            border-bottom: 1px solid var(--border);
            background: rgba(251,191,36,0.05);
        }

        .form-card-header-left {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .form-card-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, rgba(251,191,36,0.2), rgba(251,191,36,0.05));
            border: 1px solid rgba(251,191,36,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--warning);
            flex-shrink: 0;
        }

        .form-card-title {
            font-family: var(--font-head);
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text);
        }

        .form-card-subtitle {
            font-size: 0.78rem;
            color: var(--sub);
            margin-top: 0.15rem;
            font-family: var(--font-mono);
            letter-spacing: 0.05em;
        }

        .form-card-badge {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--warning);
            background: rgba(251,191,36,0.1);
            border: 1px solid rgba(251,191,36,0.25);
            border-radius: 100px;
            padding: 0.3rem 0.8rem;
            letter-spacing: 0.08em;
        }

        .form-card-body {
            padding: 2rem;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        .form-field {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .form-field.full {
                grid-column: 1 / -1;
            }

        .form-label {
            font-family: var(--font-mono);
            font-size: 0.68rem;
            color: var(--sub);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            font-weight: 700;
        }

            .form-label .required {
                color: var(--danger);
                margin-left: 2px;
            }

        .form-input {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.75rem 1rem;
            color: var(--text);
            font-size: 0.875rem;
            font-family: var(--font-body);
            outline: none;
            transition: all 0.25s ease;
            width: 100%;
        }

            .form-input:focus {
                border-color: var(--warning);
                background: rgba(251,191,36,0.04);
                box-shadow: 0 0 0 3px rgba(251,191,36,0.08);
            }

            .form-input.error {
                border-color: var(--danger);
                box-shadow: 0 0 0 3px rgba(248,113,113,0.08);
            }

            .form-input::placeholder {
                color: rgba(255,255,255,0.2);
            }

        /* File Input Styling */
        .file-upload-container {
            position: relative;
        }

        .file-upload-area {
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            background: rgba(255,255,255,0.02);
            transition: all 0.3s ease;
            cursor: none;
        }

            .file-upload-area:hover {
                border-color: var(--warning);
                background: rgba(251,191,36,0.03);
            }

            .file-upload-area.has-file {
                border-color: var(--success);
                background: rgba(52,211,153,0.03);
            }

        .file-upload-icon {
            margin-bottom: 0.75rem;
            color: var(--sub);
            transition: color 0.3s;
        }

        .file-upload-area:hover .file-upload-icon {
            color: var(--warning);
        }

        .file-upload-text {
            font-size: 0.82rem;
            color: var(--sub);
            margin-bottom: 0.25rem;
        }

        .file-upload-hint {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.25);
            font-family: var(--font-mono);
        }

        .file-input-hidden {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: none;
        }

        .file-name-display {
            margin-top: 0.75rem;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--accent);
            display: none;
        }

            .file-name-display.visible {
                display: block;
            }

        /* Image Preview */
        .image-preview-section {
            margin-top: 1rem;
        }

        .image-preview-label {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--sub);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 0.75rem;
        }

        .image-preview-grid {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .image-preview-card {
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: rgba(0,0,0,0.3);
            position: relative;
        }

        .image-preview-current {
            width: 160px;
            height: 100px;
        }

            .image-preview-current img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .image-preview-label-badge {
            position: absolute;
            top: 0.5rem;
            left: 0.5rem;
            font-family: var(--font-mono);
            font-size: 0.58rem;
            background: rgba(0,0,0,0.75);
            color: var(--sub);
            padding: 0.2rem 0.5rem;
            border-radius: 4px;
            letter-spacing: 0.06em;
            border: 1px solid var(--border);
            backdrop-filter: blur(8px);
        }

        .image-preview-new {
            width: 160px;
            height: 100px;
            border: 2px dashed var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--sub);
            font-family: var(--font-mono);
            font-size: 0.6rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Hidden field indicator */
        .hidden-field-notice {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 0.9rem;
            background: rgba(77,238,234,0.04);
            border: 1px solid rgba(77,238,234,0.12);
            border-radius: 8px;
            font-size: 0.75rem;
            color: var(--sub);
            font-family: var(--font-mono);
            margin-top: 0.5rem;
        }

        /* Form Footer */
        .form-card-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.75rem;
            padding: 1.25rem 2rem;
            border-top: 1px solid var(--border);
            background: rgba(0,0,0,0.2);
        }

        .btn-update {
            padding: 0.65rem 1.5rem;
            border-radius: 10px;
            font-size: 0.85rem;
            font-family: var(--font-body);
            font-weight: 700;
            background: linear-gradient(135deg, var(--warning), #f59e0b);
            color: #000;
            border: none;
            cursor: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            box-shadow: 0 4px 15px rgba(251,191,36,0.2);
        }

            .btn-update:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 25px rgba(251,191,36,0.35);
            }

        .btn-cancel {
            padding: 0.65rem 1.5rem;
            border-radius: 10px;
            font-size: 0.85rem;
            font-family: var(--font-body);
            font-weight: 500;
            background: transparent;
            color: var(--sub);
            border: 1px solid var(--border);
            cursor: none;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

            .btn-cancel:hover {
                border-color: var(--danger);
                color: var(--danger);
                background: rgba(248,113,113,0.05);
            }

        /* Validation */
        .field-validation-error {
            font-size: 0.72rem;
            color: var(--danger);
            margin-top: 0.3rem;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-card-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }

            .form-card-footer {
                flex-direction: column;
            }

            .btn-update, .btn-cancel {
                width: 100%;
                justify-content: center;
            }

            .image-preview-grid {
                flex-direction: column;
            }
        }
    </style>
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Product Type</h1>
        <p class="page-subtitle">Modify product type details and update image</p>
    </div>
    <div class="page-header-actions">
        <a href="~/AdminArea/ManageProductType/Index" class="btn-cancel" style="text-decoration:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12" />
                <polyline points="12 19 5 12 12 5" />
            </svg>
            Back to List
        </a>
    </div>
</div>

<!-- Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="adm-alert adm-alert-success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12" />
        </svg>
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="adm-alert adm-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <line x1="12" y1="8" x2="12" y2="12" />
            <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        @TempData["ErrorMessage"]
    </div>
}

<!-- Form Card -->
<div class="form-card">
    <div class="form-card-header">
        <div class="form-card-header-left">
            <div class="form-card-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                </svg>
            </div>
            <div>
                <div class="form-card-title">Editing: @Model.TypeName</div>
                <div class="form-card-subtitle">Product Type ID: #@Model.ProductTypeId</div>
            </div>
        </div>
        <span class="form-card-badge">EDIT MODE</span>
    </div>

    <form method="post" enctype="multipart/form-data" action="/AdminArea/ManageProductType/Edit">
        <input type="hidden" name="ProductTypeId" value="@Model.ProductTypeId" />
        <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />

        <div class="form-card-body">
            <div class="form-grid">
                <!-- Type Name -->
                <div class="form-field full">
                    <label class="form-label">
                        Type Name <span class="required">*</span>
                    </label>
                    <input type="text"
                           name="TypeName"
                           value="@Model.TypeName"
                           class="form-input"
                           placeholder="Enter product type name"
                           required />
                </div>

                <!-- Current Image Preview -->
                <div class="form-field">
                    <label class="form-label">Current Image</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="image-preview-current image-preview-card">
                            <img src="@Model.ImageUrl" alt="@Model.TypeName" loading="lazy" />
                            <span class="image-preview-label-badge">CURRENT</span>
                        </div>
                    }
                    else
                    {
                        <div class="image-preview-new">
                            NO IMAGE
                        </div>
                    }
                </div>

                <!-- Upload New Image -->
                <div class="form-field">
                    <label class="form-label">Upload New Image</label>
                    <div class="file-upload-container">
                        <div class="file-upload-area" id="fileUploadArea">
                            <div class="file-upload-icon">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                    <polyline points="17 8 12 3 7 8" />
                                    <line x1="12" y1="3" x2="12" y2="15" />
                                </svg>
                            </div>
                            <div class="file-upload-text">Drag & drop or click to browse</div>
                            <div class="file-upload-hint">PNG, JPG, or WebP (max 5MB)</div>
                        </div>
                        <input type="file"
                               name="img"
                               class="file-input-hidden"
                               id="fileInput"
                               accept="image/png,image/jpeg,image/webp"
                               onchange="handleFileSelect(this)" />
                        <div class="file-name-display" id="fileNameDisplay"></div>
                    </div>
                </div>
            </div>

            <!-- Hidden Field Notice -->
            <div class="hidden-field-notice">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="16" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
                Leave image upload empty to keep the current image.
            </div>
        </div>

        <!-- Footer -->
        <div class="form-card-footer">
            <a href="~/AdminArea/ManageProductType/Index" class="btn-cancel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
                Cancel
            </a>
            <button type="submit" class="btn-update">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
                Update Product Type
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
    function handleFileSelect(input) {
        const area = document.getElementById('fileUploadArea');
        const display = document.getElementById('fileNameDisplay');

        if (input.files && input.files.length > 0) {
            const fileName = input.files[0].name;
            area.classList.add('has-file');
            display.textContent = 'Selected: ' + fileName;
            display.classList.add('visible');
        } else {
            area.classList.remove('has-file');
            display.classList.remove('visible');
            display.textContent = '';
        }
    }

    // Drag and drop support
    const dropArea = document.getElementById('fileUploadArea');
    const fileInput = document.getElementById('fileInput');

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, function(e) {
            e.preventDefault();
            e.stopPropagation();
        });
    });

    ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.style.borderColor = 'var(--warning)';
            dropArea.style.background = 'rgba(251,191,36,0.05)';
        });
    });

    ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, function() {
            dropArea.style.borderColor = 'var(--border)';
            dropArea.style.background = 'rgba(255,255,255,0.02)';
        });
    });

    dropArea.addEventListener('drop', function(e) {
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            fileInput.files = files;
            handleFileSelect(fileInput);
        }
    });
    </script>
}