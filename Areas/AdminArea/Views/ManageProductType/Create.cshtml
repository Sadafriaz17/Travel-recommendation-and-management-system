@{
    ViewBag.Title = "Add Product Type";
    ViewBag.ActiveMenu = "Products";
    ViewBag.ActivePage = "ProductTypes";
}
<div class="page-header">
    <div><div class="page-title">Add Product Type</div><div class="page-subtitle">Create a new category for products</div></div>
    <a href="@Url.Action("Index","ManageProductType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-tags"></i> Product Type Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManageProductType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Type Name <span>*</span></label>
                    <input type="text" name="TypeName" class="form-control" placeholder="e.g. Gear, Clothing" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Type</button>
                <a href="@Url.Action("Index","ManageProductType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>