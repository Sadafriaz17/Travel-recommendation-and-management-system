@model IEnumerable<TourwebsiteFYP.DB_data_models.Booking>
@{
    ViewBag.Title = "Manage Bookings";
    ViewBag.ActiveMenu = "Bookings";
}
<div class="page-header">
    <div><div class="page-title">Bookings</div><div class="page-subtitle">Manage customer bookings and reservations</div></div>
    <a href="@Url.Action("Create","ManageBookings", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Booking</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-calendar-check"></i> All Bookings</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Customer</th><th>Package/Dest</th><th>Date</th><th>Amount</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string statusClass = "badge-neutral";
                            if (item.Status == "Approved" || item.Status == "Confirmed") { statusClass = "badge-success"; }
                            else if (item.Status == "Rejected" || item.Status == "Cancelled") { statusClass = "badge-danger"; }
                            else if (item.Status == "Pending") { statusClass = "badge-warning"; }
                            <tr>
                                <td style="font-weight:600;color:var(--text-muted);font-size:12px">#@item.BookingId</td>
                                <td style="font-weight:700">@(item.User?.FullName ?? item.Email ?? "—")</td>
                                <td>
                                    @if(item.Package != null) { <span><i class="bi bi-gift"></i> @item.Package.PackageName</span> }
                                    else if(item.Destination != null) { <span><i class="bi bi-geo-alt"></i> @item.Destination.Name</span> }
                                    else { <span>—</span> }
                                </td>
                                <td style="color:var(--text-muted)">@(item.BookingDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td style="font-weight:600">$@item.TotalAmount.ToString("N2")</td>
                                <td><span class="badge-pill @statusClass">@(item.Status ?? "Pending")</span></td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageBookings", new { area="AdminArea", id=item.BookingId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManageBookings", new { area="AdminArea", id=item.BookingId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this booking?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-calendar-x"></i></div>
                <h4>No Bookings Found</h4>
                <p>New customer bookings will appear here.</p>
                <a href="@Url.Action("Create","ManageBookings", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Booking</a>
            </div>
        }
    </div>
</div>