@model IEnumerable<TourwebsiteFYP.DB_data_models.Booking>
@{
    ViewBag.Title = "Booking Management";
}

<style>
    /* ============================================
       NEXVOY ADMIN - BOOKING MANAGEMENT PAGE
       Version: 1.0 - Matching Products Page Style
       ============================================ */

    /* OVERRIDE LAYOUT STYLES - Critical fixes */
    .app-wrapper {
        display: flex !important;
        min-height: 100vh !important;
        position: relative !important;
    }

    /* Fix sidebar - keep it on left */
    .app-sidebar {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: var(--sidebar-width, 260px) !important;
        height: 100vh !important;
        z-index: 100 !important;
        background: var(--bg-deep) !important;
    }

    /* Fix main content - MUST have margin-left to avoid sidebar */
    .app-main {
        margin-left: var(--sidebar-width, 260px) !important;
        margin-top: var(--header-height, 64px) !important;
        padding: 0 !important;
        min-height: calc(100vh - var(--header-height, 64px) - 44px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: relative !important;
        overflow-x: auto !important;
        background: var(--bg-void) !important;
    }

    /* Fix header - align with main content */
    .app-header {
        left: var(--sidebar-width, 260px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: fixed !important;
        top: 0 !important;
        z-index: 90 !important;
    }

    /* Fix footer */
    .app-footer {
        left: var(--sidebar-width, 260px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: fixed !important;
        bottom: 0 !important;
        z-index: 89 !important;
    }

    /* Header section - Top aligned */
    .app-content-header {
        margin: 0 !important;
        padding: 16px 24px 12px 24px !important;
        background: var(--bg-deep);
        border-bottom: 1px solid var(--border);
        width: 100% !important;
    }

    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .row {
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
    }

    [class*="col-"] {
        padding: 0 !important;
        margin: 0 !important;
    }

    .app-content-header h3 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.3rem;
        background: linear-gradient(135deg, #fff, var(--accent-cyan));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0 !important;
        padding: 0 !important;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        justify-content: flex-end;
    }

    .breadcrumb-item {
        color: var(--text-muted);
        font-size: 0.75rem;
    }

        .breadcrumb-item a {
            color: var(--text-muted);
            text-decoration: none;
        }

            .breadcrumb-item a:hover {
                color: var(--accent-cyan);
            }

        .breadcrumb-item.active {
            color: var(--text-secondary);
        }

    /* Content area */
    .app-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    /* Card styles */
    .card {
        background: var(--bg-card) !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .card-header {
        background: var(--bg-deep) !important;
        border-bottom: 1px solid var(--border) !important;
        color: var(--text-primary) !important;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9rem;
        padding: 14px 24px !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

        .card-header span i {
            color: var(--accent-cyan);
            margin-right: 8px;
        }

    .card-body {
        background: var(--bg-deep);
        padding: 20px 24px !important;
        overflow-x: auto !important;
    }

    /* TABLE - Horizontal scroll fix */
    .table-responsive {
        width: 100%;
        overflow-x: auto !important;
        overflow-y: visible !important;
        margin: 0 !important;
        padding: 0 !important;
        display: block !important;
    }

    /* Force table to have minimum width to show all columns */
    .table {
        width: 100% !important;
        min-width: 1200px !important;
        margin: 0 !important;
        border-collapse: collapse;
        table-layout: auto !important;
    }

        /* Table Header */
        .table thead th {
            background: rgba(13, 24, 37, 0.95);
            color: var(--accent-cyan);
            font-family: var(--font-display);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 12px 12px;
            border: none;
            border-bottom: 1px solid var(--border);
            text-align: left;
            white-space: nowrap;
        }

        /* Table Rows */
        .table tbody tr {
            background: rgba(6, 12, 20, 0.5);
            border-bottom: 1px solid rgba(0, 221, 180, 0.05);
        }

        .table tbody td {
            padding: 12px 12px;
            vertical-align: middle;
            border: none;
            color: var(--text-secondary);
            font-size: 0.8rem;
            text-align: left;
            white-space: nowrap;
        }

    .table-hover tbody tr:hover {
        background: var(--bg-hover);
    }

        .table-hover tbody tr:hover td {
            color: var(--text-primary);
        }

    /* Status Badges */
    .badge-status {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        text-align: center;
        min-width: 85px;
    }

    .badge-pending {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    .badge-approved {
        background: rgba(0, 221, 180, 0.15);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

    .badge-rejected {
        background: rgba(220, 53, 69, 0.15);
        color: #ff6b7c;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .badge-cancelled {
        background: rgba(108, 117, 125, 0.15);
        color: #adb5bd;
        border: 1px solid rgba(108, 117, 125, 0.3);
    }

    /* Buttons */
    .btn {
        border-radius: 20px !important;
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 600;
        padding: 5px 12px !important;
        transition: all 0.2s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
    }

        .btn i {
            font-size: 0.75rem;
        }

    .btn-secondary {
        background: rgba(108, 117, 125, 0.12);
        color: #adb5bd;
        border: 1px solid rgba(108, 117, 125, 0.3);
    }

        .btn-secondary:hover {
            background: #6c757d;
            color: #fff;
        }

    .btn-success {
        background: rgba(0, 221, 180, 0.12);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

        .btn-success:hover {
            background: var(--accent-grad);
            color: var(--bg-void);
        }

    .btn-danger {
        background: rgba(220, 53, 69, 0.12);
        color: #ff6b7c;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

        .btn-danger:hover {
            background: #dc3545;
            color: #fff;
        }

    .btn-warning {
        background: rgba(255, 193, 7, 0.12);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

        .btn-warning:hover {
            background: #ffc107;
            color: #0a1220;
        }

    /* Alert Messages */
    .alert {
        border-radius: 12px;
        border: none;
        background: rgba(13, 24, 37, 0.95);
        padding: 10px 16px;
        margin-bottom: 16px;
        border-left: 3px solid;
        font-size: 0.8rem;
    }

    .alert-success {
        border-left-color: var(--accent-cyan);
        background: rgba(0, 221, 180, 0.1);
        color: var(--accent-cyan);
    }

    .alert-danger {
        border-left-color: #dc3545;
        background: rgba(220, 53, 69, 0.1);
        color: #ff8a9a;
    }

    .alert .btn-close {
        filter: invert(1) brightness(0.8);
        opacity: 0.5;
        font-size: 0.7rem;
    }

    /* Scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: var(--bg-surface);
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--accent-cyan);
        border-radius: 3px;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .app-main {
            margin-left: 0 !important;
            width: 100% !important;
        }

        .app-header {
            left: 0 !important;
            width: 100% !important;
        }

        .app-footer {
            left: 0 !important;
            width: 100% !important;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .row {
            flex-direction: column;
            align-items: flex-start !important;
            gap: 8px;
        }

        .breadcrumb {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .app-content-header {
            padding: 12px 16px !important;
        }

        .card-body {
            padding: 12px 16px !important;
        }

        .card-header {
            padding: 12px 16px !important;
        }

        .table thead th {
            padding: 8px 10px;
            font-size: 0.65rem;
        }

        .table tbody td {
            padding: 8px 10px;
            font-size: 0.7rem;
        }

        .btn {
            padding: 3px 8px !important;
            font-size: 0.6rem;
        }

        .badge-status {
            padding: 3px 8px;
            font-size: 0.6rem;
            min-width: 70px;
        }
    }
</style>

<!-- Header -->
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3>Booking Management</h3>
            </div>
            <div class="col-sm-6">
                <div class="breadcrumb">
                    <span class="breadcrumb-item"><a href="#">Home</a></span>
                    <span class="breadcrumb-item active">Booking Table Detail</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Content -->
<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <span><i class="bi bi-journal-check me-2"></i> Booking Table Detail</span>
            </div>
            <div class="card-body">
                <!-- Messages -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Booking ID</th>
                                <th>User ID</th>
                                <th>User Name</th>
                                <th>Booking Date</th>
                                <th>Destination</th>
                                <th>Special Request</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th style="min-width: 200px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                // Extract values safely from proxy objects
                                string userName = "N/A";
                                if (item.User != null)
                                {
                                    // Try to get FullName property safely
                                    var userProp = item.User.GetType().GetProperty("FullName");
                                    if (userProp != null)
                                    {
                                        userName = userProp.GetValue(item.User)?.ToString() ?? "N/A";
                                    }
                                }

                                string packageName = "N/A";
                                decimal packagePrice = 0;
                                if (item.Package != null)
                                {
                                    var pkgNameProp = item.Package.GetType().GetProperty("PackageName");
                                    if (pkgNameProp != null)
                                    {
                                        packageName = pkgNameProp.GetValue(item.Package)?.ToString() ?? "N/A";
                                    }

                                    var pkgPriceProp = item.Package.GetType().GetProperty("Price");
                                    if (pkgPriceProp != null)
                                    {
                                        var priceValue = pkgPriceProp.GetValue(item.Package);
                                        if (priceValue != null)
                                        {
                                            packagePrice = Convert.ToDecimal(priceValue);
                                        }
                                    }
                                }

                                string bookingDate = item.BookingDate?.ToString("yyyy-MM-dd") ?? "N/A";
                                string specialRequest = item.SpecialRequest ?? "—";
                                if (!string.IsNullOrEmpty(specialRequest) && specialRequest.Length > 30)
                                {
                                    specialRequest = specialRequest.Substring(0, 30) + "...";
                                }
                                string status = item.Status ?? "Pending";

                                <tr>
                                    <td data-label="Booking ID">
                                        <span class="fw-semibold" style="color: var(--accent-cyan);">#@item.BookingId</span>
                                    </td>
                                    <td data-label="User ID">@item.UserId</td>
                                    <td data-label="User Name" style="font-weight: 500; color: var(--text-primary);">@userName</td>
                                    <td data-label="Booking Date">@bookingDate</td>
                                    <td data-label="Destination">@packageName</td>
                                    <td data-label="Special Request">@specialRequest</td>
                                    <td data-label="Status">
                                        @{
                                            string badgeClass = "badge-pending";
                                            if (status == "Approved") { badgeClass = "badge-approved"; }
                                            else if (status == "Rejected") { badgeClass = "badge-rejected"; }
                                            else if (status == "Cancelled") { badgeClass = "badge-cancelled"; }
                                        }
                                        <span class="badge-status @badgeClass">@status</span>
                                    </td>
                                    <td data-label="Total" class="fw-bold" style="color: var(--accent-cyan);">$@packagePrice.ToString("N2")</td>
                                    <td data-label="Actions">
                                        <a href="@Url.Action("Details", "ManageBooking", new { area = "AdminArea", id = item.BookingId })"
                                           class="btn btn-secondary btn-sm">
                                            <i class="bi bi-eye"></i> View
                                        </a>

                                        @if (status == "Pending")
                                        {
                                            <a href="@Url.Action("Approve", "ManageBooking", new { area = "AdminArea", id = item.BookingId })"
                                               class="btn btn-success btn-sm"
                                               onclick="return confirm('Approve this booking?');">
                                                <i class="bi bi-check-circle"></i> Approve
                                            </a>
                                            <a href="@Url.Action("Reject", "ManageBooking", new { area = "AdminArea", id = item.BookingId })"
                                               class="btn btn-danger btn-sm"
                                               onclick="return confirm('Reject this booking?');">
                                                <i class="bi bi-x-circle"></i> Reject
                                            </a>
                                        }
                                        else if (status == "Approved")
                                        {
                                            <a href="@Url.Action("Cancel", "ManageBooking", new { area = "AdminArea", id = item.BookingId })"
                                               class="btn btn-warning btn-sm"
                                               onclick="return confirm('Cancel this booking?');">
                                                <i class="bi bi-slash-circle"></i> Cancel
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Empty State -->
                @if (!Model.Any())
                {
                    <div style="text-align: center; padding: 40px 20px;">
                        <i class="bi bi-journal-bookmark-fill" style="font-size: 48px; color: var(--text-muted);"></i>
                        <h4 style="color: var(--text-primary); margin-top: 16px;">No Bookings Found</h4>
                        <p style="color: var(--text-muted);">No booking records available in the system.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>