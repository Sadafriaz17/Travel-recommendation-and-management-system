@model IEnumerable<TourwebsiteFYP.DB_data_models.Gallery>
@{
    ViewBag.Title = "Manage Gallery";
    ViewBag.ActiveMenu = "Gallery";
}
<div class="page-header">
    <div><div class="page-title">Gallery</div><div class="page-subtitle">Manage destination and product images</div></div>
    <a href="@Url.Action("Create","ManageGallery", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Image</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-images"></i> All Gallery Images</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Image</th><th>Destination</th><th>Product</th><th>Caption</th><th>Created</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string imgSrc = !string.IsNullOrEmpty(item.ImageUrl) ? item.ImageUrl : "/images/default-image.jpg";
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.GalleryId</td>
                                <td><img src="@imgSrc" class="tbl-img" onerror="this.src='/images/default-image.jpg'" /></td>
                                <td>@(item.Destination?.Name ?? "—")</td>
                                <td>@(item.Product?.ProductName ?? "—")</td>
                                <td style="color:var(--text-muted)">@(item.Caption ?? "—")</td>
                                <td style="color:var(--text-muted)">@(item.CreatedDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageGallery", new { area="AdminArea", id=item.GalleryId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManageGallery", new { area="AdminArea", id=item.GalleryId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this image?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-images"></i></div>
                <h4>No Images Found</h4>
                <p>Upload beautiful photos to showcase destinations and products.</p>
                <a href="@Url.Action("Create","ManageGallery", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Image</a>
            </div>
        }
    </div>
</div>
