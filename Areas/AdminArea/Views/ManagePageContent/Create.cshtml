@{
    ViewBag.Title = "Add Page Content";
    ViewBag.ActiveMenu = "PageContent";
}
<div class="page-header">
    <div><div class="page-title">Add Page Content</div><div class="page-subtitle">Create a new static content block</div></div>
    <a href="@Url.Action("Index","ManagePageContent", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-file-earmark-plus"></i> Content Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManagePageContent", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Page Name <span>*</span></label>
                    <input type="text" name="PageName" class="form-control" placeholder="e.g. Home, About" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Page Title <span>*</span></label>
                    <input type="text" name="pageTitle" class="form-control" required />
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Page Subtitle</label>
                    <textarea name="pageSubtitle" class="form-control" rows="4"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Content</button>
                <a href="@Url.Action("Index","ManagePageContent", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
