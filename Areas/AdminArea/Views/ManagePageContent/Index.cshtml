@model IEnumerable<TourwebsiteFYP.DB_data_models.PageContent>
@{
    ViewBag.Title = "Manage Page Content";
    ViewBag.ActiveMenu = "PageContent";
}
<div class="page-header">
    <div><div class="page-title">Page Content</div><div class="page-subtitle">Manage static content for website pages</div></div>
    <a href="@Url.Action("Create","ManagePageContent", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Content</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-file-earmark-text"></i> All Page Content</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Page Name</th><th>Page Title</th><th>Created At</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.Id</td>
                                <td style="font-weight:700">@item.PageName</td>
                                <td style="font-weight:600">@item.pageTitle</td>
                                <td style="color:var(--text-muted)">@(item.CreatedAt?.ToString("MMM d, yyyy HH:mm") ?? "-")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManagePageContent", new { area="AdminArea", id=item.Id })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManagePageContent", new { area="AdminArea", id=item.Id })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this page content?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-file-earmark-text"></i></div>
                <h4>No Content Blocks</h4>
                <p>Add HTML content blocks to dynamic areas of the website.</p>
                <a href="@Url.Action("Create","ManagePageContent", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Content</a>
            </div>
        }
    </div>
</div>

