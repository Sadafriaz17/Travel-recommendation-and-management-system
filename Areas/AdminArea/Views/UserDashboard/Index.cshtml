@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (function () {
            Chart.defaults.color = '#7a9ab5';
            Chart.defaults.borderColor = 'rgba(0,220,180,0.07)';

            var monthlySpending = [1200, 0, 0, 950, 0, 2100, 0, 0, 0, 1640, 0, 0];

            var ctx = document.getElementById('spendingChart').getContext('2d');

            var gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(0, 221, 180, 0.4)');
            gradient.addColorStop(1, 'rgba(0, 221, 180, 0.05)');

            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    datasets: [{
                        label: 'Spending ($)',
                        data: monthlySpending,
                        backgroundColor: gradient,
                        borderColor: 'rgba(0, 221, 180, 1)',
                        borderWidth: 2,
                        borderRadius: 10,
                        barPercentage: 0.6,
                        categoryPercentage: 0.8,
                        hoverBackgroundColor: 'rgba(0, 221, 180, 0.6)'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(6, 12, 20, 0.95)',
                            titleColor: '#00ddb4',
                            bodyColor: '#7a9ab5',
                            borderColor: 'rgba(0, 221, 180, 0.3)',
                            borderWidth: 1,
                            callbacks: {
                                label: function (context) {
                                    return '💰 Spent: $' + context.raw.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: {
                                color: '#7a9ab5',
                                font: { size: 11 }
                            }
                        },
                        y: {
                            grid: {
                                color: 'rgba(0, 220, 180, 0.08)',
                                drawBorder: true
                            },
                            beginAtZero: true,
                            ticks: {
                                callback: function (value) {
                                    if (value >= 1000) return '$' + (value / 1000).toFixed(0) + 'k';
                                    return '$' + value;
                                },
                                color: '#7a9ab5',
                                stepSize: 500
                            },
                            title: {
                                display: true,
                                text: '💰 Amount Spent ($)',
                                color: '#7a9ab5',
                                font: { size: 11, weight: '600' }
                            }
                        }
                    },
                    animation: {
                        duration: 1000,
                        easing: 'easeOutQuart'
                    }
                }
            });
        })();
    </script>
}