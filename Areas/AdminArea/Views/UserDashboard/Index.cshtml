@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Dashboard";
    ViewBag.ActivePage = "Dashboard";
}

<style>
    /* Enhanced Dashboard Styles */
    .welcome-header {
        margin-bottom: 40px;
        padding: 20px 0;
        position: relative;
    }

    .welcome-header::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100px;
        height: 4px;
        background: var(--accent-grad);
        border-radius: 4px;
    }

    .welcome-title {
        font-family: var(--font-display);
        font-size: 36px;
        font-weight: 800;
        background: linear-gradient(135deg, #fff, #00ddb4, #7c5cfc);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 12px;
        letter-spacing: -0.02em;
    }

    .welcome-subtitle {
        color: var(--text-muted);
        font-size: 15px;
    }

    /* Quick Actions */
    .quick-actions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }

    .quick-action-btn {
        text-align: center;
        padding: 22px 16px;
        background: linear-gradient(135deg, var(--bg-card), var(--bg-surface));
        border: 1px solid var(--border);
        border-radius: 24px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .quick-action-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(0, 221, 180, 0.1), transparent);
        transition: left 0.5s ease;
    }

    .quick-action-btn:hover::before {
        left: 100%;
    }

    .quick-action-btn:hover {
        border-color: var(--accent-cyan);
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 221, 180, 0.2);
    }

    .quick-action-btn i {
        font-size: 32px;
        color: var(--accent-cyan);
        display: block;
        margin-bottom: 12px;
        transition: transform 0.3s ease;
    }

    .quick-action-btn:hover i {
        transform: scale(1.15);
    }

    .quick-action-btn span {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
        letter-spacing: 0.03em;
    }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 40px;
    }

    .stat-card {
        background: linear-gradient(135deg, var(--bg-card), var(--bg-surface));
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 24px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .stat-card:nth-child(1) { border-top: 3px solid #00ddb4; }
    .stat-card:nth-child(2) { border-top: 3px solid #fbbf24; }
    .stat-card:nth-child(3) { border-top: 3px solid #7c5cfc; }
    .stat-card:nth-child(4) { border-top: 3px solid #f472b6; }

    .stat-card::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 200px;
        height: 200px;
        background: radial-gradient(circle, rgba(0, 221, 180, 0.06) 0%, transparent 70%);
        border-radius: 50%;
        transition: transform 0.5s ease;
    }

    .stat-card:hover::after {
        transform: scale(1.5);
    }

    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        transition: all 0.3s ease;
    }

    .stat-card:nth-child(1) .stat-icon { background: linear-gradient(135deg, rgba(0, 221, 180, 0.2), rgba(0, 221, 180, 0.05)); }
    .stat-card:nth-child(2) .stat-icon { background: linear-gradient(135deg, rgba(251, 191, 36, 0.2), rgba(251, 191, 36, 0.05)); }
    .stat-card:nth-child(3) .stat-icon { background: linear-gradient(135deg, rgba(124, 92, 252, 0.2), rgba(124, 92, 252, 0.05)); }
    .stat-card:nth-child(4) .stat-icon { background: linear-gradient(135deg, rgba(244, 114, 182, 0.2), rgba(244, 114, 182, 0.05)); }

    .stat-card:hover .stat-icon {
        transform: scale(1.05);
    }

    .stat-icon i {
        font-size: 28px;
    }

    .stat-card:nth-child(1) .stat-icon i { color: #00ddb4; }
    .stat-card:nth-child(2) .stat-icon i { color: #fbbf24; }
    .stat-card:nth-child(3) .stat-icon i { color: #7c5cfc; }
    .stat-card:nth-child(4) .stat-icon i { color: #f472b6; }

    .stat-value {
        font-family: var(--font-display);
        font-size: 36px;
        font-weight: 800;
        margin-bottom: 8px;
    }

    .stat-card:nth-child(1) .stat-value { color: #00ddb4; }
    .stat-card:nth-child(2) .stat-value { color: #fbbf24; }
    .stat-card:nth-child(3) .stat-value { color: #7c5cfc; }
    .stat-card:nth-child(4) .stat-value { color: #f472b6; }

    .stat-label {
        font-size: 12px;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
    }

    /* Panels */
    .panel {
        background: linear-gradient(135deg, var(--bg-card), var(--bg-surface));
        border: 1px solid var(--border);
        border-radius: 24px;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .panel:hover {
        border-color: rgba(0, 221, 180, 0.3);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }

    .panel-header {
        padding: 18px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(0, 0, 0, 0.2);
    }

    .panel-title {
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .panel-title i {
        font-size: 22px;
        color: var(--accent-cyan);
    }

    .panel-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 30px;
        background: linear-gradient(135deg, rgba(0, 221, 180, 0.15), rgba(124, 92, 252, 0.15));
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.2);
    }

    .btn-link {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 600;
        color: var(--accent-cyan);
        border: 1px solid var(--border-glow);
        background: transparent;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-link:hover {
        background: var(--accent-cyan);
        color: var(--bg-void);
        transform: translateX(3px);
        box-shadow: 0 4px 12px rgba(0, 221, 180, 0.3);
    }

    /* Enhanced Tables with Colors */
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        padding: 16px 20px;
        text-align: left;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        background: rgba(0, 0, 0, 0.3);
        border-bottom: 2px solid var(--border);
    }

    .data-table th:nth-child(1) { color: #00ddb4; }
    .data-table th:nth-child(2) { color: #7c5cfc; }
    .data-table th:nth-child(3) { color: #fbbf24; }
    .data-table th:nth-child(4) { color: #f472b6; }
    .data-table th:nth-child(5) { color: #00ddb4; }

    .data-table td {
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
        transition: all 0.2s ease;
    }

    .data-table tbody tr {
        transition: all 0.2s ease;
    }

    .data-table tbody tr:hover {
        background: rgba(0, 221, 180, 0.05);
        transform: scale(1.01);
    }

    .data-table tbody tr:hover td {
        color: var(--text-primary);
    }

    /* Booking ID Style */
    .booking-id {
        font-family: var(--font-mono);
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .booking-id i {
        font-size: 14px;
        margin-right: 6px;
    }

    /* Package Name with Icon */
    .package-name {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
    }

    .package-name i {
        font-size: 18px;
        width: 28px;
        color: var(--accent-cyan);
    }

    /* Amount Styles */
    .amount {
        font-weight: 700;
        font-family: var(--font-mono);
    }

    .amount-positive {
        color: #00ddb4;
    }

    .amount-pending {
        color: #fbbf24;
    }

    /* Status Badges */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-badge i {
        font-size: 12px;
    }

    .status-approved {
        background: linear-gradient(135deg, rgba(0, 221, 180, 0.15), rgba(0, 221, 180, 0.05));
        color: #00ddb4;
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

    .status-pending {
        background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(251, 191, 36, 0.05));
        color: #fbbf24;
        border: 1px solid rgba(251, 191, 36, 0.3);
    }

    .status-cancelled {
        background: linear-gradient(135deg, rgba(226, 68, 92, 0.15), rgba(226, 68, 92, 0.05));
        color: #e2445c;
        border: 1px solid rgba(226, 68, 92, 0.3);
    }

    .status-confirmed {
        background: linear-gradient(135deg, rgba(0, 221, 180, 0.15), rgba(0, 221, 180, 0.05));
        color: #00ddb4;
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

    /* Chart Container */
    .chart-container {
        padding: 24px;
        background: var(--bg-surface);
    }

    .chart-wrap {
        position: relative;
        height: 320px;
    }

    /* Recommendations Grid */
    .recommendations-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        padding: 24px;
    }

    .rec-card {
        background: linear-gradient(135deg, var(--bg-surface), rgba(0, 221, 180, 0.02));
        border-radius: 20px;
        padding: 24px;
        border: 1px solid var(--border);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .rec-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--accent-grad);
        transform: scaleX(0);
        transition: transform 0.3s ease;
    }

    .rec-card:hover::before {
        transform: scaleX(1);
    }

    .rec-card:hover {
        border-color: var(--accent-cyan);
        transform: translateY(-6px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
    }

    .rec-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(0, 221, 180, 0.15), rgba(124, 92, 252, 0.15));
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        transition: transform 0.3s ease;
    }

    .rec-card:hover .rec-icon {
        transform: scale(1.05);
    }

    .rec-icon i {
        font-size: 28px;
        color: var(--accent-cyan);
    }

    .rec-title {
        margin: 0 0 10px 0;
        color: var(--text-primary);
        font-weight: 700;
        font-size: 18px;
    }

    .rec-description {
        font-size: 13px;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 20px;
    }

    .rec-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
    }

    .rec-price {
        color: var(--accent-cyan);
        font-weight: 800;
        font-size: 24px;
        font-family: var(--font-display);
    }

    /* Quick Stats Footer */
    .quick-stats-footer {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-top: 30px;
    }

    .footer-stat-card {
        background: linear-gradient(135deg, var(--bg-card), var(--bg-surface));
        border: 1px solid var(--border);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.3s ease;
        text-align: center;
    }

    .footer-stat-card:hover {
        border-color: var(--accent-cyan);
        transform: translateY(-3px);
    }

    .footer-stat-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border);
        background: rgba(0, 0, 0, 0.2);
    }

    .footer-stat-header .panel-title {
        justify-content: center;
    }

    .footer-stat-body {
        padding: 30px;
    }

    .footer-stat-value {
        font-size: 42px;
        font-weight: 800;
        font-family: var(--font-display);
        margin-bottom: 8px;
    }

    .footer-stat-card:nth-child(1) .footer-stat-value { color: #fbbf24; }
    .footer-stat-card:nth-child(2) .footer-stat-value { color: #e2445c; }
    .footer-stat-card:nth-child(3) .footer-stat-value { color: #00ddb4; }

    .footer-stat-label {
        font-size: 12px;
        color: var(--text-muted);
        letter-spacing: 0.05em;
    }

    /* Two Column Layout */
    .two-col-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 30px;
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .recommendations-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 900px) {
        .two-col-grid { grid-template-columns: 1fr; }
        .quick-actions { grid-template-columns: repeat(2, 1fr); }
        .quick-stats-footer { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 600px) {
        .stats-grid { grid-template-columns: 1fr; }
        .recommendations-grid { grid-template-columns: 1fr; }
        .quick-actions { grid-template-columns: 1fr; }
        .quick-stats-footer { grid-template-columns: 1fr; }
        .welcome-title { font-size: 28px; }
        .data-table th, .data-table td { padding: 10px 12px; }
    }

    /* Animations */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .stat-card, .panel, .quick-action-btn {
        animation: fadeInUp 0.5s ease forwards;
    }

    .stat-card:nth-child(1) { animation-delay: 0.1s; }
    .stat-card:nth-child(2) { animation-delay: 0.2s; }
    .stat-card:nth-child(3) { animation-delay: 0.3s; }
    .stat-card:nth-child(4) { animation-delay: 0.4s; }
</style>

