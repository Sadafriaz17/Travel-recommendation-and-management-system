@{
    ViewBag.Title = "Add Hotel Image";
    ViewBag.ActiveMenu = "Hotels";
    ViewBag.ActivePage = "HotelImages";
}
<div class="page-header">
    <div><div class="page-title">Add Hotel Image</div><div class="page-subtitle">Upload a photo for a hotel</div></div>
    <a href="@Url.Action("Index","ManageHotelImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-image-alt"></i> Image Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManageHotelImages", new { area = "AdminArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Hotel <span>*</span></label>
                    <select name="HotelId" class="form-control" required>
                        <option value="">— Select Hotel —</option>
                        @foreach (var h in ViewBag.HotelList) { <option value="@h.HotelId">@h.HotelName</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Caption</label>
                    <input type="text" name="Caption" class="form-control" placeholder="Image caption" />
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Upload Image</label>
                    <input type="file" name="img" class="form-control" accept="image/*" />
                    <span class="form-hint">Or enter URL below.</span>
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Image URL (optional)</label>
                    <input type="text" name="ImageUrl" class="form-control" placeholder="https://..." />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Image</button>
                <a href="@Url.Action("Index","ManageHotelImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
