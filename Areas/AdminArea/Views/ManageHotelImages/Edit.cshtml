@model TourwebsiteFYP.DB_data_models.HotelImage
@{
    ViewBag.Title = "Edit Hotel Image";
    ViewBag.ActiveMenu = "Hotels";
    ViewBag.ActivePage = "HotelImages";
}
<div class="page-header">
    <div><div class="page-title">Edit Hotel Image</div><div class="page-subtitle">Update image #@Model.ImageId</div></div>
    <a href="@Url.Action("Index","ManageHotelImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Image Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManageHotelImages", new { area = "AdminArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <input type="hidden" name="ImageId" value="@Model.ImageId" />
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Hotel <span>*</span></label>
                    <select name="HotelId" class="form-control" required>
                        <option value="">— Select Hotel —</option>
                        @foreach (var h in ViewBag.HotelList) {
                            string sel = (h.HotelId == Model.HotelId) ? "selected" : "";
                            <option value="@h.HotelId" @sel>@h.HotelName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Caption</label>
                    <input type="text" name="Caption" value="@Model.Caption" class="form-control" />
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">New Image</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    { <img src="@Model.ImageUrl" style="width:80px;height:60px;object-fit:cover;border-radius:6px;border:1px solid var(--border);margin-bottom:8px" onerror="this.style.display='none'" /> }
                    <input type="file" name="img" class="form-control" accept="image/*" />
                    <span class="form-hint">Leave empty to keep current image.</span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Image</button>
                <a href="@Url.Action("Index","ManageHotelImages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
