@model IEnumerable<TourwebsiteFYP.DB_data_models.Booking>
@{
    ViewBag.Title = "Dashboard";
    ViewBag.ActiveMenu = "Dashboard";
    decimal revenue = ViewBag.TotalRevenue ?? 0m;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <div class="page-title">Welcome back, Admin </div>
        <div class="page-subtitle">Here's what's happening with your travel platform today.</div>
    </div>
    <div style="font-size:12px;color:var(--text-faint)">
        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, MMMM d yyyy")
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon-blue"><i class="bi bi-journal-check"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalBookings</div>
            <div class="stat-label">Total Bookings</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-green"><i class="bi bi-currency-dollar"></i></div>
        <div>
            <div class="stat-value">$@revenue.ToString("N0")</div>
            <div class="stat-label">Total Revenue</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-purple"><i class="bi bi-people"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
            <div class="stat-label">Registered Users</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-orange"><i class="bi bi-gift"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalPackages</div>
            <div class="stat-label">Active Packages</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-red"><i class="bi bi-geo-alt"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalDestinations</div>
            <div class="stat-label">Destinations</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-dark"><i class="bi bi-box-seam"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalProducts</div>
            <div class="stat-label">Products</div>
        </div>
    </div>
</div>

<!-- Quick Links + Recent Bookings -->
<div style="display:grid;grid-template-columns:1fr 2fr;gap:20px;align-items:start" class="dashboard-grid">

    <!-- Quick Actions -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div class="admin-card-title"><i class="bi bi-lightning-charge"></i> Quick Actions</div>
        </div>
        <div class="admin-card-body" style="padding:16px;display:flex;flex-direction:column;gap:8px">
            <a href="@Url.Action("Create","ManagePackages", new { area = "AdminArea" })" class="btn-admin btn-admin-primary" style="width:100%;justify-content:center">
                <i class="bi bi-plus-circle"></i> Add Package
            </a>
            <a href="@Url.Action("Create","ManageDestination", new { area = "AdminArea" })" class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                <i class="bi bi-geo-alt"></i> Add Destination
            </a>
            <a href="@Url.Action("Create","ManageBlogs", new { area = "AdminArea" })" class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                <i class="bi bi-pencil"></i> New Blog Post
            </a>
            <a href="@Url.Action("Create","ManageProducts", new { area = "AdminArea" })" class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                <i class="bi bi-box-seam"></i> Add Product
            </a>
            <a href="@Url.Action("Create","ManageUsers", new { area = "AdminArea" })" class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                <i class="bi bi-person-plus"></i> Add User
            </a>
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div class="admin-card-title"><i class="bi bi-clock-history"></i> Recent Bookings</div>
            <a href="@Url.Action("Index","ManageBookings", new { area = "AdminArea" })" class="btn-admin btn-admin-outline" style="padding:6px 14px;font-size:12px">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="admin-card-body-flush">
            @if (Model != null && Model.Any())
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>#ID</th>
                                <th>Email</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                string statusClass = "badge-neutral";
                                if (b.Status == "Approved" || b.Status == "Confirmed")
                                {
                                    statusClass = "badge-success";
                                }
                                else if (b.Status == "Rejected" || b.Status == "Cancelled")
                                {
                                    statusClass = "badge-danger";
                                }
                                else if (b.Status == "Pending")
                                {
                                    statusClass = "badge-warning";
                                }
                                <tr>
                                    <td style="font-weight:600;color:var(--text-muted);font-size:12px">#@b.BookingId</td>
                                    <td>@(b.Email ?? "—")</td>
                                    <td style="font-weight:600">$@b.TotalAmount.ToString("N2")</td>
                                    <td><span class="badge-pill @statusClass">@(b.Status ?? "Pending")</span></td>
                                    <td style="color:var(--text-muted)">@(b.BookingDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state" style="padding:40px">
                    <div class="empty-state-icon"><i class="bi bi-journal-x"></i></div>
                    <h4>No bookings yet</h4>
                    <p>Bookings will appear here once customers start booking.</p>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <style>
        @@media (max-width: 900px) {
            .dashboard-grid {
                grid-template-columns: 1fr !important;
            }
        }
    </style>
}
