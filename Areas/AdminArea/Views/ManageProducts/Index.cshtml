@model IEnumerable<TourwebsiteFYP.DB_data_models.Product>
@{
    ViewBag.Title = "Manage Products";
    ViewBag.ActiveMenu = "Products";
    ViewBag.ActivePage = "Products";
}
<div class="page-header">
    <div><div class="page-title">Products</div><div class="page-subtitle">Manage travel products and accessories</div></div>
    <a href="@Url.Action("Create","ManageProducts", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Product</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-box-seam"></i> All Products</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Product Name</th><th>Type</th><th>Price</th><th>Stock Status</th><th>Created</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.ProductId</td>
                                <td style="font-weight:700">@item.ProductName</td>
                                <td>@(item.ProductType?.TypeName ?? "-")</td>
                                <td style="font-weight:600">@(item.Price.ToString("C2"))</td>
                                <td>
                                    @if(item.StockStatus == "In Stock") { <span class="badge-pill badge-success">In Stock</span> }
                                    else if(item.StockStatus == "Low Stock") { <span class="badge-pill badge-warning">Low Stock</span> }
                                    else { <span class="badge-pill badge-danger">@(item.StockStatus ?? "Out of stock")</span> }
                                </td>
                                <td style="color:var(--text-muted)">@(item.CreatedAt.ToString("MMM d, yyyy"))</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageProducts", new { area="AdminArea", id=item.ProductId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManageProducts", new { area="AdminArea", id=item.ProductId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this product?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-box-seam"></i></div>
                <h4>No Products Found</h4>
                <p>Start selling travel accessories and items.</p>
                <a href="@Url.Action("Create","ManageProducts", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Product</a>
            </div>
        }
    </div>
</div>
