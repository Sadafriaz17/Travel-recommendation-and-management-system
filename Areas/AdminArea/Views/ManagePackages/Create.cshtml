@{
    ViewBag.Title = "Add Package";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "Packages";
}
<div class="page-header">
    <div><div class="page-title">Add Package</div><div class="page-subtitle">Create a new travel package</div></div>
    <a href="@Url.Action("Index","ManagePackages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-gift"></i> Package Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManagePackages", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Package Name <span>*</span></label>
                    <input type="text" name="PackageName" class="form-control" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Type</label>
                    <select name="PackageTypeId" class="form-control">
                        <option value="">- Select Type -</option>
                        @foreach (var t in ViewBag.PackageTypes) { <option value="@t.PackageTypeId">@t.TypeName</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Destination</label>
                    <select name="DestinationId" class="form-control">
                        <option value="">- Select Destination -</option>
                        @foreach (var d in ViewBag.Destinations) { <option value="@d.DestinationId">@d.Name</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Price ($)</label>
                    <input type="number" name="Price" class="form-control" step="0.01" min="0" />
                </div>
                <div class="form-group">
                    <label class="form-label">Duration (Days)</label>
                    <input type="number" name="DurationDays" class="form-control" min="1" />
                </div>
                <div class="form-group">
                    <label class="form-label">People</label>
                    <input type="number" name="People" class="form-control" min="1" />
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="4"></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Package</button>
                <a href="@Url.Action("Index","ManagePackages", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>

