@model IEnumerable<TourwebsiteFYP.DB_data_models.Package>
@{
    ViewBag.Title = "Manage Packages";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "Packages";
}
<div class="page-header">
    <div><div class="page-title">Packages</div><div class="page-subtitle">Manage tour and travel packages</div></div>
    <a href="@Url.Action("Create","ManagePackages", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Package</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-gift"></i> All Packages</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#</th><th>Name</th><th>Price</th><th>Duration</th><th>Destination</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.PackageId</td>
                                <td style="font-weight:700">@item.PackageName</td>
                                <td style="font-weight:600">@(item.Price > 0 ? "$" + item.Price.ToString("N2") : "—")</td>
                                <td>@(item.DurationDays > 0 ? item.DurationDays + " Days" : "—")</td>
                                <td>@(item.Destination?.Name ?? "—")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManagePackages", new { area="AdminArea", id=item.PackageId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManagePackages", new { area="AdminArea", id=item.PackageId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this package?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-gift"></i></div>
                <h4>No Packages Found</h4>
                <p>Start adding travel packages to your platform.</p>
                <a href="@Url.Action("Create","ManagePackages", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Package</a>
            </div>
        }
    </div>
</div>