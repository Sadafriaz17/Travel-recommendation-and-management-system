@model TourwebsiteFYP.DB_data_models.UserType
@{
    ViewBag.Title = "Edit User Role";
    ViewBag.ActiveMenu = "Users";
    ViewBag.ActivePage = "UserTypes";
}
<div class="page-header">
    <div><div class="page-title">Edit User Role</div><div class="page-subtitle">Update role #@Model.UserTypeId</div></div>
    <a href="@Url.Action("Index","ManageUserType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Role Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManageUserType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <input type="hidden" name="UserTypeId" value="@Model.UserTypeId" />
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Role Name <span>*</span></label>
                    <input type="text" name="TypeName" value="@Model.TypeName" class="form-control" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Role</button>
                <a href="@Url.Action("Index","ManageUserType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
