@model TourwebsiteFYP.DB_data_models.UserType

@{
    ViewBag.Title = "Edit User Type";
}

<div class="col-md-12">
    <!--begin::Carousel Image Card-->
    <div class="card shadow-sm rounded-4 mb-4">
        <!--begin::Card Header-->
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">Add Product Type</h5>
        </div>
        <!--end::Card Header-->
        <!--begin::Form-->
        <form enctype="multipart/form-data" method="post" action="/AdminArea/ProductType/Edit">
            <input type="hidden" name="ProductTypeId" value="@Model.UserTypeId" />
           
            <!--begin::Card Body-->
            <div class="card-body">
                <div class="row g-3">


                    <div class="col-md-6">
                        <label class="form-label"> Type Name</label>
                        <input value="@Model.TypeName" name="TypeName" type="text" class="form-control" />
                    </div>
                  


                </div>
            </div>
            <!--end::Card Body-->
            <!--begin::Card Footer-->
            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Edit
                </button>
                <a href="/AdminArea/UserType/Index" class="btn btn-danger">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
            <!--end::Card Footer-->
        </form>
        <!--end::Form-->
    </div>
    <!--end::Carousel Image Card-->
</div>
