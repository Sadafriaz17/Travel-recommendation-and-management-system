@{
    ViewBag.Title = "Add User Role";
    ViewBag.ActiveMenu = "Users";
    ViewBag.ActivePage = "UserTypes";
}
<div class="page-header">
    <div><div class="page-title">Add User Role</div><div class="page-subtitle">Create a new system role</div></div>
    <a href="@Url.Action("Index","ManageUserType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-shield-plus"></i> Role Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManageUserType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Role Name <span>*</span></label>
                    <input type="text" name="TypeName" class="form-control" placeholder="e.g. Admin, Customer" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Role</button>
                <a href="@Url.Action("Index","ManageUserType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
