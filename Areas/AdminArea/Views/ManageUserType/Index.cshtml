@model IEnumerable<TourwebsiteFYP.DB_data_models.UserType>
@{
    ViewBag.Title = "Manage User Roles";
    ViewBag.ActiveMenu = "Users";
    ViewBag.ActivePage = "UserTypes";
}
<div class="page-header">
    <div><div class="page-title">User Roles</div><div class="page-subtitle">Manage user permissions and types</div></div>
    <a href="@Url.Action("Create","ManageUserType", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Role</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-shield-lock"></i> All User Roles</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Role Name</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.UserTypeId</td>
                                <td style="font-weight:600">@item.TypeName</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageUserType", new { area="AdminArea", id=item.UserTypeId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManageUserType", new { area="AdminArea", id=item.UserTypeId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this role?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-shield-lock"></i></div>
                <h4>No User Roles</h4>
                <p>Define roles like Admin, Customer, Manager.</p>
                <a href="@Url.Action("Create","ManageUserType", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Role</a>
            </div>
        }
    </div>
</div>