@model IEnumerable<TourwebsiteFYP.DB_data_models.Booking>
@{
    ViewBag.Title      = "Manager Dashboard";
    ViewBag.ActiveMenu = "ManagerDashboard";
    string userName = ViewBag.SessionUserName ?? "Manager";
    decimal revenue = ViewBag.TotalRevenue ?? 0m;
    double avgRating = ViewBag.AverageRating ?? 0.0;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <div class="page-title">Manager Overview <span style="font-weight:400;color:var(--text-muted)">📊</span></div>
        <div class="page-subtitle">Platform analytics and vendor oversight — read-only view.</div>
    </div>
    <div style="font-size:12px;color:var(--text-faint)">
        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, MMMM d yyyy")
    </div>
</div>

<!-- Primary Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon-blue"><i class="bi bi-journal-check"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalBookings</div>
            <div class="stat-label">Total Bookings</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-green"><i class="bi bi-currency-dollar"></i></div>
        <div>
            <div class="stat-value">$@revenue.ToString("N0")</div>
            <div class="stat-label">Platform Revenue</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-purple"><i class="bi bi-people"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalUsers</div>
            <div class="stat-label">Registered Users</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-orange"><i class="bi bi-shop"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalVendors</div>
            <div class="stat-label">Active Vendors</div>
        </div>
    </div>
</div>

<!-- Secondary Stats Row -->
<div class="stat-grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr));margin-bottom:24px">
    <div class="stat-card" style="background:#f0fdf4;border-color:#bbf7d0">
        <div class="stat-icon" style="background:rgba(16,185,129,0.12);color:#10b981"><i class="bi bi-check-circle"></i></div>
        <div>
            <div class="stat-value" style="color:#059669">@ViewBag.ConfirmedCount</div>
            <div class="stat-label">Confirmed</div>
        </div>
    </div>
    <div class="stat-card" style="background:#fffbeb;border-color:#fde68a">
        <div class="stat-icon" style="background:rgba(245,158,11,0.12);color:#f59e0b"><i class="bi bi-hourglass-split"></i></div>
        <div>
            <div class="stat-value" style="color:#d97706">@ViewBag.PendingCount</div>
            <div class="stat-label">Pending</div>
        </div>
    </div>
    <div class="stat-card" style="background:#fef2f2;border-color:#fecaca">
        <div class="stat-icon" style="background:rgba(239,68,68,0.12);color:#ef4444"><i class="bi bi-x-circle"></i></div>
        <div>
            <div class="stat-value" style="color:#dc2626">@ViewBag.CancelledCount</div>
            <div class="stat-label">Cancelled</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-dark"><i class="bi bi-gift"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalPackages</div>
            <div class="stat-label">Packages</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-blue"><i class="bi bi-box-seam"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalProducts</div>
            <div class="stat-label">Products</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-purple"><i class="bi bi-star-fill"></i></div>
        <div>
            <div class="stat-value">@avgRating</div>
            <div class="stat-label">Avg Review Rating</div>
        </div>
    </div>
</div>

<!-- Main Grid: Vendor Oversight + Recent Bookings -->
<div style="display:grid;grid-template-columns:1fr 2fr;gap:20px;align-items:start" class="mgr-grid">

    <!-- Top Vendors -->
    <div style="display:flex;flex-direction:column;gap:16px">

        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title"><i class="bi bi-trophy"></i> Top Vendors by Listings</div>
            </div>
            <div class="admin-card-body-flush">
                @if (ViewBag.TopVendors != null)
                {
                    var vendors = ViewBag.TopVendors as IEnumerable<TourwebsiteFYP.DB_data_models.Vendor>;
                    if (vendors != null && vendors.Any())
                    {
                        int rank = 1;
                        foreach (var v in vendors)
                        {
                            string rankColor = rank == 1 ? "#f59e0b" : rank == 2 ? "#94a3b8" : rank == 3 ? "#d97706" : "var(--text-faint)";
                            <div style="display:flex;align-items:center;gap:14px;padding:14px 20px;border-bottom:1px solid var(--border)">
                                <div style="width:28px;height:28px;border-radius:50%;background:rgba(0,0,0,0.05);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:@rankColor;flex-shrink:0">
                                    @rank
                                </div>
                                <div style="flex:1;min-width:0">
                                    <div style="font-weight:600;font-size:13.5px;color:var(--text-dark);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@v.VendorName</div>
                                    <div style="font-size:11.5px;color:var(--text-muted)">@v.Products.Count products · Rating @v.Rating.ToString("N1")</div>
                                </div>
                                <span class="badge-pill badge-info">@v.Products.Count</span>
                            </div>
                            rank++;
                        }
                    }
                    else
                    {
                        <div class="empty-state" style="padding:30px">
                            <div class="empty-state-icon"><i class="bi bi-shop"></i></div>
                            <p>No vendors found.</p>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Manager actions (read-only navigation only) -->
        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title"><i class="bi bi-lightning-charge"></i> Quick Navigation</div>
            </div>
            <div class="admin-card-body" style="display:flex;flex-direction:column;gap:8px;padding:16px">
                <a href="@Url.Action("Index","ManageBookings", new { area = "AdminArea" })"
                   class="btn-admin btn-admin-primary" style="width:100%;justify-content:center">
                    <i class="bi bi-journal-check"></i> View All Bookings
                </a>
                <a href="@Url.Action("Index","ManageMarketplaceListing", new { area = "AdminArea" })"
                   class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                    <i class="bi bi-shop"></i> Vendor Listings
                </a>
                <a href="@Url.Action("Index","ManageReviews", new { area = "AdminArea" })"
                   class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                    <i class="bi bi-star-half"></i> Reviews
                </a>
                <a href="#profile-section"
                   class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                    <i class="bi bi-person-gear"></i> Profile Settings
                </a>
                <a href="@Url.Action("Index","Logout", new { area = "" })"
                   class="btn-admin btn-admin-outline"
                   style="width:100%;justify-content:center;color:var(--danger);border-color:rgba(239,68,68,0.25)">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </a>
            </div>
        </div>
    </div>

    <!-- Recent Bookings Oversight -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div class="admin-card-title"><i class="bi bi-clock-history"></i> Recent Bookings</div>
            <a href="@Url.Action("Index","ManageBookings", new { area = "AdminArea" })"
               class="btn-admin btn-admin-outline" style="padding:6px 14px;font-size:12px">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        <div class="admin-card-body-flush">
            @if (Model != null && Model.Any())
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>#ID</th>
                                <th>Email</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model)
                            {
                                string statusClass = "badge-neutral";
                                if (b.Status == "Approved" || b.Status == "Confirmed") { statusClass = "badge-success"; }
                                else if (b.Status == "Rejected" || b.Status == "Cancelled") { statusClass = "badge-danger"; }
                                else if (b.Status == "Pending") { statusClass = "badge-warning"; }
                                <tr>
                                    <td style="font-weight:600;color:var(--text-muted);font-size:12px">#@b.BookingId</td>
                                    <td>@(b.Email ?? "—")</td>
                                    <td style="font-weight:600">$@b.TotalAmount.ToString("N2")</td>
                                    <td><span class="badge-pill @statusClass">@(b.Status ?? "Pending")</span></td>
                                    <td style="color:var(--text-muted)">@(b.BookingDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state" style="padding:40px">
                    <div class="empty-state-icon"><i class="bi bi-journal-x"></i></div>
                    <h4>No bookings yet</h4>
                    <p>Bookings will appear here once activity picks up.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Profile Settings Section -->
<div id="profile-section" style="margin-top:24px">
    @{
        var profileUser = ViewBag.ProfileUser as TourwebsiteFYP.DB_data_models.User
                          ?? new TourwebsiteFYP.DB_data_models.User();
    }
    @Html.Partial("~/Areas/AdminArea/Views/Shared/_ProfileSettings.cshtml", profileUser)
</div>

@section scripts {
    <style>
        @@media (max-width: 1024px) {
            .mgr-grid { grid-template-columns: 1fr !important; }
        }
    </style>
}
