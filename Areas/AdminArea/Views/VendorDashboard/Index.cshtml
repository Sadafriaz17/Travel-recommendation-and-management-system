@model IEnumerable<TourwebsiteFYP.DB_data_models.BookingDetail>
@{
    ViewBag.Title      = "Vendor Dashboard";
    ViewBag.ActiveMenu = "VendorDashboard";
    string userName     = ViewBag.SessionUserName ?? "Vendor";
    string vendorName   = ViewBag.VendorName ?? userName;
    decimal earnings    = ViewBag.TotalEarnings ?? 0m;
    decimal rating      = ViewBag.VendorRating ?? 0m;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <div class="page-title">Welcome, @vendorName <span style="font-weight:400;color:var(--text-muted)"></span></div>
        <div class="page-subtitle">Manage your listings and track your performance.</div>
    </div>
    <div style="display:flex;align-items:center;gap:12px">
        <div style="font-size:12px;color:var(--text-faint)">
            <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, MMMM d yyyy")
        </div>
        @if (ViewBag.VendorId != null)
        {
            <a href="@Url.Action("Edit", "ManageMarketplaceListing", new { area = "AdminArea", id = ViewBag.VendorId })"
               class="btn-admin btn-admin-outline" style="padding:6px 14px;font-size:12px">
                <i class="bi bi-pencil"></i> Edit Listing
            </a>
        }
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon-blue"><i class="bi bi-box-seam"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalProducts</div>
            <div class="stat-label">Active Listings</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-green"><i class="bi bi-currency-dollar"></i></div>
        <div>
            <div class="stat-value">$@earnings.ToString("N0")</div>
            <div class="stat-label">Total Earnings</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-orange"><i class="bi bi-bag-check"></i></div>
        <div>
            <div class="stat-value">@ViewBag.TotalOrders</div>
            <div class="stat-label">Orders Received</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon stat-icon-purple"><i class="bi bi-star-fill"></i></div>
        <div>
            <div class="stat-value">@rating.ToString("N1")</div>
            <div class="stat-label">Vendor Rating</div>
        </div>
    </div>
</div>

<!-- Main Grid -->
<div style="display:grid;grid-template-columns:1fr 2.2fr;gap:20px;align-items:start" class="vendor-grid">

    <!-- Sidebar Actions -->
    <div style="display:flex;flex-direction:column;gap:16px">

        <div class="admin-card">
            <div class="admin-card-header">
                <div class="admin-card-title"><i class="bi bi-lightning-charge"></i> Actions</div>
            </div>
            <div class="admin-card-body" style="display:flex;flex-direction:column;gap:8px;padding:16px">
                <a href="@Url.Action("Index", "ManageMarketplaceListing", new { area = "AdminArea" })"
                   class="btn-admin btn-admin-primary" style="width:100%;justify-content:center">
                    <i class="bi bi-shop"></i> My Marketplace Listings
                </a>
                <a href="@Url.Action("Index", "ManageProducts", new { area = "AdminArea" })"
                   class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                    <i class="bi bi-box-seam"></i> Manage Products
                </a>
                <a href="#profile-section" class="btn-admin btn-admin-outline" style="width:100%;justify-content:center">
                    <i class="bi bi-person-gear"></i> Profile Settings
                </a>
                <a href="@Url.Action("Index", "Logout", new { area = "" })"
                   class="btn-admin btn-admin-outline"
                   style="width:100%;justify-content:center;color:var(--danger);border-color:rgba(239,68,68,0.25)">
                    <i class="bi bi-box-arrow-right"></i> Sign Out
                </a>
            </div>
        </div>

        <!-- Earnings summary mini-card -->
        <div class="admin-card" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border-color:#bfdbfe">
            <div class="admin-card-body" style="padding:18px">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                    <div style="width:36px;height:36px;border-radius:10px;background:#3b82f6;display:flex;align-items:center;justify-content:center">
                        <i class="bi bi-graph-up-arrow" style="color:#fff;font-size:16px"></i>
                    </div>
                    <div style="font-weight:700;font-size:13px;color:#1d4ed8">Earnings Summary</div>
                </div>
                <div style="font-size:28px;font-weight:800;color:#1d4ed8;letter-spacing:-0.03em">$@earnings.ToString("N0")</div>
                <div style="font-size:12px;color:#2563eb;margin-top:4px">Lifetime earnings from @ViewBag.TotalOrders orders</div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="admin-card">
        <div class="admin-card-header">
            <div class="admin-card-title"><i class="bi bi-bag-check"></i> Recent Orders</div>
        </div>
        <div class="admin-card-body-flush">
            @if (Model != null && Model.Any())
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>Booking Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bd in Model)
                            {
                                string statusClass = "badge-neutral";
                                string status = bd.Booking?.Status ?? "";
                                if (status == "Approved" || status == "Confirmed") { statusClass = "badge-success"; }
                                else if (status == "Rejected" || status == "Cancelled") { statusClass = "badge-danger"; }
                                else if (status == "Pending") { statusClass = "badge-warning"; }
                                <tr>
                                    <td style="font-weight:600;color:var(--text-muted);font-size:12px">#@bd.BookingId</td>
                                    <td>@(bd.Product?.ProductName ?? "")</td>
                                    <td>@(bd.Quantity ?? 1)</td>
                                    <td style="font-weight:600">$@bd.Price.ToString("N2")</td>
                                    <td><span class="badge-pill @statusClass">@status</span></td>
                                    <td style="color:var(--text-muted)">@(bd.Booking?.BookingDate?.ToString("MMM d, yyyy") ?? "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><i class="bi bi-bag-x"></i></div>
                    <h4>No orders yet</h4>
                    <p>Orders will appear here once customers purchase your products.</p>
                    <a href="@Url.Action("Create", "ManageProducts", new { area = "AdminArea" })"
                       class="btn-admin btn-admin-primary">
                        <i class="bi bi-plus-circle"></i> Add a Product
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Profile Settings Section -->
<div id="profile-section" style="margin-top:24px">
    @{
        var profileUser = ViewBag.ProfileUser as TourwebsiteFYP.DB_data_models.User
                          ?? new TourwebsiteFYP.DB_data_models.User();
    }
    @Html.Partial("~/Areas/AdminArea/Views/Shared/_ProfileSettings.cshtml", profileUser)
</div>

@section scripts {
    <style>
        @@media (max-width: 900px) {
            .vendor-grid { grid-template-columns: 1fr !important; }
        }
    </style>
}
