@{
    ViewBag.Title = "Marketplace Listings";
}

<style>
    /* ============================================
       NEXVOY ADMIN - MARKETPLACE LISTINGS PAGE
       Version: 1.0 - Static Demo Data
       ============================================ */

    /* OVERRIDE LAYOUT STYLES - Critical fixes */
    .app-wrapper {
        display: flex !important;
        min-height: 100vh !important;
        position: relative !important;
    }

    /* Fix sidebar - keep it on left */
    .app-sidebar {
        position: fixed !important;
        left: 0 !important;
        top: 0 !important;
        width: var(--sidebar-width, 260px) !important;
        height: 100vh !important;
        z-index: 100 !important;
        background: var(--bg-deep) !important;
    }

    /* Fix main content - MUST have margin-left to avoid sidebar */
    .app-main {
        margin-left: var(--sidebar-width, 260px) !important;
        margin-top: var(--header-height, 64px) !important;
        padding: 0 !important;
        min-height: calc(100vh - var(--header-height, 64px) - 44px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: relative !important;
        overflow-x: auto !important;
        background: var(--bg-void) !important;
    }

    /* Fix header - align with main content */
    .app-header {
        left: var(--sidebar-width, 260px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: fixed !important;
        top: 0 !important;
        z-index: 90 !important;
    }

    /* Fix footer */
    .app-footer {
        left: var(--sidebar-width, 260px) !important;
        width: calc(100% - var(--sidebar-width, 260px)) !important;
        position: fixed !important;
        bottom: 0 !important;
        z-index: 89 !important;
    }

    /* Header section - Top aligned */
    .app-content-header {
        margin: 0 !important;
        padding: 16px 24px 12px 24px !important;
        background: var(--bg-deep);
        border-bottom: 1px solid var(--border);
        width: 100% !important;
    }

    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .row {
        margin: 0 !important;
        padding: 0 !important;
        display: flex !important;
        justify-content: space-between !important;
        align-items: center !important;
    }

    [class*="col-"] {
        padding: 0 !important;
        margin: 0 !important;
    }

    .app-content-header h3 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.3rem;
        background: linear-gradient(135deg, #fff, var(--accent-cyan));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0 !important;
        padding: 0 !important;
    }

    .breadcrumb {
        background: transparent;
        padding: 0;
        margin: 0;
        justify-content: flex-end;
    }

    .breadcrumb-item {
        color: var(--text-muted);
        font-size: 0.75rem;
    }

        .breadcrumb-item a {
            color: var(--text-muted);
            text-decoration: none;
        }

            .breadcrumb-item a:hover {
                color: var(--accent-cyan);
            }

        .breadcrumb-item.active {
            color: var(--text-secondary);
        }

    /* Stats Cards */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
    }

        .stat-card:hover {
            border-color: var(--accent-cyan);
            transform: translateY(-2px);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(0, 221, 180, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

        .stat-icon i {
            font-size: 24px;
            color: var(--accent-cyan);
        }

    .stat-value {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .stat-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Filter Bar */
    .filter-bar {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .search-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 40px;
        padding: 6px 16px;
    }

        .search-box input {
            background: transparent;
            border: none;
            color: var(--text-primary);
            padding: 8px 0;
            width: 250px;
            outline: none;
        }

            .search-box input::placeholder {
                color: var(--text-muted);
            }

        .search-box i {
            color: var(--text-muted);
        }

    .filter-group {
        display: flex;
        gap: 10px;
    }

    .filter-select {
        background: var(--bg-surface);
        border: 1px solid var(--border);
        border-radius: 40px;
        padding: 8px 16px;
        color: var(--text-primary);
        font-size: 0.8rem;
        cursor: pointer;
        outline: none;
    }

    /* Content area */
    .app-content {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
    }

    /* Card styles */
    .card {
        background: var(--bg-card) !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        margin: 0 !important;
        width: 100% !important;
    }

    .card-header {
        background: var(--bg-deep) !important;
        border-bottom: 1px solid var(--border) !important;
        color: var(--text-primary) !important;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 0.9rem;
        padding: 14px 24px !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

        .card-header span i {
            color: var(--accent-cyan);
            margin-right: 8px;
        }

    .card-body {
        background: var(--bg-deep);
        padding: 20px 24px !important;
        overflow-x: auto !important;
    }

    /* TABLE - Horizontal scroll fix */
    .table-responsive {
        width: 100%;
        overflow-x: auto !important;
        overflow-y: visible !important;
        margin: 0 !important;
        padding: 0 !important;
        display: block !important;
    }

    .table {
        width: 100% !important;
        min-width: 1300px !important;
        margin: 0 !important;
        border-collapse: collapse;
        table-layout: auto !important;
    }

        /* Table Header */
        .table thead th {
            background: rgba(13, 24, 37, 0.95);
            color: var(--accent-cyan);
            font-family: var(--font-display);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 12px 12px;
            border: none;
            border-bottom: 1px solid var(--border);
            text-align: left;
            white-space: nowrap;
        }

        /* Table Rows */
        .table tbody tr {
            background: rgba(6, 12, 20, 0.5);
            border-bottom: 1px solid rgba(0, 221, 180, 0.05);
        }

        .table tbody td {
            padding: 12px 12px;
            vertical-align: middle;
            border: none;
            color: var(--text-secondary);
            font-size: 0.8rem;
            text-align: left;
            white-space: nowrap;
        }

    .table-hover tbody tr:hover {
        background: var(--bg-hover);
    }

        .table-hover tbody tr:hover td {
            color: var(--text-primary);
        }

    /* Vendor Badge */
    .vendor-badge {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .vendor-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: var(--bg-void);
    }

    .vendor-info {
        display: flex;
        flex-direction: column;
    }

    .vendor-name {
        font-weight: 600;
        color: var(--text-primary);
    }

    .vendor-email {
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    /* Product Image */
    .product-img {
        width: 45px;
        height: 45px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg-void);
    }

    /* Status Badges */
    .badge-status {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 0.7rem;
        font-weight: 600;
        text-align: center;
        min-width: 85px;
    }

    .badge-active {
        background: rgba(0, 221, 180, 0.15);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

    .badge-inactive {
        background: rgba(108, 117, 125, 0.15);
        color: #adb5bd;
        border: 1px solid rgba(108, 117, 125, 0.3);
    }

    .badge-pending {
        background: rgba(255, 193, 7, 0.15);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

    /* Rating Stars */
    .rating {
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .rating i {
            font-size: 12px;
        }

            .rating i.bi-star-fill {
                color: #ffc107;
            }

            .rating i.bi-star-half {
                color: #ffc107;
            }

            .rating i.bi-star {
                color: var(--text-muted);
            }

    .rating-value {
        margin-left: 5px;
        font-size: 0.7rem;
        color: var(--text-muted);
    }

    /* Buttons */
    .btn {
        border-radius: 20px !important;
        font-family: var(--font-body);
        font-size: 0.7rem;
        font-weight: 600;
        padding: 5px 12px !important;
        transition: all 0.2s ease;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-decoration: none;
    }

        .btn i {
            font-size: 0.75rem;
        }

    .btn-primary {
        background: rgba(0, 221, 180, 0.12);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

        .btn-primary:hover {
            background: var(--accent-grad);
            color: var(--bg-void);
        }

    .btn-warning {
        background: rgba(255, 193, 7, 0.12);
        color: #ffc107;
        border: 1px solid rgba(255, 193, 7, 0.3);
    }

        .btn-warning:hover {
            background: #ffc107;
            color: #0a1220;
        }

    .btn-danger {
        background: rgba(220, 53, 69, 0.12);
        color: #ff6b7c;
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

        .btn-danger:hover {
            background: #dc3545;
            color: #fff;
        }

    .btn-success {
        background: rgba(0, 221, 180, 0.12);
        color: var(--accent-cyan);
        border: 1px solid rgba(0, 221, 180, 0.3);
    }

        .btn-success:hover {
            background: var(--accent-grad);
            color: var(--bg-void);
        }

    /* Alert Messages */
    .alert {
        border-radius: 12px;
        border: none;
        background: rgba(13, 24, 37, 0.95);
        padding: 10px 16px;
        margin-bottom: 16px;
        border-left: 3px solid;
        font-size: 0.8rem;
    }

    .alert-success {
        border-left-color: var(--accent-cyan);
        background: rgba(0, 221, 180, 0.1);
        color: var(--accent-cyan);
    }

    /* Scrollbar styling */
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: var(--bg-surface);
        border-radius: 3px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--accent-cyan);
        border-radius: 3px;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .app-main {
            margin-left: 0 !important;
            width: 100% !important;
        }

        .app-header {
            left: 0 !important;
            width: 100% !important;
        }

        .app-footer {
            left: 0 !important;
            width: 100% !important;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box input {
            width: 100%;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .breadcrumb {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .stats-grid {
            grid-template-columns: 1fr;
        }

        .app-content-header {
            padding: 12px 16px !important;
        }

        .card-body {
            padding: 12px 16px !important;
        }

        .card-header {
            padding: 12px 16px !important;
        }

        .table thead th {
            padding: 8px 10px;
            font-size: 0.65rem;
        }

        .table tbody td {
            padding: 8px 10px;
            font-size: 0.7rem;
        }

        .btn {
            padding: 3px 8px !important;
            font-size: 0.6rem;
        }

        .vendor-avatar {
            width: 28px;
            height: 28px;
            font-size: 10px;
        }

        .product-img {
            width: 32px;
            height: 32px;
        }
    }
</style>

