@model IEnumerable<TourwebsiteFYP.DB_data_models.Vendor>
@{
    ViewBag.Title = "Marketplace Vendors";
    ViewBag.ActiveMenu = "Marketplace";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-toast alert-toast-success">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["SuccessMessage"]
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="bi bi-x"></i></button>
    </div>
}

@* Page Header *@
<div class="page-header">
    <div>
        <div class="page-title">Marketplace Vendors</div>
        <div class="page-subtitle">Manage vendors and browse their product listings</div>
    </div>
    <a href="@Url.Action("Create", "ManageMarketplaceListing", new { area = "AdminArea" })" class="btn-admin btn-admin-primary">
        <i class="bi bi-plus-circle"></i> Add Vendor
    </a>
</div>

@* Stats Row *@
@if (Model != null)
{
    <div class="stat-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom:24px;">
        <div class="stat-card">
            <div class="stat-icon stat-icon-blue"><i class="bi bi-shop"></i></div>
            <div>
                <div class="stat-value">@Model.Count()</div>
                <div class="stat-label">Total Vendors</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-green"><i class="bi bi-bag-check"></i></div>
            <div>
                <div class="stat-value">@Model.Sum(v => v.Products.Count)</div>
                <div class="stat-label">Total Products</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-orange"><i class="bi bi-star-fill"></i></div>
            <div>
                <div class="stat-value">@(Model.Any() ? Model.Average(v => v.Rating).ToString("0.0") : "-")</div>
                <div class="stat-label">Avg. Vendor Rating</div>
            </div>
        </div>
    </div>
}

@* Vendors Table *@
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-shop"></i> Vendor Listings</div>
        <span style="font-size:12px;color:var(--text-muted)">@(Model != null ? Model.Count() : 0) vendors</span>
    </div>
    <div class="admin-card-body-flush">
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:36px"></th>
                        <th>Vendor</th>
                        <th>Location</th>
                        <th>Rating</th>
                        <th>Products</th>
                        <th>Listed Since</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var vendor in Model)
                        {
                            var initials = !string.IsNullOrEmpty(vendor.VendorName) && vendor.VendorName.Length >= 2
                                           ? vendor.VendorName.Substring(0, 2).ToUpper()
                                           : "VD";
                            var rowId = "vendor-products-" + vendor.VendorId;
                            var productCount = vendor.Products.Count;

                            <tr style="cursor:default;">
                                <td style="padding:12px 8px 12px 16px;">
                                    @if (productCount > 0)
                                    {
                                        <button class="btn-icon" style="color:var(--text-muted);border:none;background:none;"
                                                onclick="toggleProducts('@rowId', this)" title="Show products">
                                            <i class="bi bi-chevron-right" style="font-size:12px;transition:transform 0.2s;"></i>
                                        </button>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:12px;">
                                        <div style="width:40px;height:40px;border-radius:50%;background:var(--accent-soft);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:var(--text-dark);flex-shrink:0;">
                                            @if (!string.IsNullOrEmpty(vendor.LogoIcon))
                                            {
                                                @vendor.LogoIcon
                                            }
                                            else
                                            {
                                                @initials
                                            }
                                        </div>
                                        <div>
                                            <div style="font-weight:600;font-size:13.5px;">@vendor.VendorName</div>
                                            @if (!string.IsNullOrEmpty(vendor.Description))
                                            {
                                                <div style="font-size:11px;color:var(--text-muted);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@vendor.Description</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td style="color:var(--text-muted);">
                                    @if (!string.IsNullOrEmpty(vendor.Location))
                                    {
                                        <span><i class="bi bi-geo-alt" style="font-size:11px;margin-right:3px;"></i>@vendor.Location</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex;align-items:center;gap:4px;">
                                        <i class="bi bi-star-fill" style="color:#f59e0b;font-size:12px;"></i>
                                        <span style="font-weight:600;font-size:13px;">@vendor.Rating.ToString("0.0")</span>
                                    </div>
                                </td>
                                <td>
                                    @if (productCount > 0)
                                    {
                                        <span class="badge-pill badge-info">@productCount product@(productCount != 1 ? "s" : "")</span>
                                    }
                                    else
                                    {
                                        <span class="badge-pill badge-neutral">No products</span>
                                    }
                                </td>
                                <td style="color:var(--text-muted);">@vendor.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit", "ManageMarketplaceListing", new { area = "AdminArea", id = vendor.VendorId })"
                                           class="btn-icon btn-icon-edit" title="Edit vendor">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form action="@Url.Action("Delete", "ManageMarketplaceListing", new { area = "AdminArea", id = vendor.VendorId })"
                                              method="post" style="display:inline;"
                                              onsubmit="return confirm('Remove vendor &quot;@vendor.VendorName&quot;? Their products will be unlinked.');">
                                            <button type="submit" class="btn-icon btn-icon-delete" style="border:none;background:rgba(239,68,68,0.06);cursor:pointer;" title="Delete vendor">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>

                            @* Expandable products sub-row *@
                            if (productCount > 0)
                            {
                                <tr id="@rowId" style="display:none;">
                                    <td colspan="7" style="padding:0;background:#f8fafc;border-bottom:2px solid var(--border);">
                                        <div style="padding:12px 20px 16px 64px;">
                                            <div style="font-size:11px;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:var(--text-faint);margin-bottom:10px;">
                                                Products by @vendor.VendorName
                                            </div>
                                            <table style="width:100%;border-collapse:collapse;">
                                                <thead>
                                                    <tr>
                                                        <th style="font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:6px 12px;text-align:left;background:#eef2f7;border-radius:6px 0 0 6px;">Product</th>
                                                        <th style="font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:6px 12px;text-align:left;background:#eef2f7;">Category</th>
                                                        <th style="font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:6px 12px;text-align:left;background:#eef2f7;">Price</th>
                                                        <th style="font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--text-muted);padding:6px 12px;text-align:left;background:#eef2f7;border-radius:0 6px 6px 0;">Stock</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var product in vendor.Products)
                                                    {
                                                        <tr>
                                                            <td style="padding:8px 12px;font-size:13px;font-weight:500;border-bottom:1px solid var(--border);">
                                                                <i class="bi bi-bag" style="color:var(--text-faint);margin-right:6px;font-size:12px;"></i>
                                                                @product.ProductName
                                                            </td>
                                                            <td style="padding:8px 12px;font-size:12px;color:var(--text-muted);border-bottom:1px solid var(--border);">
                                                                @(product.ProductType != null ? product.ProductType.TypeName : "-")
                                                            </td>
                                                            <td style="padding:8px 12px;font-size:13px;font-weight:700;border-bottom:1px solid var(--border);">
                                                                @product.Price.ToString("C")
                                                            </td>
                                                            <td style="padding:8px 12px;border-bottom:1px solid var(--border);">
                                                                @if (product.StockStatus == "In Stock")
                                                                {
                                                                    <span class="badge-pill badge-success">@product.StockStatus</span>
                                                                }
                                                                else if (product.StockStatus == "Low Stock")
                                                                {
                                                                    <span class="badge-pill badge-warning">@product.StockStatus</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="badge-pill badge-danger">@(string.IsNullOrEmpty(product.StockStatus) ? "Unknown" : product.StockStatus)</span>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" style="text-align:center;padding:40px;color:var(--text-muted);">
                                <i class="bi bi-shop" style="font-size:32px;display:block;margin-bottom:8px;color:var(--text-faint);"></i>
                                No vendors found. <a href="@Url.Action("Create", "ManageMarketplaceListing", new { area = "AdminArea" })">Add the first vendor</a>.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function toggleProducts(rowId, btn) {
        var row = document.getElementById(rowId);
        var icon = btn.querySelector('i');
        if (row.style.display === 'none' || row.style.display === '') {
            row.style.display = 'table-row';
            icon.style.transform = 'rotate(90deg)';
            btn.title = 'Hide products';
        } else {
            row.style.display = 'none';
            icon.style.transform = 'rotate(0deg)';
            btn.title = 'Show products';
        }
    }
</script>
