@model TourwebsiteFYP.DB_data_models.Vendor
@{
    ViewBag.Title = "Add Vendor";
    ViewBag.ActiveMenu = "Marketplace";
}
<div class="page-header">
    <div>
        <div class="page-title">Add Vendor</div>
        <div class="page-subtitle">Register a new marketplace vendor</div>
    </div>
    <a href="@Url.Action("Index", "ManageMarketplaceListing", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert-toast alert-toast-error" style="margin-bottom:16px;">
        <i class="bi bi-exclamation-triangle-fill"></i>
        Please fix the errors below before saving.
    </div>
}

<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-shop"></i> Vendor Details</div>
    </div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create", "ManageMarketplaceListing", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Vendor Name <span>*</span></label>
                    <input type="text" name="VendorName" class="form-control" placeholder="e.g. Alpine Outdoors" required
                           value="@(Model != null ? Model.VendorName : "")" />
                    @Html.ValidationMessage("VendorName", new { @class = "field-validation-error" })
                </div>

                <div class="form-group">
                    <label class="form-label">Location</label>
                    <input type="text" name="Location" class="form-control" placeholder="e.g. Interlaken, Switzerland"
                           value="@(Model != null ? Model.Location : "")" />
                </div>

                <div class="form-group">
                    <label class="form-label">Logo / Icon (emoji or text)</label>
                    <input type="text" name="LogoIcon" class="form-control" placeholder="e.g. 🏪 or ⛰️"
                           value="@(Model != null ? Model.LogoIcon : "")" />
                    <span class="form-hint">You can paste an emoji here to use as the vendor icon.</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Rating (0 – 5)</label>
                    <input type="number" name="Rating" class="form-control" step="0.1" min="0" max="5" placeholder="e.g. 4.8"
                           value="@(Model != null ? Model.Rating.ToString("0.0") : "0.0")" />
                </div>

                <div class="form-group form-grid-1">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="4"
                              placeholder="Brief description of what this vendor offers…">@(Model != null ? Model.Description : "")</textarea>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Vendor</button>
                <a href="@Url.Action("Index", "ManageMarketplaceListing", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
