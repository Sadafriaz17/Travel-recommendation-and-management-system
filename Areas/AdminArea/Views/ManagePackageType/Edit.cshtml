@model TourwebsiteFYP.DB_data_models.PackageType
@{
    ViewBag.Title = "Edit Package Type";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "PackageTypes";
}
<div class="page-header">
    <div><div class="page-title">Edit Package Type</div><div class="page-subtitle">Update type #@Model.PackageTypeId</div></div>
    <a href="@Url.Action("Index","ManagePackageType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Package Type Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManagePackageType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <input type="hidden" name="PackageTypeId" value="@Model.PackageTypeId" />
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Type Name <span>*</span></label>
                    <input type="text" name="TypeName" value="@Model.TypeName" class="form-control" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Type</button>
                <a href="@Url.Action("Index","ManagePackageType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
