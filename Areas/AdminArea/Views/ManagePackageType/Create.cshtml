@{
    ViewBag.Title = "Add Package Type";
    ViewBag.ActiveMenu = "Packages";
    ViewBag.ActivePage = "PackageTypes";
}
<div class="page-header">
    <div><div class="page-title">Add Package Type</div><div class="page-subtitle">Create a new category for packages</div></div>
    <a href="@Url.Action("Index","ManagePackageType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-tags"></i> Package Type Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManagePackageType", new { area = "AdminArea" }, FormMethod.Post))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Type Name <span>*</span></label>
                    <input type="text" name="TypeName" class="form-control" placeholder="e.g. Honeymoon, Adventure" required />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Type</button>
                <a href="@Url.Action("Index","ManagePackageType", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
