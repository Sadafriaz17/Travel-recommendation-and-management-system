@model IEnumerable<TourwebsiteFYP.DB_data_models.Payment>
@{
    ViewBag.Title = "Manage Payments";
    ViewBag.ActiveMenu = "Payments";
    ViewBag.ActivePage = "PaymentList";
}
<div class="page-header">
    <div><div class="page-title">Payments</div><div class="page-subtitle">Track and manage customer payments</div></div>
    <a href="@Url.Action("Create","ManagePayments", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Payment</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-credit-card"></i> All Payments</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#ID</th><th>Customer</th><th>Booking #</th><th>Amount</th><th>Method</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string statusClass = "badge-neutral";
                            if(item.Status == "Completed" || item.Status == "Paid") { statusClass = "badge-success"; }
                            else if(item.Status == "Pending") { statusClass = "badge-warning"; }
                            else if(item.Status == "Failed" || item.Status == "Refunded") { statusClass = "badge-danger"; }
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.PaymentId</td>
                                <td style="font-weight:600">@(item.Booking?.User?.FullName ?? "-")</td>
                                <td>#@item.BookingId</td>
                                <td style="font-weight:700">$@item.Amount.ToString("N2")</td>
                                <td>@(item.PaymentType?.PaymentTypeName ?? item.PaymentMethod ?? "-")</td>
                                <td><span class="badge-pill @statusClass">@(item.Status ?? "Completed")</span></td>
                                <td style="color:var(--text-muted)">@(item.PaymentDate?.ToString("MMM d, yyyy") ?? "-")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManagePayments", new { area="AdminArea", id=item.PaymentId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManagePayments", new { area="AdminArea", id=item.PaymentId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this payment record?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-credit-card"></i></div>
                <h4>No Payments Found</h4>
                <p>Payment records will appear here.</p>
                <a href="@Url.Action("Create","ManagePayments", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Payment</a>
            </div>
        }
    </div>
</div>

