@model TourwebsiteFYP.DB_data_models.Payment
@{
    ViewBag.Title = "Edit Payment";
    ViewBag.ActiveMenu = "Payments";
    ViewBag.ActivePage = "PaymentList";
}
<div class="page-header">
    <div><div class="page-title">Edit Payment</div><div class="page-subtitle">Update payment #@Model.PaymentId</div></div>
    <a href="@Url.Action("Index","ManagePayments", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-pencil-square"></i> Payment Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Edit","ManagePayments", new { area = "AdminArea" }, FormMethod.Post))
        {
            <input type="hidden" name="PaymentId" value="@Model.PaymentId" />
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Booking <span>*</span></label>
                    <select name="BookingId" class="form-control" required>
                        <option value="">— Select Booking —</option>
                        @foreach (var b in ViewBag.BookingList) {
                            string sel = (b.BookingId == Model.BookingId) ? "selected" : "";
                            <option value="@b.BookingId" @sel>Booking #@b.BookingId</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Payment Type <span>*</span></label>
                    <select name="PaymentTypeId" class="form-control" required>
                        <option value="">— Select Method —</option>
                        @foreach (var t in ViewBag.PaymentTypeList) {
                            string sel = (t.PaymentTypeId == Model.PaymentTypeId) ? "selected" : "";
                            <option value="@t.PaymentTypeId" @sel>@t.TypeName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Method Name (Optional)</label>
                    <input type="text" name="PaymentMethod" value="@Model.PaymentMethod" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Amount ($) <span>*</span></label>
                    <input type="number" name="Amount" value="@Model.Amount" class="form-control" step="0.01" min="0" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select name="Status" class="form-control">
                        @foreach (var s in new[]{"Completed","Pending","Failed","Refunded"}) {
                            string sel = (s == Model.Status) ? "selected" : "";
                            <option value="@s" @sel>@s</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Update Payment</button>
                <a href="@Url.Action("Index","ManagePayments", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
