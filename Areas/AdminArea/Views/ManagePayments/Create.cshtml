@model TourwebsiteFYP.DB_data_models.Payment
@{
    ViewBag.Title = "Add Payment";
}

<div class="col-md-12">
    <div class="card shadow-sm rounded-4 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">Add Payment</h5>
        </div>

        <form method="post" action="@Url.Action("Create", "ManagePayments", new { area = "AdminArea" })">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Booking ID</label>
                        <input type="number" name="BookingId" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Amount</label>
                        <input type="number" step="0.01" name="Amount" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Payment Method</label>
                        <input type="text" name="PaymentMethod" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-control">
                            <option value="Pending">Pending</option>
                            <option value="Completed">Completed</option>
                            <option value="Failed">Failed</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Save
                </button>
                <a href="@Url.Action("Index", "ManagePayments", new { area = "AdminArea" })" class="btn btn-danger">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>

