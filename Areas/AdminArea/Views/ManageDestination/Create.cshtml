@{
    ViewBag.Title = "Add Destination";
    ViewBag.ActiveMenu = "Destinations";
}
<div class="page-header">
    <div><div class="page-title">Add Destination</div><div class="page-subtitle">Register a new travel destination</div></div>
    <a href="@Url.Action("Index","ManageDestination", new { area = "AdminArea" })" class="btn-admin btn-admin-outline"><i class="bi bi-arrow-left"></i> Back</a>
</div>
<div class="admin-card">
    <div class="admin-card-header"><div class="admin-card-title"><i class="bi bi-geo-alt"></i> Destination Details</div></div>
    <div class="admin-card-body">
        @using (Html.BeginForm("Create","ManageDestination", new { area = "AdminArea" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="form-grid">
                <div class="form-group form-grid-1">
                    <label class="form-label">Name <span>*</span></label>
                    <input type="text" name="Name" class="form-control" placeholder="Destination Name" required />
                </div>
                <div class="form-group form-grid-1">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control" rows="4" placeholder="Brief description..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Upload Image</label>
                    <input type="file" name="img" class="form-control" accept="image/*" />
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-admin btn-admin-primary"><i class="bi bi-floppy"></i> Save Destination</button>
                <a href="@Url.Action("Index","ManageDestination", new { area = "AdminArea" })" class="btn-admin btn-admin-outline">Cancel</a>
            </div>
        }
    </div>
</div>
