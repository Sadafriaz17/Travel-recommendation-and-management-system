@model TourwebsiteFYP.DB_data_models.Destination
@{
    ViewBag.Title = "Edit Destination";
}

<div class="card mt-4">
    <div class="card-header">
        <span>Edit Destination</span>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" action="/AdminArea/ManageDestination/Edit">
            <input type="hidden" name="DestinationId" value="@Model.DestinationId" />

            <div class="mb-3">
                <label class="form-label">Destination Name</label>
                <input type="text" name="Name" value="@Model.Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input type="text" name="Location" value="@Model.Location" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <input type="text" name="Description" value="@Model.Description" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input type="text" name="Price" value="@Model.Price" class="form-control" required />
            </div>
            <div class="form-group col-md-6">
                <label class="form-label">Package Type Name</label>
                <select name="PackageTypeId" class="form-control">
                    @foreach (var item in ViewBag.PackageTypeList)
                    {
                        string selectedVal = "";
                        if (item.PackageTypeId == Model.PackageTypeId)
                        {
                            selectedVal = "selected";
                        }
                        <option @selectedVal value="@item.PackageTypeId">@item.TypeName</option>
                    }
                </select>
            </div>

            <!-- Image Uploads -->


            <div class="form-group">
                <label class="form-label">Upload Image </label>
                <input type="file" name="img" class="form-control" />
            </div>


            <button type="submit" class="btn btn-success">Update</button>
            <a href="/AdminArea/ManageDestination/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>


