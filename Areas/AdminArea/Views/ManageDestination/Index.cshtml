@model IEnumerable<TourwebsiteFYP.DB_data_models.Destination>
@{
    ViewBag.Title = "Manage Destinations";
    ViewBag.ActiveMenu = "Destinations";
}
<div class="page-header">
    <div><div class="page-title">Destinations</div><div class="page-subtitle">Manage travel destinations</div></div>
    <a href="@Url.Action("Create","ManageDestination", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Destination</a>
</div>
@if (TempData["SuccessMessage"] != null)
{ <div class="alert-toast alert-toast-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
@if (TempData["ErrorMessage"] != null)
{ <div class="alert-toast alert-toast-error"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"] <button class="alert-close"><i class="bi bi-x"></i></button></div> }
<div class="admin-card">
    <div class="admin-card-header">
        <div class="admin-card-title"><i class="bi bi-geo-alt"></i> All Destinations</div>
        <span style="font-size:12px;color:var(--text-muted)">@Model.Count() records</span>
    </div>
    <div class="admin-card-body-flush">
        @if (Model.Any())
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead><tr><th>#</th><th>Image</th><th>Name</th><th>Created Date</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string imgSrc = !string.IsNullOrEmpty(item.Image) ? item.Image : "/images/default-dest.jpg";
                            <tr>
                                <td style="font-size:12px;color:var(--text-muted);font-weight:600">#@item.DestinationId</td>
                                <td><img src="@imgSrc" class="tbl-img" onerror="this.src='/images/default-dest.jpg'" /></td>
                                <td style="font-weight:700">@item.Name</td>
                                <td style="color:var(--text-muted)">@(item.CreatedDate?.ToString("MMM d, yyyy") ?? "-")</td>
                                <td>
                                    <div class="action-group">
                                        <a href="@Url.Action("Edit","ManageDestination", new { area="AdminArea", id=item.DestinationId })" class="btn-icon btn-icon-edit"><i class="bi bi-pencil"></i></a>
                                        <a href="@Url.Action("Delete","ManageDestination", new { area="AdminArea", id=item.DestinationId })" class="btn-icon btn-icon-delete" onclick="return confirm('Delete this destination?')"><i class="bi bi-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon"><i class="bi bi-geo-alt"></i></div>
                <h4>No Destinations Found</h4>
                <p>Start adding travel destinations to your platform.</p>
                <a href="@Url.Action("Create","ManageDestination", new { area = "AdminArea" })" class="btn-admin btn-admin-primary"><i class="bi bi-plus-circle"></i> Add Destination</a>
            </div>
        }
    </div>
</div>
