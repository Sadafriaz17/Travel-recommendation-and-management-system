function generateAITips(data) {
    var tips = [];
    var pref = (data.packingPreference || 'balanced').toLowerCase();

    if (pref === 'minimal') {
        tips.push({ icon:'⚡', text:'Pack only multi-use items — a navy blazer works for dinners, day tours, and cool evenings.' });
        tips.push({ icon:'🔄', text:'Plan to do laundry every 4–5 days to stay minimal while staying fresh.' });
    } else if (pref === 'full') {
        tips.push({ icon:'🎯', text:'With a full pack, use packing cubes to compress and organize by category.' });
    } else {
        tips.push({ icon:'⚖️', text:'Balanced packing: choose 3 base colors that mix-and-match across all outfits.' });
    }

    var dest = (data.destination || '').toLowerCase();
    if (dest.includes('asia') || dest.includes('south-asia')) {
        tips.push({ icon:'🕌', text:'Many temples require covered shoulders and knees — keep a lightweight scarf handy at all times.' });
    }
    if (dest.includes('europe')) {
        tips.push({ icon:'🚶', text:'European cities involve a lot of walking on cobblestones — prioritize comfort over style for footwear.' });
    }

    var transport = (data.transport || '').toLowerCase();
    if (transport.includes('airplane')) {
        tips.push({ icon:'✈️', text:'Roll clothes instead of folding — saves 30% bag space and reduces creases for airplane travel.' });
        tips.push({ icon:'🛡️', text:'Pack a neck pillow, eye mask, and noise-cancelling earphones in your carry-on for the flight.' });
    }

    var days = parseInt(data.duration) || 7;
    if (days > 10) {
        tips.push({ icon:'💧', text:'For trips over 10 days, bring travel-size laundry detergent for sink washing mid-trip.' });
    }

    tips.push({ icon:'📦', text:'Pack heavier items (shoes, tech) at the bottom near the wheels of your bag to balance load.' });
    tips.push({ icon:'🔐', text:'Always keep travel documents, valuables, and a 24-hour clothing set in your carry-on bag.' });

    return tips.slice(0, 6);
}

// ── Priority assignment ──
function assignPriority(item, section) {
    var mustItems = ['Passport','Visa','Insurance','Medications','Phone','Charger','Underwear','Toothbrush','Deodorant','Sunscreen'];
    var isMust = mustItems.some(function(k) { return item.indexOf(k) !== -1 });
    if (isMust) return 'must';
    if (section === 'documents' || section === 'health') return 'must';
    var optionalItems = ['E-Reader','HDMI','Insoles','Trail Map','Rope','Bear Canister'];
    var isOpt = optionalItems.some(function(k) { return item.indexOf(k) !== -1 });
    return isOpt ? 'opt' : 'rec';
}

// ── Main generate function ──
function generatePackingList(data) {
    var pref = (data.packingPreference || 'balanced').toLowerCase();
    if (pref !== 'minimal' && pref !== 'full') pref = 'balanced';

    var activities = data.activities || [];
    if (typeof activities === 'string') activities = [activities];

    var sections = [];

    // Core sections
    var coreOrder = ['clothing','footwear','toiletries','documents','electronics','health'];
    coreOrder.forEach(function(key) {
        var db = packingDB[key];
        var sectionItems = [];
        Object.keys(db.subsections).forEach(function(subName) {
            var sub = db.subsections[subName];
            var items = sub[pref] || sub['balanced'];
            sectionItems.push({ title: subName, items: items, sectionKey: key });
        });
        sections.push({ key: key, icon: db.icon, title: db.title, subsections: sectionItems });
    });

    // Activity sections
    activities.forEach(function(activity) {
        var trimmed = activity.trim();
        if (activityGear[trimmed]) {
            var ag = activityGear[trimmed];
            var items = ag.items[pref] || ag.items['balanced'];
            sections.push({
                key: 'activity_' + trimmed,
                icon: ag.icon,
                title: ag.title,
                subsections: [{ title: trimmed + ' Items', items: items, sectionKey: 'activity' }]
            });
        }
    });

    return sections;
}

// ── Render UI ──
var totalItems = 0;
var checkedItems = 0;

function renderSections(sections) {
    var container = document.getElementById('packing-sections');
    container.innerHTML = '';
    totalItems = 0;

    sections.forEach(function(section, idx) {
        var sectionTotal = 0;
        section.subsections.forEach(function(sub) { sectionTotal += sub.items.length; });
        totalItems += sectionTotal;

        var el = document.createElement('div');
        el.className = 'pack-section' + (idx === 0 ? ' open' : '');
        el.dataset.reveal = '';

        var subsHTML = '';
        section.subsections.forEach(function(sub) {
            subsHTML += '<div class="pack-subsection">';
            subsHTML += '<div class="pack-subsection-title">' + sub.title + '</div>';
            subsHTML += '<div class="pack-items-grid">';
            sub.items.forEach(function(item) {
                var priority = assignPriority(item, sub.sectionKey);
                var priorityLabel = priority === 'must' ? 'MUST' : priority === 'rec' ? 'REC' : 'OPT';
                var priorityClass = 'priority-' + priority;
                var safeItem = item.replace(/'/g, '&#39;');
                subsHTML += '<div class="pack-item" onclick="toggleItem(this)">';
                subsHTML += '<div class="pack-item-check"></div>';
                subsHTML += '<span>' + item + '</span>';
                subsHTML += '<span class="pack-item-priority ' + priorityClass + '">' + priorityLabel + '</span>';
                subsHTML += '</div>';
            });
            subsHTML += '</div></div>';
        });

        el.innerHTML =
            '<div class="pack-section-header" onclick="toggleSection(this)">' +
                '<div class="pack-section-header-left">' +
                    '<div class="pack-section-icon">' + section.icon + '</div>' +
                    '<div>' +
                        '<div class="pack-section-title">' + section.title + '</div>' +
                        '<div class="pack-section-count">' + sectionTotal + ' items</div>' +
                    '</div>' +
                '</div>' +
                '<div class="pack-section-chevron">▼</div>' +
            '</div>' +
            '<div class="pack-section-progress"><div class="pack-section-progress-fill" style="width:0%"></div></div>' +
            '<div class="pack-section-body">' + subsHTML + '</div>';

        container.appendChild(el);
    });

    document.getElementById('stat-total').textContent = totalItems;
    updateProgress();

    // Trigger reveal
    setTimeout(function() {
        container.querySelectorAll('[data-reveal]').forEach(function(el) {
            el.classList.add('revealed');
        });
    }, 100);
}

function toggleSection(header) {
    var section = header.closest('.pack-section');
    section.classList.toggle('open');
}

function toggleItem(itemEl) {
    itemEl.classList.toggle('checked');
    if (itemEl.classList.contains('checked')) {
        itemEl.querySelector('.pack-item-check').textContent = '✓';
        checkedItems++;
    } else {
        itemEl.querySelector('.pack-item-check').textContent = '';
        checkedItems--;
    }
    updateProgress();
    updateSectionProgress(itemEl.closest('.pack-section'));
}

function updateProgress() {
    var pct = totalItems > 0 ? Math.round((checkedItems / totalItems) * 100) : 0;
    document.getElementById('progress-pct').textContent = pct + '%';
    document.getElementById('stat-checked').textContent = checkedItems;
    var circumference = 326.7;
    var offset = circumference - (pct / 100) * circumference;
    document.getElementById('progress-ring-fill').style.strokeDashoffset = offset;
}

function updateSectionProgress(sectionEl) {
    var items = sectionEl.querySelectorAll('.pack-item');
    var checked = sectionEl.querySelectorAll('.pack-item.checked').length;
    var pct = items.length > 0 ? (checked / items.length) * 100 : 0;
    sectionEl.querySelector('.pack-section-progress-fill').style.width = pct + '%';
}

function renderSummary(data) {
    var grid = document.getElementById('summary-grid');
    var fields = [
        { label: 'Destination',  value: data.destination || '—' },
        { label: 'Duration',     value: data.duration || '—' },
        { label: 'Trip Type',    value: data.tripType || '—' },
        { label: 'Activities',   value: (data.activities || []).join(', ') || '—' },
        { label: 'Traveler',     value: data.travelerType || '—' },
        { label: 'Transport',    value: data.transport || '—' },
        { label: 'Accommodation',value: data.accommodation || '—' },
        { label: 'Budget',       value: data.budget || '—' },
        { label: 'Travel Dates', value: data.travelDates || '—' },
        { label: 'Packing Pref',value: data.packingPreference || '—', accent: true }
    ];
    grid.innerHTML = fields.map(function(f) {
        return '<div class="summary-item">' +
            '<div class="summary-item-label">' + f.label + '</div>' +
            '<div class="summary-item-value' + (f.accent ? ' accent' : '') + '">' + f.value + '</div>' +
        '</div>';
    }).join('');

    document.getElementById('summary-headline').textContent =
        (data.destination || 'Your Trip') + ' · ' + (data.duration || '') + ' · ' + (data.tripType || '');
}

function renderWeather(data) {
    var dest = data.destination || 'Europe';
    var profile = weatherProfiles[dest] || weatherProfiles['Europe'];

    document.getElementById('weather-icon').textContent = profile.icon;
    document.getElementById('weather-title').textContent = dest + ' Climate Intelligence';
    document.getElementById('weather-text').textContent =
        profile.desc + ' Your ' + (data.duration || '7-day') + ' ' + (data.tripType || '') +
        ' trip calls for ' + (data.packingPreference || 'balanced') + ' packing strategy.';

    var chips = profile.chips.concat([
        data.packingPreference || 'Balanced Pack',
        data.budget || 'Mid Budget'
    ]);
    document.getElementById('weather-chips').innerHTML =
        chips.map(function(c) { return '<div class="weather-chip">' + c + '</div>'; }).join('');
}

function renderAITips(data) {
    var tips = generateAITips(data);
    document.getElementById('ai-tips-list').innerHTML =
        tips.map(function(t) {
            return '<div class="ai-tip"><span class="ai-tip-icon">' + t.icon + '</span><span>' + t.text + '</span></div>';
        }).join('');
}

// ── Loading animation ──
function runLoadingAnimation(callback) {
    var steps = ['ls1','ls2','ls3','ls4'];
    var i = 0;
    var overlay = document.getElementById('loading-overlay');
    overlay.classList.remove('hidden');

    function next() {
        if (i < steps.length) {
            if (i > 0) document.getElementById(steps[i-1]).classList.replace('active','done');
            document.getElementById(steps[i]).classList.add('active');
            i++;
            setTimeout(next, 650);
        } else {
            setTimeout(function() {
                overlay.classList.add('hidden');
                callback();
            }, 400);
        }
    }
    next();
}

// ── Main init ──
function initPackingPage() {
    var raw = sessionStorage.getItem('nexvoy_trip_data');
    var data = raw ? JSON.parse(raw) : {
        destination: 'Europe',
        duration: '7 Days',
        tripType: 'Adventure',
        activities: ['Hiking','City Tour'],
        travelerType: 'Couple',
        transport: 'Airplane',
        accommodation: 'Hotel',
        budget: 'Medium',
        travelDates: 'Summer 2025',
        packingPreference: 'Balanced'
    };

    runLoadingAnimation(function() {
        renderSummary(data);
        renderWeather(data);
        var sections = generatePackingList(data);
        renderSections(sections);
        renderAITips(data);
        checkedItems = 0;

        // Reveal animations
        setTimeout(function() {
            document.querySelectorAll('[data-reveal]').forEach(function(el) {
                el.classList.add('revealed');
            });
        }, 200);
    });
}

function regeneratePacking() {
    checkedItems = 0;
    initPackingPage();
    document.getElementById('packing-content').scrollIntoView({ behavior: 'smooth' });
}

// ── Scroll reveal ──
(function() {
    var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
            if (e.isIntersecting) { e.target.classList.add('revealed'); observer.unobserve(e.target); }
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('[data-reveal]').forEach(function(el) { observer.observe(el); });
})();

// Init on load
window.addEventListener('DOMContentLoaded', initPackingPage);</script>
}
