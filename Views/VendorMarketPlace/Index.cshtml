@{
    ViewBag.Title = "Vendor Marketplace";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.ActivePage = "Marketplace";
}

<!-- Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<style>
    /* ── ROOT VARIABLES (Matching Packages Page) ── */
    :root {
        --bg-deep: #0a0a0f;
        --bg-surface: rgba(15, 15, 20, 0.85);
        --glass: rgba(20, 20, 28, 0.7);
        --glass-hi: rgba(30, 30, 38, 0.85);
        --border: rgba(70, 70, 90, 0.3);
        --border-hi: rgba(100, 100, 130, 0.4);
        --accent: #4deeEA;
        --accent2: #a855f7;
        --purple: #c084fc;
        --text: #f0f0f4;
        --sub: #a0a0b0;
        --font-head: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'SF Mono', 'JetBrains Mono', monospace;
        --font-body: 'Inter', system-ui, sans-serif;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--bg-deep);
        color: var(--text);
        font-family: var(--font-body);
    }

    /* ── HERO SECTION ── */
    #marketplace-hero {
        position: relative;
        height: 100vh;
        min-height: 700px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: radial-gradient(ellipse at 50% 50%, #0f0f1e 0%, #06060c 50%, #020205 100%);
    }

    #marketplace-hero-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        z-index: 0;
    }

    .marketplace-hero-glow {
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at 50% 40%, rgba(77,238,234,0.08) 0%, transparent 50%), radial-gradient(ellipse at 70% 60%, rgba(168,85,247,0.06) 0%, transparent 50%), radial-gradient(ellipse at 30% 70%, rgba(77,238,234,0.04) 0%, transparent 40%);
        z-index: 1;
        pointer-events: none;
    }

    .marketplace-hero-content {
        position: relative;
        z-index: 2;
        max-width: 1200px;
        width: 100%;
        padding: 0 2rem;
        text-align: center;
    }

    .marketplace-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: rgba(77,238,234,0.08);
        border: 1px solid rgba(77,238,234,0.2);
        border-radius: 100px;
        padding: 0.5rem 1.2rem;
        margin-bottom: 2rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--accent);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        opacity: 0;
        animation: fadeUpMkt 0.8s ease 0.3s forwards;
    }

    .marketplace-hero-badge-dot {
        width: 6px;
        height: 6px;
        background: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 10px var(--accent);
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 0.5;
            transform: scale(1);
        }

        50% {
            opacity: 1;
            transform: scale(1.5);
        }
    }

    .marketplace-hero-h1 {
        font-family: var(--font-head);
        font-size: clamp(3rem, 7vw, 5.5rem);
        font-weight: 800;
        letter-spacing: -0.04em;
        line-height: 1.05;
        margin-bottom: 1.5rem;
        opacity: 0;
        animation: fadeUpMkt 0.9s ease 0.5s forwards;
    }

    .text-gradient {
        background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 50%, var(--purple) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        background-size: 200% 200%;
        animation: gradientShift 4s ease infinite;
    }

    @@keyframes gradientShift {
        0%, 100% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }
    }

    .marketplace-hero-subtitle {
        font-size: 1.1rem;
        color: var(--sub);
        max-width: 600px;
        margin: 0 auto 2rem;
        line-height: 1.6;
        opacity: 0;
        animation: fadeUpMkt 0.9s ease 0.7s forwards;
    }

    /* Hero Stats */
    .hero-stats {
        display: flex;
        justify-content: center;
        gap: 3rem;
        margin: 2rem 0;
        flex-wrap: wrap;
        opacity: 0;
        animation: fadeUpMkt 0.9s ease 0.9s forwards;
    }

    .stat-item {
        text-align: center;
        padding: 1rem 1.5rem;
        background: rgba(255,255,255,0.03);
        border-radius: 24px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(77,238,234,0.2);
        transition: all 0.3s ease;
    }

        .stat-item:hover {
            transform: translateY(-5px);
            border-color: rgba(77,238,234,0.5);
            box-shadow: 0 0 25px rgba(77,238,234,0.15);
        }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #4DEEEA, #7E6BFF);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ── INTEGRATED FILTERS ── */
    .marketplace-hero-filters {
        opacity: 0;
        animation: fadeUpMkt 0.9s ease 1.1s forwards;
        max-width: 900px;
        margin: 0 auto;
    }

    .marketplace-filter-glass {
        background: rgba(15, 15, 25, 0.6);
        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        padding: 0.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }

    .marketplace-filter-row {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .marketplace-filter-scroll {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex: 1;
        overflow-x: auto;
        scrollbar-width: none;
    }

        .marketplace-filter-scroll::-webkit-scrollbar {
            display: none;
        }

    .marketplace-filter-btn {
        padding: 0.6rem 1.3rem;
        border-radius: 100px;
        border: none;
        background: transparent;
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        font-weight: 500;
        font-family: var(--font-body);
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

        .marketplace-filter-btn:hover {
            color: rgba(255, 255, 255, 0.8);
            background: rgba(255, 255, 255, 0.05);
        }

        .marketplace-filter-btn.active {
            color: var(--bg-deep);
            background: var(--accent);
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(77, 238, 234, 0.3), 0 0 30px rgba(77, 238, 234, 0.1);
        }

    .marketplace-filter-divider {
        width: 1px;
        height: 24px;
        background: rgba(255, 255, 255, 0.1);
        margin: 0 0.5rem;
        flex-shrink: 0;
    }

    .marketplace-sort-select {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 100px;
        padding: 0.6rem 2rem 0.6rem 1.2rem;
        color: var(--text);
        font-size: 0.8rem;
        font-family: var(--font-body);
        font-weight: 500;
        outline: none;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%234deeEA' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: right 1rem center;
        transition: all 0.3s;
    }

        .marketplace-sort-select:hover {
            border-color: rgba(77, 238, 234, 0.3);
            background: rgba(255, 255, 255, 0.08);
        }

        .marketplace-sort-select option {
            background: #1a1a2e;
            color: var(--text);
        }

    /* Scroll Hint */
    .hero-scroll-hint {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        z-index: 3;
        opacity: 0;
        animation: fadeUpMkt 1s ease 1.3s forwards;
        cursor: pointer;
        transition: opacity 0.3s;
    }

        .hero-scroll-hint:hover {
            opacity: 0.8;
        }

        .hero-scroll-hint span {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--sub);
            letter-spacing: 0.2em;
            text-transform: uppercase;
        }

    .scroll-icon {
        width: 24px;
        height: 40px;
        border: 2px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        position: relative;
        display: flex;
        justify-content: center;
        padding-top: 6px;
    }

    .scroll-dot {
        width: 4px;
        height: 8px;
        background: var(--accent);
        border-radius: 2px;
        animation: scrollDot 2s ease-in-out infinite;
    }

    @@keyframes scrollDot {
        0%, 100% {
            transform: translateY(0);
            opacity: 1;
        }

        50% {
            transform: translateY(12px);
            opacity: 0.3;
        }
    }

    @@keyframes fadeUpMkt {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── MAIN CONTENT ── */
    #marketplace-main {
        max-width: 1280px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }

    .section-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--accent);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        margin-bottom: 1rem;
    }

    .section-title {
        font-family: var(--font-head);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 2rem;
    }

    /* Category Cards */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1.5rem;
        margin: 3rem 0;
    }

    .category-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(77,238,234,0.15);
        border-radius: 28px;
        padding: 1.8rem 1rem;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1);
        cursor: pointer;
    }

        .category-card:hover {
            transform: translateY(-8px);
            border-color: #4DEEEA;
            box-shadow: 0 0 30px rgba(77,238,234,0.2);
        }

    .category-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #4DEEEA;
    }

    .category-name {
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .category-count {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.5);
    }

    /* Product Grid */
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
        margin: 3rem 0;
    }

    .product-card {
        background: linear-gradient(180deg, rgba(30, 30, 45, 0.6) 0%, rgba(20, 20, 30, 0.8) 100%);
        backdrop-filter: blur(12px);
        border-radius: 28px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .product-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 28px;
            padding: 1px;
            background: linear-gradient(135deg, rgba(77,238,234,0.1), transparent 50%, rgba(168,85,247,0.1));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            z-index: 1;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.4s;
        }

        .product-card:hover {
            transform: translateY(-8px);
            border-color: rgba(77,238,234,0.15);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 30px rgba(77, 238, 234, 0.05);
        }

            .product-card:hover::before {
                opacity: 1;
            }

    .product-image {
        height: 220px;
        position: relative;
        overflow: hidden;
    }

        .product-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .product-card:hover .product-image img {
        transform: scale(1.05);
    }

    .product-image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 40%);
    }

    .product-badges {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: flex;
        gap: 0.5rem;
        z-index: 2;
    }

    .badge-category {
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(10px);
        padding: 0.3rem 0.8rem;
        border-radius: 20px;
        font-size: 0.7rem;
        border: 1px solid rgba(77,238,234,0.3);
        font-family: var(--font-mono);
    }

    .wishlist-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(0,0,0,0.5);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 50%;
        width: 36px;
        height: 36px;
        color: white;
        cursor: pointer;
        transition: all 0.3s;
        z-index: 2;
    }

        .wishlist-btn:hover {
            background: rgba(255,68,68,0.8);
            transform: scale(1.1);
        }

    .product-info {
        padding: 1.5rem;
    }

    .product-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-family: var(--font-head);
    }

    .product-desc {
        font-size: 0.82rem;
        color: var(--sub);
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .rating {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .stars {
        color: #FFD700;
        letter-spacing: 2px;
    }

    .price-stock {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .price {
        font-size: 1.6rem;
        font-weight: 800;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .stock-status {
        font-size: 0.7rem;
        padding: 0.2rem 0.6rem;
        border-radius: 20px;
        background: rgba(77,238,234,0.15);
        font-family: var(--font-mono);
    }

    .stock-instock {
        background: rgba(77,238,234,0.2);
        color: #4DEEEA;
    }

    .stock-limited {
        background: rgba(255,170,0,0.2);
        color: #FFAA00;
    }

    .product-actions {
        display: flex;
        gap: 0.8rem;
    }

    .btn-view {
        flex: 1;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 100px;
        padding: 0.6rem;
        color: white;
        transition: all 0.3s;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .btn-view:hover {
            background: rgba(255,255,255,0.1);
            border-color: rgba(77,238,234,0.3);
        }

    .btn-cart {
        flex: 1;
        background: linear-gradient(135deg, var(--accent), var(--accent2));
        border: none;
        border-radius: 100px;
        padding: 0.6rem;
        color: #000;
        font-weight: 600;
        transition: all 0.3s;
        cursor: pointer;
        font-size: 0.8rem;
    }

        .btn-cart:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 15px rgba(77,238,234,0.3);
        }

    /* Vendor Cards */
    .vendor-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
        margin: 3rem 0;
    }

    .vendor-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(77,238,234,0.15);
        border-radius: 28px;
        padding: 1.5rem;
        transition: all 0.4s;
    }

        .vendor-card:hover {
            transform: translateY(-5px);
            border-color: #4DEEEA;
            box-shadow: 0 0 25px rgba(77,238,234,0.15);
        }

    .vendor-header {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
    }

    .vendor-logo {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(77,238,234,0.2), rgba(126,107,255,0.2));
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    /* Carousel */
    .carousel-wrapper {
        position: relative;
        margin: 3rem 0;
    }

    .carousel-container {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding: 1rem 0.5rem;
        scrollbar-width: thin;
    }

        .carousel-container::-webkit-scrollbar {
            height: 4px;
        }

    .carousel-item {
        min-width: 280px;
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border-radius: 24px;
        padding: 1rem;
        border: 1px solid rgba(77,238,234,0.15);
        transition: all 0.3s;
    }

        .carousel-item:hover {
            border-color: #4DEEEA;
            transform: translateY(-5px);
        }

    .carousel-item-img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 16px;
        margin-bottom: 1rem;
    }

    .carousel-btn {
        background: rgba(77,238,234,0.15);
        border: 1px solid rgba(77,238,234,0.3);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        color: white;
        cursor: pointer;
        transition: all 0.3s;
    }

        .carousel-btn:hover {
            background: rgba(77,238,234,0.4);
            transform: scale(1.05);
        }

    /* Benefits Section */
    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin: 4rem 0;
    }

    .benefit-card {
        text-align: center;
        padding: 2rem;
        background: rgba(255,255,255,0.03);
        border-radius: 28px;
        border: 1px solid rgba(77,238,234,0.1);
        transition: all 0.3s;
    }

        .benefit-card:hover {
            border-color: #4DEEEA;
            transform: translateY(-5px);
        }

    .benefit-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #4DEEEA;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    /* CTA Section */
    .cta-section {
        background: linear-gradient(135deg, rgba(77,238,234,0.1), rgba(126,107,255,0.1));
        border-radius: 60px;
        padding: 4rem 2rem;
        text-align: center;
        margin: 4rem 0;
        position: relative;
        overflow: hidden;
    }

        .cta-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(77,238,234,0.1), transparent);
            animation: rotate 20s linear infinite;
        }

    @@keyframes rotate {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .marketplace-hero-content {
            padding: 0 1.5rem;
        }

        .marketplace-filter-row {
            flex-direction: column;
        }

        .marketplace-filter-scroll {
            width: 100%;
        }

        .marketplace-filter-divider {
            display: none;
        }

        .marketplace-sort-select {
            width: 100%;
        }

        #marketplace-main {
            padding: 4rem 1.5rem;
        }

        .hero-stats {
            gap: 1rem;
        }

        .stat-item {
            padding: 0.5rem 1rem;
        }

        .stat-number {
            font-size: 1.5rem;
        }

        .carousel-btn {
            display: none;
        }
    }
</style>

<!-- HERO SECTION WITH INTEGRATED FILTERS -->
<section id="marketplace-hero">
    <canvas id="marketplace-hero-canvas"></canvas>
    <div class="marketplace-hero-glow"></div>

    <div class="marketplace-hero-content">
        @*<div class="marketplace-hero-badge">
            <div class="marketplace-hero-badge-dot"></div>
            <i class="fas fa-store"></i> MARKETPLACE
        </div>*@

        <h1 class="marketplace-hero-h1">
            Travel <span class="text-gradient">Marketplace</span>
        </h1>

        <p class="marketplace-hero-subtitle">
            Everything You Need For Your Journey In One Place
        </p>

        <!-- Hero Statistics -->
        @*<div class="hero-stats">
            <div class="stat-item"><div class="stat-number">500+</div><div>Products</div></div>
            <div class="stat-item"><div class="stat-number">50+</div><div>Vendors</div></div>
            <div class="stat-item"><div class="stat-number">150+</div><div>Destinations</div></div>
            <div class="stat-item"><div class="stat-number">5,000+</div><div>Orders</div></div>
        </div>*@

        <!-- Integrated Filters -->
        <div class="marketplace-hero-filters">
            <div class="marketplace-filter-glass">
