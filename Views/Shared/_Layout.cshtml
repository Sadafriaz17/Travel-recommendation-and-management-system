@{
    var activePage = ViewBag.ActivePage as string ?? "Home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - NEXVOY</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --font-main: 'Inter', sans-serif;
            --text-dark: #1a1a1a;
            --text-muted: #6b7280;
            --bg-body: #f8f9fa;
            --bg-white: #ffffff;
            --bg-dark: #1a1a1a;
            --border: #e5e7eb;
            --radius: 16px;
            --shadow: 0 8px 25px rgba(0, 0, 0, 0.04);
            --shadow-hover: 0 12px 35px rgba(0, 0, 0, 0.08);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-main);
            background: var(--bg-body);
            color: var(--text-dark);
            overflow-x: hidden;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: 0.2s;
        }

        ul {
            list-style: none;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        .btn-primary {
            background: #1a1a1a;
            color: #fff;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            display: inline-block;
            transition: 0.2s;
        }

            .btn-primary:hover {
                background: #333;
                color: #fff;
            }

        .text-center-btn {
            text-align: center;
            margin-top: 2.5rem;
        }

        #site-header {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 1.5rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            max-width: 1200px;
            margin: 0 auto;
        }

            #site-header .logo {
                font-size: 1.2rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                color: #fff;
                display: flex;
                align-items: center;
                gap: 10px;
            }

                #site-header .logo i {
                    font-size: 1.4rem;
                }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 2.5rem;
        }

            .nav-links a {
                color: rgba(255, 255, 255, 0.7);
                font-size: 0.9rem;
                font-weight: 500;
            }

                .nav-links a:hover {
                    color: #fff;
                }

        /* ── NAV DROPDOWN (More menu) ── */
        .nav-dropdown {
            position: relative;
        }

        .nav-dropdown-toggle {
            display: flex;
            align-items: center;
            gap: 6px;
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
            font-weight: 500;
            font-family: var(--font-main);
            cursor: pointer;
            padding: 0;
        }

            .nav-dropdown-toggle:hover,
            .nav-dropdown.open .nav-dropdown-toggle {
                color: #fff;
            }

            .nav-dropdown-toggle i {
                font-size: 0.65rem;
                transition: transform 0.2s ease;
            }

        .nav-dropdown.open .nav-dropdown-toggle i {
            transform: rotate(180deg);
        }

        .nav-dropdown-menu {
            position: absolute;
            top: calc(100% + 18px);
            left: 50%;
            transform: translateX(-50%) translateY(8px);
            min-width: 230px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.15);
            padding: 0.5rem;
            opacity: 0;
            visibility: hidden;
            transition: 0.2s ease;
            z-index: 1100;
        }

        .nav-dropdown.open .nav-dropdown-menu {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

        .nav-dropdown-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0.65rem 0.8rem;
            border-radius: 8px;
            color: #1a1a1a;
            font-size: 0.85rem;
            font-weight: 500;
        }

            .nav-dropdown-menu a i {
                width: 16px;
                color: #6b7280;
                font-size: 0.85rem;
            }

            .nav-dropdown-menu a:hover {
                background: #f3f4f6;
                color: #111;
            }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

            .nav-actions .btn-outline-light {
                padding: 0.5rem 1.2rem;
                border-radius: 50px;
                border: 1px solid rgba(255,255,255,0.15);
                color: #fff;
                font-size: 0.85rem;
                font-weight: 500;
                background: rgba(255,255,255,0.1);
            }

                .nav-actions .btn-outline-light:hover {
                    background: #fff;
                    color: #000;
                    border-color: #fff;
                }

        /* ── USER AVATAR MENU ── */
        .user-menu {
            position: relative;
        }

        .avatar-btn {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            padding: 0;
            background: none;
        }

        .avatar-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, #00e5ff, #8b5cf6);
            color: #fff;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .user-dropdown {
            position: absolute;
            top: calc(100% + 14px);
            right: 0;
            min-width: 180px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.15);
            padding: 0.5rem;
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: 0.2s ease;
            z-index: 1100;
        }

            .user-dropdown.open {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
            }

            .user-dropdown a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0.65rem 0.8rem;
                border-radius: 8px;
                color: #1a1a1a;
                font-size: 0.85rem;
                font-weight: 500;
            }

                .user-dropdown a i {
                    width: 16px;
                    color: #6b7280;
                    font-size: 0.85rem;
                }

                .user-dropdown a:hover {
                    background: #f3f4f6;
                    color: #111;
                }

        .hero-wrapper {
            position: relative;
            width: 100%;
            min-height: 85vh;
            background-image: url('/images/background.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding-top: 100px;
            padding-bottom: 60px;
        }

            .hero-wrapper::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);
                pointer-events: none;
            }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #fff;
            max-width: 800px;
            padding: 0 1rem;
            margin-bottom: 3.5rem;
        }

            .hero-content h1 {
                font-size: clamp(2.8rem, 5vw, 4.5rem);
                font-weight: 700;
                line-height: 1.15;
                margin-bottom: 1rem;
                letter-spacing: -0.02em;
            }

            .hero-content p {
                font-size: 1.1rem;
                color: rgba(255,255,255,0.85);
                margin-bottom: 2.5rem;
            }

        .hero-search {
            display: inline-flex;
            align-items: center;
            background: #fff;
            padding: 0.4rem;
            border-radius: 60px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.15);
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }

            .hero-search .search-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 0.4rem 1.2rem;
                border-right: 1px solid #e5e7eb;
                color: #4b5563;
                font-size: 0.9rem;
            }

                .hero-search .search-item:last-of-type {
                    border: none;
                }

                .hero-search .search-item i {
                    color: #9ca3af;
                }

            .hero-search select, .hero-search input {
                border: none;
                background: transparent;
                font-size: 0.9rem;
                color: #1a1a1a;
                outline: none;
                font-family: var(--font-main);
            }

            .hero-search .btn-search {
                background: #1a1a1a;
                color: #fff;
                padding: 0.6rem 1.8rem;
                border-radius: 60px;
                border: none;
                font-weight: 600;
                cursor: pointer;
            }

        .stats-wrapper {
            position: relative;
            z-index: 3;
            width: 100%;
            max-width: 1000px;
            padding: 0 1rem;
            margin-top: 30px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            background: #fff;
            padding: 1.5rem;
            border-radius: var(--radius);
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }

        .stat-item {
            text-align: center;
        }

            .stat-item h4 {
                font-size: 1.5rem;
                font-weight: 700;
                margin-bottom: 0.25rem;
            }

            .stat-item p {
                font-size: 0.8rem;
                color: var(--text-muted);
                margin: 0;
            }

        .section-padding {
            padding: 6rem 0 0;
        }f

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-header-left .sub-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            display: block;
            margin-bottom: 0.25rem;
        }

        .section-header-left h2 {
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .section-header-right {
            max-width: 450px;
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        #site-footer {
            background: #1c1c1c;
            color: #fff;
            padding: 5rem 0 2rem;
            margin-top: 6rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
            gap: 4rem;
            padding-bottom: 3rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .footer-col h5 {
            font-weight: 600;
            margin-bottom: 1.2rem;
            font-size: 1rem;
            color: #fff;
        }

        .footer-col ul li {
            margin-bottom: 0.8rem;
        }

            .footer-col ul li a {
                color: rgba(255,255,255,0.5);
                font-size: 0.9rem;
                transition: 0.2s;
            }

                .footer-col ul li a:hover {
                    color: #fff;
                }

        .footer-col p {
            color: rgba(255,255,255,0.5);
            font-size: 0.9rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        .newsletter-wrap {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

            .newsletter-wrap p {
                margin-bottom: 1.5rem;
                text-align: right;
                max-width: 300px;
            }

        .newsletter-form {
            display: flex;
            gap: 0.5rem;
            width: 100%;
            max-width: 350px;
        }

            .newsletter-form input {
                flex: 1;
                padding: 0.8rem 1.2rem;
                border-radius: 50px;
                border: none;
                outline: none;
                font-family: var(--font-main);
                background: #2a2a2a;
                color: #fff;
            }

                .newsletter-form input::placeholder {
                    color: #666;
                }

            .newsletter-form button {
                padding: 0.8rem 2rem;
                border-radius: 50px;
                background: #fff;
                color: #000;
                border: none;
                font-weight: 600;
                cursor: pointer;
            }

        .footer-socials {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
            justify-content: flex-end;
            width: 100%;
        }

            .footer-socials a {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.1);
                display: flex;
                align-items: center;
                justify-content: center;
                color: rgba(255,255,255,0.5);
                transition: 0.2s;
            }

                .footer-socials a:hover {
                    background: #fff;
                    color: #000;
                    border-color: #fff;
                }

        .footer-bottom {
            text-align: center;
            padding-top: 2rem;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.2);
        }

        @@media (max-width: 1024px) {
            .footer-grid {
                grid-template-columns: 1fr 1fr;
                gap: 3rem;
            }
        }

        @@media (max-width: 768px) {
            #site-header .nav-links, #site-header .nav-actions {
                display: none;
            }

            .hero-search {
                background: transparent;
                padding: 0;
                box-shadow: none;
                flex-direction: column;
            }

                .hero-search .search-item {
                    background: #fff;
                    width: 100%;
                    padding: 0.8rem 1.2rem;
                    border-radius: 50px;
                    border: none;
                    margin: 0;
                    justify-content: center;
                }

                .hero-search .btn-search {
                    width: 100%;
                    padding: 1rem;
                }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
                gap: 1rem;
                padding: 1.5rem 1rem;
            }

            .footer-grid {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .newsletter-wrap {
                align-items: flex-start;
            }

                .newsletter-wrap p {
                    text-align: left;
                }

            .footer-socials {
                justify-content: flex-start;
            }

            .section-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .section-header-right {
                max-width: 100%;
            }
        }
    </style>
    @RenderSection("HeadStyles", required: false)
</head>
<body>
    <header id="site-header">
        <a href="@Url.Action("Index", "Home")" class="logo">
            <i class="fas fa-compass"></i> NEXVOY
        </a>
        <ul class="nav-links">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("Index", "Destination")">Destinations</a></li>
            <li><a href="@Url.Action("Index", "Package")">Packages</a></li>
            <li><a href="@Url.Action("About", "Home")">About</a></li>
            <li><a href="@Url.Action("Services", "Home")">Services</a></li>
            <li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
            <li class="nav-dropdown" id="moreDropdown">
                <button type="button" class="nav-dropdown-toggle" onclick="toggleNavDropdown(event)">
                    More <i class="fas fa-chevron-down"></i>
                </button>
                <div class="nav-dropdown-menu">
                    <a href="@Url.Action("Index", "VendorMarketPlace")">
                        <i class="fas fa-store"></i> Travel Marketplace
                    </a>
                    <a href="@Url.Action("Index", "Product")">
                        <i class="fas fa-shopping-bag"></i> Travel Store
                    </a>
                    <a href="@Url.Action("Index", "TripAdvisor")">
                        <i class="fas fa-comment-dots"></i> Trip Advisor
                    </a>
                    <a href="@Url.Action("Index", "PackingAssistant")">
                        <i class="fas fa-suitcase-rolling"></i> Packing Assistance
                    </a>
                </div>
            </li>
        </ul>
        <div class="nav-actions">
            @if (Session["UserId"] != null)
            {
                var initial = Session["UserName"] != null
                    ? Session["UserName"].ToString().Substring(0, 1).ToUpper()
                    : "U";

                <div class="user-menu" id="userMenu">
                    <button type="button" class="avatar-btn" onclick="toggleUserDropdown(event)">
                        <span class="avatar-circle">@initial</span>
                    </button>
                    <div class="user-dropdown" id="userDropdown">
                        <a href="@Url.Action("Index", "AdminDashboard", new { area = "AdminArea" })">
                            <i class="fas fa-gauge"></i> Dashboard
                        </a>
                        <a href="@Url.Action("Index", "Logout")">
                            <i class="fas fa-right-from-bracket"></i> Logout
                        </a>
                    </div>
                </div>
            }
            else
            {
                <a href="@Url.Action("Index", "Signup")" class="btn-outline-light" style="background:#fff; color:#000; border:none;">Get Started</a>
            }
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer id="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h5 style="font-size:1.2rem; font-weight:700; display:flex; align-items:center; gap:8px;">
                        <i class="fas fa-compass" style="color:#fff;"></i> NEXVOY
                    </h5>
                    <p>Plan your perfect trip with personalized itineraries and the best local experiences Indonesia has to offer.</p>
                </div>
                <div class="footer-col">
                    <h5>About</h5>
                    <ul>
                        <li><a href="#">About Us</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Partners</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h5>Support</h5>
                    <ul>
                        <li><a href="#">Help Center</a></li>
                        <li><a href="#">Contact Support</a></li>
                        <li><a href="#">Terms of Service</a></li>
                        <li><a href="#">Privacy Policy</a></li>

                    </ul>
                </div>
                <div class="footer-col newsletter-wrap">
                    <h5>Newsletter</h5>
                    <p>Subscribe to get exclusive travel deals and updates.</p>
                    <div class="newsletter-form">
                        <input type="email" placeholder="Your email address" />
                        <button>Send</button>
                    </div>
                    <div class="footer-socials">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-youtube"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 NEXVOY. All Rights Reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        function toggleNavDropdown(e) {
            e.stopPropagation();
            document.getElementById('moreDropdown').classList.toggle('open');
        }

        function toggleUserDropdown(e) {
            e.stopPropagation();
            document.getElementById('userDropdown').classList.toggle('open');
        }

        document.addEventListener('click', function (e) {
            var moreDropdown = document.getElementById('moreDropdown');
            if (moreDropdown && !moreDropdown.contains(e.target)) {
                moreDropdown.classList.remove('open');
            }

            var userMenu = document.getElementById('userMenu');
            var userDropdown = document.getElementById('userDropdown');
            if (userMenu && userDropdown && !userMenu.contains(e.target)) {
                userDropdown.classList.remove('open');
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
