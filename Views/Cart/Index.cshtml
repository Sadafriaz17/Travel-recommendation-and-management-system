@* CART - Views/Cart/Index.cshtml *@
@model IEnumerable<TourwebsiteFYP.DB_data_models.Cart>
@using TourwebsiteFYP.Helpers

@{
    ViewBag.Title = "My Cart";
    ViewBag.ActivePage = "Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var items = Model != null ? Model.ToList() : new List<TourwebsiteFYP.DB_data_models.Cart>();
    decimal subtotal = items.Sum(c => c.Price * c.Quantity);
}

@section HeadStyles {
    <style>
        .cart-page {
            padding: 4rem 0 6rem;
        }

        .cart-layout {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 2.5rem;
            align-items: start;
        }

        /* CART TABLE */
        .cart-table-wrap {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }

        .cart-table-head {
            display: grid;
            grid-template-columns: 80px 1fr 130px 130px 130px 60px;
            gap: 1rem;
            padding: 1rem 1.5rem;
            background: #f8f9fa;
            border-bottom: 1px solid #e5e7eb;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #6b7280;
        }

        .cart-item-row {
            display: grid;
            grid-template-columns: 80px 1fr 130px 130px 130px 60px;
            gap: 1rem;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #f3f4f6;
            align-items: center;
            transition: background 0.15s;
        }

            .cart-item-row:last-child {
                border-bottom: none;
            }

            .cart-item-row:hover {
                background: #fafafa;
            }

        .cart-item-img {
            width: 80px;
            height: 70px;
            object-fit: cover;
            border-radius: 10px;
            border: 1px solid #e5e7eb;
        }

        .cart-item-img-placeholder {
            width: 80px;
            height: 70px;
            border-radius: 10px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #9ca3af;
            font-size: 1.3rem;
        }

        .cart-item-name {
            font-size: 0.92rem;
            font-weight: 600;
            color: #1a1a1a;
            line-height: 1.3;
        }

        .cart-item-type {
            font-size: 0.75rem;
            color: #6b7280;
            margin-top: 3px;
        }

        .cart-unit-price,
        .cart-line-total {
            font-size: 0.92rem;
            font-weight: 600;
            color: #1a1a1a;
        }

        .cart-line-total {
            font-weight: 700;
        }

        /* QTY STEPPER */
        .qty-stepper {
            display: inline-flex;
            align-items: center;
            border: 1px solid #e5e7eb;
            border-radius: 50px;
            overflow: hidden;
            background: #fff;
        }

        .qty-btn {
            width: 32px;
            height: 32px;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 700;
            color: #1a1a1a;
            transition: background 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .qty-btn:hover {
                background: #f3f4f6;
            }

        .qty-val {
            min-width: 30px;
            text-align: center;
            font-size: 0.88rem;
            font-weight: 600;
            color: #1a1a1a;
        }

        /* REMOVE */
        .cart-remove-btn {
            width: 32px;
            height: 32px;
            border: none;
            background: transparent;
            cursor: pointer;
            color: #9ca3af;
            font-size: 1rem;
            border-radius: 8px;
            transition: color 0.15s, background 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .cart-remove-btn:hover {
                color: #ef4444;
                background: #fde8e8;
            }

        /* EMPTY STATE */
        .cart-empty {
            text-align: center;
            padding: 5rem 2rem;
        }

            .cart-empty i {
                font-size: 3.5rem;
                color: #d1d5db;
                margin-bottom: 1rem;
            }

            .cart-empty h3 {
                font-size: 1.35rem;
                font-weight: 700;
                color: #1a1a1a;
                margin-bottom: 0.5rem;
            }

            .cart-empty p {
                color: #6b7280;
                margin-bottom: 1.75rem;
            }

        /* ORDER SUMMARY */
        .cart-summary-card {
            background: #fff;
            border-radius: 16px;
            border: 1px solid #e5e7eb;
            padding: 1.75rem;
            position: sticky;
            top: 100px;
        }

        .cart-summary-title {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .cart-summary-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.88rem;
            color: #6b7280;
            margin-bottom: 0.75rem;
        }

        .cart-summary-divider {
            border: none;
            border-top: 1px solid #e5e7eb;
            margin: 1rem 0;
        }

        .cart-summary-total {
            display: flex;
            justify-content: space-between;
            font-size: 1.1rem;
            font-weight: 800;
            color: #1a1a1a;
        }

        .btn-checkout {
            display: block;
            width: 100%;
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 50px;
            background: #1a1a1a;
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            text-align: center;
            border: none;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s, transform 0.2s;
            font-family: var(--font-main);
        }

            .btn-checkout:hover {
                background: #333;
                color: #fff;
                transform: translateY(-1px);
            }

        .btn-continue-shopping {
            display: block;
            width: 100%;
            margin-top: 0.75rem;
            padding: 0.75rem;
            border-radius: 50px;
            border: 1px solid #e5e7eb;
            background: transparent;
            color: #6b7280;
            font-size: 0.88rem;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: 0.15s;
        }

            .btn-continue-shopping:hover {
                border-color: #1a1a1a;
                color: #1a1a1a;
            }

        .cart-toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: #1a1a1a;
            color: #fff;
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            opacity: 0;
            transform: translateY(10px);
            transition: 0.3s ease;
            z-index: 9999;
            pointer-events: none;
        }

            .cart-toast.show {
                opacity: 1;
                transform: translateY(0);
            }

        @@media (max-width: 900px) {
            .cart-layout {
                grid-template-columns: 1fr;
            }

            .cart-summary-card {
                position: static;
            }
        }

        @@media (max-width: 640px) {
            .cart-table-head,
            .cart-item-row {
                grid-template-columns: 60px 1fr auto auto;
            }

            .cart-table-head .col-unit,
            .cart-table-head .col-total,
            .cart-item-row .cart-unit-price,
            .cart-item-row .cart-line-total {
                display: none;
            }
        }
    </style>
}

<section class="hero-wrapper hero-inner">
    <div class="hero-content">
        <div class="hero-eyebrow"><i class="fas fa-shopping-cart"></i> Shopping Cart</div>
        <h1>Your Cart</h1>
        <p>Review your selected items before checking out.</p>
    </div>
</section>

<div class="container cart-page">
    @if (!items.Any())
    {
        <div class="cart-empty">
            <i class="fas fa-shopping-cart"></i>
            <h3>Your cart is empty</h3>
            <p>Looks like you haven't added any products yet.</p>
            <a href="@Url.Action("Index", "Product")" class="btn-primary">
                <i class="fas fa-store"></i> Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <!-- CART ITEMS -->
            <div>
                <div class="cart-table-wrap">
                    <div class="cart-table-head">
                        <span></span>
                        <span>Product</span>
                        <span class="col-unit">Unit Price</span>
                        <span>Quantity</span>
                        <span class="col-total">Line Total</span>
                        <span></span>
                    </div>

                    @foreach (var item in items)
                    {
                        // A cart row can point at a product or a package.
                        var name = CartItemHelper.GetItemName(item);
                        var typeName = CartItemHelper.GetItemTypeName(item);
                        var image = CartItemHelper.GetItemImage(item);

                        <div class="cart-item-row" id="row-@item.CartId">
                            <!-- Image -->
                            @if (!string.IsNullOrEmpty(image))
                            {
                                <img class="cart-item-img" src="@Url.Content(image)" alt="@name" />
                            }
                            else
                            {
                                <div class="cart-item-img-placeholder"><i class="fas fa-image"></i></div>
                            }

                            <!-- Name -->
                            <div>
                                <div class="cart-item-name">@name</div>
                                @if (!string.IsNullOrEmpty(typeName))
                                {
                                    <div class="cart-item-type">@typeName</div>
                                }
                            </div>

                            <!-- Unit price -->
                            <div class="cart-unit-price">$@item.Price.ToString("N2")</div>

                            <!-- Qty stepper -->
                            <div class="qty-stepper">
                                <button class="qty-btn" onclick="changeQty(@item.CartId, -1)">−</button>
                                <span class="qty-val" id="qty-@item.CartId">@item.Quantity</span>
                                <button class="qty-btn" onclick="changeQty(@item.CartId, 1)">+</button>
                            </div>

                            <!-- Line total -->
                            <div class="cart-line-total" id="line-@item.CartId">$@((item.Price * item.Quantity).ToString("N2"))</div>

                            <!-- Remove -->
                            <button class="cart-remove-btn" onclick="removeItem(@item.CartId)" title="Remove">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- ORDER SUMMARY -->
            <div class="cart-summary-card">
                <div class="cart-summary-title">Order Summary</div>
                <div class="cart-summary-row">
                    <span>Subtotal (@items.Sum(c => c.Quantity) items)</span>
                    <span id="summarySubtotal">$@subtotal.ToString("N2")</span>
                </div>
                <div class="cart-summary-row">
                    <span>Shipping</span>
                    <span style="color:#16a34a; font-weight:600;">Free</span>
                </div>
                <hr class="cart-summary-divider" />
                <div class="cart-summary-total">
                    <span>Grand Total</span>
                    <span id="summaryTotal">$@subtotal.ToString("N2")</span>
                </div>
                <a href="@Url.Action("Checkout", "Cart")" class="btn-checkout">
                    <i class="fas fa-lock"></i> Proceed to Checkout
                </a>
                <a href="@Url.Action("Index", "Product")" class="btn-continue-shopping">
                    ← Continue Shopping
                </a>
            </div>
        </div>
    }
</div>

<div class="cart-toast" id="cartToast"></div>

@section Scripts {
    <script>
        // Price lookup from server-rendered data
        const itemPrices = {
            @foreach (var item in items)
            {
                @Html.Raw($"{item.CartId}: {item.Price},\n")
            }
        };

        function changeQty(cartId, delta) {
            const qtyEl = document.getElementById('qty-' + cartId);
            const currentQty = parseInt(qtyEl.textContent);
            const newQty = currentQty + delta;

            if (newQty < 1) {
                removeItem(cartId);
                return;
            }

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'cartId=' + cartId + '&quantity=' + newQty
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    qtyEl.textContent = newQty;
                    const price = itemPrices[cartId] || 0;
                    document.getElementById('line-' + cartId).textContent = '$' + (price * newQty).toFixed(2);
                    document.getElementById('summarySubtotal').textContent = '$' + data.subtotal;
                    document.getElementById('summaryTotal').textContent = '$' + data.subtotal;
                    showToast('Quantity updated');
                }
            });
        }

        function removeItem(cartId) {
            fetch('/Cart/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'cartId=' + cartId
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    var row = document.getElementById('row-' + cartId);
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(20px)';
                    row.style.transition = '0.3s ease';
                    setTimeout(() => {
                        row.remove();
                        document.getElementById('summarySubtotal').textContent = '$' + data.subtotal;
                        document.getElementById('summaryTotal').textContent = '$' + data.subtotal;

                        // Check if cart is now empty
                        const remainingRows = document.querySelectorAll('.cart-item-row');
                        if (remainingRows.length === 0) {
                            location.reload();
                        }
                    }, 300);
                    showToast('Item removed');
                }
            });
        }

        function showToast(msg) {
            const t = document.getElementById('cartToast');
            t.textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 2500);
        }
    </script>
}
