@* =========================================
    CONTACT PAGE - Views/Contact/Index.cshtml
    ========================================= *@
@{
    ViewBag.Title = "Contact Us";
    ViewBag.ActivePage = "Contact";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <style>
        /* ── CONTACT HERO ── */
        .con-hero {
            position: relative;
            margin-top: 0;
            padding: 160px 0 80px;
            background: linear-gradient(rgba(20,20,20,0.55), rgba(20,20,20,0.65)), url('/images/background.jpg');
            background-size: cover;
            background-position: center;
            color: #fff;
            text-align: center;
        }

        .con-hero-badge {
            display: inline-block;
            padding: 0.4rem 1.1rem;
            border-radius: 50px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin-bottom: 1.25rem;
        }

        .con-hero h1 {
            font-size: clamp(2.4rem, 4.5vw, 3.6rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            line-height: 1.15;
            margin-bottom: 1rem;
        }

        .con-hero p {
            max-width: 560px;
            margin: 0 auto;
            color: rgba(255,255,255,0.8);
            font-size: 1.05rem;
        }

        .con-hero-actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .con-btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.8rem 2rem;
            border-radius: 50px;
            border: 1px solid rgba(255,255,255,0.35);
            background: rgba(255,255,255,0.08);
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
        }

            .con-btn-outline:hover {
                background: #fff;
                color: #1a1a1a;
            }

        /* ── MAIN LAYOUT ── */
        .con-layout {
            display: grid;
            grid-template-columns: 0.9fr 1.5fr;
            gap: 2rem;
            align-items: start;
        }

        /* ── LEFT: INFO PANEL ── */
        .con-info-panel {
            display: flex;
            flex-direction: column;
            gap: 1.25rem;
        }

        .con-badge-live {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            width: fit-content;
            padding: 0.45rem 1rem;
            border-radius: 50px;
            background: #f3f4f6;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-muted);
        }

        .con-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #22c55e;
        }

        .con-info-panel h2 {
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.25rem;
        }

        .con-info-panel > p {
            color: var(--text-muted);
            font-size: 0.92rem;
            margin-bottom: 0.5rem;
        }

        .con-detail-card {
            display: flex;
            align-items: center;
            gap: 1rem;
            background: var(--bg-white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.1rem 1.3rem;
            box-shadow: var(--shadow);
            text-decoration: none;
            color: inherit;
            transition: 0.25s;
        }

            .con-detail-card:hover {
                box-shadow: var(--shadow-hover);
                transform: translateY(-2px);
            }

        .con-detail-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .con-detail-text strong {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 0.15rem;
        }

        .con-detail-text span {
            font-size: 0.9rem;
            font-weight: 600;
        }

        .con-socials-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin: 0.5rem 0 0.75rem;
        }

        .con-socials {
            display: flex;
            gap: 0.75rem;
        }

        .con-social-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 1px solid var(--border);
            background: var(--bg-white);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-dark);
            transition: 0.2s;
        }

            .con-social-btn:hover {
                background: #1a1a1a;
                color: #fff;
                border-color: #1a1a1a;
            }

        /* ── RIGHT: FORM PANEL ── */
        .con-form-panel {
            background: var(--bg-white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 2.5rem;
        }

            .con-form-panel h3 {
                font-size: 1.35rem;
                font-weight: 700;
                letter-spacing: -0.02em;
                margin-bottom: 0.35rem;
            }

        .con-form-sub {
            color: var(--text-muted);
            font-size: 0.88rem;
            margin-bottom: 2rem;
        }

        .con-form {
            display: flex;
            flex-direction: column;
            gap: 1.1rem;
        }

        .con-field-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.1rem;
        }

        .con-field {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .con-label {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .con-input, .con-textarea {
            background: #f9fafb;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 0.8rem 1.1rem;
            font-family: var(--font-main);
            font-size: 0.88rem;
            color: var(--text-dark);
            outline: none;
            transition: 0.2s;
            width: 100%;
        }

            .con-input::placeholder, .con-textarea::placeholder {
                color: #b0b3ba;
            }

            .con-input:focus, .con-textarea:focus {
                border-color: #1a1a1a;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(26,26,26,0.06);
            }

        .con-textarea {
            resize: vertical;
            min-height: 130px;
            line-height: 1.6;
        }

        .con-field-meta {
            display: flex;
            justify-content: flex-end;
            margin-top: -0.15rem;
        }

        .con-char-count {
            font-size: 0.68rem;
            color: var(--text-muted);
        }

            .con-char-count.warn {
                color: #dc2626;
            }

        .con-topic-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .con-chip {
            padding: 0.4rem 1rem;
            border-radius: 50px;
            border: 1px solid var(--border);
            background: #fff;
            color: var(--text-muted);
            font-size: 0.78rem;
            font-family: var(--font-main);
            cursor: pointer;
            transition: 0.2s;
        }

            .con-chip:hover {
                border-color: #1a1a1a;
                color: var(--text-dark);
            }

            .con-chip.selected {
                background: #1a1a1a;
                border-color: #1a1a1a;
                color: #fff;
            }

        .con-submit-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 0.5rem;
        }

        .con-submit-note {
            font-size: 0.75rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .con-submit-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 0.85rem 2.1rem;
            border-radius: 50px;
            background: #1a1a1a;
            color: #fff;
            font-weight: 600;
            font-size: 0.88rem;
            border: none;
            cursor: pointer;
            transition: 0.25s;
            white-space: nowrap;
        }

            .con-submit-btn:hover {
                background: #333;
            }

            .con-submit-btn .btn-arrow {
                transition: transform 0.2s;
            }

            .con-submit-btn:hover .btn-arrow {
                transform: translateX(4px);
            }

        /* Success state */
        .con-success {
            display: none;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2.5rem 1rem;
            gap: 1rem;
        }

        .con-success-icon {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }

        .con-success-title {
            font-size: 1.3rem;
            font-weight: 700;
        }

        .con-success-sub {
            color: var(--text-muted);
            font-size: 0.88rem;
            max-width: 320px;
        }

        .con-success-btn {
            margin-top: 0.5rem;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            border: 1px solid var(--border);
            background: #fff;
            font-family: var(--font-main);
            font-size: 0.82rem;
            cursor: pointer;
        }

            .con-success-btn:hover {
                border-color: #1a1a1a;
            }

        /* ── FAQ ── */
        .con-faq {
            margin-top: 5rem;
            padding-top: 4rem;
            border-top: 1px solid var(--border);
        }

        .con-faq-header {
            text-align: center;
            margin-bottom: 3rem;
        }

            .con-faq-header h2 {
                font-size: clamp(1.8rem, 3vw, 2.4rem);
                font-weight: 700;
                letter-spacing: -0.02em;
                margin-bottom: 0.5rem;
            }

            .con-faq-header p {
                color: var(--text-muted);
                font-size: 0.92rem;
            }

        .con-faq-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .con-faq-item {
            background: var(--bg-white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            transition: 0.2s;
        }

            .con-faq-item:hover {
                box-shadow: var(--shadow);
            }

        .con-faq-q {
            width: 100%;
            background: none;
            border: none;
            padding: 1.2rem 1.4rem;
            text-align: left;
            font-family: var(--font-main);
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .con-faq-arrow {
            font-size: 0.7rem;
            color: var(--text-muted);
            transition: transform 0.25s;
            flex-shrink: 0;
        }

        .con-faq-item.open .con-faq-arrow {
            transform: rotate(180deg);
        }

        .con-faq-a {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.35s ease, padding 0.25s;
            font-size: 0.85rem;
            color: var(--text-muted);
            line-height: 1.7;
            padding: 0 1.4rem;
        }

        .con-faq-item.open .con-faq-a {
            max-height: 220px;
            padding: 0 1.4rem 1.2rem;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
            .con-layout {
                grid-template-columns: 1fr;
            }

            .con-faq-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 600px) {
            .con-field-row {
                grid-template-columns: 1fr;
            }

            .con-form-panel {
                padding: 1.75rem 1.25rem;
            }

            .con-submit-row {
                flex-direction: column;
                align-items: stretch;
            }

            .con-submit-btn {
                justify-content: center;
            }
        }
    </style>
}

<!-- HERO -->
<section class="con-hero">
    <div class="container">
       
        <h1>We'd Love to Hear From You</h1>
        <p>Questions, partnerships, or just curious about intelligent travel planning? Our team is ready to help you plan something extraordinary.</p>
        <div class="con-hero-actions">
            <a href="#conMain" class="btn-primary" onclick="document.getElementById('conMain').scrollIntoView({behavior:'smooth'});return false;">
                Send a Message
            </a>
            <a href="mailto:hello@pearlnex.com" class="con-btn-outline">
                <i class="fas fa-envelope"></i> Email Us
            </a>
        </div>
    </div>
</section>

<!-- MAIN -->
<div class="container section-padding" id="conMain">
    <div class="con-layout">

        <!-- LEFT: Info Panel -->
        <div class="con-info-panel">
            <div class="con-badge-live">
                <span class="con-dot"></span> Typically replies in &lt; 2 hours
            </div>

            <h2>Let's Plan Your Next Adventure</h2>
            <p>Whether you have a specific destination in mind or just a dream, our travel experts and AI tools are here to turn it into reality.</p>

            <a href="mailto:hello@pearlnex.com" class="con-detail-card">
                <div class="con-detail-icon"><i class="fas fa-envelope"></i></div>
                <div class="con-detail-text">
                    <strong>Email Us</strong>
                    <span>hello@pearlnex.com</span>
                </div>
            </a>

            <a href="tel:+923001234567" class="con-detail-card">
                <div class="con-detail-icon"><i class="fas fa-phone"></i></div>
                <div class="con-detail-text">
                    <strong>Call Us</strong>
                    <span>+92 300 123 4567</span>
                </div>
            </a>

            <div class="con-detail-card" style="cursor:default;">
                <div class="con-detail-icon"><i class="fas fa-location-dot"></i></div>
                <div class="con-detail-text">
                    <strong>Office</strong>
                    <span>Lahore, Punjab, Pakistan</span>
                </div>
            </div>

            <div class="con-detail-card" style="cursor:default;">
                <div class="con-detail-icon"><i class="fas fa-clock"></i></div>
                <div class="con-detail-text">
                    <strong>Working Hours</strong>
                    <span>Mon–Sat, 9:00 AM – 8:00 PM PKT</span>
                </div>
            </div>

            <div>
                <p class="con-socials-label">Follow Us</p>
                <div class="con-socials">
                    <a href="#" class="con-social-btn" title="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="con-social-btn" title="Twitter / X"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="con-social-btn" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" class="con-social-btn" title="Facebook"><i class="fab fa-facebook-f"></i></a>
                </div>
            </div>
        </div>

        <!-- RIGHT: Contact Form -->
        <div class="con-form-panel">
            <h3>Send Us a Message</h3>
            <p class="con-form-sub">Fill in the details below and we'll get back to you as soon as possible.</p>

            <!-- Success state -->
            <div class="con-success" id="conSuccess">
                <div class="con-success-icon"><i class="fas fa-check" style="color:#16a34a;"></i></div>
                <div class="con-success-title">Message Sent!</div>
                <p class="con-success-sub">Thanks for reaching out. Our team will get back to you within 2 hours. Keep an eye on your inbox!</p>
                <button type="button" class="con-success-btn" onclick="resetForm()">Send Another</button>
            </div>

            <!-- Form -->
            <form class="con-form" id="conForm" onsubmit="handleSubmit(event)">

                <div class="con-field-row">
                    <div class="con-field">
                        <label class="con-label" for="con-fname">First Name</label>
                        <input class="con-input" id="con-fname" type="text" placeholder="Sadaf" required />
                    </div>
                    <div class="con-field">
                        <label class="con-label" for="con-lname">Last Name</label>
                        <input class="con-input" id="con-lname" type="text" placeholder="Riaz" required />
                    </div>
                </div>

                <div class="con-field-row">
                    <div class="con-field">
                        <label class="con-label" for="con-email">Email Address</label>
                        <input class="con-input" id="con-email" type="email" placeholder="you@example.com" required />
                    </div>
                    <div class="con-field">
                        <label class="con-label" for="con-phone">Phone (Optional)</label>
                        <input class="con-input" id="con-phone" type="tel" placeholder="+92 300 000 0000" />
                    </div>
                </div>

                <div class="con-field">
                    <label class="con-label">Topic</label>
                    <input type="hidden" id="con-topic-input" value="" />
                    <div class="con-topic-chips" id="conChips">
                        <button type="button" class="con-chip" onclick="selectChip(this, 'General Inquiry')">General Inquiry</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Package Booking')">Package Booking</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'AI Trip Planner')">AI Trip Planner</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Travel Marketplace')">Travel Marketplace</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Trip Advisor')">Trip Advisor</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Support')">Support</button>
                    </div>
                </div>

                <div class="con-field">
                    <label class="con-label" for="con-subject">Subject</label>
                    <input class="con-input" id="con-subject" type="text" placeholder="How can we help you?" required />
                </div>

                <div class="con-field">
                    <label class="con-label" for="con-message">Message</label>
                    <textarea class="con-textarea" id="con-message" placeholder="Tell us about your travel plans, questions, or anything on your mind..." maxlength="1000" oninput="updateCount(this)" required></textarea>
                    <div class="con-field-meta">
                        <span class="con-char-count" id="conCharCount">0 / 1000</span>
                    </div>
                </div>

                <div class="con-submit-row">
                    <p class="con-submit-note">
                        🔒 Your details are safe with us.<br />We never share personal information.
                    </p>
                    <button type="submit" class="con-submit-btn" id="conSubmitBtn">
                        Send Message
                        <span class="btn-arrow">→</span>
                    </button>
                </div>

            </form>
        </div>

    </div>

    <!-- FAQ -->
    <div class="con-faq">
        <div class="con-faq-header">
            <h2>Frequently Asked Questions</h2>
            <p>Quick answers to the things people ask us most.</p>
        </div>

        <div class="con-faq-grid" id="conFaqGrid">
            @{
                var faqs = new[] {
                    new { q = "How does the AI Trip Planner work?", a = "Our AI analyses your preferences, budget, travel dates, and style to generate a fully personalised itinerary in seconds. It learns from your feedback and continuously improves your recommendations over time." },
                    new { q = "Can I book vendors through the Travel Marketplace directly?", a = "Yes! Our Travel Marketplace connects you with verified local vendors - hotels, guides, and experience providers - so you can browse, compare, and book everything in one place." },
                    new { q = "Is my payment information secure?", a = "Absolutely. We use industry-standard SSL encryption and PCI-DSS compliant payment processing. Your financial data is never stored on our servers." },
                    new { q = "What is your cancellation policy?", a = "Cancellation policies vary by package type. Most of our packages offer flexible cancellation up to 72 hours before departure with a full refund. Check individual package terms for details." },
                    new { q = "Do you offer group or corporate travel packages?", a = "Yes, we specialise in group bookings and corporate travel programmes. Contact us directly for custom quotes and dedicated account management for your organisation." },
                    new { q = "How does Trip Advisor help me plan better trips?", a = "Trip Advisor lets you ask travel questions and get tailored suggestions based on real traveller experiences, so you can plan with more confidence before you book." },
                };
            }
            @foreach (var faq in faqs)
            {
                <div class="con-faq-item">
                    <button type="button" class="con-faq-q" onclick="toggleFaq(this)">
                        @faq.q
                        <span class="con-faq-arrow">▼</span>
                    </button>
                    <div class="con-faq-a">@faq.a</div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── FORM INTERACTIONS ──
        function selectChip(el, value) {
            document.querySelectorAll('.con-chip').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('con-topic-input').value = value;
        }

        function updateCount(el) {
            const count = el.value.length;
            const counter = document.getElementById('conCharCount');
            counter.textContent = count + ' / 1000';
            counter.classList.toggle('warn', count > 800);
        }

        function handleSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('conSubmitBtn');
            btn.textContent = 'Sending…';
            btn.disabled = true;
            btn.style.opacity = '0.7';

            // Simulate async send - replace with real $.ajax / fetch to your controller
            setTimeout(() => {
                document.getElementById('conForm').style.display = 'none';
                document.getElementById('conSuccess').style.display = 'flex';
            }, 1200);
        }

        function resetForm() {
            document.getElementById('conForm').reset();
            document.getElementById('conCharCount').textContent = '0 / 1000';
            document.querySelectorAll('.con-chip').forEach(c => c.classList.remove('selected'));
            document.getElementById('con-topic-input').value = '';
            const btn = document.getElementById('conSubmitBtn');
            btn.innerHTML = 'Send Message <span class="btn-arrow">→</span>';
            btn.disabled = false;
            btn.style.opacity = '1';
            document.getElementById('conForm').style.display = 'flex';
            document.getElementById('conSuccess').style.display = 'none';
        }

        // ── FAQ ACCORDION ──
        function toggleFaq(btn) {
            const item = btn.closest('.con-faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.con-faq-item.open').forEach(i => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
    </script>
}
