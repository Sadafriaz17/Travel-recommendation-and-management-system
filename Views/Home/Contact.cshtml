            <!-- Success state (hidden by default) -->
            <div class="con-success" id="conSuccess">
                <div class="con-success-icon">✅</div>
                <div class="con-success-title">Message Sent!</div>
                <p class="con-success-sub">Thanks for reaching out. Our team will get back to you within 2 hours. Keep an eye on your inbox!</p>
                <button onclick="resetForm()" style="margin-top:0.5rem;padding:0.6rem 1.5rem;border-radius:100px;border:1px solid var(--border);background:var(--glass);color:var(--text);font-family:var(--font-body);font-size:0.82rem;cursor:pointer;transition:all 0.25s;" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">
                    Send Another →
                </button>
            </div>

            <!-- Actual Form -->
            <form class="con-form" id="conForm" onsubmit="handleSubmit(event)">

                <div class="con-field-row">
                    <div class="con-field">
                        <label class="con-label" for="con-fname">First Name</label>
                        <input class="con-input" id="con-fname" type="text" placeholder="Sadaf" required />
                    </div>
                    <div class="con-field">
                        <label class="con-label" for="con-lname">Last Name</label>
                        <input class="con-input" id="con-lname" type="text" placeholder="Riaz" required />
                    </div>
                </div>

                <div class="con-field-row">
                    <div class="con-field">
                        <label class="con-label" for="con-email">Email Address</label>
                        <input class="con-input" id="con-email" type="email" placeholder="you@example.com" required />
                    </div>
                    <div class="con-field">
                        <label class="con-label" for="con-phone">Phone (Optional)</label>
                        <input class="con-input" id="con-phone" type="tel" placeholder="+92 300 000 0000" />
                    </div>
                </div>

                <div class="con-field">
                    <label class="con-label" for="con-topic-input">Topic</label>
                    <input type="hidden" id="con-topic-input" value="" />
                    <div class="con-topic-chips" id="conChips">
                        <button type="button" class="con-chip" onclick="selectChip(this, 'General Inquiry')">General Inquiry</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Package Booking')">Package Booking</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'AI Trip Planner')">AI Trip Planner</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'VR Preview')">VR Preview</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Vendor Partnership')">Vendor Partnership</button>
                        <button type="button" class="con-chip" onclick="selectChip(this, 'Support')">Support</button>
                    </div>
                </div>

                <div class="con-field">
                    <label class="con-label" for="con-subject">Subject</label>
                    <input class="con-input" id="con-subject" type="text" placeholder="How can we help you?" required />
                </div>

                <div class="con-field">
                    <label class="con-label" for="con-message">Message</label>
                    <textarea class="con-textarea" id="con-message" placeholder="Tell us about your travel plans, questions, or anything on your mind..." maxlength="1000" oninput="updateCount(this)" required></textarea>
                    <div class="con-field-meta">
                        <span class="con-char-count" id="conCharCount">0 / 1000</span>
                    </div>
                </div>

                <div class="con-submit-row">
                    <p class="con-submit-note">
                        🔒 Your details are safe with us.<br />We never share personal information.
                    </p>
                    <button type="submit" class="con-submit-btn" id="conSubmitBtn">
                        Send Message
                        <span class="btn-arrow">→</span>
                    </button>
                </div>

            </form>
        </div>

    </div>

    <!-- FAQ SECTION -->
    <div id="con-faq">
        <div class="con-faq-header">
            <div class="nex-badge" style="display:inline-block;margin-bottom:1rem;">FAQ</div>
            <h2 class="con-faq-title">Frequently Asked <span class="text-gradient">Questions</span></h2>
            <p class="con-faq-sub">Quick answers to the things people ask us most.</p>
        </div>

        <div class="con-faq-grid" id="conFaqGrid">
            @{
                var faqs = new[] {
                    new { q = "How does the AI Trip Planner work?", a = "Our AI analyses your preferences, budget, travel dates, and style to generate a fully personalised itinerary in seconds. It learns from your feedback and continuously improves your recommendations." },
                    new { q = "Can I preview destinations in VR before booking?", a = "Yes! Our VR Destination Preview lets you explore hotels, beaches, attractions, and cities in immersive 360° virtual reality before you commit to any booking." },
                    new { q = "Is my payment information secure?", a = "Absolutely. We use industry-standard SSL encryption and PCI-DSS compliant payment processing. Your financial data is never stored on our servers." },
                    new { q = "What is your cancellation policy?", a = "Cancellation policies vary by package type. Most of our packages offer flexible cancellation up to 72 hours before departure with a full refund. Check individual package terms for details." },
                    new { q = "Do you offer group or corporate travel packages?", a = "Yes, we specialise in group bookings and corporate travel programmes. Contact us directly for custom quotes and dedicated account management for your organisation." },
                    new { q = "How quickly will I receive my itinerary?", a = "AI-generated itineraries are ready in under 30 seconds. For custom or complex multi-destination packages, our human travel experts typically respond within 2 hours during business hours." },
                };
            }
            @foreach (var faq in faqs)
            {
                <div class="con-faq-item">
                    <button class="con-faq-q" onclick="toggleFaq(this)">
                        @faq.q
                        <span class="con-faq-arrow">▼</span>
                    </button>
                    <div class="con-faq-a">@faq.a</div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        // ── 3D EARTH + ORBIT RINGS (identical to Packages page) ──
        (function () {
            const canvas = document.getElementById('con-hero-canvas');
            if (!canvas) return;

            const scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020205, 0.0006);

            const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0.3, 4.2);

            const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // ── Textures (same CDN as Packages page) ──
            const textureLoader = new THREE.TextureLoader();
            const earthMap = textureLoader.load('https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg');
            const earthSpecularMap = textureLoader.load('https://threejs.org/examples/textures/planets/earth_specular_2048.jpg');
            const earthNormalMap = textureLoader.load('https://threejs.org/examples/textures/planets/earth_normal_2048.jpg');
            const cloudMap = textureLoader.load('https://threejs.org/examples/textures/planets/earth_clouds_1024.png');

            // ── Earth group shifted RIGHT so text has clear left side ──
            const earthGroup = new THREE.Group();
            earthGroup.position.set(2.0, 0, 0);
            scene.add(earthGroup);

            const earth = new THREE.Mesh(
                new THREE.SphereGeometry(1.1, 128, 128),
                new THREE.MeshPhongMaterial({
                    map: earthMap,
                    specularMap: earthSpecularMap,
                    specular: new THREE.Color('grey'),
                    shininess: 5,
                    normalMap: earthNormalMap,
                    normalScale: new THREE.Vector2(0.8, 0.8)
                })
            );
            earthGroup.add(earth);

            const clouds = new THREE.Mesh(
                new THREE.SphereGeometry(1.12, 128, 128),
                new THREE.MeshPhongMaterial({
                    map: cloudMap,
                    transparent: true,
                    opacity: 0.12,
                    blending: THREE.AdditiveBlending
                })
            );
            earthGroup.add(clouds);

            // Orbit rings
            const createRing = (radius, color, opacity, segments = 200) => {
                const points = [];
                for (let i = 0; i <= segments; i++) {
                    const angle = (i / segments) * Math.PI * 2;
                    points.push(new THREE.Vector3(Math.cos(angle) * radius, 0, Math.sin(angle) * radius));
                }
                const geo = new THREE.BufferGeometry().setFromPoints(points);
                const mat = new THREE.LineBasicMaterial({ color, transparent: true, opacity });
                return new THREE.LineLoop(geo, mat);
            };
            const ring1 = createRing(1.55, 0x4deeEA, 0.3);
            const ring2 = createRing(1.75, 0xa855f7, 0.25);
            earthGroup.add(ring1);
            earthGroup.add(ring2);

            // Stars (global, not parented to earthGroup)
            const starGeometry = new THREE.BufferGeometry();
            const starCount = 4000;
            const starPositions = new Float32Array(starCount * 3);
            for (let i = 0; i < starCount; i++) {
                starPositions[i * 3] = (Math.random() - 0.5) * 2500;
                starPositions[i * 3 + 1] = (Math.random() - 0.5) * 2500;
                starPositions[i * 3 + 2] = (Math.random() - 0.5) * 600 - 200;
            }
            starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
            const stars = new THREE.Points(starGeometry,
                new THREE.PointsMaterial({ color: 0xffffff, size: 0.3, transparent: true, opacity: 0.7 })
            );
            scene.add(stars);

            // ── Lighting ──
            scene.add(new THREE.AmbientLight(0x111122));
            const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
            dirLight.position.set(5, 3, 5);
            scene.add(dirLight);
            scene.add(new THREE.PointLight(0x445566, 0.8, 10, 2));
            scene.add(new THREE.PointLight(0x4deeEA, 0.4, 5, 2));

            // ── Mouse interaction ──
            let targetRX = 0, targetRY = 0, currentRX = 0, currentRY = 0;
            document.getElementById('con-hero').addEventListener('mousemove', (e) => {
                targetRY = (e.clientX / window.innerWidth - 0.5) * 0.8;
                targetRX = (e.clientY / window.innerHeight - 0.5) * 0.4;
            });

            // ── Animation ──
            let time = 0;
            (function animate() {
                requestAnimationFrame(animate);
                time += 0.004;
                currentRY += (targetRY - currentRY) * 0.04;
                currentRX += (targetRX - currentRX) * 0.04;

                earth.rotation.y = currentRY + time * 0.5;
                earth.rotation.x = currentRX * 0.2;
                clouds.rotation.y = currentRY + time * 0.6;
                clouds.rotation.x = currentRX * 0.2;

                ring1.rotation.y += 0.0008;
                ring1.rotation.x = Math.sin(time * 0.4) * 0.1;
                ring2.rotation.z += 0.001;
                ring2.rotation.x = Math.cos(time * 0.3) * 0.1;

                stars.rotation.y += 0.0003;
                stars.rotation.x += 0.0002;

                renderer.render(scene, camera);
            })();

            // ── Resize ──
            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        })();

        // ── FORM INTERACTIONS ──
        function selectChip(el, value) {
            document.querySelectorAll('.con-chip').forEach(c => c.classList.remove('selected'));
            el.classList.add('selected');
            document.getElementById('con-topic-input').value = value;
        }

        function updateCount(el) {
            const count = el.value.length;
            const counter = document.getElementById('conCharCount');
            counter.textContent = count + ' / 1000';
            counter.classList.toggle('warn', count > 800);
        }

        function handleSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('conSubmitBtn');
            btn.textContent = 'Sending…';
            btn.disabled = true;
            btn.style.opacity = '0.7';

            // Simulate async send — replace with real $.ajax / fetch to your controller
            setTimeout(() => {
                document.getElementById('conForm').style.display = 'none';
                const success = document.getElementById('conSuccess');
                success.style.display = 'flex';
            }, 1200);
        }

        function resetForm() {
            document.getElementById('conForm').reset();
            document.getElementById('conCharCount').textContent = '0 / 1000';
            document.querySelectorAll('.con-chip').forEach(c => c.classList.remove('selected'));
            document.getElementById('con-topic-input').value = '';
            const btn = document.getElementById('conSubmitBtn');
            btn.innerHTML = 'Send Message <span class="btn-arrow">→</span>';
            btn.disabled = false;
            btn.style.opacity = '1';
            document.getElementById('conForm').style.display = 'flex';
            document.getElementById('conSuccess').style.display = 'none';
        }

        // ── FAQ ACCORDION ──
        function toggleFaq(btn) {
            const item = btn.closest('.con-faq-item');
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.con-faq-item.open').forEach(i => i.classList.remove('open'));
            if (!isOpen) item.classList.add('open');
        }
    </script>
}
