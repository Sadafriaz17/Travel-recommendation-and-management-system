@{
    ViewBag.Title = "About";
}

@{
    Html.RenderAction("Index", "navbar", new { pageName = "About-Index" });
}


<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">

            <!-- Image Side -->
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s" style="min-height: 400px;">
                <div class="position-relative h-100">
                    <img class="img-fluid position-absolute w-100 h-100"
                         src="~/content/frontend/travel-agency-html-template/img/travelimage3.jpg"
                         alt="About Us" style="object-fit: cover;">
                </div>
            </div>

            <!-- Text Side -->
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.3s">
                <h6 class="section-title bg-white text-start text-primary pe-3">About Us</h6>
                <h1 class="mb-4">Welcome to <span class="text-primary">SmartTour</span></h1>
                <p class="mb-4">
                    SmartTour is a modern tour package management system that brings travel and technology together.
                    We provide worldwide tour packages, hotel & flight bookings, and complete travel planning — all in one place.
                </p>

                <!-- Always visible text -->
                <p class="mb-4">
                    With AI-powered smart packing lists, personalized package recommendations, and an integrated travel store,
                    we make sure your journey is smooth, enjoyable, and stress-free.
                </p>

                <!-- Collapsible hidden content -->
                <div class="collapse" id="aboutMore">
                    <p class="mb-4">
                        Our mission is to simplify travel by combining expert planning with cutting-edge AI.
                        Whether you are traveling solo, with family, or in a group, we ensure comfort, affordability, and memorable experiences.
                    </p>
                    <p class="mb-4">
                        From destination guides to 24/7 support, SmartTour is your trusted partner for stress-free travel.
                    </p>
                </div>

                <!-- Button to toggle collapse -->
                <a class="btn btn-primary py-3 px-5 mt-2" data-bs-toggle="collapse" href="#aboutMore" role="button" aria-expanded="false" aria-controls="aboutMore">
                    Read More
                </a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
