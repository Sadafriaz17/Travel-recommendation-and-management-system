@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        /* ============================================================
NEXVOY — Home Page Scripts
============================================================ */


        /* ─────────────────────────────────────────
           1. 3D EARTH GLOBE (Three.js)
        ───────────────────────────────────────── */

        var canvas = document.getElementById('hero-3d-canvas');

        if (canvas && typeof THREE !== 'undefined') {

            // --- Scene setup ---
            var scene = new THREE.Scene();
            var camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            var renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });

            scene.fog = new THREE.FogExp2(0x020205, 0.0006);
            camera.position.set(0, 0.3, 4.2);
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            // --- Textures ---
            var loader = new THREE.TextureLoader();
            var base = 'https://threejs.org/examples/textures/planets/';

            var earthMat = new THREE.MeshPhongMaterial({
                map: loader.load(base + 'earth_atmos_2048.jpg'),
                specularMap: loader.load(base + 'earth_specular_2048.jpg'),
                normalMap: loader.load(base + 'earth_normal_2048.jpg'),
                specular: new THREE.Color('grey'),
                shininess: 5,
                normalScale: new THREE.Vector2(0.8, 0.8)
            });

            var cloudMat = new THREE.MeshPhongMaterial({
                map: loader.load(base + 'earth_clouds_1024.png'),
                transparent: true,
                opacity: 0.12,
                blending: THREE.AdditiveBlending,
                depthWrite: false
            });

            // --- Earth & clouds ---
            var earth = new THREE.Mesh(new THREE.SphereGeometry(1.1, 128, 128), earthMat);
            var clouds = new THREE.Mesh(new THREE.SphereGeometry(1.12, 128, 128), cloudMat);
            scene.add(earth, clouds);

            // --- Stars ---
            var starPositions = new Float32Array(4000 * 3);
            for (var i = 0; i < starPositions.length; i++) {
                // x, y spread wide; z pulled back so stars sit behind globe
                starPositions[i] = i % 3 === 2
                    ? (Math.random() - 0.5) * 600 - 200
                    : (Math.random() - 0.5) * 2500;
            }
            var starGeo = new THREE.BufferGeometry();
            starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
            var stars = new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 'white', size: 0.3, transparent: true, opacity: 0.7 }));
            scene.add(stars);

            // --- Orbit rings ---
            function makeRing(radius, color, opacity) {
                var pts = [];
                for (var j = 0; j <= 200; j++) {
                    var a = (j / 200) * Math.PI * 2;
                    pts.push(new THREE.Vector3(Math.cos(a) * radius, 0, Math.sin(a) * radius));
                }
                return new THREE.LineLoop(
                    new THREE.BufferGeometry().setFromPoints(pts),
                    new THREE.LineBasicMaterial({ color: color, transparent: true, opacity: opacity })
                );
            }

            var ring1 = makeRing(1.55, 0x4deeEA, 0.3);
            var ring2 = makeRing(1.75, 0xa855f7, 0.25);
            scene.add(ring1, ring2);

            // --- Lighting ---
            var sun = new THREE.DirectionalLight('white', 1.5);
            sun.position.set(5, 3, 5);
            scene.add(
                new THREE.AmbientLight(0x111122),
                sun,
                new THREE.PointLight(0x445566, 0.8, 10, 2),
                new THREE.PointLight(0x4deeEA, 0.4, 5, 2)
            );

            // --- Mouse parallax ---
            var targetX = 0, targetY = 0;
            var currentX = 0, currentY = 0;

            document.getElementById('hero').addEventListener('mousemove', function (e) {
                targetX = (e.clientX / window.innerWidth - 0.5) * 0.8;
                targetY = (e.clientY / window.innerHeight - 0.5) * 0.4;
            });

            // --- Animation loop ---
            var time = 0;

            function animate() {
                requestAnimationFrame(animate);
                time += 0.004;

                // Smooth mouse follow
                currentX += (targetX - currentX) * 0.04;
                currentY += (targetY - currentY) * 0.04;

                // Spin globe
                earth.rotation.y = currentX + time * 0.5;
                earth.rotation.x = currentY * 0.2;
                clouds.rotation.y = currentX + time * 0.6;
                clouds.rotation.x = currentY * 0.2;

                // Animate rings
                ring1.rotation.y += 0.0008;
                ring1.rotation.x = Math.sin(time * 0.4) * 0.1;
                ring2.rotation.z += 0.001;
                ring2.rotation.x = Math.cos(time * 0.3) * 0.1;

                // Drift stars
                stars.rotation.y += 0.0003;
                stars.rotation.x += 0.0002;

                renderer.render(scene, camera);
            }

            animate();

            // --- Resize handler ---
            window.addEventListener('resize', function () {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        }


        /* ─────────────────────────────────────────
           2. COUNT-UP ANIMATION
           Elements with data-count="500" count up
           from 0 when scrolled into view
        ───────────────────────────────────────── */

        var countObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;

                var el = entry.target;
                var target = parseInt(el.dataset.count);
                if (!target) return;

                var suffix = el.textContent.replace(/\d/g, ''); // keep "+", "%", etc.
                var current = 0;
                var step = target / 60;

                var timer = setInterval(function () {
                    current = Math.min(current + step, target);
                    el.textContent = Math.round(current) + suffix;
                    if (current >= target) clearInterval(timer);
                }, 16);

                countObserver.unobserve(el); // run only once
            });
        }, { threshold: 0.5 });

        document.querySelectorAll('[data-count]').forEach(function (el) {
            countObserver.observe(el);
        });


        /* ─────────────────────────────────────────
           3. SCROLL REVEAL ANIMATION
           Elements with data-reveal fade in when
           they enter the viewport
        ───────────────────────────────────────── */

        var revealObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('revealed');
                revealObserver.unobserve(entry.target); // reveal only once
            });
        }, { threshold: 0.12 });

        document.querySelectorAll('[data-reveal]').forEach(function (el) {
            revealObserver.observe(el);
        });
    </script>

}