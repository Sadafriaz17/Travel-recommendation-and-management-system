@{
    ViewBag.Title = "Home";
    ViewBag.ActivePage = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ═══════════════════════════════════════════
        NEXVOY — HOME PAGE STYLES
        ═══════════════════════════════════════════ */

        /* ── Global color & font tokens ── */
        :root {
            /* Backgrounds */
            --bg-deep: black;
            --bg-surface: rgba(black, 0.85); /* dark card/panel surface */
            --glass: rgba(0, 0, 25, 0.6); /* frosted-glass panels */
            --glass-hi: rgba(30, 30, 38, 0.85); /* brighter frosted glass */
            /* Borders */
            --border: rgba(white, 0.08);
            --border-hi: rgba(white, 0.14);
            /* Brand colors */
            --accent: cyan;
            --accent2: blueviolet;
            --purple: violet;
            /* Text */
            --text: whitesmoke;
            --sub: rgba(245, 245, 245, 0.5); /* muted / secondary text */
            /* Fonts */
            --font-head: 'Inter', system-ui, sans-serif;
            --font-body: 'Inter', system-ui, sans-serif;
            --font-mono: 'SF Mono', 'JetBrains Mono', monospace;
            /* Smooth easing curve for animations */
            --ease-out: cubic-bezier(0.4, 0, 0.2, 1);
        }


        /* ── Reset ── */
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg-deep);
            color: var(--text);
            font-family: var(--font-body);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }


        /* ════════════════════════════════
        SHARED / REUSABLE UTILITIES
        ════════════════════════════════ */

        /* Animated gradient text (cyan → purple → violet) */
        .text-gradient {
            background: linear-gradient(135deg, cyan 0%, blueviolet 50%, violet 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            background-size: 200% 200%;
            animation: gradShift 4s ease infinite;
        }

        @@keyframes gradShift {
            0%, 100% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }
        }

        /* Small uppercase monospace label above section headings */
        .nex-badge {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: cyan;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        /* Big bold section heading */
        .section-title {
            font-family: var(--font-head);
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.1;
        }

        /* Centered wrapper for badge + title */
        .section-head {
            text-align: center;
            margin-bottom: 4rem;
            padding: 0 2.5rem;
        }

        /* Scroll-reveal: fade up when .revealed is added by JS */
        [data-reveal] {
            opacity: 0;
            transform: translateY(32px);
            transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
        }

            [data-reveal].revealed {
                opacity: 1;
                transform: translateY(0);
            }


        /* ════════════════════════
        HERO SECTION
        ════════════════════════ */

        #hero {
            position: relative;
            height: 100vh;
            min-height: 700px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: radial-gradient(ellipse at 50% 50%, #0f0f1e 0%, #06060c 50%, black 100%);
        }

        /* Three.js canvas sits behind everything */
        #hero-3d-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            z-index: 0;
        }

        /* Soft colored glow over the 3D canvas */
        .hero-glow {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: radial-gradient(ellipse 50% 50% at 50% 40%, rgba(0, 255, 255, 0.08) 0%, transparent 50%), radial-gradient(ellipse 40% 40% at 70% 60%, rgba(138, 43, 226, 0.06) 0%, transparent 50%), radial-gradient(ellipse 35% 35% at 30% 70%, rgba(0, 255, 255, 0.04) 0%, transparent 40%);
        }

        /* Headline / button area */
        .hero-content {
            position: relative;
            z-index: 3;
            text-align: center;
            padding: 0 1.5rem;
            max-width: 960px;
        }

        /* Small label above headline */
        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: cyan;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin-bottom: 1.75rem;
            opacity: 0;
            animation: fadeUp 0.8s ease 0.3s forwards;
        }

        /* Decorative line beside eyebrow text */
        .hero-eyebrow-line {
            width: 32px;
            height: 1px;
            background: cyan;
            box-shadow: 0 0 8px cyan;
        }

        /* Main hero headline */
        .hero-h1 {
            font-family: var(--font-head);
            font-size: clamp(3rem, 7vw, 6.5rem);
            font-weight: 800;
            line-height: 0.95;
            letter-spacing: -0.04em;
            margin-bottom: 1.75rem;
            opacity: 0;
            animation: fadeUp 0.9s ease 0.5s forwards;
        }

        /* Subtitle below headline */
        .hero-sub {
            font-size: clamp(1rem, 2vw, 1.2rem);
            color: var(--sub);
            max-width: 600px;
            margin: 0 auto 2.5rem;
            line-height: 1.65;
            font-weight: 300;
            opacity: 0;
            animation: fadeUp 0.9s ease 0.7s forwards;
        }

        /* CTA buttons container */
        .hero-ctas {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            opacity: 0;
            animation: fadeUp 0.9s ease 0.9s forwards;
        }

        /* Primary CTA — filled gradient pill */
        .btn-hero-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.9rem 2rem;
            border-radius: 100px;
            background: linear-gradient(135deg, cyan, blueviolet);
            color: black;
            font-weight: 700;
            font-size: 0.9rem;
            font-family: var(--font-body);
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.35s var(--ease-out);
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.3);
        }

            .btn-hero-primary:hover {
                transform: translateY(-3px) scale(1.04);
                box-shadow: 0 0 50px rgba(0, 255, 255, 0.5);
                color: black;
            }

        /* Secondary CTA — ghost/glass pill */
        .btn-hero-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.9rem 2rem;
            border-radius: 100px;
            border: 1px solid var(--border);
            background: var(--glass);
            backdrop-filter: blur(12px);
            color: var(--text);
            font-size: 0.9rem;
            font-family: var(--font-body);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s var(--ease-out);
        }

            .btn-hero-secondary:hover {
                border-color: cyan;
                background: rgba(0, 255, 255, 0.1);
                transform: translateY(-2px);
            }

        /* Scroll-down hint */
        .hero-scroll-hint {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            z-index: 3;
            opacity: 0;
            animation: fadeUp 1s ease 1.3s forwards;
            cursor: pointer;
        }

            .hero-scroll-hint span {
                font-family: var(--font-mono);
                font-size: 0.65rem;
                color: var(--sub);
                letter-spacing: 0.2em;
                text-transform: uppercase;
            }

        /* Mouse/scroll icon */
        .hero-scroll-icon {
            width: 24px;
            height: 40px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            padding-top: 6px;
        }

        /* Bouncing dot inside scroll icon */
        .hero-scroll-dot {
            width: 4px;
            height: 8px;
            background: cyan;
            border-radius: 2px;
            animation: scrollDotHome 2s ease-in-out infinite;
        }

        @@keyframes scrollDotHome {
            0%, 100% {
                transform: translateY(0);
                opacity: 1;
            }

            50% {
                transform: translateY(12px);
                opacity: 0.3;
            }
        }

        /* Shared fade-up entrance animation */
        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* ════════════════════════
        STATS BAR
        ════════════════════════ */

        #stats-bar {
            position: relative;
            z-index: 5;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(20px);
            padding: 2.5rem 0;
        }

        /* Four equal columns */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 2.5rem;
        }

        .stat-item {
            text-align: center;
            padding: 0 2rem;
            border-right: 1px solid var(--border);
        }

            .stat-item:last-child {
                border-right: none;
            }

        /* Big number */
        .stat-num {
            font-family: var(--font-head);
            font-size: clamp(2rem, 3.5vw, 3rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1;
            margin-bottom: 0.4rem;
        }

        /* Label under number */
        .stat-label {
            font-size: 0.8rem;
            color: var(--sub);
            font-family: var(--font-mono);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }


        /* ════════════════════════════
        DESTINATIONS SCROLL STRIP
        ════════════════════════════ */

        #destinations-section {
            padding: 8rem 0;
            overflow: hidden;
        }

        .dest-scroll-wrapper {
            overflow: hidden;
            padding: 1rem 0 3rem;
        }

        /* Horizontal scrollable row */
        .dest-track {
            display: flex;
            gap: 1.5rem;
            padding: 0 2.5rem;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            cursor: grab;
        }

            .dest-track::-webkit-scrollbar {
                display: none;
            }

        /* Individual destination card */
        .dest-card-home {
            flex: 0 0 340px;
            height: 460px;
            border-radius: 24px;
            overflow: hidden;
            position: relative;
            border: 1px solid var(--border);
            scroll-snap-align: start;
            transition: transform 0.4s var(--ease-out), box-shadow 0.4s;
            cursor: pointer;
        }

            .dest-card-home:hover {
                transform: scale(1.03) translateY(-8px);
                box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 40px rgba(0, 255, 255, 0.1);
            }

        /* Destination photo */
        .dest-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease, filter 0.5s;
            filter: brightness(0.7);
        }

        .dest-card-home:hover .dest-img {
            transform: scale(1.08);
            filter: brightness(0.5);
        }

        /* Dark gradient overlay + text */
        .dest-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, transparent 50%);
            padding: 2rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        /* Country label */
        .dest-country {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: cyan;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: 0.4rem;
        }

        /* Destination name */
        .dest-name {
            font-family: var(--font-head);
            font-size: 1.8rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            line-height: 1.1;
            margin-bottom: 0.75rem;
        }

        /* Info chips — slide up on hover */
        .dest-meta-home {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.8rem;
            color: var(--sub);
            opacity: 0;
            transform: translateY(12px);
            transition: all 0.35s 0.1s;
        }

        .dest-card-home:hover .dest-meta-home {
            opacity: 1;
            transform: translateY(0);
        }

        /* "Explore →" button — slides up on hover */
        .dest-explore {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 1rem;
            padding: 0.5rem 1.2rem;
            border-radius: 100px;
            background: cyan;
            color: black;
            font-weight: 700;
            font-size: 0.8rem;
            text-decoration: none;
            opacity: 0;
            transform: translateY(12px);
            transition: all 0.35s 0.15s;
        }

        .dest-card-home:hover .dest-explore {
            opacity: 1;
            transform: translateY(0);
        }


        /* ════════════════════════
        AI TRIP GENERATOR
        ════════════════════════ */

        #ai-generator {
            padding: 8rem 0;
            background: linear-gradient(180deg, transparent 0%, rgba(0, 255, 255, 0.02) 50%, transparent 100%);
        }

        .ai-gen-wrapper {
            max-width: 900px;
            margin: 0 auto;
            padding: 0 2.5rem;
        }

        /* Frosted glass card */
        .ai-gen-card {
            background: var(--glass);
            border: 1px solid var(--border-hi);
            border-radius: 28px;
            padding: 3rem;
            backdrop-filter: blur(30px);
            position: relative;
            overflow: hidden;
        }

            /* Decorative glow blob in top-right */
            .ai-gen-card::before {
                content: '';
                position: absolute;
                top: -100px;
                right: -100px;
                width: 400px;
                height: 400px;
                background: radial-gradient(ellipse, rgba(0, 255, 255, 0.08) 0%, transparent 70%);
                pointer-events: none;
            }

        .ai-gen-title {
            font-family: var(--font-head);
            font-size: clamp(1.8rem, 3vw, 2.5rem);
            font-weight: 800;
            letter-spacing: -0.03em;
            margin-bottom: 0.75rem;
        }

        .ai-gen-sub {
            color: var(--sub);
            font-size: 0.95rem;
            margin-bottom: 2.5rem;
        }

        /* 3-column input grid */
        .ai-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 1.25rem;
            margin-bottom: 1.5rem;
        }

        /* Label + input pair */
        .ai-field {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

            .ai-field label {
                font-size: 0.75rem;
                font-family: var(--font-mono);
                color: var(--sub);
                letter-spacing: 0.1em;
                text-transform: uppercase;
            }

        /* Inputs & selects */
        .ai-input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 0.8rem 1rem;
            color: var(--text);
            font-size: 0.9rem;
            font-family: var(--font-body);
            outline: none;
            transition: border-color 0.25s, background 0.25s;
            width: 100%;
        }

            .ai-input:focus {
                border-color: cyan;
                background: rgba(0, 255, 255, 0.05);
            }

            .ai-input option {
                background: #111;
            }

        /* Generate button */
        .ai-generate-btn {
            width: 100%;
            padding: 1rem;
            border-radius: 14px;
            background: linear-gradient(135deg, cyan, blueviolet);
            border: none;
            color: black;
            font-size: 1rem;
            font-weight: 700;
            font-family: var(--font-body);
            cursor: pointer;
            transition: all 0.35s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

            .ai-generate-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 40px rgba(0, 255, 255, 0.3);
            }

        /* Result panel — hidden until .visible added by JS */
        .ai-result {
            margin-top: 2rem;
            padding: 1.5rem;
            background: rgba(0, 255, 255, 0.04);
            border: 1px solid rgba(0, 255, 255, 0.15);
            border-radius: 16px;
            display: none;
        }

            .ai-result.visible {
                display: block;
                animation: fadeUp 0.4s var(--ease-out);
            }


        /* ── AI Result: Recommendation blocks ── */

        /* "SIMULATED RESULT" banner */
        .ai-simulation-header {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: blueviolet;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 1.25rem;
            padding: 0.5rem 1rem;
            background: rgba(138, 43, 226, 0.08);
            border: 1px solid rgba(138, 43, 226, 0.2);
            border-radius: 8px;
        }

        /* Title & meta row */
        .ai-result-header {
            text-align: center;
            margin-bottom: 1.75rem;
        }

        .ai-result-header-title {
            font-family: var(--font-head);
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: var(--text);
            margin-bottom: 0.4rem;
        }

        .ai-result-header-meta {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--sub);
            letter-spacing: 0.05em;
        }

        /* Recommendation blocks stack */
        .ai-reco-blocks {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

        /* Individual recommendation row */
        .ai-reco-block {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 1.25rem 1.5rem;
            transition: border-color 0.3s, background 0.3s;
            position: relative;
        }

            .ai-reco-block:hover {
                border-color: rgba(0, 255, 255, 0.25);
                background: rgba(0, 255, 255, 0.03);
            }

        /* "#1 Match" rank label */
        .ai-reco-block-rank {
            font-family: var(--font-head);
            font-size: 1.1rem;
            font-weight: 800;
            color: cyan;
            margin-bottom: 0.5rem;
        }

        /* City name */
        .ai-reco-block-name {
            font-family: var(--font-head);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.6rem;
            color: var(--text);
        }

        /* 2-column label/value grid */
        .ai-reco-block-details {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.3rem 2rem;
            font-size: 0.82rem;
            color: var(--sub);
            line-height: 1.7;
        }

            .ai-reco-block-details .detail-label {
                font-family: var(--font-mono);
                font-size: 0.68rem;
                color: rgba(255, 255, 255, 0.35);
                letter-spacing: 0.06em;
                text-transform: uppercase;
                display: inline-block;
                width: 85px;
            }

            .ai-reco-block-details .detail-value {
                color: var(--text);
                font-weight: 500;
            }

                .ai-reco-block-details .detail-value.highlight {
                    color: cyan;
                    font-weight: 600;
                }

                .ai-reco-block-details .detail-value.match-score {
                    background: linear-gradient(135deg, cyan, blueviolet);
                    -webkit-background-clip: text;
                    background-clip: text;
                    color: transparent;
                    font-weight: 700;
                    font-size: 0.9rem;
                }

        /* Ghost medal numbers top-right of each block */
        .ai-reco-block-medal {
            position: absolute;
            top: 1.25rem;
            right: 1.5rem;
            font-size: 1.4rem;
        }

        .ai-reco-block:nth-child(1) .ai-reco-block-medal::after {
            content: "1";
            font-family: var(--font-head);
            font-weight: 800;
            color: rgba(0, 255, 255, 0.3);
            font-size: 2.5rem;
        }

        .ai-reco-block:nth-child(2) .ai-reco-block-medal::after {
            content: "2";
            font-family: var(--font-head);
            font-weight: 800;
            color: rgba(138, 43, 226, 0.25);
            font-size: 2.2rem;
        }

        .ai-reco-block:nth-child(3) .ai-reco-block-medal::after {
            content: "3";
            font-family: var(--font-head);
            font-weight: 800;
            color: rgba(192, 132, 252, 0.25);
            font-size: 2rem;
        }


        /* ════════════════════════
        PRODUCTS SECTION
        ════════════════════════ */

        #products-section {
            padding: 8rem 0;
        }

        /* 3-column product grid */
        .products-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            padding: 0 2.5rem;
            max-width: 1280px;
            margin: 0 auto;
        }

        /* Dark glass product card */
        .product-card {
            background: linear-gradient(180deg, rgba(30, 30, 45, 0.6) 0%, rgba(20, 20, 30, 0.8) 100%);
            border: 1px solid var(--border);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.4s var(--ease-out);
            position: relative;
            display: flex;
            flex-direction: column;
        }

            /* Gradient border on hover */
            .product-card::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 24px;
                padding: 1px;
                background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), transparent 50%, rgba(138, 43, 226, 0.1));
                -webkit-mask: linear-gradient(white 0 0) content-box, linear-gradient(white 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                z-index: 1;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.4s;
            }

            .product-card:hover {
                border-color: rgba(0, 255, 255, 0.2);
                transform: translateY(-8px);
                box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);
            }

                .product-card:hover::before {
                    opacity: 1;
                }

        /* Product image */
        .product-img-wrap {
            position: relative;
            height: 220px;
            overflow: hidden;
        }

            .product-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease, filter 0.4s;
                filter: brightness(0.85);
            }

        .product-card:hover .product-img-wrap img {
            transform: scale(1.08);
            filter: brightness(0.7);
        }

        /* Category chip on image */
        .product-category-badge {
            position: absolute;
            top: 1rem;
            left: 1rem;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: cyan;
            background: rgba(0, 0, 0, 0.7);
            border: 1px solid rgba(0, 255, 255, 0.3);
            backdrop-filter: blur(10px);
            padding: 0.3rem 0.75rem;
            border-radius: 100px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            z-index: 2;
        }

        /* Card body */
        .product-body {
            padding: 1.75rem;
            display: flex;
            flex-direction: column;
            flex: 1;
            position: relative;
            z-index: 2;
        }

        .product-title {
            font-family: var(--font-head);
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .product-desc {
            font-size: 0.83rem;
            color: var(--sub);
            line-height: 1.6;
            margin-bottom: 1.25rem;
            flex: 1;
        }

        /* Star rating row */
        .product-rating {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
        }

        .product-stars {
            color: cyan;
            font-size: 0.8rem;
            letter-spacing: 2px;
        }

        .product-rating-count {
            font-size: 0.75rem;
            color: var(--sub);
            font-family: var(--font-mono);
        }

        /* Price + buttons row */
        .product-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.75rem;
        }

        .product-price {
            font-family: var(--font-head);
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: cyan;
        }

            .product-price span {
                font-size: 0.75rem;
                font-weight: 400;
                color: var(--sub);
            }

        .product-actions {
            display: flex;
            gap: 0.5rem;
        }

        /* "Details" ghost button */
        .btn-product-details {
            padding: 0.5rem 1rem;
            border-radius: 100px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text);
            font-size: 0.78rem;
            font-family: var(--font-body);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s;
            white-space: nowrap;
        }

            .btn-product-details:hover {
                border-color: cyan;
                background: rgba(0, 255, 255, 0.08);
            }

        /* "Add to Cart" gradient button */
        .btn-product-cart {
            padding: 0.5rem 1rem;
            border-radius: 100px;
            background: linear-gradient(135deg, cyan, blueviolet);
            border: none;
            color: black;
            font-size: 0.78rem;
            font-weight: 700;
            font-family: var(--font-body);
            cursor: pointer;
            transition: all 0.25s;
            white-space: nowrap;
        }

            .btn-product-cart:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(0, 255, 255, 0.3);
            }


        /* ════════════════════════
        PACKAGES SECTION
        ════════════════════════ */

        #packages-section {
            padding: 8rem 0;
        }

        /* 3-column layout */
        .pkg-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            padding: 0 2.5rem;
            max-width: 1280px;
            margin: 0 auto;
        }

        /* Package card */
        .pkg-card {
            background: linear-gradient(180deg, rgba(30, 30, 45, 0.6) 0%, rgba(20, 20, 30, 0.8) 100%);
            border: 1px solid var(--border);
            border-radius: 24px;
            overflow: hidden;
            transition: all 0.4s var(--ease-out);
            position: relative;
        }

            .pkg-card::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 24px;
                padding: 1px;
                background: linear-gradient(135deg, rgba(0, 255, 255, 0.1), transparent 50%, rgba(138, 43, 226, 0.1));
                -webkit-mask: linear-gradient(white 0 0) content-box, linear-gradient(white 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                z-index: 1;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.4s;
            }

            .pkg-card:hover {
                border-color: rgba(0, 255, 255, 0.2);
                transform: translateY(-8px);
                box-shadow: 0 40px 80px rgba(0, 0, 0, 0.5);
            }

                .pkg-card:hover::before {
                    opacity: 1;
                }

            /* Featured package — purple tint */
            .pkg-card.featured {
                border-color: rgba(0, 255, 255, 0.2);
                background: linear-gradient(180deg, rgba(40, 30, 60, 0.6) 0%, rgba(20, 20, 35, 0.8) 100%);
            }

        /* Package image */
        .pkg-img-wrap {
            position: relative;
            height: 220px;
            overflow: hidden;
        }

            .pkg-img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease;
                filter: brightness(0.75);
            }

        .pkg-card:hover .pkg-img-wrap img {
            transform: scale(1.08);
        }

        /* Type chip on image */
        .pkg-type-badge {
            position: absolute;
            top: 1rem;
            left: 1rem;
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: cyan;
            background: rgba(0, 0, 0, 0.7);
            border: 1px solid rgba(0, 255, 255, 0.3);
            backdrop-filter: blur(10px);
            padding: 0.3rem 0.75rem;
            border-radius: 100px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            z-index: 2;
        }

        /* "Featured" chip top-right */
        .pkg-featured-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-family: var(--font-mono);
            font-size: 0.62rem;
            background: linear-gradient(135deg, cyan, blueviolet);
            color: black;
            font-weight: 700;
            padding: 0.28rem 0.65rem;
            border-radius: 100px;
            z-index: 2;
        }

        /* Package card body */
        .pkg-body {
            padding: 1.75rem;
            position: relative;
            z-index: 2;
        }

        .pkg-title {
            font-family: var(--font-head);
            font-size: 1.2rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .pkg-desc {
            font-size: 0.83rem;
            color: var(--sub);
            line-height: 1.6;
            margin-bottom: 1.5rem;
        }

        /* 3 mini stat tiles */
        .pkg-specs {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.6rem;
            margin-bottom: 1.5rem;
        }

        .pkg-spec {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 0.6rem;
            text-align: center;
        }

        .pkg-spec-val {
            font-family: var(--font-head);
            font-size: 0.95rem;
            font-weight: 700;
            color: cyan;
        }

        .pkg-spec-key {
            font-size: 0.6rem;
            color: var(--sub);
            font-family: var(--font-mono);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* Price + Book button row */
        .pkg-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1.2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        /* Price — gradient text */
        .pkg-price {
            font-family: var(--font-head);
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            background: linear-gradient(135deg, cyan, blueviolet);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

            .pkg-price span {
                font-size: 0.65rem;
                font-weight: 400;
                color: var(--sub);
                -webkit-text-fill-color: var(--sub);
            }

        /* "Book Now" button */
        .pkg-book-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.65rem 1.3rem;
            border-radius: 100px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text);
            font-size: 0.78rem;
            font-weight: 600;
            font-family: var(--font-body);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s;
        }

            .pkg-book-btn:hover {
                background: rgba(255, 255, 255, 0.1);
                transform: translateY(-2px);
            }

        /* Featured card — gradient book button */
        .pkg-card.featured .pkg-book-btn {
            background: linear-gradient(135deg, cyan, blueviolet);
            border-color: transparent;
            color: white;
            box-shadow: 0 4px 15px rgba(0, 255, 255, 0.3);
        }

            .pkg-card.featured .pkg-book-btn:hover {
                box-shadow: 0 8px 25px rgba(0, 255, 255, 0.4);
            }


        /* ════════════════════════
        TESTIMONIALS
        ════════════════════════ */

        #testimonials {
            padding: 8rem 0;
        }

        /* 3-column grid */
        .testi-track {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            padding: 0 2.5rem;
            max-width: 1280px;
            margin: 0 auto;
        }

        .testi-card {
            background: linear-gradient(180deg, rgba(30, 30, 45, 0.6) 0%, rgba(20, 20, 30, 0.8) 100%);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2rem;
            transition: all 0.3s var(--ease-out);
        }

            .testi-card:hover {
                border-color: rgba(138, 43, 226, 0.3);
                transform: translateY(-4px);
            }

        .testi-stars {
            color: cyan;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            letter-spacing: 2px;
        }

        .testi-text {
            font-size: 0.92rem;
            color: var(--sub);
            line-height: 1.75;
            margin-bottom: 1.5rem;
            font-style: italic;
        }

        /* Avatar + name row */
        .testi-author {
            display: flex;
            align-items: center;
            gap: 0.85rem;
        }

        .testi-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border);
        }

        .testi-name {
            font-weight: 600;
            font-size: 0.875rem;
        }

        .testi-role {
            font-size: 0.75rem;
            color: var(--sub);
            font-family: var(--font-mono);
        }


        /* ════════════════════════
        FINAL CTA SECTION
        ════════════════════════ */

        #cta-section {
            padding: 8rem 2.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            /* Soft purple glow background */
            #cta-section::before {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 800px;
                height: 600px;
                background: radial-gradient(ellipse, rgba(138, 43, 226, 0.08) 0%, transparent 70%);
                pointer-events: none;
            }

        /* Large headline */
        .cta-title {
            font-family: var(--font-head);
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1;
            margin-bottom: 1.5rem;
            position: relative;
            z-index: 1;
        }

        .cta-sub {
            font-size: 1.05rem;
            color: var(--sub);
            margin-bottom: 3rem;
            position: relative;
            z-index: 1;
        }

        .cta-btns {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }


        /* ════════════════════════════════
        RESPONSIVE BREAKPOINTS
        ════════════════════════════════ */

        /* Tablet: ~1024px — 2-column grids */
        @@media (max-width: 1024px) {
            .pkg-grid,
            .products-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .testi-track {
                grid-template-columns: 1fr 1fr;
            }

            .ai-reco-block-details,
            .ai-form-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        /* Mobile: ~768px — single column */
        @@media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .stat-item {
                border-right: none;
                border-bottom: 1px solid var(--border);
                padding: 1.5rem 0;
            }

                .stat-item:nth-child(odd) {
                    border-right: 1px solid var(--border);
                }

                .stat-item:last-child {
                    border-bottom: none;
                }

            .ai-form-grid,
            .ai-reco-block-details,
            .pkg-grid,
            .products-grid,
            .testi-track {
                grid-template-columns: 1fr;
            }

            #cta-section {
                padding: 5rem 1.5rem;
            }

            .ai-reco-block-medal {
                position: static;
                text-align: right;
                margin-bottom: 0.5rem;
            }
        }
    </style>
}

<!-- ═══════════════════════════════════
     HERO
═══════════════════════════════════ -->
<section id="hero">
    <canvas id="hero-3d-canvas"></canvas>
    <div class="hero-glow"></div>

    <div class="hero-content">
        <h1 class="hero-h1">
            Travel <span class="text-gradient">Beyond</span><br />
            Destinations
        </h1>
        <p class="hero-sub">
            AI-powered immersive journeys, personalized planning, and smart exploration — all in one intelligent platform.
        </p>
        <div class="hero-ctas">
            <a href="~/Destinations/Index" class="btn-hero-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                Start Exploring
            </a>
            <a href="~/AiDreamTrip/Index" class="btn-hero-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83" /></svg>
                Generate Smart Tour
            </a>
        </div>
    </div>


</section>

<!-- ═══════════════════════════════════
     STATS BAR
═══════════════════════════════════ -->
<div id="stats-bar">
    <div class="stats-grid">
        <div class="stat-item" data-reveal>
            <div class="stat-num text-gradient" data-count="500">0+</div>
            <div class="stat-label">Destinations</div>
        </div>
        <div class="stat-item" data-reveal>
            <div class="stat-num text-gradient" data-count="12000">0+</div>
            <div class="stat-label">Happy Travelers</div>
        </div>
        <div class="stat-item" data-reveal>
            <div class="stat-num text-gradient" data-count="98">0%</div>
            <div class="stat-label">Satisfaction Rate</div>
        </div>
        <div class="stat-item" data-reveal>
            <div class="stat-num text-gradient" data-count="45">0+</div>
            <div class="stat-label">AI Travel Plans/Day</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════
     DESTINATIONS SCROLL
═══════════════════════════════════ -->
<section id="destinations-section">
    <div class="section-head" data-reveal>
        <div class="nex-badge">Destinations</div>
        <h2 class="section-title" style="margin-top:1.25rem">
            Explore the<br /><span class="text-gradient">World's Wonders</span>
        </h2>
        <p style="color:var(--sub);margin-top:1rem;font-size:0.95rem">Hand-picked destinations with AI-powered recommendations</p>
    </div>
    <div class="dest-scroll-wrapper">
        <div class="dest-track" id="destTrack">
            @{
                var destinations = new[] {
                    new { name="Santorini",    country="Greece",       img="https://images.unsplash.com/photo-1613395877344-13d4a8e0d49e?w=800", budget="$1,200", days="7"  },
                    new { name="Kyoto",        country="Japan",        img="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=800", budget="$1,800", days="10" },
                    new { name="Maldives",     country="Indian Ocean", img="https://images.unsplash.com/photo-1514282401047-d79a71a590e8?w=800", budget="$3,500", days="7"  },
                    new { name="Machu Picchu", country="Peru",         img="https://images.unsplash.com/photo-1580502304784-8985b7eb7260?w=800", budget="$1,600", days="12" },
                    new { name="Amalfi Coast", country="Italy",        img="https://images.unsplash.com/photo-1520175480921-4edfa2983e0f?w=800", budget="$2,100", days="8"  },
                    new { name="Bali",         country="Indonesia",    img="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800", budget="$900",   days="9"  },
                    new { name="Dubai",        country="UAE",          img="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=800", budget="$2,400", days="6"  },
                };
            }
            @foreach (var d in destinations)
            {
                <div class="dest-card-home">
                    <img class="dest-img" src="@d.img&q=80&fit=crop&w=680&h=920" alt="@d.name" loading="lazy" />
                    <div class="dest-overlay">
                        <div class="dest-country">@d.country</div>
                        <div class="dest-name">@d.name</div>
                        <div class="dest-meta-home">
                            <span>From @d.budget</span>
                            <span>·</span>
                            <span>@d.days days</span>
                        </div>
                        <a href="~/Destinations/Index" class="dest-explore">Explore →</a>
                    </div>
                </div>
            }
        </div>
    </div>
    <div style="text-align:center;margin-top:2rem">
        <a href="~/Destinations/Index" class="btn-hero-secondary">View All Destinations</a>
    </div>
</section>

<!-- ═══════════════════════════════════
     AI PACKAGE GENERATOR
═══════════════════════════════════ -->
<section id="ai-generator">
    <div class="ai-gen-wrapper">
        <div style="text-align:center;margin-bottom:3rem" data-reveal>
            <div class="nex-badge">AI Intelligence</div>
            <h2 class="section-title" style="margin-top:1.25rem">
                Generate Your<br /><span class="text-gradient">Dream Trip</span>
            </h2>
            <p style="color:var(--sub);margin-top:1rem">Tell our AI your preferences. Get a bespoke travel plan in seconds.</p>
        </div>
        <div class="ai-gen-card" data-reveal>
            <div class="nex-badge" style="margin-bottom:1.5rem">✦ AI Powered</div>
            <h3 class="ai-gen-title">Smart Tour Generator</h3>
            <p class="ai-gen-sub">Let our AI craft the perfect journey for you</p>
            <div class="ai-form-grid">
                <div class="ai-field">
                    <label>Destination</label>
                    <select class="ai-input" id="ai-dest">
                        <option>Europe</option>
                        <option>Asia</option>
                        <option>USA</option>
                        <option>South-Asia</option>
                        <option>Africa</option>
                    </select>
                </div>
                <div class="ai-field">
                    <label>Temperature</label>
                    <input type="text" class="ai-input" id="ai-temp" placeholder="e.g. 20°C, warm, tropical..." />
                </div>
                <div class="ai-field">
                    <label>Duration</label>
                    <select class="ai-input" id="ai-duration">
                        <option>5 Days</option>
                        <option>7 Days</option>
                        <option>10 Days</option>
                        <option>14 Days</option>
                    </select>
                </div>
                <div class="ai-field">
                    <label>Travel Style</label>
                    <select class="ai-input" id="ai-style">
                        <option>Luxury</option>
                        <option>Adventure</option>
                        <option>Cultural</option>
                        <option>Family</option>
                        <option>Romantic</option>
                        <option>Budget</option>
                    </select>
                </div>
                <div class="ai-field">
                    <label>Budget Range</label>
                    <select class="ai-input" id="ai-budget">
                        <option>Under $1,000</option>
                        <option>$1,000 – $2,500</option>
                        <option>$2,500 – $5,000</option>
                        <option>$5,000+</option>
                    </select>
                </div>
            </div>
            <button class="ai-generate-btn" onclick="generateTour()">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z" /><path d="M2 17l10 5 10-5" /><path d="M2 12l10 5 10-5" /></svg>
                Generate AI Trip
            </button>
            <div class="ai-result" id="ai-result">
                <div class="ai-simulation-header">AI SIMULATION MODE</div>
                <div class="ai-result-header">
                    <div class="ai-result-header-title">TOP 5 RECOMMENDED DESTINATIONS</div>
                    <div class="ai-result-header-meta" id="ai-result-meta">Budget: Mid-range | Preferred temp: -5.0&deg;C | Region: Europe</div>
                </div>
                <div class="ai-reco-blocks" id="ai-reco-blocks"></div>
                <div style="margin-top:1.5rem;display:flex;gap:1rem">
                    <a href="~/Packages/Index" class="btn-hero-primary" style="flex:1;justify-content:center">Book This Package</a>
                    <button onclick="generateTour()" style="flex:1;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:100px;color:var(--text);font-family:var(--font-body);cursor:pointer;transition:all 0.25s;padding:0.9rem;font-size:0.9rem" onmouseover="this.style.borderColor='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'">Regenerate</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════
     TRAVEL PRODUCTS
═══════════════════════════════════ -->
<section id="products-section">
    <div class="section-head" data-reveal>
        <div class="nex-badge">Travel Essentials</div>
        <h2 class="section-title" style="margin-top:1.25rem">
            Popular <span class="text-gradient">Travel Products</span>
        </h2>
        <p style="color:var(--sub);margin-top:1rem;font-size:0.95rem">
            Explore essential travel products and accessories for your journey.
        </p>
    </div>
    <div class="products-grid">
        @{
            var products = new[] {
