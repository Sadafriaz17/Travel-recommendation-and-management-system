        /* ── LIGHTBOX ── */
        .lightbox-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.92);
            z-index: 3000;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

            .lightbox-overlay.active {
                display: flex;
            }

        .lightbox-content {
            position: relative;
            max-width: 1100px;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .lightbox-content img {
                max-width: 100%;
                max-height: 80vh;
                border-radius: 12px;
                object-fit: contain;
                display: block;
            }

        .lightbox-close {
            position: absolute;
            top: -3rem;
            right: 0;
            background: none;
            border: none;
            color: #fff;
            font-size: 1.6rem;
            cursor: pointer;
        }

        .lightbox-nav {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.2);
            color: #fff;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
        }

            .lightbox-nav:hover {
                background: rgba(255,255,255,0.25);
            }

        .lightbox-prev {
            left: -60px;
        }

        .lightbox-next {
            right: -60px;
        }

        .lightbox-counter {
            position: absolute;
            bottom: -2.5rem;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255,255,255,0.7);
            font-size: 0.85rem;
        }

        @@media (max-width: 768px) {
            .lightbox-prev {
                left: 0.5rem;
            }

            .lightbox-next {
                right: 0.5rem;
            }

            .lightbox-nav {
                width: 36px;
                height: 36px;
            }
        }

        /* ── VIEW ALL PHOTOS MODAL ── */
        .viewall-modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.75);
            z-index: 2500;
            padding: 2rem 1rem;
            overflow-y: auto;
        }

            .viewall-modal-overlay.active {
                display: block;
            }

        .viewall-modal {
            max-width: 1000px;
            margin: 0 auto;
            background: #fff;
            border-radius: 18px;
            padding: 2rem;
            position: relative;
        }

            .viewall-modal h3 {
                font-size: 1.3rem;
                font-weight: 700;
                margin-bottom: 1.5rem;
            }

        .viewall-modal-close {
            position: absolute;
            top: 1.4rem;
            right: 1.4rem;
            background: none;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            color: #6b7280;
        }

        .viewall-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

            .viewall-grid img {
                width: 100%;
                height: 200px;
                object-fit: cover;
                border-radius: 12px;
                cursor: pointer;
                transition: 0.2s;
                display: block;
            }

                .viewall-grid img:hover {
                    opacity: 0.85;
                }

        @@media (max-width: 768px) {
            .viewall-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 900px) {
            .pkg-detail-grid {
                grid-template-columns: 1fr;
            }

            .pkg-sidebar {
                position: static;
            }
        }

        @@media (max-width: 768px) {
            .pkg-gallery {
                grid-template-columns: 1fr 1fr;
                grid-template-rows: repeat(3, 140px);
                height: auto;
            }

            .pkg-gallery-center {
                grid-column: 1 / 3;
                grid-row: 1 / 2;
            }

            .included-grid {
                grid-template-columns: 1fr;
            }

            .pkg-meta-row {
                gap: 1.2rem;
            }
        }
    </style>
}

<!-- HERO SECTION -->
<section class="pkg-detail-hero-wrapper" style="background-image: url('@heroImgUrl');">
    <div class="pkg-detail-hero-content">
        <div class="pkg-detail-hero-breadcrumb">
            <a href="@Url.Action("Index", "Home")">Home</a>
            <i class="fas fa-chevron-right"></i>
            <a href="@Url.Action("Index", "Package")">Packages</a>
            <i class="fas fa-chevron-right"></i>
            <span>@Model.PackageName</span>
        </div>
        <div class="pkg-detail-hero-badges">
            <span class="pkg-badge dark">@packageTypeName</span>
            @if (isPopular)
            {
                <span class="pkg-badge">★ Popular</span>
            }
        </div>
        <h1>@Model.PackageName</h1>
        <div class="pkg-hero-location">
            <i class="fas fa-map-pin"></i> @destinationName
        </div>
    </div>
</section>

<div class="container">

    <!-- GALLERY -->
    <div class="pkg-gallery">
        @for (int i = 0; i < 5; i++)
        {
            int imgIndex = i < resolvedImageUrls.Count ? i : resolvedImageUrls.Count - 1;
            string imgUrl = resolvedImageUrls[imgIndex];
            bool isLastTile = (i == 4);
            string cssClass = i == 2 ? "pkg-gallery-item pkg-gallery-center" : "pkg-gallery-item";

            <div class="@cssClass" onclick="openLightbox(@imgIndex)">
                <img src="@imgUrl" alt="@Model.PackageName"
                     onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.jpg")';" />
                @if (isLastTile)
                {
                    <button type="button" class="pkg-gallery-viewall-btn" onclick="event.stopPropagation(); openViewAllModal();">
                        <i class="fas fa-images"></i>
                        <span>View all @resolvedImageUrls.Count photos</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="pkg-detail-desc">
        <p>@Model.Description</p>
    </div>

    <div class="pkg-meta-row">
        <div class="pkg-meta-item">
            <i class="fas fa-calendar-alt"></i>
            <div>
                <div class="pkg-meta-label">Duration</div>
                <div class="pkg-meta-value">@Model.DurationDays Days</div>
            </div>
        </div>
        <div class="pkg-meta-item">
            <i class="fas fa-users"></i>
            <div>
                <div class="pkg-meta-label">Group Size</div>
                <div class="pkg-meta-value">Up to @Model.People</div>
            </div>
        </div>
        <div class="pkg-meta-item">
            <i class="fas fa-hiking"></i>
            <div>
                <div class="pkg-meta-label">Package Type</div>
                <div class="pkg-meta-value">@packageTypeName</div>
            </div>
        </div>
        <div class="pkg-meta-item">
            <i class="fas fa-bed"></i>
            <div>
                <div class="pkg-meta-label">Accommodation</div>
                <div class="pkg-meta-value">@nights Nights</div>
            </div>
        </div>
    </div>

    <div class="pkg-detail-grid">

        <!-- LEFT: MAIN CONTENT -->
        <div class="pkg-detail-main">

            <div class="pkg-detail-section">
                <h2>Trip Overview</h2>
                <p>@Model.Description</p>
                <p>
                    This @Model.DurationDays-day journey to @destinationName is designed to give you a genuine
                    taste of the destination — blending guided experiences with free time to explore at your
                    own pace. Ideal for groups of up to @Model.People traveler(s).
                </p>
            </div>

            <div class="pkg-detail-section">
                <h2>What's Included</h2>
                <div class="included-grid">
                    @foreach (var item in includedItems)
                    {
                        <div class="included-item">
                            <i class="fas fa-check-circle"></i>
                            <span>@item</span>
                        </div>
                    }
                </div>
            </div>

            @if (itinerary.Any())
            {
                <div class="pkg-detail-section">
                    <h2>Itinerary</h2>
                    @foreach (var day in itinerary)
                    {
                        <details class="itinerary-day" @(day == itinerary.First() ? "open" : "")>
                            <summary>
                                <div class="itinerary-day-label">
                                    <div class="itinerary-day-num">D@(day.DayNumber)</div>
                                    <span>@(!string.IsNullOrWhiteSpace(day.Title) ? day.Title : "Day " + day.DayNumber)</span>
                                </div>
                                <i class="fas fa-chevron-down"></i>
                            </summary>
                            <div class="itinerary-day-body">
                                @if (!string.IsNullOrWhiteSpace(day.Description))
                                {
                                    <p>@day.Description</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(day.ActivityDescription))
                                {
                                    <p><strong>Activities:</strong> @day.ActivityDescription</p>
                                }
                                <div class="itinerary-tags">
                                    @if (!string.IsNullOrWhiteSpace(day.Location))
                                    {
                                        <span class="itinerary-tag"><i class="fas fa-map-marker-alt"></i> @day.Location</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(day.Accommodation))
                                    {
                                        <span class="itinerary-tag"><i class="fas fa-bed"></i> @day.Accommodation</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(day.MealsProvided))
                                    {
                                        <span class="itinerary-tag"><i class="fas fa-utensils"></i> @day.MealsProvided</span>
                                    }
                                </div>
                            </div>
                        </details>
                    }
                </div>
            }
        </div>

        <!-- RIGHT: STICKY BOOKING SIDEBAR -->
        <div class="pkg-sidebar">
            @if (isPopular)
            {
                <span class="pkg-sidebar-badge">TOP SELLER</span>
            }
            <div class="pkg-sidebar-days">@Model.DurationDays Days</div>
            <div class="pkg-sidebar-route">@destinationName</div>

            <div class="pkg-sidebar-price">$@Model.Price.ToString("N0")</div>
            <div class="pkg-sidebar-price-sub">USD per person</div>

            <div class="pkg-sidebar-info">
                <i class="fas fa-calendar-check"></i>
                Listed @((Model.UpdatedDate ?? Model.CreatedDate).ToString("MMM dd, yyyy"))
            </div>
            <div class="pkg-sidebar-info">
                <i class="fas fa-ticket-alt"></i>
                Trip Code: PKG-@Model.PackageId
            </div>

            <div class="pkg-sidebar-rating">
                ★★★★★ <span>4.8 rating</span>
            </div>

            <div class="pkg-sidebar-icons">
                <div class="pkg-sidebar-icon-item">
                    <i class="fas fa-plane"></i>
                    <div>Flight</div>
                    <small>On request</small>
                </div>
                <div class="pkg-sidebar-icon-item">
                    <i class="fas fa-hotel"></i>
                    <div>Hotels</div>
                    <small>Included</small>
                </div>
                <div class="pkg-sidebar-icon-item">
                    <i class="fas fa-user-tie"></i>
                    <div>Tours</div>
                    <small>Expert guide</small>
                </div>
            </div>

            <button type="button" class="pkg-book-now-btn" onclick="openBookingModal()">Book Now</button>
        </div>

    </div>
</div>

<!-- BOOKING MODAL -->
<div class="booking-modal-overlay" id="bookingModalOverlay">
    <div class="booking-modal">
        <button type="button" class="booking-modal-close" onclick="closeBookingModal()">
            <i class="fas fa-times"></i>
        </button>
        <h3>Book "@Model.PackageName"</h3>

        @using (Html.BeginForm("CreateBooking", "Package", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="PackageId" value="@Model.PackageId" />

            <div class="booking-field">
                <label>Travel Date</label>
                <input type="date" name="BookingDate" required min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="booking-field">
                <label>Number of Travelers</label>
                <input type="number" name="NumberOfTravelers" min="1" max="@Model.People" value="1" required />
            </div>
            <div class="booking-field">
                <label>Contact Email</label>
                <input type="email" name="Email" required value="@(user != null ? user.Email : "")" />
            </div>
            <div class="booking-field">
                <label>Special Request (optional)</label>
                <textarea name="SpecialRequest" rows="3"></textarea>
            </div>

            <button type="submit" class="booking-submit-btn">Confirm Booking — $@Model.Price.ToString("N0")/person</button>
        }
    </div>
</div>

<!-- VIEW ALL PHOTOS MODAL -->
<div class="viewall-modal-overlay" id="viewAllModalOverlay">
    <div class="viewall-modal">
        <button type="button" class="viewall-modal-close" onclick="closeViewAllModal()">
            <i class="fas fa-times"></i>
        </button>
        <h3>All Photos — @Model.PackageName</h3>
        <div class="viewall-grid">
            @for (int i = 0; i < resolvedImageUrls.Count; i++)
            {
                <img src="@resolvedImageUrls[i]" alt="@Model.PackageName photo @(i + 1)"
                     onclick="closeViewAllModal(); openLightbox(@i);"
                     onerror="this.onerror=null;this.src='@Url.Content("~/images/no-image.jpg")';" />
            }
        </div>
    </div>
</div>

<!-- LIGHTBOX -->
<div class="lightbox-overlay" id="lightboxOverlay">
    <div class="lightbox-content">
        <button type="button" class="lightbox-close" onclick="closeLightbox()">
            <i class="fas fa-times"></i>
        </button>
        <button type="button" class="lightbox-nav lightbox-prev" onclick="lightboxPrev()">
            <i class="fas fa-chevron-left"></i>
        </button>
        <img id="lightboxImg" src="" alt="@Model.PackageName" />
        <button type="button" class="lightbox-nav lightbox-next" onclick="lightboxNext()">
            <i class="fas fa-chevron-right"></i>
        </button>
        <div class="lightbox-counter" id="lightboxCounter"></div>
    </div>
</div>

@section Scripts {
    <script>
        // All gallery image URLs, in order, rendered server-side
        var galleryImages = [@Html.Raw(galleryImagesJs)];
        var currentLightboxIndex = 0;

        function openLightbox(index) {
            if (!galleryImages.length) return;
            currentLightboxIndex = index;
            updateLightboxImage();
            document.getElementById('lightboxOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightboxOverlay').classList.remove('active');
            document.body.style.overflow = '';
        }

        function lightboxPrev() {
            currentLightboxIndex = (currentLightboxIndex - 1 + galleryImages.length) % galleryImages.length;
            updateLightboxImage();
        }

        function lightboxNext() {
            currentLightboxIndex = (currentLightboxIndex + 1) % galleryImages.length;
            updateLightboxImage();
        }

        function updateLightboxImage() {
            document.getElementById('lightboxImg').src = galleryImages[currentLightboxIndex];
            document.getElementById('lightboxCounter').textContent =
                (currentLightboxIndex + 1) + ' / ' + galleryImages.length;
        }

        function openViewAllModal() {
            document.getElementById('viewAllModalOverlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeViewAllModal() {
            document.getElementById('viewAllModalOverlay').classList.remove('active');
            document.body.style.overflow = '';
        }

        function openBookingModal() {
            document.getElementById('bookingModalOverlay').classList.add('active');
        }

        function closeBookingModal() {
            document.getElementById('bookingModalOverlay').classList.remove('active');
        }

        // Close modals when clicking outside their content
        document.getElementById('bookingModalOverlay').addEventListener('click', function (e) {
            if (e.target === this) closeBookingModal();
        });
        document.getElementById('viewAllModalOverlay').addEventListener('click', function (e) {
            if (e.target === this) closeViewAllModal();
        });
        document.getElementById('lightboxOverlay').addEventListener('click', function (e) {
            if (e.target === this) closeLightbox();
        });

        // Keyboard support for lightbox
        document.addEventListener('keydown', function (e) {
            var lightbox = document.getElementById('lightboxOverlay');
            if (!lightbox.classList.contains('active')) return;

            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') lightboxPrev();
            if (e.key === 'ArrowRight') lightboxNext();
        });

        @if (TempData["Message"] != null)
        {
            <text>alert('@Html.Raw(TempData["Message"])');</text>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <text>alert('@Html.Raw(TempData["ErrorMessage"])');</text>
        }
    </script>
}
