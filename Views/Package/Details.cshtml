@* =========================================
    PACKAGE DETAILS — Views/Package/Details.cshtml
    ========================================= *@
@model TourwebsiteFYP.DB_data_models.Package
@using System.Web

@{
    ViewBag.Title = Model.PackageName;
    ViewBag.ActivePage = "Packages";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Func<string, string> ResolveImg = (url) =>
    {
        if (string.IsNullOrWhiteSpace(url))
            return Url.Content("~/images/no-image.jpg");

        url = url.Replace('\\', '/');

        if (url.StartsWith("http://") || url.StartsWith("https://") || url.StartsWith("//"))
            return url;

        string path = url;
        if (!path.StartsWith("~/"))
        {
            path = path.StartsWith("/") ? "~" + path : "~/" + path;
        }

        string resolved = Url.Content(path);
        return resolved.Replace(" ", "%20");
    };

    var images = Model.PackageImages != null
        ? Model.PackageImages.Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl)).ToList()
        : new List<TourwebsiteFYP.DB_data_models.PackageImage>();

    // Resolved URLs for every image (used by lightbox + view-all modal)
    var resolvedImageUrls = images.Select(im => ResolveImg(im.ImageUrl)).ToList();
    if (!resolvedImageUrls.Any())
    {
        resolvedImageUrls.Add(Url.Content("~/images/no-image.jpg"));
    }

    // Safe JS array literal of all gallery image URLs
    var galleryImagesJs = string.Join(",", resolvedImageUrls.Select(u => "\"" + HttpUtility.JavaScriptStringEncode(u) + "\""));

    var itinerary = Model.PackageItineraries != null
        ? Model.PackageItineraries.OrderBy(i => i.DayNumber).ToList()
        : new List<TourwebsiteFYP.DB_data_models.PackageItinerary>();

    var packageTypeName = Model.PackageType != null ? Model.PackageType.TypeName : "Tour";
    var isPopular = packageTypeName.ToLower() == "luxury" || packageTypeName.ToLower() == "adventure";
    var destinationName = Model.Destination != null ? Model.Destination.Name : "Unknown Destination";
    var nights = Model.DurationDays > 1 ? Model.DurationDays - 1 : 0;

    var user = ViewBag.User as TourwebsiteFYP.DB_data_models.User;

    var heroImgUrl = resolvedImageUrls.First();

    // Build a "What's Included" list dynamically from real data
    var accommodations = itinerary
        .Where(i => !string.IsNullOrWhiteSpace(i.Accommodation))
        .Select(i => i.Accommodation)
        .Distinct()
        .ToList();

    var mealsIncluded = itinerary
        .Where(i => !string.IsNullOrWhiteSpace(i.MealsProvided))
        .Select(i => i.MealsProvided)
        .Distinct()
        .ToList();

    var includedItems = new List<string>();

    if (Model.DurationDays > 0)
    {
        includedItems.Add($"{Model.DurationDays} days / {nights} nights guided tour");
    }

    if (accommodations.Any())
    {
        includedItems.Add($"{nights} nights accommodation ({string.Join(", ", accommodations.Take(2))})");
    }
    else
    {
        includedItems.Add($"{nights} nights hotel accommodation");
    }

    if (mealsIncluded.Any())
    {
        includedItems.Add($"Meals included: {string.Join(", ", mealsIncluded)}");
    }

    includedItems.Add("Expert local guide throughout");
    includedItems.Add($"Group size up to {Model.People} guest(s)");

    if (itinerary.Any(i => !string.IsNullOrWhiteSpace(i.Location)))
    {
        includedItems.Add("All in-destination transfers");
    }
}

@section HeadStyles {
