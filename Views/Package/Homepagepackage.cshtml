@model IEnumerable<TourwebsiteFYP.DB_data_models.Package>
@{
    Layout = null;
}

<style>
    .pkg-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .pkg-card {
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.04);
        transition: 0.3s;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        height: 100%;
        border: 1px solid #f3f4f6;
    }

        .pkg-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        }

        .pkg-card .img-wrap {
            position: relative;
            height: 240px;
            flex-shrink: 0;
            overflow: hidden;
        }

            .pkg-card .img-wrap img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.4s;
            }

        .pkg-card:hover .img-wrap img {
            transform: scale(1.05);
        }

        .pkg-card .pkg-body {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

            .pkg-card .pkg-body h4 {
                font-weight: 600;
                font-size: 1.1rem;
                margin-bottom: 0.5rem;
            }

            .pkg-card .pkg-body p {
                color: #6b7280;
                font-size: 0.85rem;
                line-height: 1.4;
                flex-grow: 1;
                margin-bottom: 1.5rem;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

        /* Price capsule at bottom center */
        .pkg-card .pkg-footer {
            background: #1a1a1a;
            color: #fff;
            padding: 0.6rem 1.5rem;
            border-radius: 40px;
            display: inline-block;
            align-self: center;
            font-weight: 600;
            font-size: 0.9rem;
        }

    @@media (max-width: 1024px) {
        .pkg-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .pkg-grid {
            grid-template-columns: 1fr;
            max-width: 400px;
            margin: 0 auto;
        }
    }
</style>

<div class="pkg-grid">
    @if (Model != null && Model.Count() > 0)
    {
        foreach (var item in Model)
        {
            var images = item.PackageImages?.ToList() ?? new List<TourwebsiteFYP.DB_data_models.PackageImage>();
            var mainImg = images.FirstOrDefault()?.ImageUrl ?? "~/images/no-image.jpg";

            <a href="@Url.Action("Details", "Package", new { id = item.PackageId })" class="pkg-card">
                <div class="img-wrap">
                    <img src="@Url.Content(mainImg)" alt="@item.PackageName" loading="lazy" />
                </div>
                <div class="pkg-body">
                    <h4>@item.PackageName</h4>
                    <p>@item.Description</p>
                    <div class="pkg-footer">$@item.Price.ToString("N0")</div>
                </div>
            </a>
        }
    }
    else
    {
        <div class="text-center py-5" style="grid-column: span 3;">
            <p style="color: #6b7280;">No packages available at the moment.</p>
        </div>
    }
</div>