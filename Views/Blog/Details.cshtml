@model TourwebsiteFYP.DB_data_models.Blog
@{
    ViewBag.Title = Model.Title;
    ViewBag.ActivePage = "Blog";

    var img = !string.IsNullOrEmpty(Model.FeaturedImage) ? Model.FeaturedImage : "/images/background.jpg";
    var date = Model.CreatedDate?.ToString("MMMM dd, yyyy") ?? "";
    var author = Model.User?.FullName ?? "NEXVOY Editor";
    var initial = author.Substring(0, 1).ToUpper();
    var relatedBlogs = ViewBag.RelatedBlogs as IList<TourwebsiteFYP.DB_data_models.Blog>;
}

@section HeadStyles {
    <style>
        /* ── Hero (same proportions as layout hero-wrapper) ── */
        .blog-detail-hero {
            position: relative;
            width: 100%;
            min-height: 85vh;
            background-image: url('@img');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding-top: 100px;
            padding-bottom: 80px;
        }

        .blog-detail-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.72) 100%);
            pointer-events: none;
        }

        .blog-detail-hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #fff;
            max-width: 860px;
            padding: 0 1.5rem;
        }

        .blog-detail-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            backdrop-filter: blur(6px);
            color: #fff;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 0.4rem 1rem;
            border-radius: 50px;
            margin-bottom: 1.5rem;
        }

        .blog-detail-hero h1 {
            font-size: clamp(2rem, 4.5vw, 3.5rem);
            font-weight: 800;
            line-height: 1.15;
            letter-spacing: -0.02em;
            margin-bottom: 2rem;
            text-shadow: 0 4px 16px rgba(0,0,0,0.3);
        }

        .blog-detail-meta {
            display: inline-flex;
            align-items: center;
            gap: 1.25rem;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.2);
            backdrop-filter: blur(8px);
            padding: 0.65rem 1.5rem;
            border-radius: 50px;
            font-size: 0.88rem;
            color: rgba(255,255,255,0.9);
            font-weight: 500;
        }

        .blog-detail-meta .meta-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255,255,255,0.25);
            border: 1.5px solid rgba(255,255,255,0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .blog-detail-meta .meta-sep {
            opacity: 0.4;
            font-size: 1rem;
        }

        /* ── Content Card ── */
        .blog-content-outer {
            background: var(--bg-body, #f8f9fa);
            padding-bottom: 6rem;
        }

        .blog-content-card {
            max-width: 780px;
            margin: -5rem auto 0;
            background: #fff;
            border-radius: 20px;
            padding: 3.5rem 4rem;
            box-shadow: 0 24px 60px rgba(0,0,0,0.1);
            position: relative;
            z-index: 10;
        }

        .blog-content-card .blog-content-body {
            font-size: 1.05rem;
            line-height: 1.85;
            color: #374151;
        }

        .blog-content-body p { margin-bottom: 1.5rem; }
        .blog-content-body h2, .blog-content-body h3 {
            color: #111;
            font-weight: 700;
            margin: 2.5rem 0 1rem;
            line-height: 1.3;
        }
        .blog-content-body h2 { font-size: 1.65rem; }
        .blog-content-body h3 { font-size: 1.35rem; }
        .blog-content-body img {
            max-width: 100%;
            border-radius: 12px;
            margin: 2rem 0;
            box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        }
        .blog-content-body blockquote {
            border-left: 4px solid var(--accent, #0d9488);
            margin: 2rem 0;
            padding: 1rem 1.5rem;
            background: #f0fdfb;
            border-radius: 0 8px 8px 0;
            font-style: italic;
            color: #374151;
        }

        /* ── Footer bar ── */
        .blog-post-footer {
            margin-top: 3.5rem;
            padding-top: 2rem;
            border-top: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .btn-back-blog {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            font-size: 0.9rem;
            color: #111;
            background: #f3f4f6;
            padding: 0.6rem 1.2rem;
            border-radius: 50px;
            text-decoration: none;
            transition: 0.2s;
        }
        .btn-back-blog:hover { background: #111; color: #fff; }

        .share-group {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .share-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4b5563;
            font-size: 0.95rem;
            text-decoration: none;
            transition: 0.2s;
        }
        .share-icon:hover { background: #111; color: #fff; }

        /* ── Author box ── */
        .blog-author-box {
            margin-top: 3rem;
            background: #f8f9fb;
            border-radius: 16px;
            padding: 2rem;
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }
        .blog-author-avatar-lg {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0d9488, #0f766e);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff;
            flex-shrink: 0;
        }
        .blog-author-box h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; color: #111; }
        .blog-author-box p { font-size: 0.88rem; color: #6b7280; margin: 0; }

        /* ── Related posts ── */
        .related-section {
            max-width: 1100px;
            margin: 4rem auto 0;
            padding: 0 2rem 4rem;
        }
        .related-section h3 {
            font-size: 1.6rem;
            font-weight: 700;
            margin-bottom: 2rem;
            color: #111;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e5e7eb;
        }
        .related-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem;
        }
        .related-card {
            display: flex;
            gap: 1rem;
            align-items: center;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            padding: 1.1rem;
            text-decoration: none;
            color: inherit;
            transition: 0.2s;
        }
        .related-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.07); }
        .related-card img {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 10px;
            flex-shrink: 0;
        }
        .related-card-body h4 {
            font-size: 0.98rem;
            font-weight: 700;
            line-height: 1.35;
            margin-bottom: 0.4rem;
            color: #111;
        }
        .related-card-body span {
            font-size: 0.78rem;
            color: #6b7280;
        }

        @@media (max-width: 768px) {
            .blog-detail-hero h1 { font-size: 2rem; }
            .blog-content-card { padding: 2rem 1.5rem; margin-top: -3rem; }
            .related-grid { grid-template-columns: 1fr; }
            .blog-author-box { flex-direction: column; text-align: center; }
        }
    </style>
}

<!-- ═══ HERO ═══ -->
<section class="blog-detail-hero">
    <div class="blog-detail-hero-content">
        <div class="blog-detail-tag">
            <i class="fas fa-feather-alt"></i> Travel Story
        </div>
        <h1>@Model.Title</h1>
        <div class="blog-detail-meta">
            <div class="meta-avatar">@initial</div>
            <span>@author</span>
            <span class="meta-sep">|</span>
            <i class="fas fa-calendar-alt" style="opacity:0.7;font-size:0.8rem;"></i>
            <span>@date</span>
        </div>
    </div>
</section>

<!-- ═══ CONTENT ═══ -->
<div class="blog-content-outer">
    <div class="container">
        <article class="blog-content-card">
            <div class="blog-content-body">
                @Html.Raw(Model.Content?.Replace("\n", "<br/>") ?? "<p>No content available for this article.</p>")
            </div>

            <!-- Author Box -->
            <div class="blog-author-box">
                <div class="blog-author-avatar-lg">@initial</div>
                <div>
                    <h4>@author</h4>
                    <p>Travel writer & destination explorer at NEXVOY. Passionate about sharing authentic travel experiences from around the world.</p>
                </div>
            </div>

            <!-- Footer -->
            <div class="blog-post-footer">
                <a href="@Url.Action("Index", "Blog")" class="btn-back-blog">
                    <i class="fas fa-arrow-left"></i> Back to all stories
                </a>
                <div class="share-group">
                    <span>Share</span>
                    <a href="#" class="share-icon"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="share-icon"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="share-icon"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" class="share-icon"><i class="fas fa-link"></i></a>
                </div>
            </div>
        </article>
    </div>
</div>

<!-- ═══ RELATED POSTS ═══ -->
@if (relatedBlogs != null && relatedBlogs.Any())
{
    <div class="related-section">
        <h3>More from the blog</h3>
        <div class="related-grid">
            @foreach (var p in relatedBlogs)
            {
                var rImg = !string.IsNullOrEmpty(p.FeaturedImage) ? p.FeaturedImage : "/images/default-blog.jpg";
                <a href="@Url.Action("Details", "Blog", new { id = p.BlogId })" class="related-card">
                    <img src="@rImg" alt="@p.Title" onerror="this.src='/images/default-blog.jpg'" />
                    <div class="related-card-body">
                        <h4>@p.Title</h4>
                        <span><i class="fas fa-calendar-alt" style="margin-right:4px;"></i>@(p.CreatedDate?.ToString("MMM dd, yyyy"))</span>
                    </div>
                </a>
            }
        </div>
    </div>
}
