@{
    ViewBag.Title = "Create Account";
    ViewBag.ActivePage = "Signup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <style>
                /* ═══════════════════════════════════════════
           SIGNUP PAGE — NEXVOY
        ═══════════════════════════════════════════ */
                #signup-wrap {
                    min-height: 100vh;
                    display: flex;
                    align-items: stretch;
                    padding-top: 72px; /* navbar height */
                }

                /* Left Panel */
                .signup-left {
                    flex: 1;
                    position: relative;
                    overflow: hidden;
                    display: none;
                }

                @@media (min-width: 900px) {
                    .signup-left {
                        display: block;
                    }
                }

                .signup-left-img {
                    position: absolute;
                    inset: 0;
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    filter: brightness(0.35) saturate(1.4);
                }

                .signup-left-overlay {
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(135deg, rgba(77,238,234,0.08) 0%, rgba(0,0,0,0.6) 100%);
                }

                .signup-left-content {
                    position: absolute;
                    inset: 0;
                    display: flex;
                    flex-direction: column;
                    justify-content: flex-end;
                    padding: 3rem;
                }

                .signup-left-quote {
                    font-family: var(--font-head);
                    font-size: clamp(1.8rem, 2.5vw, 2.6rem);
                    font-weight: 800;
                    letter-spacing: -0.03em;
                    line-height: 1.1;
                    margin-bottom: 1rem;
                }

                .signup-left-sub {
                    font-size: 0.875rem;
                    color: var(--sub);
                    line-height: 1.65;
                    max-width: 360px;
                }

                .signup-left-stats {
                    display: flex;
                    gap: 2.5rem;
                    margin-top: 2rem;
                    padding-top: 2rem;
                    border-top: 1px solid var(--border);
                }

                .signup-left-stat-num {
                    font-family: var(--font-head);
                    font-size: 1.5rem;
                    font-weight: 800;
                    color: var(--accent);
                }

                .signup-left-stat-label {
                    font-size: 0.72rem;
                    color: var(--sub);
                    font-family: var(--font-mono);
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    margin-top: 2px;
                }

                /* Right Panel */
                .signup-right {
                    width: 100%;
                    max-width: 520px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 3rem 2.5rem;
                    background: var(--bg);
                    border-left: 1px solid var(--border);
                }

                @@media (min-width: 900px) {
                    .signup-right {
                        min-height: calc(100vh - 72px);
                    }
                }

                .signup-form-inner {
                    width: 100%;
                    max-width: 400px;
                }

                .signup-eyebrow {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    font-family: var(--font-mono);
                    font-size: 0.7rem;
                    color: var(--accent);
                    letter-spacing: 0.15em;
                    text-transform: uppercase;
                    margin-bottom: 1.5rem;
                }

                    .signup-eyebrow::before {
                        content: '';
                        width: 20px;
                        height: 1px;
                        background: var(--accent);
                        box-shadow: 0 0 6px var(--accent);
                    }

                .signup-title {
                    font-family: var(--font-head);
                    font-size: clamp(1.8rem, 3vw, 2.4rem);
                    font-weight: 800;
                    letter-spacing: -0.03em;
                    line-height: 1.1;
                    margin-bottom: 0.5rem;
                }

                .signup-subtitle {
                    color: var(--sub);
                    font-size: 0.875rem;
                    margin-bottom: 2.5rem;
                    line-height: 1.6;
                }

                /* Form Fields */
                .nex-form-group {
                    margin-bottom: 1.25rem;
                    position: relative;
                }

                .nex-form-label {
                    display: block;
                    font-size: 0.72rem;
                    font-family: var(--font-mono);
                    color: var(--sub);
                    letter-spacing: 0.1em;
                    text-transform: uppercase;
                    margin-bottom: 0.5rem;
                    transition: color 0.25s;
                }

                .nex-form-group:focus-within .nex-form-label {
                    color: var(--accent);
                }

                .nex-input-wrap {
                    position: relative;
                    display: flex;
                    align-items: center;
                }

                .nex-input-icon {
                    position: absolute;
                    left: 1rem;
                    color: rgba(255,255,255,0.3);
                    pointer-events: none;
                    transition: color 0.25s;
                    width: 16px;
                    height: 16px;
                    flex-shrink: 0;
                }

                .nex-form-group:focus-within .nex-input-icon {
                    color: var(--accent);
                }

                .nex-form-input {
                    width: 100%;
                    background: var(--glass);
                    border: 1px solid var(--border);
                    border-radius: 12px;
                    padding: 0.85rem 1rem 0.85rem 2.75rem;
                    color: var(--text);
                    font-size: 0.9rem;
                    font-family: var(--font-body);
                    outline: none;
                    transition: border-color 0.25s, background 0.25s, box-shadow 0.25s;
                }

                    .nex-form-input:focus {
                        border-color: var(--accent);
                        background: rgba(77,238,234,0.04);
                        box-shadow: 0 0 0 3px rgba(77,238,234,0.08);
                    }

                    .nex-form-input.error-input {
                        border-color: #f87171;
                        box-shadow: 0 0 0 3px rgba(248,113,113,0.08);
                    }

                    .nex-form-input::placeholder {
                        color: rgba(255,255,255,0.25);
                    }

                /* Password toggle */
                .pwd-toggle {
                    position: absolute;
                    right: 1rem;
                    background: none;
                    border: none;
                    color: rgba(255,255,255,0.3);
                    cursor: none;
                    padding: 4px;
                    transition: color 0.2s;
                    line-height: 0;
                }

                    .pwd-toggle:hover {
                        color: var(--sub);
                    }

                .nex-error-msg {
                    display: none;
                    font-size: 0.72rem;
                    color: #f87171;
                    margin-top: 0.4rem;
                    padding-left: 0.25rem;
                    font-family: var(--font-mono);
                }

                    .nex-error-msg.visible {
                        display: block;
                    }

                .nex-success-msg {
                    display: none;
                    font-size: 0.72rem;
                    color: var(--accent);
                    margin-top: 0.4rem;
                    padding-left: 0.25rem;
                    font-family: var(--font-mono);
                }

                    .nex-success-msg.visible {
                        display: block;
                    }

                /* Password strength */
                .pwd-strength-bar {
                    display: flex;
                    gap: 4px;
                    margin-top: 0.5rem;
                }

                .pwd-strength-seg {
                    height: 3px;
                    flex: 1;
                    border-radius: 2px;
                    background: var(--border);
                    transition: background 0.4s;
                }

                .pwd-strength-label {
                    font-size: 0.68rem;
                    color: var(--sub);
                    font-family: var(--font-mono);
                    margin-top: 0.3rem;
                    transition: color 0.3s;
                }

                /* Avatar upload */
                .avatar-upload-area {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    padding: 1rem;
                    border: 1px dashed var(--border);
                    border-radius: 12px;
                    cursor: none;
                    transition: border-color 0.25s, background 0.25s;
                    position: relative;
                    overflow: hidden;
                }

                    .avatar-upload-area:hover {
                        border-color: var(--accent);
                        background: rgba(77,238,234,0.03);
                    }

                .avatar-preview {
                    width: 48px;
                    height: 48px;
                    border-radius: 50%;
                    background: linear-gradient(135deg, var(--accent), var(--accent2));
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-family: var(--font-head);
                    font-weight: 700;
                    font-size: 1.1rem;
                    color: #000;
                    flex-shrink: 0;
                    overflow: hidden;
                }

                    .avatar-preview img {
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: none;
                    }

                .avatar-upload-text {
                    font-size: 0.82rem;
                    color: var(--sub);
                }

                    .avatar-upload-text span {
                        color: var(--accent);
                    }

                .avatar-upload-area input[type=file] {
                    position: absolute;
                    inset: 0;
                    opacity: 0;
                    cursor: pointer;
                    width: 100%;
                    height: 100%;
                }

                /* Terms */
                .terms-row {
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    margin: 1.5rem 0;
                }

                .nex-checkbox {
                    width: 18px;
                    height: 18px;
                    border: 1.5px solid var(--border);
                    border-radius: 4px;
                    background: var(--glass);
                    appearance: none;
                    -webkit-appearance: none;
                    cursor: none;
                    flex-shrink: 0;
                    margin-top: 1px;
                    transition: all 0.2s;
                    position: relative;
                }

                    .nex-checkbox:checked {
                        background: var(--accent);
                        border-color: var(--accent);
                    }

                        .nex-checkbox:checked::after {
                            content: '';
                            position: absolute;
                            top: 2px;
                            left: 5px;
                            width: 5px;
                            height: 9px;
                            border-right: 2px solid #000;
                            border-bottom: 2px solid #000;
                            transform: rotate(45deg);
                        }

                .terms-text {
                    font-size: 0.8rem;
                    color: var(--sub);
                    line-height: 1.6;
                }

                    .terms-text a {
                        color: var(--accent);
                        text-decoration: none;
                    }

                        .terms-text a:hover {
                            text-decoration: underline;
                        }

                /* Submit button */
                .signup-submit-btn {
                    width: 100%;
                    padding: 0.95rem;
                    border-radius: 12px;
                    border: none;
                    background: linear-gradient(135deg, var(--accent), var(--accent2));
                    color: #000;
                    font-size: 0.95rem;
                    font-weight: 700;
                    font-family: var(--font-body);
                    cursor: none;
                    transition: all 0.35s;
                    position: relative;
                    overflow: hidden;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 8px;
                }

                    .signup-submit-btn::after {
                        content: '';
                        position: absolute;
                        inset: 0;
                        background: linear-gradient(135deg, transparent, rgba(255,255,255,0.15));
                        opacity: 0;
                        transition: opacity 0.3s;
                    }

                    .signup-submit-btn:hover::after {
                        opacity: 1;
                    }

                    .signup-submit-btn:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 15px 40px rgba(77,238,234,0.3);
                    }

                    .signup-submit-btn:disabled {
                        opacity: 0.5;
                        cursor: default;
                        transform: none;
                    }

                .signup-divider {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    margin: 1.5rem 0;
                    font-size: 0.75rem;
                    color: rgba(255,255,255,0.25);
                    font-family: var(--font-mono);
                }

                    .signup-divider::before, .signup-divider::after {
                        content: '';
                        flex: 1;
                        height: 1px;
                        background: var(--border);
                    }

                .signup-footer-link {
                    text-align: center;
                    font-size: 0.85rem;
                    color: var(--sub);
                    margin-top: 1.5rem;
                }

                    .signup-footer-link a {
                        color: var(--accent);
                        text-decoration: none;
                        font-weight: 600;
                    }

                        .signup-footer-link a:hover {
                            text-decoration: underline;
                        }

                /* Features list on left panel */
                .feature-chips {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                    margin-top: 1.5rem;
                }

                .feature-chip {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                    padding: 0.3rem 0.75rem;
                    border: 1px solid var(--border);
                    border-radius: 100px;
                    font-size: 0.72rem;
                    color: var(--sub);
                    background: var(--glass);
                    font-family: var(--font-mono);
                }

                    .feature-chip::before {
                        content: '✦';
                        color: var(--accent);
                        font-size: 0.6rem;
                    }
    </style>
}

<div id="signup-wrap">
    <!-- Left Cinematic Panel -->
    <div class="signup-left">
        <img class="signup-left-img"
             src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1400&q=90&fit=crop"
             alt="Travel destination" />
        <div class="signup-left-overlay"></div>
        <div class="signup-left-content">
            @*<div class="nex-badge" style="margin-bottom:1.5rem;">AI + VR Travel Intelligence</div>*@
            <div class="signup-left-quote">
                Your Journey<br />Starts <span class="text-gradient">Here</span>
            </div>
            <p class="signup-left-sub">
                Join NEXVOY and unlock AI-powered travel planning, VR destination previews, and personalised smart itineraries crafted just for you.
            </p>
            <div class="feature-chips">
                <span class="feature-chip">AI Itineraries</span>
                <span class="feature-chip">Smart Packing</span>
                <span class="feature-chip">Smart Packages</span>
                <span class="feature-chip">24/7 Assistant</span>
                <span class="feature-chip">Vendor Marketplace</span>
            </div>
            <div class="signup-left-stats">
                <div>
                    <div class="signup-left-stat-num">500+</div>
                    <div class="signup-left-stat-label">Destinations</div>
                </div>
                <div>
                    <div class="signup-left-stat-num">12K+</div>
                    <div class="signup-left-stat-label">Happy Travelers</div>
                </div>
                <div>
                    <div class="signup-left-stat-num">4.9★</div>
                    <div class="signup-left-stat-label">App Rating</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Form Panel -->
    <div class="signup-right">
        <div class="signup-form-inner">
            <div class="signup-eyebrow">Create Account</div>
            <h1 class="signup-title">
                Join <span class="text-gradient">NEXVOY</span>
            </h1>
            <p class="signup-subtitle">Start planning your dream journeys with AI intelligence</p>

            @if (ViewBag.Message != null)
            {
                <div class="nex-alert nex-alert-danger" style="margin-bottom:1.5rem;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    @ViewBag.Message
                </div>
            }

            <form id="signupForm" enctype="multipart/form-data" method="post" action="/signup/index" novalidate>

                <!-- Full Name -->
                <div class="nex-form-group">
                    <label class="nex-form-label" for="FullName">Full Name</label>
                    <div class="nex-input-wrap">
                        <svg class="nex-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        <input type="text" id="FullName" name="FullName" class="nex-form-input"
                               placeholder="Enter your full name" required autocomplete="name" />
                    </div>
                    <span class="nex-error-msg" id="name-error">Please enter your full name</span>
                </div>

                <!-- Email -->
                <div class="nex-form-group">
                    <label class="nex-form-label" for="Email">Email Address</label>
                    <div class="nex-input-wrap">
                        <svg class="nex-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        <input type="email" id="Email" name="Email" class="nex-form-input"
                               placeholder="your@email.com" required autocomplete="email" />
                    </div>
                    <span class="nex-error-msg" id="email-error">Please enter a valid email address</span>
                </div>

                <!-- Password -->
                <div class="nex-form-group">
                    <label class="nex-form-label" for="PasswordHash">Password</label>
                    <div class="nex-input-wrap">
                        <svg class="nex-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        <input type="password" id="PasswordHash" name="PasswordHash" class="nex-form-input"
                               placeholder="Create a strong password" required autocomplete="new-password"
                               oninput="checkStrength(this.value)" />
                        <button type="button" class="pwd-toggle" onclick="togglePwd('PasswordHash', this)" aria-label="Show password">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                    <div class="pwd-strength-bar">
                        <div class="pwd-strength-seg" id="seg1"></div>
                        <div class="pwd-strength-seg" id="seg2"></div>
                        <div class="pwd-strength-seg" id="seg3"></div>
                        <div class="pwd-strength-seg" id="seg4"></div>
                    </div>
                    <div class="pwd-strength-label" id="pwd-label">Enter a password</div>
                    <span class="nex-error-msg" id="pwd-error">Password must be at least 8 characters</span>
                </div>

                <!-- Confirm Password -->
                <div class="nex-form-group">
                    <label class="nex-form-label" for="ConfirmPassword">Confirm Password</label>
                    <div class="nex-input-wrap">
                        <svg class="nex-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                        <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="nex-form-input"
                               placeholder="Repeat your password" required autocomplete="new-password"
                               oninput="checkMatch()" />
                        <button type="button" class="pwd-toggle" onclick="togglePwd('ConfirmPassword', this)" aria-label="Show password">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                    <span class="nex-error-msg" id="match-error">Passwords do not match</span>
                    <span class="nex-success-msg" id="match-ok">✦ Passwords match</span>
                </div>

                <!-- Profile Photo (optional) -->
                <div class="nex-form-group">
                    <label class="nex-form-label">Profile Photo <span style="color:rgba(255,255,255,0.25);font-size:0.65rem;">(optional)</span></label>
                    <div class="avatar-upload-area" id="avatar-area">
                        <div class="avatar-preview" id="avatar-preview">
                            N
                            <img id="avatar-img" src="" alt="" />
                        </div>
                        <div class="avatar-upload-text">
                            <div><span>Click to upload</span> your photo</div>
                            <div style="font-size:0.72rem;margin-top:2px;color:rgba(255,255,255,0.2);">JPG, PNG up to 5MB</div>
                        </div>
                        <input type="file" name="ProfileImage" accept="image/*"
                               onchange="previewAvatar(this)" />
                    </div>
                </div>

                <!-- Terms -->
                <div class="terms-row">
                    <input type="checkbox" id="terms" class="nex-checkbox" required />
                    <label for="terms" class="terms-text">
                        I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.
                        I consent to receiving personalised travel recommendations from NEXVOY.
                    </label>
                </div>

                <button type="submit" id="submitBtn" class="signup-submit-btn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    Create My Account
                </button>
            </form>

            <div class="signup-divider">or</div>

            <div class="signup-footer-link">
                Already have an account? <a href="~/Login/Index">Sign In →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
// ── Password strength checker ──
function checkStrength(val) {
    const segs = [document.getElementById('seg1'), document.getElementById('seg2'),
                  document.getElementById('seg3'), document.getElementById('seg4')];
    const label = document.getElementById('pwd-label');
    let score = 0;
    if (val.length >= 8) score++;
    if (/[A-Z]/.test(val)) score++;
    if (/[0-9]/.test(val)) score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const colors = ['#f87171', '#fbbf24', '#4DEEEA', '#34d399'];
    const labels = ['Too weak', 'Fair', 'Good', 'Strong ✦'];

    segs.forEach((s, i) => {
        s.style.background = i < score ? colors[score - 1] : 'var(--border)';
    });
    label.textContent = score > 0 ? labels[score - 1] : 'Enter a password';
    label.style.color = score > 0 ? colors[score - 1] : 'var(--sub)';
}

// ── Password match checker ──
function checkMatch() {
    const pwd = document.getElementById('PasswordHash').value;
    const conf = document.getElementById('ConfirmPassword').value;
    const errEl = document.getElementById('match-error');
    const okEl = document.getElementById('match-ok');
    const input = document.getElementById('ConfirmPassword');

    if (conf.length === 0) {
        errEl.classList.remove('visible');
        okEl.classList.remove('visible');
        input.classList.remove('error-input');
        return;
    }
    if (pwd !== conf) {
        errEl.classList.add('visible');
        okEl.classList.remove('visible');
        input.classList.add('error-input');
    } else {
        errEl.classList.remove('visible');
        okEl.classList.add('visible');
        input.classList.remove('error-input');
    }
}

// ── Toggle password visibility ──
function togglePwd(id, btn) {
    const input = document.getElementById(id);
    const isText = input.type === 'text';
    input.type = isText ? 'password' : 'text';
    btn.innerHTML = isText
        ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`
        : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
}

// ── Avatar preview ──
function previewAvatar(input) {
    if (!input.files || !input.files[0]) return;
    const reader = new FileReader();
    reader.onload = e => {
        const img = document.getElementById('avatar-img');
        img.src = e.target.result;
        img.style.display = 'block';
        // Update initial letter
        const name = document.getElementById('FullName').value;
        document.getElementById('avatar-preview').firstChild.textContent = '';
    };
    reader.readAsDataURL(input.files[0]);
}

// Update avatar initial as name is typed
document.getElementById('FullName').addEventListener('input', function() {
    const img = document.getElementById('avatar-img');
    if (img.style.display === 'none' || !img.src) {
        document.getElementById('avatar-preview').innerHTML =
            (this.value.trim()[0] || 'N').toUpperCase() +
            '<img id="avatar-img" src="" alt="" style="display:none;" />';
    }
});

// ── Form validation ──
document.getElementById('signupForm').addEventListener('submit', function(e) {
    let valid = true;

    const name = document.getElementById('FullName');
    const email = document.getElementById('Email');
    const pwd = document.getElementById('PasswordHash');
    const conf = document.getElementById('ConfirmPassword');
    const terms = document.getElementById('terms');

    // Name
    if (!name.value.trim()) {
        document.getElementById('name-error').classList.add('visible');
        name.classList.add('error-input');
        valid = false;
    } else {
        document.getElementById('name-error').classList.remove('visible');
        name.classList.remove('error-input');
    }

    // Email
    if (!email.value || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email.value)) {
        document.getElementById('email-error').classList.add('visible');
        email.classList.add('error-input');
        valid = false;
    } else {
        document.getElementById('email-error').classList.remove('visible');
        email.classList.remove('error-input');
    }

    // Password
    if (pwd.value.length < 8) {
        document.getElementById('pwd-error').classList.add('visible');
        pwd.classList.add('error-input');
        valid = false;
    } else {
        document.getElementById('pwd-error').classList.remove('visible');
        pwd.classList.remove('error-input');
    }

    // Match
    if (pwd.value !== conf.value) {
        document.getElementById('match-error').classList.add('visible');
        conf.classList.add('error-input');
        valid = false;
    }

    if (!terms.checked) {
        window.nexToast && window.nexToast('Please accept the Terms of Service to continue.');
        valid = false;
    }

    if (!valid) {
        e.preventDefault();
        // Scroll to first error
        const firstErr = document.querySelector('.nex-error-msg.visible');
        if (firstErr) firstErr.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="animation:spin 1s linear infinite"><path d="M21 12a9 9 0 1 1-6.22-8.56"/></svg> Creating Account...`;
    }
});

// Spin animation for loader
const style = document.createElement('style');
style.textContent = `@@keyframes spin { to { transform: rotate(360deg); } }`;
document.head.appendChild(style);
    </script>
}
