@model IEnumerable<TourwebsiteFYP.DB_data_models.Destination>

@{
    ViewBag.Title = "Destinations";
    ViewBag.ActivePage = "Destinations";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // CLEAN & RELIABLE IMAGE RESOLVER
    // Fixes the "Double Encoding" and "Special Character" issues for Destinations
    Func<string, string> ResolveImg = (url) =>
    {
        if (string.IsNullOrWhiteSpace(url))
            return "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=900&q=85&fit=crop";

        // 1. Normalize slashes (Fixes Windows \ vs Web /)
        url = url.Replace('\\', '/');

        // 2. Handle absolute external URLs
        if (url.StartsWith("http://") || url.StartsWith("https://") || url.StartsWith("//"))
            return url;

        // 3. Ensure path is application-relative
        string path = url;
        if (!path.StartsWith("~/"))
        {
            path = path.StartsWith("/") ? "~" + path : "~/" + path;
        }

        // 4. Resolve the path and handle spaces manually
        string resolved = Url.Content(path);
        return resolved.Replace(" ", "%20");
    };
}

@section HeadStyles {
    <style>
        /* ─── HERO SECTION ─── */
        #dest-hero {
            position: relative;
            width: 100%;
            min-height: 100vh;
            background-image: url('/images/background.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding-top: 80px;
            padding-bottom: 60px;
        }

            #dest-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
                pointer-events: none;
            }

        .dest-hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #fff;
            max-width: 800px;
            padding: 0 1rem;
            margin-bottom: 3.5rem;
        }

            .dest-hero-content h1 {
                font-size: clamp(2.8rem, 4vw, 4rem);
                font-weight: 700;
                line-height: 1.15;
                margin-bottom: 1rem;
                letter-spacing: -0.02em;
            }

            .dest-hero-content p {
                font-size: 1.1rem;
                color: rgba(255,255,255,0.85);
                font-weight: 300;
            }

        /* ─── FILTER BAR ─── */
        .dest-filter-wrapper {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 900px;
            padding: 0 1rem;
        }

        .dest-filter-glass {
            background: #fff;
            border-radius: 60px;
            padding: 0.5rem 0.5rem 0.5rem 1.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .dest-filter-scroll {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            flex: 1;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .dest-chip {
            padding: 0.5rem 1.2rem;
            border-radius: 50px;
            border: none;
            background: transparent;
            color: #6b7280;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
            white-space: nowrap;
        }

            .dest-chip.active {
                color: #fff;
                background: #111;
                font-weight: 600;
            }

        .dest-search-wrap {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 50px;
            padding: 0.4rem 1rem 0.4rem 1.2rem;
            flex-shrink: 0;
        }

            .dest-search-wrap input {
                background: none;
                border: none;
                outline: none;
                color: #111;
                font-size: 0.85rem;
                width: 140px;
            }

        /* ─── GRID SECTION ─── */
        #dest-main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 5rem 2rem 3rem;
        }

        .dest-section-head {
            text-align: center;
            margin-bottom: 4rem;
        }

        .dest-section-title {
            font-size: clamp(2rem, 3vw, 2.5rem);
            font-weight: 700;
            margin-bottom: 1rem;
            color: #111;
        }

        /* ─── DESTINATION CARDS ─── */
        .dest-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }

        .dest-card {
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            height: 320px;
            cursor: pointer;
            display: block;
            text-decoration: none;
            color: inherit;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            transition: transform 0.3s, box-shadow 0.3s;
            background: #fff;
        }

            .dest-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 12px 30px rgba(0,0,0,0.1);
            }

            .dest-card.featured {
                grid-column: 1 / 3;
                grid-row: 1 / 3;
                height: auto;
                min-height: 650px;
            }

        .card-img {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

            .card-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s;
                display: block;
            }

        .card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 60%);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: #fff;
        }

        .card-name {
            font-size: 1.25rem;
            font-weight: 700;
        }

        .dest-card.featured .card-name {
            font-size: 2rem;
        }

        .explore-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.6rem 1.5rem;
            border-radius: 50px;
            background: #fff;
            color: #111;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
        }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 1024px) {
            .dest-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .dest-card.featured {
                grid-column: 1 / 3;
                min-height: 450px;
            }
        }

        @@media (max-width: 768px) {
            .dest-grid {
                grid-template-columns: 1fr;
            }

            .dest-card.featured {
                grid-column: auto;
                min-height: 320px;
            }
        }
    </style>
}

<!-- HERO -->
<section id="dest-hero">
    <div class="dest-hero-content">
        <h1>Explore Our <br />Destinations</h1>
        <p>Discover breathtaking landscapes and unforgettable experiences.</p>
    </div>

    <div class="dest-filter-wrapper">
        <div class="dest-filter-glass">
            <div class="dest-filter-scroll">
                <button class="dest-chip active" data-filter="all" onclick="filterDests(this,'all')">All</button>
                @{
                    var uniqueLocations = Model
                        .Select(d => d.Location?.Trim())
                        .Where(l => !string.IsNullOrEmpty(l))
                        .Distinct()
                        .OrderBy(l => l);
                    foreach (var loc in uniqueLocations)
                    {
                        <button class="dest-chip" data-filter="@loc.ToLower()" onclick="filterDests(this,'@loc.ToLower()')">@loc</button>
                    }
                }
            </div>
            <div class="dest-search-wrap">
                <input type="text" placeholder="Search destinations…" oninput="searchDests(this.value)" />
            </div>
        </div>
    </div>
</section>

<!-- GRID -->
<div id="dest-main">
    <div class="dest-section-head">
        <h2 class="dest-section-title">Featured Destinations</h2>
    </div>

    <div class="dest-grid" id="destGrid">
        @{
            var destList = Model.ToList();
            int count = 0;
        }

        @foreach (var dest in destList)
        {
            var isFeatured = count == 0;
            var imageUrl = ResolveImg(dest.Image);

            <a href="@Url.Action("Details", "Destination", new { id = dest.DestinationId })"
               class="dest-card @(isFeatured ? "featured" : "")"
               data-filter="@(dest.Location?.ToLower() ?? "")"
               data-name="@(dest.Name?.ToLower() ?? "")">
                <div class="card-img">
                    <img src="@imageUrl" alt="@dest.Name" loading="lazy" onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1501854140801-50d01698950b?w=900&q=85&fit=crop';" />
                </div>
                <div class="card-overlay">
                    <div class="card-region">@(dest.Location ?? "Worldwide")</div>
                    <h3 class="card-name">@dest.Name</h3>
                    <div class="card-meta">
                        <span><i class="fas fa-map-marker-alt"></i> @(dest.Location ?? "Global")</span>
                    </div>
                    <div class="card-cta">
                        <span class="explore-btn">Explore <i class="fas fa-arrow-right"></i></span>
                    </div>
                </div>
            </a>
            count++;
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterDests(btn, filter) {
            document.querySelectorAll('.dest-chip').forEach(c => c.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('.dest-card').forEach(card => {
                if (filter === 'all' || card.dataset.filter === filter) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function searchDests(query) {
            query = query.toLowerCase();
            document.querySelectorAll('.dest-card').forEach(card => {
                const name = card.dataset.name;
                if (name.includes(query)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
}
