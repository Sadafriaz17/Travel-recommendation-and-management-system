@model IEnumerable<TourwebsiteFYP.DB_data_models.Destination>

@{
    ViewBag.Title = "Destinations";
    ViewBag.ActivePage = "Destinations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
/* ═══════════════════════════════════════════════
   DESTINATIONS — NEXVOY  |  Synced to Packages
   ═══════════════════════════════════════════════ */
:root {
    --bg-deep:    #020205;
    --bg-surface: rgba(15,15,20,0.85);
    --glass:      rgba(15,15,25,0.6);
    --border:     rgba(255,255,255,0.08);
    --border-hi:  rgba(255,255,255,0.14);
    --accent:     #4deeEA;
    --accent2:    #a855f7;
    --purple:     #c084fc;
    --ink:        #f0f0f4;
    --mist:       #a0a0b0;
    --font-head:  'Inter', system-ui, sans-serif;
    --font-mono:  'SF Mono','JetBrains Mono',monospace;
    --ease-out:   cubic-bezier(0.4,0,0.2,1);
}

*,*::before,*::after { margin:0; padding:0; box-sizing:border-box }
html { scroll-behavior:smooth }
body {
    background: var(--bg-deep);
    color: var(--ink);
    font-family: var(--font-head);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

/* ─── HERO ─── */
#dest-hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 50%, #0f0f1e 0%, #06060c 50%, #020205 100%);
}

#dest-hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
}

.dest-hero-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
        radial-gradient(ellipse 50% 50% at 50% 40%, rgba(77,238,234,0.08) 0%, transparent 50%),
        radial-gradient(ellipse 40% 40% at 70% 60%, rgba(168,85,247,0.06) 0%, transparent 50%),
        radial-gradient(ellipse 35% 35% at 30% 70%, rgba(77,238,234,0.04) 0%, transparent 40%);
}

.dest-hero-content {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
    padding: 0 2rem;
    text-align: center;
}

/* Badge */
.dest-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(77,238,234,0.08);
    border: 1px solid rgba(77,238,234,0.2);
    border-radius: 100px;
    padding: 0.5rem 1.2rem;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0;
    animation: fadeUpDest 0.8s ease 0.3s forwards;
}
.dest-badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent);
    animation: pulseDest 2s ease-in-out infinite;
}
@@keyframes pulseDest {
    0%,100% { opacity:0.5; transform:scale(1) }
    50%      { opacity:1;   transform:scale(1.5) }
}

/* Heading */
.dest-hero-h1 {
    font-family: var(--font-head);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeUpDest 0.9s ease 0.5s forwards;
}
.text-gradient {
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 50%, var(--purple) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    background-size: 200% 200%;
    animation: gradShiftDest 4s ease infinite;
}
@@keyframes gradShiftDest {
    0%,100% { background-position:0% 50% }
    50%      { background-position:100% 50% }
}

/* Subtitle */
.dest-hero-subtitle {
    font-size: 1.1rem;
    color: var(--mist);
    max-width: 500px;
    margin: 0 auto 3rem;
    line-height: 1.6;
    font-weight: 300;
    opacity: 0;
    animation: fadeUpDest 0.9s ease 0.7s forwards;
}

/* Filter bar */
.dest-hero-filters {
    opacity: 0;
    animation: fadeUpDest 0.9s ease 0.9s forwards;
    max-width: 860px;
    margin: 0 auto;
}
.dest-filter-glass {
    background: var(--glass);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 0.5rem;
    box-shadow: 0 20px 60px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.05);
}
.dest-filter-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
}
.dest-filter-scroll {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
}
.dest-filter-scroll::-webkit-scrollbar { display:none }

.dest-chip {
    padding: 0.6rem 1.3rem;
    border-radius: 100px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.5);
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--font-head);
    cursor: pointer;
    transition: all 0.3s var(--ease-out);
    white-space: nowrap;
    flex-shrink: 0;
}
.dest-chip:hover { color:rgba(255,255,255,0.8); background:rgba(255,255,255,0.05) }
.dest-chip.active {
    color: var(--bg-deep);
    background: var(--accent);
    font-weight: 600;
    box-shadow: 0 4px 15px rgba(77,238,234,0.3), 0 0 30px rgba(77,238,234,0.1);
}

.dest-filter-sep {
    width: 1px;
    height: 24px;
    background: rgba(255,255,255,0.1);
    margin: 0 0.3rem;
    flex-shrink: 0;
}
.dest-search-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 100px;
    padding: 0.6rem 1.2rem;
    transition: all 0.3s;
    min-width: 180px;
    flex-shrink: 0;
}
.dest-search-wrap:focus-within {
    border-color: rgba(77,238,234,0.35);
    background: rgba(255,255,255,0.08);
}
.dest-search-wrap svg { color:var(--mist); flex-shrink:0 }
.dest-search-wrap input {
    background: none; border: none; outline: none;
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 0.8rem;
    width: 100%;
}
.dest-search-wrap input::placeholder { color:var(--mist) }

/* Scroll hint */
.dest-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 3;
    opacity: 0;
    animation: fadeUpDest 1s ease 1.3s forwards;
    cursor: pointer;
    transition: opacity 0.3s;
}
.dest-scroll-hint:hover { opacity:0.7!important }
.dest-scroll-hint span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--mist);
    letter-spacing: 0.2em;
    text-transform: uppercase;
}
.dest-scroll-icon {
    width: 24px; height: 40px;
    border: 2px solid rgba(255,255,255,0.2);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
}
.dest-scroll-dot {
    width: 4px; height: 8px;
    background: var(--accent);
    border-radius: 2px;
    animation: scrollDotDest 2s ease-in-out infinite;
}
@@keyframes scrollDotDest {
    0%,100% { transform:translateY(0); opacity:1 }
    50%      { transform:translateY(12px); opacity:0.3 }
}

@@keyframes fadeUpDest {
    from { opacity:0; transform:translateY(40px) }
    to   { opacity:1; transform:translateY(0) }
}

/* ─── GRID SECTION ─── */
#dest-main {
    max-width: 1300px;
    margin: 0 auto;
    padding: 6rem 2.5rem 5rem;
}
.dest-section-head {
    text-align: center;
    margin-bottom: 4rem;
}
.dest-section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 1rem;
}
.dest-section-title {
    font-family: var(--font-head);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    line-height: 1.1;
}
.dest-section-desc {
    color: var(--mist);
    font-size: 1rem;
    max-width: 500px;
    margin: 0 auto;
    font-weight: 300;
}

/* Grid */
.dest-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 280px;
    gap: 1.4rem;
}
.dest-card:first-child {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
}

.dest-card {
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.06);
    transition: transform 0.4s var(--ease-out), border-color 0.4s, box-shadow 0.4s;
    background: rgba(20,20,30,0.8);
}
.dest-card:hover {
    transform: translateY(-8px);
    border-color: rgba(77,238,234,0.15);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5), 0 0 30px rgba(77,238,234,0.05);
}
.dest-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(77,238,234,0.15), transparent 50%, rgba(168,85,247,0.1));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.4s;
}
.dest-card:hover::before { opacity:1 }

.card-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
}
.card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.6) saturate(1.15);
    transition: transform 0.7s var(--ease-out), filter 0.5s;
    display: block;
}
.dest-card:hover .card-img img {
    transform: scale(1.05);
    filter: brightness(0.45) saturate(1.25);
}

.card-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.25) 45%, transparent 100%);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
}
.dest-card:first-child .card-overlay { padding:2rem }

.card-ai-tag {
    position: absolute;
    top: 1rem; right: 1rem;
    z-index: 4;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(77,238,234,0.25);
    border-radius: 100px;
    padding: 0.28rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--accent);
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translateY(-4px);
    transition: all 0.3s;
}
.dest-card:hover .card-ai-tag { opacity:1; transform:translateY(0) }

.card-region {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
}
.card-name {
    font-family: var(--font-head);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
}
.dest-card:first-child .card-name { font-size:2rem }

.card-meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.72rem;
    color: rgba(255,255,255,0.45);
    opacity: 0;
    transform: translateY(6px);
    transition: all 0.35s 0.05s;
    margin-top: 0.15rem;
}
.dest-card:hover .card-meta { opacity:1; transform:translateY(0) }
.meta-dot {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.meta-dot::before {
    content: '';
    width: 3px; height: 3px;
    background: var(--accent2);
    border-radius: 50%;
}

.card-cta {
    margin-top: 0.5rem;
    opacity: 0;
    transform: translateY(8px);
    transition: all 0.35s 0.1s;
}
.dest-card:hover .card-cta { opacity:1; transform:translateY(0) }
.explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 1.3rem;
    border-radius: 100px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    font-weight: 600;
    font-size: 0.78rem;
    font-family: var(--font-head);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.25s, box-shadow 0.25s;
}
.explore-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 6px 20px rgba(77,238,234,0.3);
}

/* No results */
#no-results {
    display: none;
    text-align: center;
    padding: 5rem 0;
    color: var(--mist);
}
.no-results-title {
    font-family: var(--font-head);
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--ink);
}
.reset-btn {
    display: inline-flex;
    margin-top: 1.5rem;
    padding: 0.65rem 1.5rem;
    border-radius: 100px;
    border: 1px solid var(--border-hi);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 0.84rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.25s;
}
.reset-btn:hover { border-color:var(--accent); color:var(--accent); background:rgba(77,238,234,0.08) }

/* ─── MODAL ─── */
#dest-modal {
    position: fixed;
    inset: 0;
    z-index: 9900;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(0,0,0,0.82);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s;
}
#dest-modal.open { opacity:1; pointer-events:all }

.modal-card {
    width: 100%;
    max-width: 780px;
    background: linear-gradient(170deg, #0c0c1e 0%, #060610 100%);
    border: 1px solid var(--border-hi);
    border-radius: 22px;
    overflow: hidden;
    transform: scale(0.96) translateY(16px);
    transition: transform 0.4s var(--ease-out);
    max-height: 90vh;
    overflow-y: auto;
}
#dest-modal.open .modal-card { transform:scale(1) translateY(0) }

.modal-img-wrap {
    position: relative;
    height: 260px;
    overflow: hidden;
    flex-shrink: 0;
}
.modal-img-wrap img {
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.55);
    display: block;
}
.modal-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #0c0c1e 0%, transparent 55%);
    padding: 1.8rem;
    display: flex; flex-direction: column; justify-content: flex-end;
    gap: 0.3rem;
}
.modal-close {
    position: absolute;
    top: 0.9rem; right: 0.9rem;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(0,0,0,0.6);
    border: 1px solid var(--border);
    color: var(--mist);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s;
    z-index: 5;
}
.modal-close:hover { border-color:var(--accent); color:var(--accent); background:rgba(77,238,234,0.1) }

.modal-body { padding:1.8rem }

.modal-stats {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 0.7rem;
    margin: 1.2rem 0;
}
.modal-stat {
    background: rgba(255,255,255,0.025);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.8rem;
    text-align: center;
}
.stat-val {
    font-family: var(--font-head);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 3px;
}
.stat-key {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--mist);
    letter-spacing: 0.07em;
    text-transform: uppercase;
}
.modal-desc {
    color: var(--mist);
    font-size: 0.86rem;
    line-height: 1.72;
    font-weight: 300;
    margin-bottom: 1.2rem;
}
.modal-ai {
    background: rgba(77,238,234,0.03);
    border: 1px solid rgba(77,238,234,0.12);
    border-radius: 13px;
    padding: 1rem 1.1rem;
    margin-bottom: 1.2rem;
}
.ai-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 0.35rem;
}
.ai-tip { font-size:0.82rem; color:var(--mist); line-height:1.6; font-weight:300 }
.modal-actions { display:flex; gap:0.65rem }
.btn-primary {
    flex: 1;
    padding: 0.75rem;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.84rem;
    text-align: center;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 0.25s, box-shadow 0.25s;
}
.btn-primary:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(77,238,234,0.28) }
.btn-ghost {
    padding: 0.75rem 1.3rem;
    border-radius: 12px;
    border: 1px solid var(--border-hi);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-head);
    font-size: 0.84rem;
    text-decoration: none;
    display: flex; align-items: center;
    transition: all 0.25s;
}
.btn-ghost:hover { border-color:var(--accent); color:var(--accent); background:rgba(77,238,234,0.08) }

/* ─── RESPONSIVE ─── */
@@media(max-width:1024px) {
    .dest-grid { grid-template-columns:repeat(2,1fr) }
    .dest-card:first-child { grid-column:1/3 }
}
@@media(max-width:768px) {
    .dest-grid {
        grid-template-columns: 1fr;
        grid-auto-rows: 260px;
        max-width: 440px;
        margin: 0 auto;
    }
    .dest-card:first-child { grid-column:auto; grid-row:auto }
    .dest-hero-content { padding:0 1.5rem }
    .dest-filter-row { flex-direction:column; gap:0.5rem }
    .dest-filter-scroll { width:100% }
    .dest-filter-sep { display:none }
    .dest-search-wrap { width:100%; min-width:auto }
    .modal-stats { grid-template-columns:repeat(2,1fr) }
    .modal-actions { flex-direction:column }
    #dest-main { padding:4rem 1.5rem 3rem }
}
@@media(max-width:480px) {
    .dest-hero-h1 { font-size:2.4rem }
}
    </style>
}

<!-- ════════════════ HERO ════════════════ -->
<section id="dest-hero">
    <canvas id="dest-hero-canvas"></canvas>
    <div class="dest-hero-glow"></div>

    <div class="dest-hero-content">
        @*<div class="dest-hero-badge">
            <div class="dest-badge-dot"></div>
            EXPLORE THE WORLD
        </div>*@

        <h1 class="dest-hero-h1">
            Discover<br />
            <span class="text-gradient">@Model.Count()+ Destinations</span>
        </h1>

        <p class="dest-hero-subtitle">
            Every corner of the planet, curated by AI. Discover and compare before you book.
        </p>

        <div class="dest-hero-filters">
            <div class="dest-filter-glass">
                <div class="dest-filter-row">
                    <div class="dest-filter-scroll">
                        <button class="dest-chip active" data-filter="all" onclick="filterDests(this,'all')">All</button>
                        @{
                            var uniqueLocations = Model
                                .Select(d => d.Location?.Trim())
                                .Where(l => !string.IsNullOrEmpty(l))
                                .Distinct()
                                .OrderBy(l => l);
                            foreach (var loc in uniqueLocations)
                            {
                                <button class="dest-chip" data-filter="@loc.ToLower()" onclick="filterDests(this,'@loc.ToLower()')">@loc</button>
                            }
                        }
                    </div>
                    <div class="dest-filter-sep"></div>
                    <div class="dest-search-wrap">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <circle cx="11" cy="11" r="8" />
                            <line x1="21" y1="21" x2="16.65" y2="16.65" />
                        </svg>
                        <input type="text" placeholder="Search destinations…" oninput="searchDests(this.value)" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dest-scroll-hint" onclick="document.getElementById('dest-main').scrollIntoView({behavior:'smooth'})">
        <span>Explore</span>
        <div class="dest-scroll-icon">
            <div class="dest-scroll-dot"></div>
        </div>
    </div>
</section>

<!-- ════════════════ GRID ════════════════ -->
<div id="dest-main">
    <div class="dest-section-head">
        <div class="dest-section-eyebrow">Curated Selection</div>
        <h2 class="dest-section-title">Featured <span class="text-gradient">Destinations</span></h2>
        <p class="dest-section-desc">Handpicked locations blending beauty, culture, and unforgettable experiences</p>
    </div>

    <div class="dest-grid" id="destGrid">
        @foreach (var dest in Model)
        {
            var imageUrl = !string.IsNullOrEmpty(dest.Image)
                ? Url.Content(dest.Image)
                : "https://images.unsplash.com/photo-1501854140801-50d01698950b?w=900&q=85&fit=crop";
            var location = !string.IsNullOrEmpty(dest.Location) ? dest.Location : "Worldwide";
            var priceDisplay = dest.Price > 0 ? $"From ${dest.Price:N0}" : "Price on Request";

            <div class="dest-card"
                 data-category="@location.ToLower()"
                 data-name="@dest.Name.ToLower()"
                 onclick="openModal({
                     name:'@HttpUtility.JavaScriptStringEncode(dest.Name)',
                     location:'@HttpUtility.JavaScriptStringEncode(location)',
                     image:'@HttpUtility.JavaScriptStringEncode(imageUrl)',
                     price:'@priceDisplay',
                     desc:'@HttpUtility.JavaScriptStringEncode(dest.Description ?? "Discover this amazing destination.")',
                     destinationId:@dest.DestinationId
                 })">
                <div class="card-img">
                    <img src="@imageUrl" alt="@dest.Name" loading="lazy" />
                </div>
                <div class="card-ai-tag">✦ AI CURATED</div>
                <div class="card-overlay">
                    <div class="card-region">@location</div>
                    <div class="card-name">@dest.Name</div>
                    <div class="card-meta">
                        <span class="meta-dot">@priceDisplay</span>
                        <span class="meta-dot">7–14 days</span>
                        <span class="meta-dot">★ 4.8</span>
                    </div>
                    <div class="card-cta">
                        <button class="explore-btn"
                                onclick="event.stopPropagation();window.location.href='@Url.Action("Details","Destination",new{id=dest.DestinationId})'">
                            Explore
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="no-results">
        <div style="font-family:var(--font-mono);font-size:.65rem;color:rgba(255,255,255,.18);letter-spacing:.15em;text-transform:uppercase;margin-bottom:.8rem">No Results</div>
        <div class="no-results-title">No destinations found</div>
        <p style="margin-top:.8rem;font-weight:300">Try a different filter or search term</p>
        <button onclick="filterDests(document.querySelector('[data-filter=all]'),'all')" class="reset-btn">Reset Filters</button>
    </div>
</div>

<!-- ════════════════ MODAL ════════════════ -->
<div id="dest-modal" role="dialog" aria-modal="true" onclick="if(event.target===this)closeModal()">
    <div class="modal-card">
        <div class="modal-img-wrap">
            <img id="m-img" src="" alt="" />
            <div class="modal-img-overlay">
                <div id="m-region" style="font-family:var(--font-mono);font-size:.62rem;color:var(--accent);letter-spacing:.12em;text-transform:uppercase"></div>
                <div id="m-name" style="font-family:var(--font-head);font-size:1.75rem;font-weight:800;letter-spacing:-.03em"></div>
            </div>
            <button class="modal-close" onclick="closeModal()" aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
            <div class="modal-stats">
                <div class="modal-stat"><div class="stat-val" id="m-price">—</div><div class="stat-key">Budget</div></div>
                <div class="modal-stat"><div class="stat-val">7–14</div><div class="stat-key">Days</div></div>
                <div class="modal-stat"><div class="stat-val">★ 4.8</div><div class="stat-key">Rating</div></div>
            </div>
            <p class="modal-desc" id="m-desc"></p>
            <div class="modal-ai">
                <div class="ai-label">✦ AI INSIGHT</div>
                <p class="ai-tip" id="m-tip">Loading…</p>
            </div>
            <div class="modal-actions">
                <a href="#" class="btn-primary" id="m-book">Book This Destination</a>
                <a href="#" class="btn-ghost" id="m-pkgs">View Packages</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>
        /* ── 3D EARTH — identical setup to Packages page ── */
        (function () {
            var canvas = document.getElementById('dest-hero-canvas');
            if (!canvas || typeof THREE === 'undefined') return;

            var scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x020205, 0.0006);

            var camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 0.3, 4.2);

            var renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

            /* Textures */
            var TL = new THREE.TextureLoader();
            var earthTex = TL.load('https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg');
            var specTex = TL.load('https://threejs.org/examples/textures/planets/earth_specular_2048.jpg');
            var normTex = TL.load('https://threejs.org/examples/textures/planets/earth_normal_2048.jpg');
            var cloudTex = TL.load('https://threejs.org/examples/textures/planets/earth_clouds_1024.png');

            /* Earth — radius 1.1 */
            var earthMesh = new THREE.Mesh(
                new THREE.SphereGeometry(1.1, 128, 128),
                new THREE.MeshPhongMaterial({
                    map: earthTex,
                    specularMap: specTex,
                    specular: new THREE.Color('grey'),
                    shininess: 5,
                    normalMap: normTex,
                    normalScale: new THREE.Vector2(0.8, 0.8)
                })
            );
            scene.add(earthMesh);

            /* Clouds — radius 1.12 */
            var cloudMesh = new THREE.Mesh(
                new THREE.SphereGeometry(1.12, 128, 128),
                new THREE.MeshPhongMaterial({
                    map: cloudTex,
                    transparent: true,
                    opacity: 0.12,
                    blending: THREE.AdditiveBlending,
                    depthWrite: false
                })
            );
            scene.add(cloudMesh);

            /* Stars — 4000 */
            var sGeo = new THREE.BufferGeometry();
            var sArr = new Float32Array(4000 * 3);
            for (var i = 0; i < 4000; i++) {
                sArr[i * 3] = (Math.random() - 0.5) * 2500;
                sArr[i * 3 + 1] = (Math.random() - 0.5) * 2500;
                sArr[i * 3 + 2] = (Math.random() - 0.5) * 600 - 200;
            }
            sGeo.setAttribute('position', new THREE.BufferAttribute(sArr, 3));
            var stars = new THREE.Points(sGeo,
                new THREE.PointsMaterial({ color: 0xffffff, size: 0.3, transparent: true, opacity: 0.7 })
            );
            scene.add(stars);

            /* Orbit rings — cyan + purple, radii 1.55 / 1.75 */
            function createRing(radius, color, opacity) {
                var pts = [];
                for (var j = 0; j <= 200; j++) {
                    var a = (j / 200) * Math.PI * 2;
                    pts.push(new THREE.Vector3(Math.cos(a) * radius, 0, Math.sin(a) * radius));
                }
                var geo = new THREE.BufferGeometry().setFromPoints(pts);
                var mat = new THREE.LineBasicMaterial({ color: color, transparent: true, opacity: opacity });
                return new THREE.LineLoop(geo, mat);
            }
            var ring1 = createRing(1.55, 0x4deeEA, 0.3);
            var ring2 = createRing(1.75, 0xa855f7, 0.25);
            scene.add(ring1);
            scene.add(ring2);

            /* Lighting */
            scene.add(new THREE.AmbientLight(0x111122));
            var sun = new THREE.DirectionalLight(0xffffff, 1.5);
            sun.position.set(5, 3, 5);
            scene.add(sun);
            scene.add(new THREE.PointLight(0x445566, 0.8, 10, 2));
            scene.add(new THREE.PointLight(0x4deeEA, 0.4, 5, 2));

            /* Mouse parallax */
            var targetRY = 0, targetRX = 0, currentRY = 0, currentRX = 0;
            document.getElementById('dest-hero').addEventListener('mousemove', function (e) {
                targetRY = (e.clientX / window.innerWidth - 0.5) * 0.8;
                targetRX = (e.clientY / window.innerHeight - 0.5) * 0.4;
            });

            /* Animate */
            var time = 0;
            (function tick() {
                requestAnimationFrame(tick);
                time += 0.004;

                currentRY += (targetRY - currentRY) * 0.04;
                currentRX += (targetRX - currentRX) * 0.04;

                earthMesh.rotation.y = currentRY + time * 0.5;
                earthMesh.rotation.x = currentRX * 0.2;
                cloudMesh.rotation.y = currentRY + time * 0.6;
                cloudMesh.rotation.x = currentRX * 0.2;

                ring1.rotation.y += 0.0008;
                ring1.rotation.x = Math.sin(time * 0.4) * 0.1;
                ring2.rotation.z += 0.001;
                ring2.rotation.x = Math.cos(time * 0.3) * 0.1;

                stars.rotation.y += 0.0003;
                stars.rotation.x += 0.0002;

                renderer.render(scene, camera);
            })();

            window.addEventListener('resize', function () {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
        })();

        /* ── FILTERS ── */
        function filterDests(btn, cat) {
            document.querySelectorAll('.dest-chip').forEach(function (b) { b.classList.remove('active'); });
            btn.classList.add('active');
            var q = document.querySelector('.dest-search-wrap input') ? document.querySelector('.dest-search-wrap input').value : '';
            applyFilters(cat, q);
        }
        function searchDests(val) {
            var cat = document.querySelector('.dest-chip.active') ? document.querySelector('.dest-chip.active').dataset.filter : 'all';
            applyFilters(cat, val);
        }
        function applyFilters(cat, val) {
            var q = (val || '').toLowerCase().trim();
            var n = 0;
            document.querySelectorAll('.dest-card').forEach(function (c) {
                var cats = c.dataset.category || '';
                var name = c.dataset.name || '';
                var show = (cat === 'all' || cats.includes(cat)) && (!q || name.includes(q) || cats.includes(q));
                c.style.display = show ? '' : 'none';
                if (show) n++;
            });
            document.getElementById('no-results').style.display = n === 0 ? 'block' : 'none';
        }

        /* ── MODAL ── */
        function getAiTip(n) {
            var tips = [
                'Best time to visit ' + n + ' is in the shoulder season for fewer crowds and lower prices.',
                n + ' rewards explorers — skip the guidebook highlights and wander the side streets.',
                'Book accommodation in ' + n + ' 2–3 months ahead for the best combination of choice and value.',
                'Early morning visits in ' + n + ' unlock golden-hour light and quiet that most tourists miss.',
                'Flying mid-week to ' + n + ' can cut flight costs by up to 30% compared to weekends.',
                'The local food scene in ' + n + ' is unmissable — ask locals, not apps, for recommendations.',
                'Comfortable walking shoes are essential — ' + n + '\'s best discoveries are always on foot.'
            ];
            return tips[Math.floor(Math.random() * tips.length)];
        }

        function openModal(d) {
            document.getElementById('m-img').src = d.image;
            document.getElementById('m-img').alt = d.name;
            document.getElementById('m-region').textContent = d.location;
            document.getElementById('m-name').textContent = d.name;
            document.getElementById('m-price').textContent = d.price;
            document.getElementById('m-desc').textContent = d.desc;
            document.getElementById('m-tip').textContent = getAiTip(d.name);
            document.getElementById('m-book').href = '/Bookings/Index';
            document.getElementById('m-pkgs').href = '/Packages/Index';
            document.getElementById('dest-modal').classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closeModal() {
            document.getElementById('dest-modal').classList.remove('open');
            document.body.style.overflow = '';
        }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
        var mc = document.querySelector('.modal-card');
        if (mc) mc.addEventListener('click', function (e) { e.stopPropagation(); });
    </script>
}
