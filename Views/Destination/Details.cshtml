@model IEnumerable<TourwebsiteFYP.DB_data_models.Destination>
@{
    ViewBag.Title = ViewBag.RegionName + " Destinations";
    ViewBag.ActivePage = "Destination";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <style>
        :root {
            --accent-cyan: #00e5ff;
            --accent-purple: #8b5cf6;
            --accent-gradient: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
            --page-dark: #07070c;
        }

        /* Override header for this page to make it transparent over the hero */
        #site-header {
            position: absolute;
            background: transparent;
            border-bottom: none;
            padding: 1.5rem 2rem;
            max-width: 1200px;
        }
        #site-header .logo, #site-header .nav-links a { color: #fff; }
        #site-header .nav-actions .btn-outline-light {
            background: transparent;
            color: #fff;
            border: 1px solid rgba(255,255,255,0.3);
        }

        /* ── HERO SECTION ── */
        .details-hero {
            position: relative;
            width: 100%;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 80px; /* offset for header */
            background-color: var(--page-dark);
            overflow: hidden;
            color: #fff;
            text-align: center;
        }

        .details-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(0,229,255,0.12), rgba(139,92,246,0.15));
            pointer-events: none;
        }

        .details-hero .grid-overlay {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 40px 40px;
            mask-image: radial-gradient(ellipse at 50% 50%, #000 10%, transparent 70%);
            pointer-events: none;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.35;
            pointer-events: none;
            mix-blend-mode: screen;
        }

        .orb-1 { width: 340px; height: 340px; background: var(--accent-cyan); top: -80px; left: -60px; }
        .orb-2 { width: 280px; height: 280px; background: var(--accent-purple); bottom: -60px; right: -40px; }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 800px;
            padding: 0 2rem;
        }

        .hero-content h1 {
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 800;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
            line-height: 1.1;
        }

        .hero-content p {
            font-size: 1.15rem;
            color: rgba(255,255,255,0.8);
            margin-bottom: 0;
        }

        /* ── GRID SECTION ── */
        .page-content {
            background-color: var(--page-dark);
            min-height: 50vh;
            padding: 4rem 2rem 6rem;
        }

        .dest-grid-3x3 {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .dest-card-v2 {
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            height: 340px;
            display: block;
            text-decoration: none;
            color: inherit;
            background: #111;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

        .dest-card-v2 img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease, filter 0.5s ease;
            filter: brightness(0.9);
        }

        .dest-card-v2:hover {
            transform: translateY(-8px);
        }

        .dest-card-v2:hover img {
            transform: scale(1.05);
            filter: brightness(1);
        }

        .dest-card-v2 .overlay-v2 {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            padding: 1.75rem;
            background: linear-gradient(to top, rgba(7,7,12,0.85) 0%, rgba(7,7,12,0.2) 50%, transparent 100%);
            color: #fff;
        }

        .dest-label h4 {
            font-weight: 700;
            font-size: 1.4rem;
            margin: 0 0 4px 0;
        }
        
        .dest-label p {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.7);
            margin: 0;
        }

        .btn-see-details {
            flex-shrink: 0;
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(8px);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.2);
            padding: 0.55rem 1.3rem;
            border-radius: 50px;
            font-size: 0.82rem;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.2s;
        }

        .dest-card-v2:hover .btn-see-details {
            background: #fff;
            color: var(--page-dark);
            border-color: #fff;
        }

        /* ── EMPTY STATE ── */
        .empty-state {
            text-align: center;
            padding: 6rem 2rem;
            max-width: 600px;
            margin: 0 auto;
        }
        
        .empty-state i {
            font-size: 4rem;
            color: rgba(255,255,255,0.2);
            margin-bottom: 1.5rem;
        }
        
        .empty-state h3 {
            font-size: 1.8rem;
            color: #fff;
            margin-bottom: 1rem;
        }
        
        .empty-state p {
            color: rgba(255,255,255,0.6);
            font-size: 1.1rem;
        }
    </style>
}

<div class="details-hero">
    <div class="grid-overlay"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="hero-content">
        <h1>Explore @ViewBag.RegionName</h1>
        <p>Discover breathtaking destinations, unique experiences, and unforgettable journeys in @ViewBag.RegionName.</p>
    </div>
</div>

<div class="page-content">
    @if (Model != null && Model.Any())
    {
        <div class="dest-grid-3x3">
            @foreach (var item in Model)
            {
                <a href="@Url.Action("index", "Destination", new { id = item.DestinationId })" class="dest-card-v2">
                    <img src="@Url.Content(item.Image)" alt="@item.Name" loading="lazy" onerror="this.src='/images/placeholder.jpg';" />
                    <div class="overlay-v2">
                        <div class="dest-label">
                            <h4>@item.Name</h4>
                            <p>@(item.Price.HasValue ? "From " + item.Price.Value.ToString("C") : "Explore packages")</p>
                        </div>
                        <span class="btn-see-details">View Details</span>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-compass"></i>
            <h3>No Destinations Yet</h3>
            <p>We are currently exploring and curating new experiences in @ViewBag.RegionName. Check back soon for amazing travel packages!</p>
        </div>
    }
</div>
