@model TourwebsiteFYP.DB_data_models.Destination
@{
    ViewBag.Title = Model.Name;
    ViewBag.ActivePage = "Destinations";

    var img = !string.IsNullOrEmpty(Model.Image) ? Url.Content(Model.Image) : "/images/no-image.jpg";
    var packages = ViewBag.Packages as IList<TourwebsiteFYP.DB_data_models.Package>;
}

@section HeadStyles {
    <style>
        .dest-detail-hero {
            background-image: linear-gradient(to bottom, rgba(0,0,0,0.2), rgba(0,0,0,0.6)), url('@img');
            background-size: cover;
            background-position: center;
            min-height: 50vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-align: center;
            padding: 2rem;
            position: relative;
        }

        .dest-detail-hero-content {
            position: relative;
            z-index: 2;
            margin-top: 3rem;
        }

        .dest-detail-meta {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.15);
            backdrop-filter: blur(8px);
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 1.5rem;
        }

        .dest-detail-hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 1rem;
            text-shadow: 0 4px 12px rgba(0,0,0,0.3);
        }

        .dest-detail-desc {
            max-width: 800px;
            margin: 0 auto;
            font-size: 1.15rem;
            line-height: 1.6;
            color: rgba(255,255,255,0.9);
            text-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }

        .pkg-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
        
        @@media (max-width: 900px) {
            .pkg-grid { grid-template-columns: repeat(2, 1fr); }
            .dest-detail-hero h1 { font-size: 2.8rem; }
        }
        @@media (max-width: 600px) {
            .pkg-grid { grid-template-columns: 1fr; }
            .dest-detail-hero h1 { font-size: 2.2rem; }
        }
    </style>
}

<section class="dest-detail-hero">
    <div class="dest-detail-hero-content">
        <div class="dest-detail-meta">
            <i class="fas fa-map-marker-alt"></i> @Model.Location
        </div>
        <h1>@Model.Name</h1>
        <p class="dest-detail-desc">@Model.Description</p>
    </div>
</section>

<div class="container section-padding">
    <div class="section-header" style="margin-bottom: 3rem;">
        <div class="section-header-left">
            <span class="sub-label">EXPLORE PACKAGES</span>
            <h2>Tours in @Model.Name</h2>
        </div>
    </div>

    @if (packages != null && packages.Any())
    {
        <div class="pkg-grid">
            @foreach (var pkg in packages)
            {
                var pkgImg = pkg.PackageImages.FirstOrDefault()?.ImageUrl ?? "/images/no-image.jpg";
                <a href="@Url.Action("Details", "Package", new { id = pkg.PackageId })" class="pkg-card">
                    <div class="img-wrap">
                        <img src="@Url.Content(pkgImg)" alt="@pkg.PackageName" loading="lazy" onerror="this.src='/images/no-image.jpg'" />
                        <span class="pkg-badge">@(pkg.PackageType?.TypeName ?? "Tour")</span>
                    </div>
                    <div class="pkg-body">
                        <h4>@pkg.PackageName</h4>
                        <div class="pkg-meta">
                            <span><i class="fas fa-clock"></i> @pkg.DurationDays Days</span>
                        </div>
                        <div class="pkg-footer">$@pkg.Price.ToString("N0")</div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div style="text-align:center; padding: 4rem; color: var(--text-muted); background: var(--bg-white); border-radius: 12px; border: 1px solid var(--border);">
            <i class="fas fa-box-open" style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.3;"></i>
            <h3>No packages available right now.</h3>
            <p>Please check back later for exciting tours in @Model.Name.</p>
        </div>
    }
</div>
