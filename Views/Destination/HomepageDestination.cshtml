@model IEnumerable<TourwebsiteFYP.DB_data_models.Destination>
@{
    Layout = null;
}

<style>
    .dest-grid-2x2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .dest-card-v2 {
        border-radius: 24px;
        overflow: hidden;
        position: relative;
        height: 300px;
        width: 100%;
        display: block;
        text-decoration: none;
        color: inherit;
    }

        .dest-card-v2 img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .dest-card-v2:hover img {
            transform: scale(1.06);
        }

        .dest-card-v2 .overlay-v2 {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            padding: 1.75rem;
            background: linear-gradient(to top, rgba(10,20,15,0.75) 0%, rgba(10,20,15,0.15) 45%, transparent 70%);
            color: #fff;
        }

            .dest-card-v2 .overlay-v2 .dest-label h4 {
                font-weight: 600;
                font-size: 1.35rem;
                margin: 0;
            }

            .dest-card-v2 .overlay-v2 .btn-see-details {
                flex-shrink: 0;
                background: #fff;
                color: #14301f;
                border: none;
                padding: 0.55rem 1.3rem;
                border-radius: 50px;
                font-size: 0.82rem;
                font-weight: 700;
                white-space: nowrap;
                transition: background 0.2s, transform 0.2s;
            }

        .dest-card-v2:hover .btn-see-details {
            background: #14301f;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .dest-grid-2x2 {
            grid-template-columns: 1fr;
        }

        .dest-card-v2 {
            height: 240px;
        }
    }
</style>

<div class="dest-grid-2x2">
    @if (Model != null && Model.Count() > 0)
    {
        foreach (var item in Model.Take(4))
        {
            <a href="@Url.Action("index", "Destination", new { id = item.DestinationId })" class="dest-card-v2">
                <img src="@Url.Content(item.Image)" alt="@item.Name" loading="lazy" />
                <div class="overlay-v2">
                    <div class="dest-label">
                        <h4>@item.Name</h4>
                    </div>
                    <span class="btn-see-details">See More</span>
                </div>
            </a>
        }
    }
    else
    {
        <p style="grid-column: span 2; text-align: center; color: #6b7280;">No destinations available.</p>
    }
</div>