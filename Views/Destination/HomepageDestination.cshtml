@model IEnumerable<TourwebsiteFYP.DB_data_models.Destination>
@{
    Layout = null;
}

<style>
    /* ── HOMEPAGE DESTINATIONS ─────────────────────────────────────── */
    .hpd-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .hpd-card {
        position: relative;
        display: block;
        height: 320px;
        border-radius: 20px;
        overflow: hidden;
        background: #111;
        text-decoration: none;
        color: #fff;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

        .hpd-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.18);
        }

        .hpd-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.6s ease;
        }

        .hpd-card:hover img {
            transform: scale(1.06);
        }

    /* Readability gradient, stronger towards the caption */
    .hpd-scrim {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top,
            rgba(9, 18, 15, 0.86) 0%,
            rgba(9, 18, 15, 0.40) 42%,
            rgba(9, 18, 15, 0) 72%);
    }

    /* Optional "From $x" chip */
    .hpd-price {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: rgba(255,255,255,0.92);
        color: #111;
        border-radius: 50px;
        padding: 0.3rem 0.85rem;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    /* Caption row pinned to the bottom of the image */
    .hpd-body {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.4rem 1.5rem;
    }

    .hpd-text {
        display: block;
        min-width: 0;
    }

    .hpd-name {
        display: block;
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1.25;
        letter-spacing: -0.01em;
        text-shadow: 0 1px 6px rgba(0,0,0,0.35);
    }

    .hpd-loc {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 0.35rem;
        font-size: 0.78rem;
        font-weight: 500;
        color: rgba(255,255,255,0.82);
    }

        .hpd-loc i {
            font-size: 0.7rem;
        }

    .hpd-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.95);
        color: #0f2018;
        border-radius: 50px;
        padding: 0.55rem 1.15rem;
        font-size: 0.76rem;
        font-weight: 700;
        white-space: nowrap;
        transition: background 0.2s, color 0.2s, transform 0.2s;
    }

    .hpd-card:hover .hpd-btn {
        background: #fff;
        color: #0d9488;
        transform: translateX(2px);
    }

    .hpd-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem;
        color: #6b7280;
    }

    /* ── RESPONSIVE ───────────────────────────────────────────────── */
    @@media (max-width: 900px) {
        .hpd-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 560px) {
        .hpd-grid {
            grid-template-columns: 1fr;
        }

        .hpd-card {
            height: 240px;
        }
    }
</style>

<div class="hpd-grid">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model.Take(6))
        {
            <a href="@Url.Action("Details", "Destination", new { id = item.DestinationId })" class="hpd-card">
                <img src="@Url.Content(item.Image ?? "")" alt="@item.Name" loading="lazy"
                     onerror="this.src='/images/background.jpg'" />
                <span class="hpd-scrim"></span>

                @if (item.Price.HasValue && item.Price.Value > 0)
                {
                    <span class="hpd-price">From $@item.Price.Value.ToString("N0")</span>
                }

                <span class="hpd-body">
                    <span class="hpd-text">
                        <span class="hpd-name">@item.Name</span>
                        @if (!string.IsNullOrWhiteSpace(item.Location))
                        {
                            <span class="hpd-loc"><i class="fas fa-location-dot"></i> @item.Location</span>
                        }
                    </span>
                    <span class="hpd-btn">See Details <i class="fas fa-arrow-right"></i></span>
                </span>
            </a>
        }
    }
    else
    {
        <p class="hpd-empty">No destinations available yet.</p>
    }
</div>
