
@{
    ViewBag.Title = "HomepageDestination";
     Layout = null;
}


<div class="container-xxl py-5 destination">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Destination</h6>
            <h1 class="mb-5">Popular Destination</h1>
        </div>
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 wow zoomIn" data-wow-delay="0.2s">
                    <a class="position-relative d-block overflow-hidden" href="@Url.Action("Details","Destination", new { id=item.DestinationId })">
                        <img class="img-fluid" src="@Url.Content(item.Image)" alt="@item.Name" style="object-fit:cover; height:250px; width:100%;">
                        <div class="bg-white text-danger fw-bold position-absolute top-0 start-0 m-3 py-1 px-2">
                           @item.Price.ToString("C")

                        </div>
                        <div class="bg-white text-primary fw-bold position-absolute bottom-0 end-0 m-3 py-1 px-2">
                            @item.Name
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

