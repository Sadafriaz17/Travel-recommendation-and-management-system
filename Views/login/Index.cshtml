@{
    ViewBag.Title = "Sign In";
    ViewBag.ActivePage = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section HeadStyles {
    <style>
        :root {
            --accent-cyan: #00e5ff;
            --accent-purple: #8b5cf6;
            --accent-gradient: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
            --auth-dark: #07070c;
            --auth-dark-2: #0d0d18;
            --glass-bg: rgba(255,255,255,0.05);
            --glass-border: rgba(255,255,255,0.10);
        }

        body:has(.auth-page) #site-header {
            position: static;
            max-width: 100%;
            background: #fff;
            border-bottom: 1px solid var(--border);
            padding: 1.1rem 2rem;
        }

            body:has(.auth-page) #site-header .logo,
            body:has(.auth-page) #site-header .nav-links a {
                color: var(--text-dark);
            }

                body:has(.auth-page) #site-header .nav-links a:hover {
                    color: #000;
                }

            body:has(.auth-page) #site-header .nav-actions .btn-outline-light {
                background: var(--text-dark);
                color: #fff;
                border: 1px solid var(--text-dark);
            }

        body:has(.auth-page) main {
            display: block;
        }

        /* ---------- MAIN CONTAINER ---------- */
        .auth-page {
            display: flex;
            align-items: stretch;
            min-height: calc(100vh - 73px);
            width: 100%;
        }

        /* ---------- Left: photo panel ---------- */
        .auth-visual {
            position: relative;
            flex: 1 1 46%;
            padding: 3rem 3rem 0 3rem;
            overflow: hidden;
            background-image: url('/images/login.jpg'); /* or signup.jpg */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #fff;
        }

            .auth-visual::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(165deg, rgba(7,7,12,0.35) 0%, rgba(7,7,12,0.82) 100%), linear-gradient(135deg, rgba(0,229,255,0.32), rgba(139,92,246,0.42));
                mix-blend-mode: multiply;
                pointer-events: none;
            }

            .auth-visual .grid-overlay {
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px);
                background-size: 42px 42px;
                mask-image: radial-gradient(ellipse at 50% 40%, #000 10%, transparent 72%);
                pointer-events: none;
            }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(60px);
            opacity: 0.35;
            pointer-events: none;
            mix-blend-mode: screen;
        }

        .orb-1 {
            width: 340px;
            height: 340px;
            background: var(--accent-cyan);
            top: -80px;
            left: -60px;
            animation: drift1 16s ease-in-out infinite;
        }

        .orb-2 {
            width: 280px;
            height: 280px;
            background: var(--accent-purple);
            bottom: -60px;
            right: -40px;
            animation: drift2 20s ease-in-out infinite;
        }

        .orb-3 {
            width: 160px;
            height: 160px;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
            top: 42%;
            left: 55%;
            opacity: 0.25;
            animation: drift3 13s ease-in-out infinite;
        }

        @@keyframes drift1 {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(40px,50px) scale(1.12);
            }
        }

        @@keyframes drift2 {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(-30px,-40px) scale(1.08);
            }
        }

        @@keyframes drift3 {
            0%, 100% {
                transform: translate(0,0) scale(1);
                opacity: 0.25;
            }

            50% {
                transform: translate(-20px,25px) scale(1.3);
                opacity: 0.4;
            }
        }

        .auth-logo {
            position: relative;
            z-index: 2;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.02em;
            width: fit-content;
            text-shadow: 0 2px 12px rgba(0,0,0,0.35);
        }

        .auth-visual-content {
            position: relative;
            z-index: 2;
            margin-top: auto;
            margin-bottom: auto;
        }

            .auth-visual-content h2 {
                font-size: clamp(1.8rem, 3vw, 2.6rem);
                line-height: 1.2;
                font-weight: 700;
                letter-spacing: -0.02em;
                margin-bottom: 1rem;
                text-shadow: 0 4px 20px rgba(0,0,0,0.35);
            }

            .auth-visual-content p {
                color: rgba(255,255,255,0.75);
                font-size: 0.95rem;
                max-width: 380px;
                margin-bottom: 2rem;
                text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            }

        .auth-chip-row {
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .auth-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.10);
            border: 1px solid var(--glass-border);
            backdrop-filter: blur(10px);
            padding: 0.6rem 1rem;
            border-radius: 50px;
            font-size: 0.8rem;
            color: rgba(255,255,255,0.9);
        }

            .auth-chip i {
                background: var(--accent-gradient);
                -webkit-background-clip: text;
                background-clip: text;
                color: transparent;
            }

        .auth-visual-foot {
            position: relative;
            z-index: 2;
            font-size: 0.78rem;
            color: rgba(255,255,255,0.5);
            padding-bottom: 3rem;
        }

        /* ---------- Right: form panel ---------- */
        .auth-form-panel {
            flex: 1 1 54%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 2rem;
            background: var(--bg-body);
            overflow-y: auto;
        }

        .auth-form-card {
            width: 100%;
            max-width: 400px;
            margin: auto 0;
        }

        .auth-eyebrow {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--accent-purple);
            margin-bottom: 0.6rem;
        }

        .auth-form-card h1 {
            font-size: 1.9rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .auth-form-card > .auth-form-header > p {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 2rem;
        }

            .auth-form-card > .auth-form-header > p a {
                color: var(--text-dark);
                font-weight: 600;
                text-decoration: underline;
                text-underline-offset: 3px;
            }

        .btn-google {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 0.85rem 1.2rem;
            border-radius: 50px;
            border: 1px solid var(--border);
            background: #fff;
            font-family: var(--font-main);
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-dark);
            cursor: pointer;
            transition: 0.2s;
        }

            .btn-google i {
                color: #ea4335;
                font-size: 1rem;
            }

            .btn-google:hover {
                border-color: #d1d5db;
                box-shadow: var(--shadow);
                transform: translateY(-1px);
            }

        .divider {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            margin: 1.6rem 0;
            color: var(--text-muted);
            font-size: 0.78rem;
        }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        .field-group {
            position: relative;
            margin-bottom: 1.2rem;
        }

            .field-group input {
                width: 100%;
                padding: 1.15rem 2.7rem 0.5rem 1rem;
                border-radius: 12px;
                border: 1.5px solid var(--border);
                font-family: var(--font-main);
                font-size: 0.92rem;
                color: var(--text-dark);
                background: #fff;
                outline: none;
                transition: 0.2s;
            }

                .field-group input:focus {
                    border-color: var(--accent-purple);
                    box-shadow: 0 0 0 4px rgba(139,92,246,0.12);
                }

            .field-group label {
                position: absolute;
                left: 1rem;
                top: 0.95rem;
                font-size: 0.92rem;
                color: var(--text-muted);
                pointer-events: none;
                transition: 0.15s ease;
                transform-origin: left top;
            }

            .field-group input:focus + label,
            .field-group input:not(:placeholder-shown) + label {
                top: 0.4rem;
                font-size: 0.68rem;
                font-weight: 600;
                color: var(--accent-purple);
            }

            .field-group input:invalid:not(:placeholder-shown):not(:focus) {
                border-color: #ef4444;
            }

        .field-icon {
            position: absolute;
            right: 1rem;
            top: 1.05rem;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .toggle-pass {
            position: absolute;
            right: 0.9rem;
            top: 0.75rem;
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 0.4rem;
            font-size: 0.85rem;
        }

        .form-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.6rem;
            font-size: 0.83rem;
        }

        .checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            cursor: pointer;
        }

            .checkbox input {
                accent-color: var(--accent-purple);
            }

        .forgot-link {
            color: var(--text-dark);
            font-weight: 600;
        }

        .btn-block {
            width: 100%;
            position: relative;
            padding: 0.95rem 2rem;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-spinner {
            display: none;
            width: 15px;
            height: 15px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
        }

        .auth-page form.is-loading .btn-spinner {
            display: inline-block;
            animation: spin 0.7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .auth-page form.is-loading .btn-text {
            opacity: 0.7;
        }

        .auth-form-card .field-group.shake {
            animation: shake 0.35s;
        }

        @@keyframes shake {
            25% {
                transform: translateX(-4px);
            }

            75% {
                transform: translateX(4px);
            }
        }

        /* Mobile Responsiveness */
        @@media (max-width: 900px) {
            .auth-page {
                flex-direction: column;
                min-height: auto;
            }

            .auth-visual {
                min-height: 280px;
                height: 280px;
                padding: 2rem 2rem 0 2rem;
                flex: none;
            }

            .auth-visual-foot {
                padding-bottom: 2rem;
            }

            .auth-chip-row {
                display: none;
            }

            .auth-form-panel {
                padding: 2.5rem 1.5rem;
                overflow-y: visible;
            }
        }
    </style>
}

<div class="auth-page">
    <div class="auth-visual">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="grid-overlay"></div>

        <div class="auth-visual-content">
            <h2>Every journey starts<br />with a single sign in.</h2>
            <p>Pick up your saved itineraries, track live bookings, and get AI-matched destinations the moment you're back in.</p>
            <div class="auth-chip-row">
                <div class="auth-chip"><i class="fas fa-route"></i> Smart itineraries</div>
                <div class="auth-chip"><i class="fas fa-shield-halved"></i> Secure by design</div>
                <div class="auth-chip"><i class="fas fa-bolt"></i> Instant sync</div>
            </div>
        </div>

        <div class="auth-visual-foot">&copy; 2025 NEXVOY. All Rights Reserved.</div>
    </div>

    <div class="auth-form-panel">
        <div class="auth-form-card">
            <div class="auth-form-header">
                <span class="auth-eyebrow">Welcome back</span>
                <h1>Sign in to your account</h1>
                <p>New to NEXVOY? <a href="@Url.Action("Index", "Signup")">Create an account</a></p>
            </div>

            @if (TempData["LoginError"] != null)
            {
                <div style="background:#fde8e8;color:#c0392b;padding:0.8rem 1rem;border-radius:10px;font-size:0.85rem;margin-bottom:1.2rem;">
                    @TempData["LoginError"]
                </div>
            }

            <button type="button" class="btn-google" id="googleLoginBtn">
                <i class="fab fa-google"></i> Continue with Google
            </button>

            <div class="divider"><span>or sign in with email</span></div>

            <form action="@Url.Action("Index", "Login")" method="post" id="loginForm" novalidate>
                @Html.AntiForgeryToken()

                <div class="field-group">
                    <input type="email" id="email" name="Email" placeholder=" " required />
                    <label for="email">Email address</label>
                    <i class="fas fa-envelope field-icon"></i>
                </div>

                <div class="field-group">
                    <input type="password" id="password" name="Password" placeholder=" " required minlength="6" />
                    <label for="password">Password</label>
                    <button type="button" class="toggle-pass" data-target="password" aria-label="Show password">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>

                <div class="form-row">
                    <label class="checkbox">
                        <input type="checkbox" name="RememberMe" value="true" />
                        <input type="hidden" name="RememberMe" value="false" />
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-primary btn-block" id="submitBtn">
                    <span class="btn-text">Sign In</span>
                    <span class="btn-spinner"></span>
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('.toggle-pass').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.dataset.target);
                    var icon = btn.querySelector('i');
                    var isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    icon.classList.toggle('fa-eye');
                    icon.classList.toggle('fa-eye-slash');
                });
            });

            var form = document.getElementById('loginForm');
            form.addEventListener('submit', function (e) {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    form.querySelectorAll(':invalid').forEach(function (el) {
                        var group = el.closest('.field-group');
                        group.classList.remove('shake');
                        void group.offsetWidth;
                        group.classList.add('shake');
                    });
                    return;
                }
                form.classList.add('is-loading');
                document.getElementById('submitBtn').disabled = true;
            });

            document.getElementById('googleLoginBtn').addEventListener('click', function () {
                window.location.href = '@Url.Action("ExternalLogin", "GoogleAuth", new { provider = "Google" })';
            });
        })();
    </script>
}