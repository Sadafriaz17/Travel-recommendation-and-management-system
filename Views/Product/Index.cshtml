@* =========================================
    PRODUCTS INDEX — Views/Product/Index.cshtml
    Earth 3D hero + scrollable category filters
    ========================================= *@
@model IEnumerable<TourwebsiteFYP.DB_data_models.Product>

@{
    ViewBag.Title = "Travel Products";
    ViewBag.ActivePage = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var productTypes = ViewBag.ProductTypes as IEnumerable<TourwebsiteFYP.DB_data_models.ProductType>;
    var hasProducts = Model != null && Model.Any();
    var productList = hasProducts ? Model.ToList() : new List<TourwebsiteFYP.DB_data_models.Product>();
}

@functions {
    string GetFallbackImageForCategory(string name)
    {
        if (string.IsNullOrEmpty(name)) return "https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=300&q=60";
        var n = name.ToLower();
        if (n.Contains("backpack")) return "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=300&q=60";
        if (n.Contains("gps") || n.Contains("navigation")) return "https://images.unsplash.com/photo-1524660988542-c440e0a3b8f8?w=300&q=60";
        if (n.Contains("clothing")) return "https://images.unsplash.com/photo-1539533113208-f6c13dac0080?w=300&q=60";
        if (n.Contains("camping")) return "https://images.unsplash.com/photo-1546976975-2b6b4c7c1593?w=300&q=60";
        if (n.Contains("electronic")) return "https://images.unsplash.com/photo-1617788138017-80ad29151361?w=300&q=60";
        if (n.Contains("safety") || n.Contains("first aid")) return "https://images.unsplash.com/photo-1603398938378-e54eab446d8f?w=300&q=60";
        if (n.Contains("accessories")) return "https://images.unsplash.com/photo-1602491453631-e2a5ad90a131?w=300&q=60";
        return "https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=300&q=60";
    }
}

@section HeadStyles {
    <style>
        /* ── ROOT VARIABLES ── */
        :root {
            --bg-deep: #0a0a0f;
            --accent: #4deeEA;
            --accent2: #a855f7;
            --purple: #c084fc;
            --text: #f0f0f4;
            --sub: #a0a0b0;
            --font-head: 'Inter', system-ui, sans-serif;
            --font-mono: 'SF Mono', 'JetBrains Mono', monospace;
            --font-body: 'Inter', system-ui, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg-deep);
            color: var(--text);
            font-family: var(--font-body);
        }

        #prod-hero {
            position: relative;
            height: 100vh;
            min-height: 720px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: radial-gradient(ellipse at 50% 50%, #0f0f1e 0%, #06060c 50%, #020205 100%);
        }

        #prod-hero-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            z-index: 0;
        }

        .prod-hero-glow {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 50% 40%, rgba(77,238,234,.09) 0%, transparent 55%), radial-gradient(ellipse at 75% 55%, rgba(168,85,247,.07) 0%, transparent 50%), radial-gradient(ellipse at 25% 65%, rgba(77,238,234,.05) 0%, transparent 45%);
            z-index: 1;
            pointer-events: none;
        }

        .prod-hero-content {
            position: relative;
            z-index: 2;
            max-width: 1200px;
            width: 100%;
            padding: 0 2rem;
            text-align: center;
        }

        .prod-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(77,238,234,.08);
            border: 1px solid rgba(77,238,234,.22);
            border-radius: 100px;
            padding: .5rem 1.2rem;
            margin-bottom: 2rem;
            font-family: var(--font-mono);
            font-size: .7rem;
            color: var(--accent);
            letter-spacing: .15em;
            text-transform: uppercase;
            opacity: 0;
            animation: fadeUpP .8s ease .3s forwards;
        }

        .prod-hero-badge-dot {
            width: 6px;
            height: 6px;
            background: var(--accent);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent);
            animation: pulse 2s ease-in-out infinite;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: .5;
                transform: scale(1)
            }

            50% {
                opacity: 1;
                transform: scale(1.5)
            }
        }

        .prod-hero-h1 {
            font-family: var(--font-head);
            font-size: clamp(2.8rem,7vw,5.5rem);
            font-weight: 800;
            letter-spacing: -.04em;
            line-height: 1.05;
            margin-bottom: 1.4rem;
            opacity: 0;
            animation: fadeUpP .9s ease .5s forwards;
        }

        .text-gradient {
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 50%, var(--purple) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            background-size: 200% 200%;
            animation: gradShift 4s ease infinite;
        }

        @@keyframes gradShift {
            0%, 100% {
                background-position: 0% 50%
            }

            50% {
                background-position: 100% 50%
            }
        }

        .prod-hero-subtitle {
            font-size: 1.05rem;
            color: var(--sub);
            max-width: 500px;
            margin: 0 auto 3rem;
            line-height: 1.65;
            opacity: 0;
            animation: fadeUpP .9s ease .7s forwards;
        }

        .prod-hero-filters {
            opacity: 0;
            animation: fadeUpP .9s ease .9s forwards;
            max-width: 860px;
            margin: 0 auto;
        }

        .prod-filter-glass {
            background: rgba(12,12,22,.65);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 24px;
            padding: .45rem .45rem .45rem .6rem;
            box-shadow: 0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.05);
        }

        .prod-filter-row {
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .prod-filter-scroll {
            display: flex;
            align-items: center;
            gap: .35rem;
            flex: 1;
            overflow-x: auto;
            scroll-behavior: smooth;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            padding: .1rem .1rem;
        }

            .prod-filter-scroll::-webkit-scrollbar {
                display: none;
            }

        .prod-filter-btn {
            padding: .58rem 1.25rem;
            border-radius: 100px;
            border: none;
            background: transparent;
            color: rgba(255,255,255,.48);
            font-size: .78rem;
            font-weight: 500;
            font-family: var(--font-body);
            cursor: pointer;
            white-space: nowrap;
            transition: all .28s cubic-bezier(.4,0,.2,1);
            flex-shrink: 0;
        }

            .prod-filter-btn:hover {
                color: rgba(255,255,255,.82);
                background: rgba(255,255,255,.06);
            }

            .prod-filter-btn.active {
                color: #000;
                background: var(--accent);
                font-weight: 700;
                box-shadow: 0 4px 16px rgba(77,238,234,.35), 0 0 28px rgba(77,238,234,.12);
            }

        .filter-arrow {
            flex-shrink: 0;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.1);
            background: rgba(255,255,255,.04);
            color: var(--sub);
            font-size: .85rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .25s;
            user-select: none;
        }

            .filter-arrow:hover {
                border-color: rgba(77,238,234,.4);
                color: var(--accent);
                background: rgba(77,238,234,.08);
            }

        .prod-filter-divider {
            width: 1px;
            height: 24px;
            background: rgba(255,255,255,.1);
            margin: 0 .4rem;
            flex-shrink: 0;
        }

        .prod-sort-select {
            background: rgba(255,255,255,.05);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: 100px;
            padding: .58rem 2rem .58rem 1.1rem;
            color: var(--text);
            font-size: .78rem;
            font-family: var(--font-body);
            font-weight: 500;
            outline: none;
            cursor: pointer;
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%234deeEA' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
            background-repeat: no-repeat;
            background-position: right .9rem center;
            transition: all .3s;
            flex-shrink: 0;
        }

            .prod-sort-select:hover {
                border-color: rgba(77,238,234,.3);
                background-color: rgba(255,255,255,.08);
            }

            .prod-sort-select option {
                background: #1a1a2e;
                color: var(--text);
            }

        .hero-scroll-hint {
            position: absolute;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            z-index: 3;
            cursor: pointer;
            opacity: 0;
            animation: fadeUpP 1s ease 1.3s forwards;
            transition: opacity .3s;
        }

            .hero-scroll-hint:hover {
                opacity: .75;
            }

            .hero-scroll-hint span {
                font-family: var(--font-mono);
                font-size: .62rem;
                color: var(--sub);
                letter-spacing: .22em;
                text-transform: uppercase;
            }

        .scroll-icon {
            width: 24px;
            height: 40px;
            border: 2px solid rgba(255,255,255,.2);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            padding-top: 6px;
        }

        .scroll-dot {
            width: 4px;
            height: 8px;
            background: var(--accent);
            border-radius: 2px;
            animation: sdot 2s ease-in-out infinite;
        }

        @@keyframes sdot {
            0%, 100% {
                transform: translateY(0);
                opacity: 1
            }

            50% {
                transform: translateY(12px);
                opacity: .3
            }
        }

        @@keyframes fadeUpP {
            from {
                opacity: 0;
                transform: translateY(38px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        #prod-main {
            max-width: 1280px;
            margin: 0 auto;
            padding: 6rem 2.5rem;
        }

        .prod-section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .prod-section-label {
            font-family: var(--font-mono);
            font-size: .68rem;
            color: var(--accent);
            letter-spacing: .22em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .prod-section-title {
            font-family: var(--font-head);
            font-size: clamp(2rem,4vw,3rem);
            font-weight: 800;
            letter-spacing: -.03em;
            margin-bottom: .9rem;
        }

        .prod-section-subtitle {
            color: var(--sub);
            font-size: .98rem;
            max-width: 500px;
            margin: 0 auto;
        }

        .prod-results-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.8rem;
        }

        .prod-results-count {
            font-family: var(--font-mono);
            font-size: .73rem;
            color: var(--sub);
        }

            .prod-results-count span {
                color: var(--accent);
                font-weight: 700;
            }

        .prod-cards-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 1.5rem;
        }

        .nex-prod-card {
            background: linear-gradient(180deg,rgba(30,30,45,.6) 0%,rgba(20,20,30,.85) 100%);
            border: 1px solid rgba(255,255,255,.06);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            transition: all .4s cubic-bezier(.4,0,.2,1);
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
        }

            .nex-prod-card::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 20px;
                padding: 1px;
                background: linear-gradient(135deg,rgba(77,238,234,.12),transparent 50%,rgba(168,85,247,.12));
                -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                z-index: 1;
                pointer-events: none;
                opacity: 0;
                transition: opacity .4s;
            }

            .nex-prod-card:hover {
                transform: translateY(-8px);
                border-color: rgba(77,238,234,.16);
                box-shadow: 0 28px 58px rgba(0,0,0,.55),0 0 28px rgba(77,238,234,.06);
            }

                .nex-prod-card:hover::before {
                    opacity: 1;
                }

        .prod-card-media {
            position: relative;
            height: 240px;
            overflow: hidden;
        }

            .prod-card-media img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform .7s ease;
            }

        .nex-prod-card:hover .prod-card-media img {
            transform: scale(1.07);
        }

        .prod-card-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top,rgba(0,0,0,.6) 0%,transparent 55%);
        }

        .prod-card-badge-row {
            position: absolute;
            top: 1rem;
            left: 1rem;
            right: 1rem;
            display: flex;
            justify-content: space-between;
            z-index: 2;
        }

        .prod-type-tag {
            background: rgba(0,0,0,.65);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(77,238,234,.22);
            border-radius: 100px;
            padding: .28rem .75rem;
            font-family: var(--font-mono);
            font-size: .55rem;
            color: var(--accent);
            letter-spacing: .1em;
            text-transform: uppercase;
        }

        .prod-quick-view-btn {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%) translateY(10px);
            background: rgba(0,0,0,.75);
            backdrop-filter: blur(12px);
            border: 1px solid var(--accent);
            border-radius: 50px;
            padding: .42rem 1rem;
            font-size: .68rem;
            font-weight: 600;
            color: var(--accent);
            cursor: pointer;
            opacity: 0;
            transition: all .3s;
            white-space: nowrap;
            z-index: 3;
        }

        .nex-prod-card:hover .prod-quick-view-btn {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .prod-card-body {
            padding: 1.4rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 2;
        }

        .prod-card-type {
            display: flex;
            align-items: center;
            gap: 5px;
            font-family: var(--font-mono);
            font-size: .58rem;
            color: var(--sub);
            text-transform: uppercase;
            letter-spacing: .1em;
            margin-bottom: .75rem;
        }

        .prod-card-type-dot {
            width: 4px;
            height: 4px;
            background: var(--accent2);
            border-radius: 50%;
        }

        .prod-card-title {
            font-family: var(--font-head);
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: -.02em;
            margin-bottom: .45rem;
            line-height: 1.3;
        }

        .prod-card-desc {
            font-size: .8rem;
            color: var(--sub);
            line-height: 1.6;
            margin-bottom: 1.4rem;
            flex: 1;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .prod-card-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1.1rem;
            border-top: 1px solid rgba(255,255,255,.06);
        }

        .prod-price-block {
            display: flex;
            flex-direction: column;
        }

        .prod-price-val {
            font-family: var(--font-head);
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -.03em;
            background: linear-gradient(135deg,var(--accent),var(--accent2));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .prod-price-label {
            font-size: .58rem;
            color: var(--sub);
            font-family: var(--font-mono);
        }

        .prod-details-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: .6rem 1.2rem;
            border-radius: 100px;
            font-size: .76rem;
            font-weight: 600;
            font-family: var(--font-body);
            cursor: pointer;
            transition: all .3s;
            border: 1px solid rgba(255,255,255,.1);
            background: rgba(255,255,255,.05);
            color: var(--text);
            position: relative;
            z-index: 2;
            text-decoration: none;
        }

            .prod-details-btn:hover {
                background: rgba(255,255,255,.1);
                border-color: rgba(255,255,255,.22);
                transform: translateY(-2px);
            }

        .prod-empty {
            text-align: center;
            padding: 4rem;
            color: var(--sub);
            grid-column: 1/-1;
        }

        .prod-empty-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: .4;
        }

        /* Quick View */
        .qv-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.88);
            backdrop-filter: blur(14px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            opacity: 0;
            pointer-events: none;
            transition: opacity .3s;
        }

            .qv-overlay.open {
                opacity: 1;
                pointer-events: all;
            }

        .qv-modal {
            background: linear-gradient(180deg,#1a1a28,#0f0f1a);
            border: 1px solid rgba(77,238,234,.22);
            border-radius: 24px;
            width: 100%;
            max-width: 850px;
            max-height: 85vh;
            overflow-y: auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            transform: scale(.95);
            transition: transform .3s;
            position: relative;
        }

        .qv-overlay.open .qv-modal {
            transform: scale(1);
        }

        .qv-img-side img {
            width: 100%;
            height: 100%;
            min-height: 300px;
            object-fit: cover;
            border-radius: 24px 0 0 24px;
        }

        .qv-info-side {
            padding: 2rem;
            display: flex;
            flex-direction: column;
        }

        .qv-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255,255,255,.1);
            border: none;
            color: #fff;
            cursor: pointer;
            z-index: 10;
            font-size: 1rem;
        }

        .qv-type-tag {
            font-family: var(--font-mono);
            font-size: .63rem;
            color: var(--accent);
            margin-bottom: .5rem;
        }

        .qv-title {
            font-size: 1.45rem;
            font-weight: 800;
            margin-bottom: .75rem;
        }

        .qv-desc {
            font-size: .84rem;
            color: var(--sub);
            line-height: 1.65;
            margin-bottom: 1.4rem;
            flex: 1;
        }

        .qv-price {
            font-size: 1.75rem;
            font-weight: 800;
            background: linear-gradient(135deg,var(--accent),var(--accent2));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 1.4rem;
        }

        .qv-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .qv-btn-primary {
            flex: 1;
            background: linear-gradient(135deg,var(--accent),var(--accent2));
            border: none;
            border-radius: 12px;
            padding: .8rem;
            color: #000;
            font-weight: 700;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
        }

        /* Responsive */
        @@media (min-width:1600px) {
            .prod-cards-grid {
                grid-template-columns: repeat(5,1fr);
            }
        }

        @@media (max-width:1200px) {
            .prod-cards-grid {
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media (max-width:1024px) {
            .prod-cards-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width:768px) {
            .prod-cards-grid {
                grid-template-columns: 1fr;
                max-width: 450px;
                margin: 0 auto;
            }

            .prod-hero-content {
                padding: 0 1.2rem;
            }

            .prod-filter-row {
                flex-direction: column;
                gap: .45rem;
            }

            .prod-filter-scroll {
                width: 100%;
            }

            .prod-filter-divider, .filter-arrow {
                display: none;
            }

            .prod-sort-select {
                width: 100%;
            }

            #prod-main {
                padding: 4rem 1.3rem;
            }

            .qv-modal {
                grid-template-columns: 1fr;
            }

            .qv-img-side img {
                border-radius: 24px 24px 0 0;
                min-height: 200px;
            }
        }
    </style>
}

<!-- ═══════════════════════════════════════════════
     HERO  –  Earth 3-D + scrollable filter pills
     ═══════════════════════════════════════════════ -->
<section id="prod-hero">
    <canvas id="prod-hero-canvas"></canvas>
    <div class="prod-hero-glow"></div>

    <div class="prod-hero-content">
     
        <h1 class="prod-hero-h1">
            Gear Up for<br />
            <span class="text-gradient">Your Adventure</span>
        </h1>

        <p class="prod-hero-subtitle">
            Premium travel accessories, gear, and essentials curated for the modern explorer.
        </p>

        <div class="prod-hero-filters">
            <div class="prod-filter-glass">
                <div class="prod-filter-row">
                    <button class="filter-arrow" id="filterArrowLeft" onclick="scrollFilters(-200)" aria-label="Scroll left">&#8592;</button>

                    <div class="prod-filter-scroll" id="filterPills">
                        <button class="prod-filter-btn active" data-type-id="0" onclick="filterByType(this,0)">All Products</button>

                        @if (productTypes != null && productTypes.Any())
                        {
                            foreach (var pt in productTypes)
                            {
                                <button class="prod-filter-btn" data-type-id="@pt.ProductTypeId"
                                        onclick="filterByType(this,@pt.ProductTypeId)">
                                    @pt.TypeName
                                </button>
                            }
                        }
                        else
                        {
                            <button class="prod-filter-btn" data-type-id="1" onclick="filterByType(this,1)">GPS &amp; Navigation</button>
                            <button class="prod-filter-btn" data-type-id="2" onclick="filterByType(this,2)">Backpacks</button>
                            <button class="prod-filter-btn" data-type-id="3" onclick="filterByType(this,3)">Clothing</button>
                            <button class="prod-filter-btn" data-type-id="4" onclick="filterByType(this,4)">Camping Gear</button>
                            <button class="prod-filter-btn" data-type-id="5" onclick="filterByType(this,5)">Electronics</button>
                            <button class="prod-filter-btn" data-type-id="6" onclick="filterByType(this,6)">Safety</button>
                            <button class="prod-filter-btn" data-type-id="7" onclick="filterByType(this,7)">Accessories</button>
                            <button class="prod-filter-btn" data-type-id="8" onclick="filterByType(this,8)">Footwear</button>
                            <button class="prod-filter-btn" data-type-id="9" onclick="filterByType(this,9)">Luggage</button>
                            <button class="prod-filter-btn" data-type-id="10" onclick="filterByType(this,10)">Health &amp; Wellness</button>
                        }
                    </div>

                    <button class="filter-arrow" id="filterArrowRight" onclick="scrollFilters(200)" aria-label="Scroll right">&#8594;</button>
                    <div class="prod-filter-divider"></div>

                    <select class="prod-sort-select" onchange="sortProducts(this.value)">
                        <option value="default">Default</option>
                        <option value="price-asc">Price ↑</option>
                        <option value="price-desc">Price ↓</option>
                        <option value="name">Name A–Z</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-scroll-hint" onclick="document.getElementById('prod-main').scrollIntoView({behavior:'smooth'})">
        <span>Browse</span>
        <div class="scroll-icon"><div class="scroll-dot"></div></div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════
     PRODUCTS GRID
     ═══════════════════════════════════════════════ -->
<div id="prod-main">
    <div class="prod-section-header">
        <div class="prod-section-label">OUR COLLECTION</div>
        <h2 class="prod-section-title">Featured <span class="text-gradient">Products</span></h2>
        <p class="prod-section-subtitle">Handpicked gear and accessories for every kind of traveler</p>
    </div>
    <div class="prod-results-bar">
        <div class="prod-results-count">Showing <span id="prodCount">0</span> products</div>
    </div>
    <div class="prod-cards-grid" id="prodGrid"></div>
</div>

<!-- QUICK VIEW MODAL -->
<div class="qv-overlay" id="qvOverlay" onclick="closeQV(event)">
    <div class="qv-modal">
        <button class="qv-close" onclick="closeQuickView()">✕</button>
        <div class="qv-img-side"><img id="qvImg" src="" alt="" /></div>
        <div class="qv-info-side">
            <div class="qv-type-tag" id="qvType"></div>
            <h2 class="qv-title" id="qvTitle"></h2>
            <p class="qv-desc" id="qvDesc"></p>
            <div class="qv-price" id="qvPrice"></div>
            <div class="qv-actions">
                <a id="qvDetailsLink" href="#" class="qv-btn-primary">View Full Details →</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script>

/* ════════════════════════════════════════════════════════════════════
