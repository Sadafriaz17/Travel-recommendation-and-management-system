/* ════════════════════════════════════════════
   AUTO IMAGE FALLBACK
   Runs only when img field is left as ""
════════════════════════════════════════════ */
function getFallbackImage(name) {
    const n = name.toLowerCase();
    if (n.includes('backpack'))                         return 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600&q=80';
    if (n.includes('headphone'))                        return 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&q=80';
    if (n.includes('camera'))                           return 'https://images.unsplash.com/photo-1575936123452-b67c3203c357?w=600&q=80';
    if (n.includes('adapter'))                          return 'https://images.unsplash.com/photo-1543512214-318c7553f230?w=600&q=80';
    if (n.includes('water filter'))                     return 'https://images.unsplash.com/photo-1613246123321-7ab3d3c6e38b?w=600&q=80';
    if (n.includes('hiking') || n.includes('trekking')) return 'https://images.unsplash.com/photo-1532343774358-870d3d2e9c8a?w=600&q=80';
    if (n.includes('first aid'))                        return 'https://images.unsplash.com/photo-1603398938378-e54eab446d8f?w=600&q=80';
    if (n.includes('belt'))                             return 'https://images.unsplash.com/photo-1598620617137-59e55d2a8a2c?w=600&q=80';
    if (n.includes('cook') || n.includes('camp'))       return 'https://images.unsplash.com/photo-1546976975-2b6b4c7c1593?w=600&q=80';
    if (n.includes('merino') || n.includes('wool'))     return 'https://images.unsplash.com/photo-1576566588028-4147f3842f27?w=600&q=80';
    if (n.includes('steamer') || n.includes('iron'))    return 'https://images.unsplash.com/photo-1602491453631-e2a5ad90a131?w=600&q=80';
    if (n.includes('jacket') || n.includes('down'))     return 'https://images.unsplash.com/photo-1539533113208-f6c13dac0080?w=600&q=80';
    if (n.includes('solar') || n.includes('charger'))   return 'https://images.unsplash.com/photo-1617788138017-80ad29151361?w=600&q=80';
    if (n.includes('packing cube'))                     return 'https://images.unsplash.com/photo-1557847344-6d7d93e82a5d?w=600&q=80';
    if (n.includes('gps') || n.includes('navigator'))   return 'https://images.unsplash.com/photo-1524660988542-c440e0a3b8f8?w=600&q=80';
    if (n.includes('pant') || n.includes('convertible')) return 'https://images.unsplash.com/photo-1556909114-44e7b9f2ae6e?w=600&q=80';
    if (n.includes('shoe') || n.includes('boot') || n.includes('footwear')) return 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&q=80';
    if (n.includes('luggage') || n.includes('suitcase')) return 'https://images.unsplash.com/photo-1566438480900-0609be27a4be?w=600&q=80';
    if (n.includes('health') || n.includes('wellness')) return 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=600&q=80';
    return 'https://images.unsplash.com/photo-1488646953014-85cb44e25828?w=600&q=80';
}

productsData.forEach(p => {
    if (!p.img || !p.img.trim()) p.img = getFallbackImage(p.name);
});

/* ════════════════════════════════════════════
   FILTER + SORT
════════════════════════════════════════════ */
let currentTypeId = 0;
let currentSort   = 'default';

function scrollFilters(by) {
    document.getElementById('filterPills').scrollBy({ left: by, behavior: 'smooth' });
}

function filterByType(btn, typeId) {
    currentTypeId = typeId;
    document.querySelectorAll('.prod-filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderFiltered();
    btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
}

function sortProducts(val) {
    currentSort = val;
    renderFiltered();
}

function renderFiltered() {
    let list = currentTypeId === 0
        ? [...productsData]
        : productsData.filter(p => p.typeId === currentTypeId);

    if (currentSort === 'price-asc')  list.sort((a, b) => a.price - b.price);
    if (currentSort === 'price-desc') list.sort((a, b) => b.price - a.price);
    if (currentSort === 'name')       list.sort((a, b) => a.name.localeCompare(b.name));

    document.getElementById('prodCount').textContent = list.length;
    renderProducts(list);
}

/* ════════════════════════════════════════════
   RENDER CARDS
════════════════════════════════════════════ */
function renderProducts(list) {
    const grid = document.getElementById('prodGrid');
    if (!grid) return;
    if (!list.length) {
        grid.innerHTML = `<div class="prod-empty"><div class="prod-empty-icon">🧳</div><h3>No products found</h3><p>Try a different category.</p></div>`;
        return;
    }
    grid.innerHTML = list.map(p => `
        <div class="nex-prod-card" onclick="window.location.href='/Product/Details/${p.id}'">
            <div class="prod-card-media">
                <img src="${p.img}" alt="${esc(p.name)}" data-name="${esc(p.name)}" loading="lazy"
                     onerror="this.onerror=null;this.src=getFallbackImage(this.dataset.name);" />
                <div class="prod-card-overlay"></div>
                <div class="prod-card-badge-row">
                    <span class="prod-type-tag">${esc(p.typeName)}</span>
                </div>
                <button class="prod-quick-view-btn"
                        onclick="event.stopPropagation();openQuickView(${p.id})">⚡ Quick View</button>
            </div>
            <div class="prod-card-body">
                <div class="prod-card-type"><span class="prod-card-type-dot"></span>${esc(p.typeName)}</div>
                <h3 class="prod-card-title">${esc(p.name)}</h3>
                <p class="prod-card-desc">${esc(p.desc.substring(0, 85))}${p.desc.length > 85 ? '…' : ''}</p>
                <div class="prod-card-footer">
                    <div class="prod-price-block">
                        <span class="prod-price-val">$${p.price}</span>
                        <span class="prod-price-label">Free shipping</span>
                    </div>
                    <span class="prod-details-btn"
                          onclick="event.stopPropagation();window.location.href='/Product/Details/${p.id}'">
                        View →
                    </span>
                </div>
            </div>
        </div>
    `).join('');
}

function esc(s) {
    return String(s).replace(/[&<>"']/g,
        m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m]);
}

/* ════════════════════════════════════════════
   QUICK VIEW MODAL
════════════════════════════════════════════ */
function openQuickView(id) {
    const p = productsData.find(x => x.id === id);
    if (!p) return;
    document.getElementById('qvImg').src           = p.img;
    document.getElementById('qvType').textContent  = p.typeName;
    document.getElementById('qvTitle').textContent = p.name;
    document.getElementById('qvDesc').textContent  = p.desc;
    document.getElementById('qvPrice').textContent = '$' + p.price;
    document.getElementById('qvDetailsLink').href  = '/Product/Details/' + p.id;
    document.getElementById('qvOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeQuickView() {
    document.getElementById('qvOverlay').classList.remove('open');
    document.body.style.overflow = '';
}
function closeQV(e) {
    if (e.target === document.getElementById('qvOverlay')) closeQuickView();
}

/* ════════════════════════════════════════════
   3-D EARTH HERO
════════════════════════════════════════════ */
(function () {
    const canvas = document.getElementById('prod-hero-canvas');
    if (!canvas) return;

    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0x020205, 0.0006);

    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 0.3, 4.2);

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const textureLoader    = new THREE.TextureLoader();
    const earthMap         = textureLoader.load('https://threejs.org/examples/textures/planets/earth_atmos_2048.jpg');
    const earthSpecularMap = textureLoader.load('https://threejs.org/examples/textures/planets/earth_specular_2048.jpg');
    const earthNormalMap   = textureLoader.load('https://threejs.org/examples/textures/planets/earth_normal_2048.jpg');
    const cloudMap         = textureLoader.load('https://threejs.org/examples/textures/planets/earth_clouds_1024.png');

    const earth = new THREE.Mesh(
        new THREE.SphereGeometry(1.1, 128, 128),
        new THREE.MeshPhongMaterial({
            map: earthMap, specularMap: earthSpecularMap,
            specular: new THREE.Color('grey'), shininess: 5,
            normalMap: earthNormalMap, normalScale: new THREE.Vector2(0.8, 0.8)
        })
    );
    scene.add(earth);

    const clouds = new THREE.Mesh(
        new THREE.SphereGeometry(1.12, 128, 128),
        new THREE.MeshPhongMaterial({ map: cloudMap, transparent: true, opacity: 0.12, blending: THREE.AdditiveBlending })
    );
    scene.add(clouds);

    // Stars
    const starPositions = new Float32Array(4000 * 3);
    for (let i = 0; i < 4000; i++) {
        starPositions[i * 3]     = (Math.random() - 0.5) * 2500;
        starPositions[i * 3 + 1] = (Math.random() - 0.5) * 2500;
        starPositions[i * 3 + 2] = (Math.random() - 0.5) * 600 - 200;
    }
    const starGeo = new THREE.BufferGeometry();
    starGeo.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
    const stars = new THREE.Points(starGeo, new THREE.PointsMaterial({ color: 0xffffff, size: 0.3, transparent: true, opacity: 0.7 }));
    scene.add(stars);

    // Orbit Rings
    const createRing = (radius, color, opacity) => {
        const pts = [];
        for (let i = 0; i <= 200; i++) {
            const a = (i / 200) * Math.PI * 2;
            pts.push(new THREE.Vector3(Math.cos(a) * radius, 0, Math.sin(a) * radius));
        }
        return new THREE.LineLoop(
            new THREE.BufferGeometry().setFromPoints(pts),
            new THREE.LineBasicMaterial({ color, transparent: true, opacity })
        );
    };
    const ring1 = createRing(1.55, 0x4deeEA, 0.3);
    const ring2 = createRing(1.75, 0xa855f7, 0.25);
    scene.add(ring1);
    scene.add(ring2);

    // Lights
    scene.add(new THREE.AmbientLight(0x111122));
    const dirLight = new THREE.DirectionalLight(0xffffff, 1.5);
    dirLight.position.set(5, 3, 5);
    scene.add(dirLight);
    scene.add(new THREE.PointLight(0x445566, 0.8, 10, 2));
    scene.add(new THREE.PointLight(0x4deeEA, 0.4, 5, 2));

    let targetRX = 0, targetRY = 0, currentRX = 0, currentRY = 0;
    document.getElementById('prod-hero').addEventListener('mousemove', (e) => {
        targetRY = (e.clientX / window.innerWidth  - 0.5) * 0.8;
        targetRX = (e.clientY / window.innerHeight - 0.5) * 0.4;
    });

    let time = 0;
    (function animate() {
        requestAnimationFrame(animate);
        time += 0.004;
        currentRY += (targetRY - currentRY) * 0.04;
        currentRX += (targetRX - currentRX) * 0.04;

        earth.rotation.y  = currentRY + time * 0.5;
        earth.rotation.x  = currentRX * 0.2;
        clouds.rotation.y = currentRY + time * 0.6;
        clouds.rotation.x = currentRX * 0.2;
        ring1.rotation.y += 0.0008;
        ring1.rotation.x  = Math.sin(time * 0.4) * 0.1;
        ring2.rotation.z += 0.001;
        ring2.rotation.x  = Math.cos(time * 0.3) * 0.1;
        stars.rotation.y += 0.0003;
        stars.rotation.x += 0.0002;

        renderer.render(scene, camera);
    })();

    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });
})();

/* ── INIT ── */
renderFiltered();
    </script>
}
