@{
    ViewBag.Title = "Gallery";
    ViewBag.ActivePage = "Gallery";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <style>
        /* ── HERO SECTION ── */
        #gallery-hero {
            position: relative;
            width: 100%;
            min-height: 100vh; /* Matches the Homepage & Destinations layout */
            background-image: url('/images/background.jpg'); /* Your standard hero image */
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding-top: 80px;
            padding-bottom: 60px;
        }

            #gallery-hero::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.6) 100%);
                pointer-events: none;
            }

        .gallery-hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            color: #fff;
            max-width: 800px;
            padding: 0 1rem;
            margin-bottom: 3.5rem;
        }

            .gallery-hero-content h1 {
                font-family: var(--font-main);
                font-size: clamp(2.8rem, 4vw, 4rem);
                font-weight: 700;
                line-height: 1.15;
                margin-bottom: 1rem;
                letter-spacing: -0.02em;
            }

            .gallery-hero-content p {
                font-size: 1.1rem;
                color: rgba(255,255,255,0.85);
                font-weight: 300;
            }

        /* ── FILTER BAR ── */
        #gallery-filters {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 900px;
            padding: 0 1rem;
        }

        .gal-filters-inner {
            background: #fff;
            border-radius: 60px;
            padding: 0.5rem 0.5rem 0.5rem 1.5rem;
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .gal-filter-scroll {
            display: flex;
            align-items: center;
            gap: 0.4rem;
            flex: 1;
            overflow-x: auto;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
        }

            .gal-filter-scroll::-webkit-scrollbar {
                display: none;
            }

        .gal-filter {
            padding: 0.5rem 1.2rem;
            border-radius: 50px;
            border: none;
            background: transparent;
            color: var(--text-muted);
            font-size: 0.85rem;
            font-weight: 500;
            font-family: var(--font-main);
            cursor: pointer;
            transition: all 0.3s;
            white-space: nowrap;
        }

            .gal-filter:hover {
                color: var(--text-dark);
                background: var(--bg-body);
            }

            .gal-filter.active {
                color: #fff;
                background: var(--text-dark);
                font-weight: 600;
            }

        .gal-filter-sep {
            width: 1px;
            height: 30px;
            background: var(--border);
            flex-shrink: 0;
        }

        .gal-search-wrap {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--bg-body);
            border: 1px solid var(--border);
            border-radius: 50px;
            padding: 0.4rem 1rem 0.4rem 1.2rem;
            transition: all 0.3s;
            flex-shrink: 0;
        }

            .gal-search-wrap:focus-within {
                border-color: var(--text-dark);
                background: #fff;
            }

            .gal-search-wrap input {
                background: none;
                border: none;
                outline: none;
                color: var(--text-dark);
                font-family: var(--font-main);
                font-size: 0.85rem;
                width: 140px;
            }

                .gal-search-wrap input::placeholder {
                    color: var(--text-muted);
                }

        .count-label {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 500;
            align-self: center;
            margin-left: auto;
            padding-right: 1rem;
        }

        /* ── MAIN CONTENT ── */
        #gallery-main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 5rem 2rem 3rem;
        }

        .gallery-section-head {
            text-align: center;
            margin-bottom: 4rem;
        }

        .gallery-section-eyebrow {
            font-size: 0.8rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: block;
            margin-bottom: 0.5rem;
        }

        .gallery-section-title {
            font-family: var(--font-main);
            font-size: clamp(2rem, 3vw, 2.5rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
            color: var(--text-dark);
        }

        .gallery-section-desc {
            color: var(--text-muted);
            font-size: 1rem;
            max-width: 500px;
            margin: 0 auto;
            font-weight: 400;
        }

        /* ── MASONRY GALLERY ── */
        .gallery-masonry {
            column-count: 4;
            column-gap: 1.5rem;
        }

        .gal-item {
            break-inside: avoid;
            margin-bottom: 1.5rem;
            border-radius: var(--radius);
            overflow: hidden;
            position: relative;
            cursor: pointer;
            display: block;
            background: var(--bg-white);
            box-shadow: var(--shadow);
            transition: transform 0.3s, box-shadow 0.3s;
        }

            .gal-item:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-hover);
            }

            .gal-item img {
                width: 100%;
                display: block;
                object-fit: cover;
                transition: transform 0.5s;
            }

            .gal-item:hover img {
                transform: scale(1.05);
            }

        .gal-item-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 50%);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .gal-item:hover .gal-item-overlay {
            opacity: 1;
        }

        .gal-item-category {
            font-size: 0.7rem;
            color: rgba(255,255,255,0.7);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.2rem;
        }

        .gal-item-title {
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
        }

        .gal-item-location {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.8);
            margin-top: 0.2rem;
        }

        /* ── RESPONSIVE ── */
        @@media (max-width: 1024px) {
            .gallery-masonry {
                column-count: 3;
            }
        }

        @@media (max-width: 768px) {
            .gallery-masonry {
                column-count: 2;
            }

            .gal-filters-inner {
                flex-direction: column;
                border-radius: 20px;
                padding: 1rem;
                align-items: stretch;
                gap: 1rem;
            }

            .gal-filter-scroll {
                width: 100%;
            }

            .gal-filter-sep {
                display: none;
            }

            .gal-search-wrap {
                width: 100%;
            }

                .gal-search-wrap input {
                    width: 100%;
                }

            #gallery-main {
                padding: 4rem 1.5rem 3rem;
            }

            #gallery-hero {
                min-height: 70vh;
            }
        }

        @@media (max-width: 480px) {
            .gallery-masonry {
                column-count: 1;
            }
        }
    </style>
}

<!-- ── HERO ──────────────────────────────── -->
<section id="gallery-hero">
    <div class="gallery-hero-content">
        <h1>Visual <br />Gallery</h1>
        <p>Moments captured from around the world, curated just for you.</p>
    </div>

    <!-- ── FILTERS ── -->
    <div id="gallery-filters">
        <div class="gal-filters-inner">
            <div class="gal-filter-scroll">
                <button class="gal-filter active" onclick="filterGallery(this,'all')">All</button>
                <button class="gal-filter" onclick="filterGallery(this,'nature')">Nature</button>
                <button class="gal-filter" onclick="filterGallery(this,'city')">Cities</button>
                <button class="gal-filter" onclick="filterGallery(this,'beach')">Beaches</button>
                <button class="gal-filter" onclick="filterGallery(this,'culture')">Culture</button>
                <button class="gal-filter" onclick="filterGallery(this,'adventure')">Adventure</button>
                <button class="gal-filter" onclick="filterGallery(this,'food')">Food</button>
            </div>

            <div class="gal-filter-sep"></div>

            <div class="gal-search-wrap">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" placeholder="Search gallery…" oninput="searchGallery(this.value)" />
            </div>

            <span class="count-label" id="img-count">- images</span>
        </div>
    </div>
</section>

<!-- ── GALLERY MAIN ────────────────────── -->
<div id="gallery-main">
    <div class="gallery-section-head">
        <span class="gallery-section-eyebrow">Curated Moments</span>
        <h2 class="gallery-section-title">Travel Memories</h2>
        <p class="gallery-section-desc">Handpicked visual stories from the most beautiful places on earth</p>
    </div>

    @{
        var galleryItems = new[] {
            new { title="Blue Caldera", location="Santorini, Greece", cat="beach", img="https://images.unsplash.com/photo-1613395877344-13d4a8e0d49e?w=800&q=85&fit=crop" },
            new { title="Bamboo Forest", location="Arashiyama, Japan", cat="nature", img="https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=800&q=85&fit=crop" },
            new { title="Overwater Bliss", location="Maldives", cat="beach", img="https://images.unsplash.com/photo-1514282401047-d79a71a590e8?w=800&q=85&fit=crop" },
            new { title="Burj at Dusk", location="Dubai, UAE", cat="city", img="https://images.unsplash.com/photo-1512453979798-5ea266f8880c?w=800&q=85&fit=crop" },
            new { title="Rice Terraces", location="Ubud, Bali", cat="nature", img="https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&q=85&fit=crop" },
            new { title="Machu Picchu Dawn", location="Peru", cat="culture", img="https://images.unsplash.com/photo-1580502304784-8985b7eb7260?w=800&q=85&fit=crop" },
            new { title="Positano Cliffs", location="Amalfi Coast, Italy", cat="beach", img="https://images.unsplash.com/photo-1520175480921-4edfa2983e0f?w=800&q=85&fit=crop" },
            new { title="Patagonia Peaks", location="Torres del Paine, Chile", cat="adventure", img="https://images.unsplash.com/photo-1501854140801-50d01698950b?w=800&q=85&fit=crop" },
            new { title="Kyoto Temple", location="Kyoto, Japan", cat="culture", img="https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=800&q=85&fit=crop" },
            new { title="Desert Safari", location="Dubai, UAE", cat="adventure", img="https://images.unsplash.com/photo-1509316785289-025f5b846b35?w=800&q=85&fit=crop" },
            new { title="Street Food", location="Bangkok, Thailand", cat="food", img="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=800&q=85&fit=crop" },
            new { title="Northern Lights", location="Tromsø, Norway", cat="nature", img="https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=800&q=85&fit=crop" },
            new { title="Ancient Medina", location="Marrakech, Morocco", cat="culture", img="https://images.unsplash.com/photo-1539020140153-e479b8c22e70?w=800&q=85&fit=crop" },
            new { title="Swiss Alps", location="Interlaken, Switzerland", cat="adventure", img="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800&q=85&fit=crop" },
            new { title="Italian Cuisine", location="Rome, Italy", cat="food", img="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=800&q=85&fit=crop" },
            new { title="Tokyo Nights", location="Tokyo, Japan", cat="city", img="https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?w=800&q=85&fit=crop" }
        };
    }

    <!-- Masonry Layout -->
    <div class="gallery-masonry" id="galleryMasonry">
        @for (int i = 0; i < galleryItems.Length; i++)
        {
            var item = galleryItems[i];
            <div class="gal-item"
                 data-cat="@item.cat"
                 data-title="@item.title"
                 data-location="@item.location"
                 data-img="@item.img"
                 data-index="@i"
                 onclick="openLightbox(@i)">
                <img src="@item.img" alt="@item.title - @item.location" loading="lazy" />
                <div class="gal-item-overlay">
                    <div class="gal-item-category">@item.cat</div>
                    <div class="gal-item-title">@item.title</div>
                    <div class="gal-item-location">@item.location</div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // ── Gallery data ──
        const galleryData = Array.from(document.querySelectorAll('.gal-item')).map(el => ({
            img: el.dataset.img,
            title: el.dataset.title,
            location: el.dataset.location,
            cat: el.dataset.cat
        }));
        let currentIndex = 0;

        // Update count
        function updateCount() {
            const visible = document.querySelectorAll('.gal-item:not([style*="display: none"])').length;
            document.getElementById('img-count').textContent = visible + ' images';
        }
        updateCount();

        // ── Filter ──
        function filterGallery(btn, cat) {
            document.querySelectorAll('.gal-filter').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            document.querySelectorAll('.gal-item').forEach(item => {
                const show = cat === 'all' || item.dataset.cat === cat;
                item.style.display = show ? '' : 'none';
            });
            updateCount();
        }

        // ── Search ──
        function searchGallery(val) {
            const q = val.toLowerCase().trim();
            document.querySelectorAll('.gal-item').forEach(item => {
                const title = (item.dataset.title || '').toLowerCase();
                const loc = (item.dataset.location || '').toLowerCase();
                const show = !q || title.includes(q) || loc.includes(q);
                item.style.display = show ? '' : 'none';
            });
            updateCount();
        }

        // ── Lightbox ──
        function openLightbox(index) {
            currentIndex = index;
            const d = galleryData[currentIndex];
            const img = document.getElementById('lb-img');

            // Create Lightbox dynamically
            const lb = document.createElement('div');
            lb.id = 'lb-container';
            lb.style.cssText = `
                    position: fixed; inset: 0; z-index: 9999;
                    background: rgba(255, 255, 255, 0.95);
                    backdrop-filter: blur(10px);
                    display: flex; flex-direction: column; align-items: center; justify-content: center;
                    padding: 2rem;
                `;

            lb.innerHTML = `
                    <button onclick="closeLightbox()" style="position:absolute; top:1.5rem; right:1.5rem; width:44px; height:44px; border:1px solid #e5e7eb; border-radius:50%; background:#fff; color:#1a1a1a; font-size:1.2rem; cursor:pointer;">✕</button>
                    <div style="max-width:1000px; width:100%; text-align:center;">
                        <img src="${d.img}" alt="${d.title}" style="width:100%; max-height:80vh; object-fit:contain; border-radius:16px; box-shadow:0 20px 40px rgba(0,0,0,0.1);" />
                        <div style="margin-top:1.5rem;">
                            <div style="font-size:1.2rem; font-weight:700; color:#1a1a1a;">${d.title}</div>
                            <div style="font-size:0.9rem; color:#6b7280;">${d.location}</div>
                        </div>
                        <div style="margin-top:1rem; font-size:0.8rem; color:#9ca3af;">${currentIndex + 1} / ${galleryData.length}</div>
                    </div>
                `;

            document.body.appendChild(lb);
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            const lb = document.getElementById('lb-container');
            if (lb) lb.remove();
            document.body.style.overflow = '';
        }
    </script>
}
