                title: 'African Travel Intelligence',
                desc: 'Africa offers the ultimate adventure - from Sahara dunes to Serengeti safaris. Your budget goes far here, with mid-range options delivering luxury-level experiences by Western standards.',
                chips: ['Safari Adventures', 'Natural Wonders', 'Tribal Cultures', 'Diverse Ecosystems']
            }
        };

        // ── AI Tips Engine ──
        function generateAITips(data) {
            var tips = [];
            var dest = (data.destination || 'Europe').toLowerCase();
            var budget = (data.budget || '').toLowerCase();

            if (budget.includes('under') || budget.includes('1,000')) {
                tips.push({ icon: '💰', text: 'Budget-friendly tip: Book flights 6-8 weeks in advance and consider shoulder season for best rates.' });
            } else if (budget.includes('5,000')) {
                tips.push({ icon: '✨', text: 'Premium tip: Consider upgrading to boutique hotels for unique, immersive experiences.' });
            }

            if (dest.includes('europe')) {
                tips.push({ icon: '🚄', text: 'European rail passes can save you up to 40% on inter-city travel compared to booking individually.' });
                tips.push({ icon: '🏛️', text: 'Book museum tickets online in advance - skip the queues at major attractions like the Vatican and Louvre.' });
            } else if (dest.includes('asia')) {
                tips.push({ icon: '🍜', text: 'Street food is not just budget-friendly - it\'s often the most authentic culinary experience.' });
            }

            tips.push({ icon: '📱', text: 'Download offline maps and translation apps before departure - connectivity can be unpredictable.' });
            tips.push({ icon: '🛡️', text: 'Always purchase comprehensive travel insurance - medical emergencies abroad can be extremely costly.' });
            tips.push({ icon: '💳', text: 'Notify your bank of international travel dates to avoid card blocks and check foreign transaction fees.' });
            tips.push({ icon: '📸', text: 'Pack a portable charger - you\'ll use your phone for navigation, photos, and reservations constantly.' });

            return tips.slice(0, 5);
        }

        // ── Render Functions ──
        function renderParams(data) {
            var grid = document.getElementById('params-grid');
            var fields = [
                { label: 'Destination',  value: data.destination || 'Europe' },
                { label: 'Temperature',   value: data.temperature || '-' },
                { label: 'Duration',      value: data.duration || '7 Days' },
                { label: 'Travel Style',  value: data.style || 'Adventure' },
                { label: 'Budget Range',  value: data.budget || 'Mid-range', accent: true }
            ];
            grid.innerHTML = fields.map(function(f) {
                return '<div class="params-item">' +
                    '<div class="params-item-label">' + f.label + '</div>' +
                    '<div class="params-item-value' + (f.accent ? ' accent' : '') + '">' + f.value + '</div>' +
                '</div>';
            }).join('');

            document.getElementById('params-headline').textContent =
                (data.destination || 'Europe') + ' · ' + (data.duration || '') + ' · ' + (data.style || '');
        }

        function renderInsight(data) {
            var dest = data.destination || 'Europe';
            var profile = regionInsights[dest] || regionInsights['Europe'];

            document.getElementById('insight-icon').textContent = profile.icon;
            document.getElementById('insight-title').textContent = profile.title;
            document.getElementById('insight-text').textContent =
                profile.desc + ' Your ' + (data.duration || '7-day') + ' ' + (data.style || 'adventure').toLowerCase() +
                ' trip with a ' + (data.budget || 'mid-range').toLowerCase() + ' budget is perfectly positioned for an unforgettable experience.';

            var chips = profile.chips.concat([
                data.style || 'Adventure',
                data.duration || '7 Days'
            ]);
            document.getElementById('insight-chips').innerHTML =
                chips.map(function(c) { return '<div class="insight-chip">' + c + '</div>'; }).join('');
        }

        function renderDestinations(data) {
            var container = document.getElementById('destinations-list');
            var durationText = data.duration || '7 Days';
            var daysNum = parseInt(durationText) || 7;

            function getHighlightKeyword(totalDays) {
                if (totalDays >= 14) return '1–2+ weeks';
                if (totalDays >= 7) return '5–7 days';
                return '3–5 days';
            }

            var highlightKw = getHighlightKeyword(daysNum);
            var html = '';

            destinationsDB.forEach(function(d, i) {
                var rank = i + 1;
                var tripParts = [];
                d.idealTripSegments.forEach(function(segment, j) {
                    if (segment === highlightKw) {
                        tripParts.push('<span class="dest-spec-val highlight">' + segment + '</span>');
                    } else {
                        tripParts.push('<span class="dest-spec-val">' + segment + '</span>');
                    }
                });

                html += '<div class="dest-card" data-reveal>';
                html += '<div class="dest-card-inner">';
                html += '<div class="dest-card-img">';
                html += '<img src="' + d.image + '" alt="' + d.name + '" loading="lazy" />';
                html += '<div class="dest-card-rank">' + rank + '</div>';
                html += '</div>';
                html += '<div class="dest-card-body">';
                html += '<div class="dest-card-region">' + d.region + '</div>';
                html += '<div class="dest-card-name">' + d.name + '</div>';
                html += '<p style="font-size:0.82rem;color:var(--sub);line-height:1.6;margin-bottom:1rem;">' + d.description + '</p>';
                html += '<div class="dest-card-specs">';
                html += '<div class="dest-spec"><span style="color:var(--sub);">🌡️</span> <span class="dest-spec-val">' + d.avgTemp.toFixed(1) + '°C avg</span></div>';
                html += '<div class="dest-spec"><span style="color:var(--sub);">💰</span> <span class="dest-spec-val">~$' + d.costPerNight + '/night</span></div>';
                html += '<div class="dest-spec"><span style="color:var(--sub);">📅</span> ' + tripParts.join(' / ') + '</div>';
                html += '<div class="dest-spec"><span style="color:var(--sub);">⭐</span> <span class="dest-spec-val">' + d.highlights.join(', ') + '</span></div>';
                html += '</div>';
                html += '<div class="dest-card-match">';
                html += '<div class="match-score-ring">';
                html += '<svg width="52" height="52" viewBox="0 0 52 52">';
                html += '<circle cx="26" cy="26" r="22" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="3" />';
                html += '<circle cx="26" cy="26" r="22" fill="none" stroke="url(#matchGrad' + i + ')" stroke-width="3" stroke-linecap="round" transform="rotate(-90 26 26)" stroke-dasharray="138.2" stroke-dashoffset="' + (138.2 - (d.matchScore/100)*138.2) + '" style="transition: stroke-dashoffset 0.8s ease;" />';
                html += '</svg>';
                html += '</div>';
                html += '<div>';
                html += '<div class="match-score-text text-gradient">' + d.matchScore + '%</div>';
                html += '<div class="match-label">Match Score</div>';
                html += '</div>';
                html += '<div class="dest-card-actions">';
                html += '<a href="~/Packages/Index" class="btn-book">Book Now</a>';
                html += '<a href="~/Destinations/Index" class="btn-details">Details</a>';
                html += '</div>';
                html += '</div>';
                html += '</div>';
                html += '</div>';
                html += '</div>';
            });

            container.innerHTML = html;

            // Add SVG gradient defs
            var svgDefs = '<svg width="0" height="0" style="position:absolute">';
            destinationsDB.forEach(function(d, i) {
                svgDefs += '<linearGradient id="matchGrad' + i + '" x1="0%" y1="0%" x2="100%" y2="0%"><stop offset="0%" stop-color="#4deeEA"/><stop offset="100%" stop-color="#a855f7"/></linearGradient>';
            });
            svgDefs += '</svg>';
            container.insertAdjacentHTML('beforeend', svgDefs);

            document.getElementById('stat-destinations').textContent = destinationsDB.length;
            document.getElementById('stat-top-match').textContent = destinationsDB[0].matchScore + '%';
        }

        function renderBudgetSummary(data) {
            var container = document.getElementById('budget-breakdown');
            var budgetText = data.budget || '$1,000 – $2,500';
            var totalEstimate = '';

            if (budgetText.includes('Under')) totalEstimate = '$800';
            else if (budgetText.includes('2,500') && budgetText.includes('5,000')) totalEstimate = '$3,200';
            else if (budgetText.includes('5,000')) totalEstimate = '$6,500';
            else totalEstimate = '$1,750';

            var html = '';
            html += '<div class="budget-row"><span class="budget-row-label">Flights (est.)</span><span class="budget-row-val">$450</span></div>';
            html += '<div class="budget-row"><span class="budget-row-label">Accommodation</span><span class="budget-row-val">$620</span></div>';
            html += '<div class="budget-row"><span class="budget-row-label">Activities & Tours</span><span class="budget-row-val">$380</span></div>';
            html += '<div class="budget-row"><span class="budget-row-label">Food & Dining</span><span class="budget-row-val">$200</span></div>';
            html += '<div class="budget-row"><span class="budget-row-label">Local Transport</span><span class="budget-row-val">$100</span></div>';
            html += '<div class="budget-row" style="padding-top:0.75rem;border-top:1px solid var(--border);margin-top:0.25rem;">';
            html += '<span class="budget-row-label">Total Estimate</span>';
            html += '<span class="budget-row-val total">' + totalEstimate + '</span>';
            html += '</div>';

            container.innerHTML = html;
            document.getElementById('budget-bar-fill').style.width = '65%';
        }

        function renderAITips(data) {
            var tips = generateAITips(data);
            document.getElementById('ai-tips-list').innerHTML =
                tips.map(function(t) {
                    return '<div class="ai-tip"><span class="ai-tip-icon">' + t.icon + '</span><span>' + t.text + '</span></div>';
                }).join('');
        }

        // ── Loading Animation ──
        function runLoadingAnimation(callback) {
            var steps = ['ls1','ls2','ls3','ls4'];
            var i = 0;
            var overlay = document.getElementById('loading-overlay');
            overlay.classList.remove('hidden');

            function next() {
                if (i < steps.length) {
                    if (i > 0) document.getElementById(steps[i-1]).classList.replace('active','done');
                    document.getElementById(steps[i]).classList.add('active');
                    i++;
                    setTimeout(next, 650);
                } else {
                    setTimeout(function() {
                        overlay.classList.add('hidden');
                        callback();
                    }, 400);
                }
            }
            next();
        }

        // ── Main Init ──
        function initTripPage() {
            var raw = sessionStorage.getItem('nexvoy_dreamtrip_data');
            var data = raw ? JSON.parse(raw) : {
                destination: 'Europe',
                temperature: '20°C, warm',
                duration: '7 Days',
                style: 'Adventure',
                budget: '$1,000 – $2,500'
            };

            runLoadingAnimation(function() {
                renderParams(data);
                renderInsight(data);
                renderDestinations(data);
                renderBudgetSummary(data);
                renderAITips(data);

                // Reveal animations
                setTimeout(function() {
                    document.querySelectorAll('[data-reveal]').forEach(function(el) {
                        el.classList.add('revealed');
                    });
                }, 200);

                // Animate match score rings
                setTimeout(function() {
                    document.querySelectorAll('.dest-card-match circle:nth-child(2)').forEach(function(circle) {
                        var dasharray = circle.getAttribute('stroke-dasharray');
                        if (dasharray) {
                            circle.style.strokeDashoffset = circle.dataset.finalOffset || circle.style.strokeDashoffset;
                        }
                    });
                }, 400);
            });
        }

        function regenerateTrip() {
            initTripPage();
            document.getElementById('trip-content').scrollIntoView({ behavior: 'smooth' });
        }

        // ── Scroll Reveal ──
        (function() {
            var observer = new IntersectionObserver(function(entries) {
                entries.forEach(function(e) {
                    if (e.isIntersecting) { e.target.classList.add('revealed'); observer.unobserve(e.target); }
                });
            }, { threshold: 0.1 });
            document.querySelectorAll('[data-reveal]').forEach(function(el) { observer.observe(el); });
        })();

        // Init on load
        window.addEventListener('DOMContentLoaded', initTripPage);
    </script>
}
