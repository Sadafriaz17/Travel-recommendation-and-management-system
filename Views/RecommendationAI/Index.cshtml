                chips: ['Cultural Immersion', 'Budget-Friendly', 'Exotic Cuisine', 'Tropical Climate']
            },
            'USA': {
                icon: '🗽',
                title: 'USA Travel Intelligence',
                desc: 'The USA spans multiple climate zones and experiences. Urban hubs offer world-class entertainment while national parks deliver unparalleled natural beauty. Domestic flights are often necessary for multi-destination trips.',
                chips: ['Diverse Landscapes', 'National Parks', 'Urban Adventures', 'Road Trip Culture']
            },
