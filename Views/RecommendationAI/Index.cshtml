@{
    ViewBag.Title = "AI Dream Trip Generator";
    ViewBag.ActivePage = "DreamTrip";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeadStyles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ═══════════════════════════════════════════════
           AI DREAM TRIP GENERATOR - NEXVOY
           Strict design system match with homepage & packing list
        ═══════════════════════════════════════════════ */
        :root {
            --bg-deep: #020205;
            --bg-surface: rgba(15,15,20,0.85);
            --glass: rgba(15,15,25,0.6);
            --glass-hi: rgba(30,30,38,0.85);
            --border: rgba(255,255,255,0.08);
            --border-hi: rgba(255,255,255,0.14);
            --accent: #4deeEA;
            --accent2: #a855f7;
            --purple: #c084fc;
            --text: #f0f0f4;
            --sub: rgba(240,240,244,0.5);
            --font-head: 'Inter', system-ui, sans-serif;
            --font-body: 'Inter', system-ui, sans-serif;
            --font-mono: 'SF Mono','JetBrains Mono',monospace;
            --ease-out: cubic-bezier(0.4,0,0.2,1);
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box
        }

        html {
            scroll-behavior: smooth
        }

        body {
            background: var(--bg-deep);
            color: var(--text);
            font-family: var(--font-body);
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }

        /* ─── SHARED UTILITIES ─── */
        .text-gradient {
            background: linear-gradient(135deg, var(--accent) 0%, var(--accent2) 50%, var(--purple) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            background-size: 200% 200%;
            animation: gradShift 4s ease infinite;
        }

        @@keyframes gradShift {
            0%, 100% {
                background-position: 0% 50%
            }

            50% {
                background-position: 100% 50%
            }
        }

        .nex-badge {
            display: inline-block;
            font-family: var(--font-mono);
            font-size: 0.7rem;
            color: var(--accent);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        [data-reveal] {
            opacity: 0;
            transform: translateY(32px);
            transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
        }

            [data-reveal].revealed {
                opacity: 1;
                transform: translateY(0);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        /* ─── HERO (EXACT MATCH) ─── */
        #hero {
            position: relative;
            height: 100vh;
            min-height: 700px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: radial-gradient(ellipse at 50% 50%, #0f0f1e 0%, #06060c 50%, #020205 100%);
        }

        #hero-3d-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            z-index: 0;
        }

        .hero-glow {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: radial-gradient(ellipse 50% 50% at 50% 40%, rgba(77,238,234,0.08) 0%, transparent 50%), radial-gradient(ellipse 40% 40% at 70% 60%, rgba(168,85,247,0.06) 0%, transparent 50%), radial-gradient(ellipse 35% 35% at 30% 70%, rgba(77,238,234,0.04) 0%, transparent 40%);
        }

        .hero-content {
            position: relative;
            z-index: 3;
            text-align: center;
            padding: 0 1.5rem;
            max-width: 960px;
        }

        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            color: var(--accent);
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin-bottom: 1.75rem;
            opacity: 0;
            animation: fadeUp 0.8s ease 0.3s forwards;
        }

        .hero-eyebrow-line {
            width: 32px;
            height: 1px;
            background: var(--accent);
            box-shadow: 0 0 8px var(--accent);
        }

        .hero-h1 {
            font-family: var(--font-head);
            font-size: clamp(2.8rem, 6vw, 5.5rem);
            font-weight: 800;
            line-height: 0.95;
            letter-spacing: -0.04em;
            margin-bottom: 1.75rem;
            opacity: 0;
            animation: fadeUp 0.9s ease 0.5s forwards;
        }

        .hero-sub {
            font-size: clamp(1rem, 2vw, 1.15rem);
            color: var(--sub);
            max-width: 580px;
            margin: 0 auto 2rem;
            line-height: 1.65;
            font-weight: 300;
            opacity: 0;
            animation: fadeUp 0.9s ease 0.7s forwards;
        }

        .hero-ctas {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            opacity: 0;
            animation: fadeUp 0.9s ease 1s forwards;
        }

        .btn-hero-primary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.9rem 2rem;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #000;
            font-weight: 700;
            font-size: 0.9rem;
            font-family: var(--font-body);
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.35s var(--ease-out);
            box-shadow: 0 0 30px rgba(77,238,234,0.3);
        }

            .btn-hero-primary:hover {
                transform: translateY(-3px) scale(1.04);
                box-shadow: 0 0 50px rgba(77,238,234,0.5);
                color: #000;
            }

        .btn-hero-secondary {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 0.9rem 2rem;
            border-radius: 100px;
            border: 1px solid var(--border);
            background: var(--glass);
            backdrop-filter: blur(12px);
            color: var(--text);
            font-size: 0.9rem;
            font-family: var(--font-body);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.3s var(--ease-out);
        }

            .btn-hero-secondary:hover {
                border-color: var(--accent);
                background: rgba(77,238,234,0.1);
                transform: translateY(-2px);
            }

        .hero-scroll-hint {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            z-index: 3;
            opacity: 0;
            animation: fadeUp 1s ease 1.3s forwards;
            cursor: pointer;
        }

            .hero-scroll-hint span {
                font-family: var(--font-mono);
                font-size: 0.65rem;
                color: var(--sub);
                letter-spacing: 0.2em;
                text-transform: uppercase;
            }

        .hero-scroll-icon {
            width: 24px;
            height: 40px;
            border: 2px solid rgba(255,255,255,0.2);
            border-radius: 12px;
            display: flex;
            justify-content: center;
            padding-top: 6px;
        }

        .hero-scroll-dot {
            width: 4px;
            height: 8px;
            background: var(--accent);
            border-radius: 2px;
            animation: scrollDot 2s ease-in-out infinite;
        }

        @@keyframes scrollDot {
            0%, 100% {
                transform: translateY(0);
                opacity: 1
            }

            50% {
                transform: translateY(12px);
                opacity: 0.3
            }
        }

        /* ─── MAIN CONTENT AREA ─── */
        #trip-content {
            position: relative;
            z-index: 5;
            padding: 5rem 0 8rem;
        }

        .content-wrapper {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 2.5rem;
        }

        /* ─── TRIP PARAMETERS CARD ─── */
        .params-card {
            background: var(--glass);
            border: 1px solid var(--border-hi);
            border-radius: 24px;
            padding: 2.5rem;
            backdrop-filter: blur(30px);
            margin-bottom: 2rem;
            position: relative;
            overflow: hidden;
        }

            .params-card::before {
                content: '';
                position: absolute;
                top: -80px;
                right: -80px;
                width: 300px;
                height: 300px;
                background: radial-gradient(ellipse, rgba(168,85,247,0.08) 0%, transparent 70%);
                pointer-events: none;
            }

        .params-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .params-title {
            font-family: var(--font-head);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .params-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 1rem;
        }

        .params-item {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 1rem;
        }

        .params-item-label {
            font-family: var(--font-mono);
            font-size: 0.6rem;
            color: var(--sub);
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 0.4rem;
        }

        .params-item-value {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--text);
            line-height: 1.3;
        }

            .params-item-value.accent {
                color: var(--accent)
            }

        /* ─── AI INSIGHT BANNER ─── */
        .insight-banner {
            background: linear-gradient(135deg, rgba(168,85,247,0.05) 0%, rgba(77,238,234,0.05) 100%);
            border: 1px solid rgba(168,85,247,0.2);
            border-radius: 20px;
            padding: 2rem 2.5rem;
            margin-bottom: 2rem;
            display: flex;
            align-items: flex-start;
            gap: 1.5rem;
            position: relative;
            overflow: hidden;
        }

            .insight-banner::after {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(168,85,247,0.04) 0%, transparent 70%);
                pointer-events: none;
            }

        .insight-icon {
            font-size: 2.5rem;
            flex-shrink: 0;
            margin-top: 0.2rem;
        }

        .insight-content {
            flex: 1
        }

        .insight-label {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            color: var(--accent2);
            letter-spacing: 0.14em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .insight-title {
            font-family: var(--font-head);
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.6rem;
        }

        .insight-text {
            font-size: 0.875rem;
            color: var(--sub);
            line-height: 1.7;
        }

        .insight-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .insight-chip {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            padding: 0.3rem 0.75rem;
            border-radius: 100px;
            border: 1px solid rgba(168,85,247,0.25);
            color: var(--accent2);
            background: rgba(168,85,247,0.06);
            letter-spacing: 0.08em;
        }

        /* ─── TWO COLUMN LAYOUT ─── */
        .trip-layout {
            display: grid;
            grid-template-columns: 1fr 340px;
            gap: 2rem;
            align-items: start;
        }

        /* ─── DESTINATION CARDS ─── */
        .destinations-list {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .dest-card {
            background: linear-gradient(180deg, rgba(30,30,45,0.6) 0%, rgba(20,20,30,0.8) 100%);
            border: 1px solid var(--border);
            border-radius: 20px;
            overflow: hidden;
            backdrop-filter: blur(20px);
            transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
            position: relative;
        }

            .dest-card:hover {
                border-color: rgba(77,238,234,0.25);
                transform: translateY(-4px);
                box-shadow: 0 30px 60px rgba(0,0,0,0.4);
            }

            .dest-card::before {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 20px;
                padding: 1px;
                background: linear-gradient(135deg, rgba(77,238,234,0.1), transparent 50%, rgba(168,85,247,0.1));
                -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                z-index: 1;
                pointer-events: none;
                opacity: 0;
                transition: opacity 0.4s;
            }

            .dest-card:hover::before {
                opacity: 1
            }

        .dest-card-inner {
            display: flex;
            padding: 0;
            position: relative;
            z-index: 2;
        }

        .dest-card-img {
            width: 280px;
            min-height: 280px;
            flex-shrink: 0;
            position: relative;
            overflow: hidden;
        }

            .dest-card-img img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.6s ease;
                filter: brightness(0.75);
            }

        .dest-card:hover .dest-card-img img {
            transform: scale(1.06);
            filter: brightness(0.65);
        }

        .dest-card-rank {
            position: absolute;
            top: 1rem;
            left: 1rem;
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(77,238,234,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-head);
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--accent);
            z-index: 3;
        }

        .dest-card-body {
            flex: 1;
            padding: 1.75rem 2rem;
            display: flex;
            flex-direction: column;
        }

        .dest-card-region {
            font-family: var(--font-mono);
            font-size: 0.62rem;
            color: var(--accent);
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-bottom: 0.4rem;
        }

        .dest-card-name {
            font-family: var(--font-head);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.75rem;
        }

        .dest-card-specs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.5rem 1.5rem;
            margin-bottom: 1rem;
        }

        .dest-spec {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.8rem;
            color: var(--sub);
        }

        .dest-spec-val {
            color: var(--text);
            font-weight: 500;
        }

            .dest-spec-val.highlight {
                color: var(--accent);
                font-weight: 600;
            }

        .dest-card-match {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-top: auto;
            padding-top: 1rem;
            border-top: 1px solid rgba(255,255,255,0.06);
        }

        .match-score-ring {
            width: 52px;
            height: 52px;
            flex-shrink: 0;
        }

        .match-score-text {
            font-family: var(--font-head);
            font-size: 1.1rem;
            font-weight: 800;
        }

        .match-label {
            font-family: var(--font-mono);
            font-size: 0.6rem;
            color: var(--sub);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .dest-card-actions {
            display: flex;
            gap: 0.5rem;
            margin-left: auto;
        }

        .btn-book {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.55rem 1.2rem;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #000;
            font-weight: 700;
            font-size: 0.78rem;
            font-family: var(--font-body);
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: all 0.25s;
        }

            .btn-book:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(77,238,234,0.3);
            }

        .btn-details {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 0.55rem 1.2rem;
            border-radius: 100px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,0.04);
            color: var(--text);
            font-size: 0.78rem;
            font-family: var(--font-body);
            text-decoration: none;
            cursor: pointer;
            transition: all 0.25s;
        }

            .btn-details:hover {
                border-color: var(--accent);
                background: rgba(77,238,234,0.06);
            }

        /* ─── SIDEBAR ─── */
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            position: sticky;
            top: 2rem;
        }

        /* Trip Summary Card */
        .summary-card {
            background: var(--glass);
            border: 1px solid var(--border-hi);
            border-radius: 20px;
            padding: 1.75rem;
            backdrop-filter: blur(20px);
        }

        .summary-card-title {
            font-family: var(--font-head);
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
        }

        .budget-breakdown {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }

        .budget-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.82rem;
        }

        .budget-row-label {
            color: var(--sub);
        }

        .budget-row-val {
            font-weight: 600;
            color: var(--text);
        }

            .budget-row-val.total {
                font-family: var(--font-head);
                font-size: 1.1rem;
                color: var(--accent);
                font-weight: 800;
            }

        .budget-bar {
            height: 6px;
            background: rgba(255,255,255,0.06);
            border-radius: 3px;
            overflow: hidden;
            margin-bottom: 1.25rem;
        }

        .budget-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--accent2));
            border-radius: 3px;
            transition: width 0.6s var(--ease-out);
        }

        .summary-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
        }

        .summary-stat {
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 0.75rem;
            text-align: center;
        }

        .summary-stat-val {
            font-family: var(--font-head);
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--accent);
        }

        .summary-stat-key {
            font-family: var(--font-mono);
            font-size: 0.58rem;
            color: var(--sub);
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-top: 2px;
        }

        /* AI Tips Card */
        .ai-tips-card {
            background: var(--glass);
            border: 1px solid var(--border-hi);
            border-radius: 20px;
            padding: 1.75rem;
            backdrop-filter: blur(20px);
            position: relative;
            overflow: hidden;
        }

            .ai-tips-card::before {
                content: '';
                position: absolute;
                top: -60px;
                left: -60px;
                width: 200px;
                height: 200px;
                background: radial-gradient(ellipse, rgba(77,238,234,0.07) 0%, transparent 70%);
                pointer-events: none;
            }

        .ai-tips-title {
            font-family: var(--font-head);
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 1.25rem;
        }

        .ai-tip {
            display: flex;
            gap: 0.75rem;
            padding: 0.85rem 0;
            border-bottom: 1px solid var(--border);
            font-size: 0.82rem;
            line-height: 1.55;
            color: var(--sub);
        }

            .ai-tip:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .ai-tip-icon {
            color: var(--accent);
            font-size: 0.85rem;
            flex-shrink: 0;
            margin-top: 2px;
        }

        /* Quick Actions */
        .actions-card {
            background: var(--glass);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 1.5rem;
            backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .action-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 0.75rem;
            border-radius: 12px;
            font-size: 0.83rem;
            font-family: var(--font-body);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s;
            border: none;
            text-decoration: none;
        }

        .action-btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: #000;
        }

            .action-btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 24px rgba(77,238,234,0.3);
            }

        .action-btn-secondary {
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--border);
            color: var(--text);
        }

            .action-btn-secondary:hover {
                border-color: var(--accent);
                background: rgba(77,238,234,0.06);
            }

        /* ─── LOADING OVERLAY ─── */
        #loading-overlay {
            position: fixed;
            inset: 0;
            background: var(--bg-deep);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2rem;
            transition: opacity 0.5s, visibility 0.5s;
        }

            #loading-overlay.hidden {
                opacity: 0;
                visibility: hidden;
            }

        .loading-orb {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            border: 2px solid rgba(77,238,234,0.15);
            border-top-color: var(--accent);
            border-right-color: var(--accent2);
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg)
            }
        }

        .loading-text {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            color: var(--sub);
            letter-spacing: 0.15em;
            text-transform: uppercase;
        }

        .loading-steps {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            align-items: center;
        }

        .loading-step {
            font-size: 0.8rem;
            color: var(--sub);
            opacity: 0;
            transition: opacity 0.4s, color 0.4s;
        }

            .loading-step.active {
                opacity: 1;
                color: var(--accent);
            }

            .loading-step.done {
                opacity: 0.5;
                color: var(--text);
            }

        /* ─── SECTION HEADING ─── */
        .section-head-block {
            margin-bottom: 3rem;
            text-align: center;
        }

            .section-head-block h2 {
                font-family: var(--font-head);
                font-size: clamp(1.8rem, 3.5vw, 2.5rem);
                font-weight: 800;
                letter-spacing: -0.03em;
                margin-bottom: 0.5rem;
            }

            .section-head-block p {
                color: var(--sub);
                font-size: 0.95rem;
            }

        /* ─── RESPONSIVE ─── */
        @@media(max-width:1024px) {
            .trip-layout {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: static;
            }

            .params-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .dest-card-inner {
                flex-direction: column;
            }

            .dest-card-img {
                width: 100%;
                min-height: 200px;
                height: 200px;
            }
        }

        @@media(max-width:768px) {
            .params-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .dest-card-body {
                padding: 1.25rem;
            }

            .dest-card-specs {
                grid-template-columns: 1fr;
            }
        }

        @@media(max-width:480px) {
            .params-grid {
                grid-template-columns: 1fr 1fr;
            }

            .content-wrapper {
                padding: 0 1.25rem;
            }
        }
    </style>
}

