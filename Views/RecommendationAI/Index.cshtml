        // ── Region-specific insights ──
        var regionInsights = {
            'Europe': {
                icon: '🧠',
                title: 'European Travel Intelligence',
                desc: 'European destinations offer incredible diversity within short distances. Your mid-range budget opens doors to authentic experiences - from Mediterranean coastlines to Alpine retreats. Spring and fall provide the best balance of pleasant weather and fewer crowds.',
