@model TourwebsiteFYP.DB_data_models.PackageType

@{
    ViewBag.Title = "Edit Package Type";
}

<div class="container-fluid mt-4">
    <div class="col-md-12">

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Card -->
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-warning text-dark">
                <h1 class="card-title mb-0 fs-5">Edit Package Type</h1>
                <a href="~/AdminArea/ManagePackageType/Index" class="btn btn-light btn-sm float-end">
                    <i class="bi bi-arrow-left-circle me-1"></i> Back to List
                </a>
            </div>

            <!-- Form -->
            <form method="post" enctype="multipart/form-data" action="/AdminArea/ManagePackageType/Edit">


                <input type="hidden" name="PackageTypeId" value="@Model.PackageTypeId" />
                <input type="hidden" name="ImageUrl" value="@Model.ImageUrl" />


                <div class="card-body">
                    <div class="row g-4">

                        <!-- Type Name -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Type Name</label>
                            <input type="text" name="TypeName" value="@Model.TypeName" class="form-control" placeholder="Enter type name" required />
                        </div>

                        <!-- Current Image Preview -->
                        <!-- Upload New Image -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Upload New Image</label>
                            <input type="file" name="img" class="form-control" />
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="card-footer d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-warning text-white">
                        <i class="bi bi-check-circle me-1"></i> Update
                    </button>
                    <a href="~/AdminArea/ManagePackageTypes/Index" class="btn btn-danger">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
