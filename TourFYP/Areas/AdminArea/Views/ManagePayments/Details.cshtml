@model TourwebsiteFYP.DB_data_models.Payment

@{
    ViewBag.Title = "Payment Details";
}

<div class="container mt-4">
    <div class="card shadow-sm rounded-4">
        <!-- Card Header -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Payment Details</h5>
            <a href="@Url.Action("Index", "ManagePayments", new { area = "AdminArea" })" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left-circle me-1"></i> Back to List
            </a>
        </div>

        <!-- Card Body -->
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold">Payment ID:</label>
                    <p>@Model.PaymentId</p>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Booking ID:</label>
                    <p>@Model.BookingId</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold">Amount:</label>
                    <p>@Model.Amount.ToString("C")</p>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Payment Method:</label>
                    <p>@Model.PaymentMethod</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold">Status:</label>
                    <p>
                        @if (Model.Status == "Completed")
                        {
                            <span class="badge bg-success">Completed</span>
                        }
                        else if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Status</span>
                        }
                    </p>
                </div>
                <div class="col-md-6">
                    <label class="fw-bold">Payment Date:</label>
                    <p>@Model.PaymentDate?.ToString("yyyy-MM-dd")</p>
                </div>
            </div>

          
        </div>

        <!-- Card Footer -->
        <div class="card-footer d-flex justify-content-end">
            <a href="@Url.Action("Edit", "ManagePayments", new { id = Model.PaymentId, area = "AdminArea" })" class="btn btn-warning me-2">
                <i class="bi bi-pencil-square me-1"></i> Edit
            </a>
            <a href="@Url.Action("Index", "ManagePayments", new { area = "AdminArea" })" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Back
            </a>
        </div>
    </div>
</div>

