@model TourwebsiteFYP.DB_data_models.Payment
@{
    ViewBag.Title = "Edit Payment";
}

<div class="col-md-12">
    <div class="card shadow-sm rounded-4 mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">Edit Payment</h5>
        </div>

        <form method="post" action="@Url.Action("Edit", "ManagePayments", new { area = "AdminArea" })">
            @Html.HiddenFor(m => m.PaymentId)

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Booking ID</label>
                        @Html.TextBoxFor(m => m.BookingId, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Amount</label>
                        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Payment Method</label>
                        @Html.TextBoxFor(m => m.PaymentMethod, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Pending", "Completed", "Failed" }, Model.Status), new { @class = "form-control" })
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Update
                </button>
                <a href="@Url.Action("Index", "ManagePayments", new { area = "AdminArea" })" class="btn btn-danger">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>


