@model TourwebsiteFYP.DB_data_models.PaymentType
@{
    ViewBag.Title = "Edit";
}




<div class="col-md-12 mt-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-header bg-primary text-white">
            <h5>Edit Payment Method</h5>
        </div>

        <form method="post" action="/AdminArea/ManagePaymentType/Edit">
            <input type="hidden" name="PaymentTypeId" value="@Model.PaymentTypeId" />
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Payment Type Name</label>
                    <input name="PaymentTypeName" type="text" class="form-control" value="@Model.PaymentTypeName" required />
                </div>
            </div>

            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success">Update</button>
                <a href="/AdminArea/ManagePaymentType/Index" class="btn btn-danger">Cancel</a>
            </div>
        </form>
    </div>
</div>
