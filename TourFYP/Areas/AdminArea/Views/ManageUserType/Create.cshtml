@model TourwebsiteFYP.DB_data_models.UserType

@{
    ViewBag.Title = "Create User Type";
}

<div class="col-md-12">
    @if (ViewBag.Message != null)
    {
        <label style="width:100%" class="alert alert-success">Data Inserted Successfully!</label>
    }

    <!--begin::Package Type Card-->
    <div class="card shadow-sm rounded-4 mb-4">
        <!--begin::Card Header-->
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">Add User Type</h5>
        </div>
        <!--end::Card Header-->
        <!--begin::Form-->
        <form enctype="multipart/form-data" method="post" action="/AdminArea/ManageUserType/Create">
            <!--begin::Card Body-->
            <div class="card-body">
                <div class="row g-3">
                    <!-- Package Type Name -->
                    <div class="col-md-6">
                        <label class="form-label">User Type Name</label>
                        <input name="TypeName" type="text" class="form-control" placeholder="Enter User type name" required />
                    </div>

                  
                   
                </div>
            </div>
            <!--end::Card Body-->
            <!--begin::Card Footer-->
            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i> Submit
                </button>
                <a href="/AdminArea/ManageUserType/Index" class="btn btn-danger">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </a>
            </div>
            <!--end::Card Footer-->
        </form>
        <!--end::Form-->
    </div>
    <!--end::Package Type Card-->
</div>
