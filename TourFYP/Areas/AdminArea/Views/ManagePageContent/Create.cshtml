
@model TourwebsiteFYP.DB_data_models.PageContent
@{
    ViewBag.Title = "Create Page Content";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>Create Page Content</h4>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Page Name</label>
                    <input type="text" name="PageName" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" name="pageTitle" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Subtitle</label>
                    <textarea name="pageSubtitle" class="form-control"></textarea>
                </div>
                <button type="submit" class="btn btn-success">Save</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
