@model TourwebsiteFYP.DB_data_models.PageContent
@{
    ViewBag.Title = "Edit Page Content";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h4>Edit Page Content</h4>
        </div>
        <div class="card-body">
            <form method="post">
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Page Name</label>
                    <input type="text" name="PageName" class="form-control" value="@Model.PageName" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" name="pageTitle" class="form-control" value="@Model.pageTitle" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Subtitle</label>
                    <textarea name="pageSubtitle" class="form-control">@Model.pageSubtitle</textarea>
                </div>
                <button type="submit" class="btn btn-success">Update</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>


