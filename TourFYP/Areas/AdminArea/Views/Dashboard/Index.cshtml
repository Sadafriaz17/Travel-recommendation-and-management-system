@{
    ViewBag.Title = "Dashboard";
   
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>



<div class="container-fluid mt-4">

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-box2-fill fs-1"></i>
                    <h6 class="mt-2">Total Packages</h6>
                    <h2>12</h2>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-white bg-success shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check-fill fs-1"></i>
                    <h6 class="mt-2">Total Bookings</h6>
                    <h2>250</h2>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-white bg-warning shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-people-fill fs-1"></i>
                    <h6 class="mt-2">Total Customers</h6>
                    <h2>180</h2>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-white bg-danger shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-currency-dollar fs-1"></i>
                    <h6 class="mt-2">Total Revenue</h6>
                    <h2>$45K</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row">
        <!-- Booking Trends Full Width -->
        <div class="col-lg-12 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">📈 Booking Trends (Jan - Dec)</div>
                <div class="card-body">
                    <canvas id="lineChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="row">
            <!-- Package Distribution -->
            <div class="row">
                <!-- Package Distribution -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-success text-white">📊 Package Distribution</div>
                        <div class="card-body d-flex justify-content-center align-items-center">
                            <canvas id="packagePieChart" style="max-height:300px; width:100%;"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Product Distribution (Doughnut) -->
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-warning text-white">🛒 Product Distribution</div>
                        <div class="card-body d-flex justify-content-center align-items-center">
                            <canvas id="productDoughnutChart" style="max-height:300px; width:100%;"></canvas>
                        </div>
                    </div>
                </div>
            </div>


            <!-- Monthly Revenue -->
            <div class="col-lg-12 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-info text-white">💰 Monthly Revenue</div>
                    <div class="card-body">
                        <canvas id="barChart" height="100" ></canvas>
                    </div>
                </div>
            </div>
        </div>



        <!-- Tables -->
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-dark text-white">📝 Latest Bookings</div>
                    <div class="card-body p-0">
                        <table class="table table-striped m-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Customer</th>
                                    <th>Package</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>BK001</td>
                                    <td>John Doe</td>
                                    <td>Dubai Tour</td>
                                    <td><span class="badge bg-success">Confirmed</span></td>
                                </tr>
                                <tr>
                                    <td>BK002</td>
                                    <td>Sara Ali</td>
                                    <td>Turkey Adventure</td>
                                    <td><span class="badge bg-warning">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>BK003</td>
                                    <td>Michael Smith</td>
                                    <td>Maldives Trip</td>
                                    <td><span class="badge bg-danger">Cancelled</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">🛍️ Latest Products</div>
                    <div class="card-body p-0">
                        <table class="table table-striped m-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Category</th>
                                    <th>Stock</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>PR001</td>
                                    <td>Travel Bag</td>
                                    <td>Accessories</td>
                                    <td><span class="badge bg-success">In Stock</span></td>
                                </tr>
                                <tr>
                                    <td>PR002</td>
                                    <td>Camera</td>
                                    <td>Electronics</td>
                                    <td><span class="badge bg-warning">Low</span></td>
                                </tr>
                                <tr>
                                    <td>PR003</td>
                                    <td>Water Bottle</td>
                                    <td>Essentials</td>
                                    <td><span class="badge bg-danger">Out</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
    </div>

<!-- Chart.js Scripts -->
<script>
    // Booking Trends Line Chart (Jan - Dec)
    // Booking + Product Trends Line Chart (Jan - Dec)
    new Chart(document.getElementById("lineChart"), {
        type: 'line',
        data: {
            labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
            datasets: [
                {
                    label: "Bookings",
                    data: [12, 19, 3, 5, 8, 15, 20, 25, 18, 22, 30, 35],
                    borderColor: "rgba(75, 192, 192, 1)",
                    backgroundColor: "rgba(75, 192, 192, 0.2)",
                    fill: true,
                    tension: 0.3
                },
                {
                    label: "Products",
                    data: [8, 12, 5, 10, 15, 18, 22, 28, 24, 20, 27, 32],
                    borderColor: "rgba(255, 99, 132, 1)",
                    backgroundColor: "rgba(255, 99, 132, 0.2)",
                    fill: true,
                    tension: 0.3
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: "top"
                },
                title: {
                    display: true,
                    text: "📈 Booking & Product Trends (Jan - Dec)"
                }
            }
        }
    });


    // Package Distribution Pie Chart
    // Package Distribution (Pie Chart)
    new Chart(document.getElementById("packagePieChart"), {
        type: 'pie',
        data: {
            labels: ["Adventure", "Luxury", "Budget", "Family"],
            datasets: [{
                data: [30, 25, 20, 25],
                backgroundColor: [
                    "rgba(54, 162, 235, 0.7)",
                    "rgba(255, 99, 132, 0.7)",
                    "rgba(255, 206, 86, 0.7)",
                    "rgba(75, 192, 192, 0.7)"
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: "bottom" },
                title: {
                    display: true,
                    text: "Package Distribution"
                }
            }
        }
    });

    // Product Distribution (Doughnut Chart)
    new Chart(document.getElementById("productDoughnutChart"), {
        type: 'doughnut',
        data: {
            labels: ["Flights", "Hotels", "Tours", "Transport"],
            datasets: [{
                data: [40, 20, 25, 15],
                backgroundColor: [
                    "rgba(153, 102, 255, 0.7)",
                    "rgba(255, 159, 64, 0.7)",
                    "rgba(255, 205, 86, 0.7)",
                    "rgba(54, 162, 235, 0.7)"
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: "bottom" },
                title: {
                    display: true,
                    text: "Product Distribution"
                }
            }
        }
    });


    // Monthly Revenue Bar Chart
    new Chart(document.getElementById("barChart"), {
        type: 'bar',
        data: {
            labels: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
            datasets: [{
                label: "Revenue ($)",
                data: [500, 700, 800, 600, 900, 1200, 1500, 1400, 1100, 1300, 1600, 1800],
                backgroundColor: "rgba(54, 162, 235, 0.6)"
            }]
        }
    });

</script>
