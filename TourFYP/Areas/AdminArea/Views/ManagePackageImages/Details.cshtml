@model TourwebsiteFYP.DB_data_models.PackageImage
@{
    ViewBag.Title = "Image Details";
}

<div class="container mt-4">
    <h3>Image Details</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Image ID</dt>
        <dd class="col-sm-10">@Model.ImageId</dd>

        <dt class="col-sm-2">Package ID</dt>
        <dd class="col-sm-10">@Model.PackageId</dd>

        <dt class="col-sm-2">Image</dt>
        <dd class="col-sm-10">
            <img src="@Model.ImageUrl" alt="Image" style="width:150px;height:auto;" />
        </dd>
    </dl>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>
</div>
