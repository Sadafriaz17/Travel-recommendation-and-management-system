@model TourwebsiteFYP.DB_data_models.Booking

@{
    ViewBag.Title = "Booking Details";
}

<div class="card mt-4">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Booking Details</h3>
        <a href="~/AdminArea/ManageBookings/Index" class="btn btn-light btn-sm">
            <i class="bi bi-arrow-left-circle"></i> Back to List
        </a>
    </div>

    <div class="card-body">
        <h5 class="mb-3">Booking Information</h5>
        <dl class="row">
            <dt class="col-sm-3">Booking ID</dt>
            <dd class="col-sm-9">@Model.BookingId</dd>

            <dt class="col-sm-3">Customer Name</dt>
            <dd class="col-sm-9">@Model.UserId</dd>

            <dt class="col-sm-3">Booking Date</dt>
            <dd class="col-sm-9">@Model.BookingDate</dd>

            <dt class="col-sm-3">Total Amount</dt>
            <dd class="col-sm-9">Rs. @Model.TotalAmount</dd>

            <dt class="col-sm-3">Payment Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
        </dl>
    </div>

    <div class="card-body border-top">
        <h5 class="mb-3">Package Details</h5>
        @if (Model.BookingDetails != null && Model.BookingDetails.Any())
        {
            <table class="table table-bordered table-striped">
                <thead class="table-secondary">
                    <tr>
                        <th>Package</th>
                        <th>Quantity</th>
                        <th>Price (Rs.)</th>
                        <th>Subtotal (Rs.)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.BookingDetails)
                    {
                        <tr>
                            <td>@detail.Package.PackageName</td>
                            <td>@detail.Quantity</td>
                            <td>@detail.Price</td>
                            <td>@(detail.Quantity * detail.Price)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-info">
                        <td colspan="3" class="text-end"><strong>Total:</strong></td>
                        <td><strong>Rs. @Model.TotalAmount</strong></td>
                    </tr>
                </tfoot>
            </table>
        }
        else
        {
            <p>No package details available for this booking.</p>
        }
    </div>
</div>
