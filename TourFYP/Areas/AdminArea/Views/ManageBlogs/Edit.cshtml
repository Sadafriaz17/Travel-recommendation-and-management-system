
@model TourwebsiteFYP.DB_data_models.Blog

@{
    ViewBag.Title = "Edit Blog";
}

<div class="card mt-4">
    <div class="card-header"  style="background-color:paleturquoise">Edit Blog</div>
    <div class="card-body">
        @using (Html.BeginForm("Edit", "ManageBlogs", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(m => m.BlogId)

            <div class="form-group">
                <label>Title</label>
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
            </div>
            <div class="form-group mt-2">
                <label>Content</label>
                @Html.TextAreaFor(m => m.Content, new { @class = "form-control", rows = 6 })
            </div>
            <div class="col-md-6">
                <label class="form-label">Upload Image</label>
                <input type="file" name="img" class="form-control" />

            </div>
            <div class="form-group mt-2">
                <label>Author Id</label>
                @Html.TextBoxFor(m => m.AuthorId, new { @class = "form-control" })
            </div>
            <button type="submit" class="btn btn-success mt-3">Update</button>
            <a href="/AdminArea/ManageBlogs" class="btn btn-secondary mt-3">Cancel</a>
        }
    </div>
</div>
