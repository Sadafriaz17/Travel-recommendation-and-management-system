@{
    ViewBag.Title = "Create Destination";
}

<div class="card mt-4">
    <div class="card-header">
        <span>Create Destination</span>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" action="/AdminArea/ManageDestination/Create">
            <div class="mb-3">
                <label class="form-label">Destination Name</label>
                <input type="text" name="Name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Location</label>
                <input type="text" name="Location" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <input type="text" name="Description" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Price</label>
                <input type="text" name="Price" class="form-control" />
            </div>
            <!-- Image Uploads -->
            <div class="mb-3">
                <label class="form-label">Upload Image</label>
                <input type="file" name="img" class="form-control" />
            </div>
            
            <div class="form-group col-md-6">
                <label class="form-label">Package Type Name</label>
                <select name="PackageTypeId" class="form-control">
                    @foreach (var item in ViewBag.Packagelist)
                    {
                       
                        <option  value="@item.PackageTypeId">@item.TypeName</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-success">Save</button>
            <a href="/AdminArea/ManageDestination/Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>


